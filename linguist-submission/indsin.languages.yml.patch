# Add this entry, alphabetically, inside lib/linguist/languages.yml in the github-linguist/linguist
# repo. As with the Rin entry, OMIT `language_id` (it is generated by `script/update-ids`).
# `tm_scope` must match syntaxes/indsin.tmLanguage.json → "scopeName": "source.indsin".

indsin:
  type: markup
  color: "#6A55D8"
  extensions:
  - ".indsin"
  tm_scope: source.indsin
  ace_mode: text
  aliases:
  - indsin-ui
