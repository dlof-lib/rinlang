// indsin sample — a counter card with responsive padding and an animated banner
@import "lib/ui.og.rin";

@container=Demo
    warp count = 0;

    @view.Column=Root
        padding="spacious";
        padding_md=24;
        gap="normal";
        bg="#1E1E2E";
        effect="slideUp";
        stagger=60ms;

        @view.Banner=Notice
            type="success";
            message="Hello, indsin!";
            dismissible=true;
        .end/view

        @view.Card=CounterCard
            elevation="lg";
            radius="soft";
            title="Counter";

            @view.Text=Value
                text="Count: " + count;
                size="heading";
                tone="primary";
            .end/view

            @view.Button=Inc
                label="Add";
                variant="gradient";
                width=120px;
                onTap=count = count + 1;
            .end/view
        .end/view
    .end/view
.end/container
