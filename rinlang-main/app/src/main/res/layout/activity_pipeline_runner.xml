<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pipeline_screen_bg">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pipeline_header_bg"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rin+"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_pipeline_logo_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pipeline_runner_title"
                android:textColor="@color/pipeline_header_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPipelineContainerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pipeline_header_subtext"
                android:textSize="12sp"
                android:layout_marginTop="1dp"
                tools:text="@container.pipe = sales_pipeline" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPipelineClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/find_close_desc"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- ===== Body ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Source code preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pipeline_source_label"
                android:textColor="@color/pipeline_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtPipelineCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="12dp"
                android:background="@drawable/bg_pipeline_code_card"
                android:textColor="@color/pipeline_text_primary"
                tools:text="@container.pipe=sales_pipeline" />

            <!-- Flow diagram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_pipeline_panel_card"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/flowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal" />

            </LinearLayout>

            <!-- Execution status -->
            <LinearLayout
                android:id="@+id/statusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pipeline_status_neutral"
                android:padding="14dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/txtPipelineStatusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_status_running"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/txtPipelineStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pipeline_status_idle"
                    android:textColor="@color/pipeline_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPipelineDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/pipeline_text_muted"
                android:visibility="gone" />

            <!-- Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnPipelineRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/pipeline_action_run"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_pipeline_btn_primary" />

                <Button
                    android:id="@+id/btnPipelineStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/pipeline_action_stop"
                    android:textAllCaps="false"
                    android:textColor="@color/pipeline_btn_outline_text"
                    android:background="@drawable/bg_pipeline_btn_outline"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btnPipelineConfigure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pipeline_action_configure"
                    android:textAllCaps="false"
                    android:textColor="@color/pipeline_btn_outline_text"
                    android:background="@drawable/bg_pipeline_btn_outline" />
            </LinearLayout>

            <!-- يظهر فقط عندما لا يتم التعرّف على أي @container.pipe حقيقي في كود المستخدم؛
                 لا يُستبدل كود المستخدم تلقائياً أبداً — هذا الزر هو الطريقة الوحيدة لتحميل المثال. -->
            <Button
                android:id="@+id/btnPipelineLoadSample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pipeline_action_load_sample"
                android:textAllCaps="false"
                android:textColor="@color/pipeline_green"
                android:background="@drawable/bg_pipeline_btn_outline"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
