<?xml version="1.0" encoding="utf-8"?>
<!-- الصفحة الرئيسية لـ "معرض مشاريع Rin": بحث + تصنيفات + قائمة بطاقات مشاريع، بنفس هوية
     activity_rin_extensions_marketplace.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_store_section_card"
        android:layout_margin="10dp"
        android:padding="6dp">

        <EditText
            android:id="@+id/edtGallerySearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:hint="@string/project_gallery_search_hint"
            android:textColor="@color/rin_editor_text"
            android:textColorHint="@color/rin_editor_hint"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_store_section_card"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        android:padding="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/project_gallery_publish_hint"
            android:textColor="@color/rin_editor_hint"
            android:textSize="11.5sp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnGalleryOpenPublish"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/project_gallery_publish_button"
            android:textAllCaps="false"
            android:textSize="12.5sp"
            android:background="@drawable/bg_toolbar_btn_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGalleryCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:singleSelection="true"
            app:chipSpacingHorizontal="6dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dlof.rinlang.widgets.ShimmerLayout
            android:id="@+id/shimmerGallerySkeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGalleryProjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/txtGalleryEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/project_gallery_empty"
            android:textColor="@color/rin_editor_hint"
            android:textSize="13sp"
            android:visibility="gone"
            android:gravity="center"
            android:paddingHorizontal="32dp" />
    </FrameLayout>
</LinearLayout>
