{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rin",
  "scopeName": "source.rin",
  "fileTypes": ["rin", "aak.rin"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#import-statement" },
    { "include": "#end-tags" },
    { "include": "#dot-member-tags" },
    { "include": "#link-id-attribute" },
    { "include": "#block-tags" },
    { "include": "#section-tags" },
    { "include": "#oop-keywords" },
    { "include": "#keywords-control" },
    { "include": "#keywords-logical" },
    { "include": "#keywords-storage" },
    { "include": "#keyword-print" },
    { "include": "#make-unit" },
    { "include": "#reckon-unit" },
    { "include": "#container-statement-keywords" },
    { "include": "#relation-keywords" },
    { "include": "#attribute-keywords" },
    { "include": "#ternary-keyword" },
    { "include": "#constants" },
    { "include": "#math-constants" },
    { "include": "#explicit-math-functions" },
    { "include": "#builtin-functions" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "oop-keywords": {
      "comment": "Rin 1.0 OOP: contextual (non-reserved) words. Declarations are only recognised when followed by a name, modifiers only inside class bodies.",
      "patterns": [
        { "match": "\\b(abstract|final)(?=\\s+(?:abstract\\s+|final\\s+)*class\\b)", "name": "storage.modifier.rin" },
        { "match": "\\b(class|struct|interface|trait|enum)(?=\\s+[A-Za-z_])", "name": "storage.type.class.rin" },
        { "match": "\\b(extends|implements|uses|instanceof)(?=\\s+[A-Za-z_])", "name": "keyword.operator.word.rin" },
        { "match": "\\b(public|private|protected|static|abstract|final|override)(?=\\s+(?:let|fun|get|set|public|private|protected|static|abstract|final|override)\\b)", "name": "storage.modifier.rin" },
        { "match": "\\b(get|set)(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*\\()", "name": "storage.modifier.accessor.rin" },
        { "match": "\\b(self|super)\\b", "name": "variable.language.rin" },
        { "match": "\\b__(?:add|sub|mul|div|mod|neg|eq|ne|lt|le|gt|ge|cmp|str|len|getitem|setitem|call|iter|contains)__\\b", "name": "support.function.magic.rin" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rin",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.rin",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "comment": "Rin's lexer supports \\n \\t \\r \\\" \\\\ and a backslash-newline continuation; any other escaped char is kept literally, so match generically.",
          "name": "constant.character.escape.rin",
          "match": "\\\\."
        }
      ]
    },

    "numbers": {
      "comment": "Rin numbers are unsigned decimal literals only: \\d+ or \\d+.\\d+ (no hex, no exponents, no leading dot, no digit separators).",
      "name": "constant.numeric.rin",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },

    "import-statement": {
      "comment": "@import \"path\"; and @import \"path\" as alias; -- import/as are contextual, not reserved, but always mean the same thing here.",
      "patterns": [
        {
          "match": "(@)(import)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.tag.rin" },
            "2": { "name": "keyword.control.import.rin" }
          }
        },
        {
          "match": "\\bas\\b",
          "name": "keyword.control.import.rin"
        }
      ]
    },

    "end-tags": {
      "comment": ".end/Kind closing marker. Slashes can appear inside the kind itself (container.open/object), so the tail is matched greedily.",
      "patterns": [
        {
          "match": "(\\.end)(/)(Containers\\.Group|Volume|Object|portal|block|sticker|AUKT|Everything|Rin\\.make|make|table|doc|container(?:\\.(?:pipe|data|api|import|table|doc|object|portal|block|sticker|aukt|everything|make|open))?(?:/object)?|view(?:\\.[A-Za-z][A-Za-z0-9_]*)?|Section|Translations)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.tag.end.rin" },
            "2": { "name": "punctuation.separator.rin" },
            "3": { "name": "entity.name.tag.container.rin" }
          }
        },
        {
          "match": "(\\.end)(/)([A-Za-z_][A-Za-z0-9_./]*)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.end.rin" },
            "2": { "name": "punctuation.separator.rin" },
            "3": { "name": "entity.name.tag.rin" }
          }
        }
      ]
    },

    "dot-member-tags": {
      "comment": "`.object=` is the only member shorthand the parser actually accepts (Parser::objectFieldStatement), used inside @container.open/object: .object=text title = \"Rin\"; / .object=let x = 1; / .object=fun f() {...}",
      "match": "(\\.)(object)(=)",
      "captures": {
        "1": { "name": "punctuation.accessor.rin" },
        "2": { "name": "entity.other.attribute-name.rin" },
        "3": { "name": "keyword.operator.assignment.rin" }
      }
    },

    "link-id-attribute": {
      "comment": "link.id=\"X\"; registers a cross-file link id for the current container (Parser::linkIdDeclOrStatement).",
      "match": "\\b(link)(\\.)(id)\\b(=)?",
      "captures": {
        "1": { "name": "keyword.other.container.rin" },
        "2": { "name": "punctuation.accessor.rin" },
        "3": { "name": "entity.other.attribute-name.rin" },
        "4": { "name": "keyword.operator.assignment.rin" }
      }
    },

    "block-tags": {
      "comment": "@Kind=name ... .end/Kind block openers used by @import/@container/@Containers.Group/@Object/@view.*/etc.",
      "patterns": [
        {
          "comment": "Recognized container/view family tags get their own scope for finer theming.",
          "match": "(@)(Containers\\.Group|Volume|Object|portal|block|sticker|AUKT|Everything|Rin\\.make|make|table|doc|container(?:\\.(?:pipe|data|api|import|table|doc|object|portal|block|sticker|aukt|everything|make|open))?(?:/object)?|view(?:\\.[A-Za-z][A-Za-z0-9_]*)?)\\b(=)?",
          "captures": {
            "1": { "name": "punctuation.definition.tag.rin" },
            "2": { "name": "entity.name.tag.container.rin" },
            "3": { "name": "keyword.operator.assignment.rin" }
          }
        },
        {
          "comment": "Fallback for any other/custom @Tag the interpreter may accept.",
          "match": "(@)([A-Za-z_][A-Za-z0-9_./]*)(=)?",
          "captures": {
            "1": { "name": "punctuation.definition.tag.rin" },
            "2": { "name": "entity.name.tag.rin" },
            "3": { "name": "keyword.operator.assignment.rin" }
          }
        }
      ]
    },

    "section-tags": {
      "comment": "Section=name and bare Translations blocks nest inside a container without an @ prefix.",
      "patterns": [
        {
          "match": "\\b(Section)\\b(=)?",
          "captures": {
            "1": { "name": "entity.name.tag.container.rin" },
            "2": { "name": "keyword.operator.assignment.rin" }
          }
        },
        {
          "match": "\\b(Translations)\\b",
          "name": "entity.name.tag.container.rin"
        }
      ]
    },

    "keywords-control": {
      "name": "keyword.control.rin",
      "match": "\\b(continue|rinopen|return|break|while|else|for|if)\\b"
    },

    "keywords-logical": {
      "name": "keyword.operator.word.rin",
      "match": "\\b(and|or)\\b"
    },

    "keywords-storage": {
      "comment": "الكلمات المحجوزة let/fun/text، وwarp/make سياقيتان وتُعاملان كـ let (Parser::declaration / warpDeclaration). define/declare/create/var/set ليست مرادفات لـ let في المحلّل — راجع syntaxes/rin-keywords.json (claimedButAbsent).",
      "name": "storage.type.rin",
      "match": "\\b(make|text|warp|fun|let)\\b"
    },

    "keyword-print": {
      "comment": "'show' is a full lexer-level synonym for 'print' (rin_lexer.cpp keywords table -> same TokenType::PRINT), part of the simplified-English keyword family alongside `make`/`@make`.",
      "name": "keyword.other.print.rin",
      "match": "\\b(print|show)\\b"
    },

    "make-unit": {
      "comment": "Make Unit syntax and policy directives (see docs/MAKE_UNIT.md).",
      "patterns": [
        {
          "match": "(@)(make)(\\.)(\\()([A-Za-z_][A-Za-z0-9_]*)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.tag.rin" },
            "2": { "name": "entity.name.tag.container.rin" },
            "3": { "name": "punctuation.accessor.rin" },
            "4": { "name": "punctuation.section.parameters.begin.rin" },
            "5": { "name": "entity.name.type.rin" },
            "6": { "name": "punctuation.section.parameters.end.rin" }
          }
        },
        {
          "comment": "Policy directive keywords: kind, use, need, allow, deny, strict, input/output, public/private, version/description.",
          "match": "\\b(kind|use|need|allow|deny|strict|input|output|public|private|version|description)\\b",
          "name": "keyword.control.directive.make.rin"
        },
        {
          "comment": "kind's value list: app|page|component|library|module|service|task|data|plugin, only right after the `kind` keyword.",
          "match": "(?<=\\bkind\\s)\\s*(app|page|component|library|module|service|task|data|plugin)\\b",
          "name": "storage.type.make-kind.rin"
        },
        {
          "comment": "Capability names, only when they follow use/need/allow/deny (Rin's Make-Unit capability policy surface).",
          "match": "(?<=\\b(?:use|need|allow|deny)\\s)\\s*(container|loop|function|condition|return|view|data|api|import|table|doc|chatbot|reckon)\\b",
          "name": "support.type.capability.make.rin"
        }
      ]
    },

    "reckon-unit": {
      "comment": "Reckon: a two-line computed value over a collection. See docs/RECKON.md.",
      "patterns": [
        {
          "comment": "reckon name(collection) header.",
          "match": "\\b(reckon)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.reckon.rin" },
            "2": { "name": "entity.name.function.reckon.rin" }
          }
        },
        {
          "comment": "where filter clause on the body line.",
          "match": "\\bwhere\\b",
          "name": "keyword.control.reckon.rin"
        },
        {
          "comment": "item: the implicit per-element binding, only meaningful inside a Reckon body.",
          "match": "\\bitem\\b",
          "name": "variable.language.reckon-item.rin"
        }
      ]
    },

    "container-statement-keywords": {
      "comment": "Statement-level keywords belonging to Rin's data/container language.",
      "name": "keyword.other.container.rin",
      "match": "\\b(save|file|installation|simplified|link|tying|merge|pipe|container|Containers|Group|Volume|translation)\\b"
    },

    "relation-keywords": {
      "comment": "Contextual statement keywords for the table/NoSQL/API surface (Parser::statement dispatch on peek().lexeme): document, route, row, style, table. Not reserved in the lexer, but always mean the same thing when they start a statement.",
      "name": "keyword.other.relation.rin",
      "match": "\\b(document|route|row|table|style)\\b"
    },

    "attribute-keywords": {
      "comment": "The closed, authoritative set of key=value attribute names the parser actually checks for by exact text (rin_parser.cpp): print's sep/level/label/repeat/pretty/upper/lower/width/align/end/if, document's id/fields, file/save/installation's path/format, row's cells, style's value, route's method/path/status/body, link's to/id, tying/merge's with, translation's lang. `end` and `if` are already lexically reserved control keywords and are highlighted by #keywords-control; they are intentionally omitted here to avoid re-tagging them.",
      "match": "\\b(sep|level|label|repeat|pretty|upper|lower|width|align|id|fields|path|format|cells|value|method|status|body|to|with|lang)\\b(?=\\s*=(?!=))",
      "name": "entity.other.attribute-name.rin"
    },

    "ternary-keyword": {
      "name": "keyword.control.conditional.ternary.rin",
      "match": "\\bplus\\.condition\\b"
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.rin",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.rin",
          "match": "\\bnil\\b"
        }
      ]
    },

    "math-constants": {
      "comment": "PI and E from Rin's math library, only when used as bare values (not as part of a longer identifier).",
      "match": "(?<![\\w.])(PI|E)(?![\\w])",
      "name": "constant.numeric.math.rin"
    },

    "explicit-math-functions": {
      "comment": "Explicit-arithmetic helpers used inside data containers, e.g. print Addition(a, b);",
      "match": "(?<![\\w.])(Addition|Subtraction|Multiplication|Equal)(?=\\s*\\()",
      "name": "support.function.math.rin"
    },

    "builtin-functions": {
      "comment": "Rin standard-library functions.",
      "match": "(?<![\\w.])(clcContainerMetaVersion|arabicStripDiacritics|clcContainerFileCount|clcContainerFileName|clcContainerMetaName|volumeContainerCount|groupContainerCount|rollbackTransaction|volumeHasContainer|appliedMigrations|clcContainerClose|colorToHslaString|colorToRgbaString|commitTransaction|groupHasContainer|pendingMigrations|rollbackMigration|beginTransaction|botReplyMarkdown|candleByRelation|chatMessageCount|clcContainerOpen|destroyContainer|volumeContainers|arabicNormalize|colorComponents|defineMigration|groupContainers|lastChatMessage|maskByNamespace|maskDescendants|Multiplication|bytesFromArray|candleRelation|colorGrayscale|colorLuminance|colorWithAlpha|containerNames|defineRelation|httpSetTimeout|maskChildrenOf|maskHasAllTags|splitSentences|volumeSnapshot|zlibDeflateRaw|zlibInflateRaw|bannerDismiss|bannerSuccess|bannerWarning|candleSources|candleTargets|colorContrast|cumulativeSum|extinguishAll|geometricMean|groupSnapshot|inTransaction|libraryExport|listInstalled|listRelations|loadInstalled|maskClearRefs|maskClearTags|maskHasAnyTag|maskKindCount|maskNamespace|maskParentGet|maskParentSet|movingAverage|setChatTyping|tokenizeWords|volumeMembers|attachToChat|botReplyCode|candleExists|candleLeaves|colorIsLight|colorLighten|defineSchema|detectScript|groupMembers|harmonicMean|hasContainer|isChatTyping|maskChildren|regexFindAll|regexReplace|runMigration|sectionNames|volumeParent|weightedMean|Subtraction|apiRegister|bannerError|cacheDelete|candleChain|candleCount|candleDepth|candleRoots|chatHistory|colorDarken|colorInvert|colorTextOn|createIndex|findByIndex|fromEntries|groupParent|httpRequest|inputNumber|isInstalled|lastIndexOf|levenshtein|listIndexes|maskAliases|maskCompare|maskDisable|maskMembers|maskResolve|maskSummary|maskVersion|queryOneDoc|regexGroups|relatedDocs|sectionVars|sendMessage|sqlGroupSum|sqlValidate|streamReply|unsubscribe|utf8Reverse|utf8ToArray|validateDoc|volumeNames|appendFile|bannerInfo|buildDylib|cacheClear|candleInfo|candleTree|childrenOf|colorBlend|colorParse|colorToHsl|colorValid|deleteFile|dropSchema|exportChat|extinguish|fetchImage|fileExists|groupNames|hasSection|httpDelete|isFunction|jsonDecode|jsonEncode|logHistory|maskActive|maskDetach|maskEnable|maskExists|maskHasRef|maskHasTag|maskLocked|maskParent|maskTarget|percentile|regexSplit|rinEdition|rinVersion|siblingsOf|sqlExplain|sqlGroupBy|utf8CharAt|utf8Substr|volumePath|volumeVars|apiDelete|apiHeader|cacheKeys|clearChat|closeChat|colorAnsi|colorHsla|colorRgba|countDocs|deepMerge|deleteDoc|dropIndex|fetchIcon|getSchema|groupPath|groupVars|hasVolume|httpPatch|insertDoc|key_terms|maskAlias|maskByTag|maskCount|maskDepth|maskKinds|maskNames|maskUnref|maskUntag|mergeMaps|normalize|queryDocs|regexFind|regexTest|sqlDelete|sqlExists|sqlUpdate|subscribe|tokenType|trimStart|updateDoc|writeFile|Addition|apiPatch|assertEq|botReply|buildCom|buildDll|buildExe|buildLib|cacheGet|cacheHas|cacheSet|coalesce|colorHsl|colorMix|colorRgb|contains|deepCopy|filename|findMask|getField|hasField|hasGroup|httpPost|isNumber|isString|logClear|maskInfo|maskKind|maskLock|maskNote|maskRefs|maskRoot|maskTags|omitKeys|openChat|padStart|parentOf|pickKeys|readFile|setField|setState|sqlCount|sqlPluck|toNumber|toString|variance|adler32|allDocs|apiCall|apiPost|barcode|between|buildSo|callApi|confirm|entries|findDoc|flatten|getPath|httpGet|httpPut|indexOf|isArray|logSave|maskRef|maskTag|offChat|pattern|product|publish|replace|reverse|setPath|slotsOf|trimEnd|unwatch|utf8Len|apiGet|apiPut|assert|buildA|callFn|charAt|choose|concat|create|docIds|isBool|kindOf|maskOf|median|onChat|padEnd|random|remove|repeat|sqlAvg|sqlIds|sqlMax|sqlMin|sqlOne|sqlSum|stddev|substr|toBool|tokens|typeIs|values|zscore|Equal|atan2|clamp|count|crc32|empty|floor|isMap|isNil|isNot|light|log10|lower|maxOf|minOf|range|round|scale|shift|slice|spawn|split|toHex|trunc|upper|watch|acos|asin|atan|call|cbrt|ceil|fail|hash|join|keys|lerp|mask|mean|mode|none|push|seed|sign|sort|sqrt|trim|type|uuid|abs|all|any|chr|cos|exp|has|iqr|len|log|max|min|now|ord|pop|pow|rms|run|sin|sql|str|sum|tan|is|ln|qr)(?=\\s*\\()",
      "name": "support.function.builtin.rin"
    },

    "functions": {
      "patterns": [
        {
          "comment": "function name right after 'fun'",
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.rin" },
            "2": { "name": "entity.name.function.rin" }
          }
        },
        {
          "comment": "generic call site: name(",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.rin"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "comment": "Rin's statistics/data pipeline operator",
          "name": "keyword.operator.pipeline.rin",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.rin",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.rin",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.rin",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.rin",
          "match": "!"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.rin",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.rin",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.parameters.rin",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.comma.rin",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.rin",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.rin",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.rin",
          "match": "\\."
        }
      ]
    }
  }
}
