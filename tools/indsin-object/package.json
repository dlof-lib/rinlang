{
  "name": "indsin-object",
  "version": "4.0.0",
  "description": "Official Indsin Object translator & interpreter: renders Indsin Fabric trees to themed, accessible HTML and interprets user events. Dependency-free; runs in browsers, WebViews, Node, Deno, Bun and Electron.",
  "license": "MIT",
  "main": "src/indsin_object.js",
  "browser": "src/indsin_object.js",
  "module": "src/indsin_object.js",
  "types": "types/indsin_object.d.ts",
  "bin": {
    "indsin-object": "bin/indsin-object.js",
    "indsin-open": "bin/indsin-open.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "hosts",
    "integration",
    "scripts",
    "indsin_object.html",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/gen_syntax.js && node build.js",
    "syntax": "node scripts/gen_syntax.js",
    "test": "node tests/test_indsin_object.js"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "indsin",
    "rin",
    "ui",
    "renderer",
    "interpreter",
    "translator",
    "html",
    "syntax-highlighting",
    "textmate",
    "file-association"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/indsin_object.d.ts",
      "default": "./src/indsin_object.js"
    },
    "./highlight": {
      "types": "./types/indsin_highlight.d.ts",
      "default": "./src/indsin_highlight.js"
    },
    "./package.json": "./package.json"
  }
}
