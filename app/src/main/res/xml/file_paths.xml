<?xml version="1.0" encoding="utf-8"?>
<!-- يحدّد المسارات التي يُسمح لـ FileProvider بمشاركتها كـ content:// Uri آمن،
     مطلوب لفتح الملف المنزَّل (ACTION_VIEW) على أندرويد 9 وأقدم بدون FileUriExposedException. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="downloads" path="Download/" />
    <!-- ملفات المشاريع (filesDir/projects/...): مطلوب لفتح ملف ثنائي مرفوع (pdf/صوت/أرشيف...)
         بتطبيق خارجي (ACTION_VIEW) من شاشة "الملفات" ([FilesActivity]). -->
    <files-path name="projects" path="projects/" />
    <!-- حزم APK الناتجة عن ميزة "تصدير APK" ([RinApkExporter]) تُبنى داخل cacheDir/apk_export/؛
         هذا المسار مطلوب لتثبيت/مشاركة الحزمة عبر content:// Uri آمن. -->
    <cache-path name="apk_export" path="apk_export/" />
</paths>
