<?xml version="1.0" encoding="utf-8"?>
<!-- أنماط الحوارات والقوائم المنبثقة (هوية RinStudio). -->
<resources>
    <style name="RinLang.DialogTitle" parent="@android:style/DialogWindowTitle.Material">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rin_menu_text</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <style name="Widget.RinLang.DialogButton" parent="@android:style/Widget.Material.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/rin_menu_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:background">@drawable/bg_dialog_btn</item>
    </style>

    <style name="Widget.RinLang.DialogButton.Positive">
        <item name="android:textColor">@color/rin_menu_accent</item>
    </style>

    <style name="RinLang.TextAppearance.PopupItem" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">@color/rin_menu_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
