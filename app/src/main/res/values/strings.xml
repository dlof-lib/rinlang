    <string name="sample_program">// Welcome to the Rin programming language!
fun fib(n) {
    if (n &lt; 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

let i = 0;
while (i &lt; 10) {
    print \"fib(\" + i + \") = \" + fib(i);
    i = i + 1;
}

let name = \"world\";
print \"Hello, \" + name + \"!\";
</string>

