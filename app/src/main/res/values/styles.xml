<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- شريحة اختيار نوع المشروع (Container / Table / UI / Free Project) داخل حوار "مشروع جديد". -->
    <style name="ProjectTypeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_project_type_chip</item>
        <item name="android:textColor">@color/selector_project_type_chip_text</item>
    </style>
</resources>
