<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- بطاقة اختيار نوع المشروع (Container / Table / UI / Free Project) داخل حوار "مشروع جديد":
         أيقونة + عنوان + وصف قصير، بدل شريحة نصية فقط، لمظهر أكثر احترافية. -->
    <style name="ProjectTypeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_project_type_chip</item>
    </style>

    <!-- شريحة نصّية بسيطة (بلا أيقونة/وصف) لصفّ "قوالب indsin الجاهزة" أسفل نوع المشروع —
         نفس خلفية bg_project_type_chip.xml (محدَّد/غير محدَّد) بحشو أخفّ لأنها سطر واحد فقط. -->
    <style name="IndsinTemplateChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_project_type_chip</item>
        <item name="android:textColor">@color/selector_project_type_chip_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- عنوان بطاقة نوع المشروع (اسم النوع نفسه، مثل "Container"). -->
    <style name="ProjectTypeChipTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/selector_project_type_chip_text</item>
    </style>

    <!-- زوايا دائرية للصورة المصغّرة (thumbnail) في بطاقة نوع مشروع UI، بدل أيقونة عادية. -->
    <style name="ProjectTypeUiThumbShape">
        <item name="cornerSize">10dp</item>
    </style>

    <!-- وصف مختصر أسفل عنوان البطاقة (مثل "بيانات حيّة داخل حاوية"). -->
    <style name="ProjectTypeChipSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/rin_editor_hint</item>
    </style>

    <!-- شريط لوني صغير يسبق عنوان كل قسم "خيارات" (Container/Table/Free/Illust/UI) داخل حوار
         "مشروع جديد"، ليتّبع الجميع نفس أسلوب الترويسة الموحّد بدل نصّ عادي فقط. -->
    <style name="OptionsSectionAccent">
        <item name="android:layout_width">4dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_options_section_accent</item>
    </style>

    <!-- عنوان قسم "خيارات" (مثل "خيارات الجدول")، يظهر بجانب [OptionsSectionAccent]. -->
    <style name="OptionsSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/rin_on_toolbar</item>
    </style>

    <!-- وصف مختصر أسفل عنوان قسم "خيارات". -->
    <style name="OptionsSectionDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/rin_editor_hint</item>
    </style>

    <!-- بطاقة قسم "خيارات" الموحّدة (نفس bg_list_card + padding ثابت) لكل الأقسام الأربعة. -->
    <style name="OptionsSectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_list_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- زر رمز واحد في "لوحة مفاتيح المحرر" (activity_main.xml): مربّع صغير ثابت العرض ضمن صف
         أفقي قابل للتمرير. focusable="false" مقصود: بلمسه يجب ألا يسرق تركيز المحرر (editCode)
         وإلا تختفي اللوحة نفسها (مربوطة بمستمع تركيز المحرر في MainActivity). -->
    <style name="RinEditorKeyButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:focusable">false</item>
        <item name="android:background">@drawable/bg_toolbar_btn_ghost</item>
        <item name="android:textColor">@color/rin_on_toolbar</item>
    </style>

    <!-- فاصل رفيع بين مجموعات لوحة مفاتيح المحرر (رموز / أسهم تنقل). -->
    <style name="RinEditorKeyDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@color/rin_divider</item>
    </style>

    <!-- حبّة كلمة محجوزة من لغة Rin نفسها (let/fun/if/container...) في صف ثانٍ منفصل ضمن لوحة
         مفاتيح المحرر — تمييزًا بصريًا (تعبئة بلون الهوية) عن صف رموز الترقيم العامة أعلاه؛
         الأزرار تُنشأ برمجيًا في MainActivity.setupEditorKeyboardPanel من RinKeywordDocs.allKeywords
         (نفس مصدر توثيق الكلمات المحجوزة، فتبقى القائمة مطابقة دومًا لـrin_lexer.cpp الحقيقي) عبر
         مُنشئ Button(context, null, 0, R.style.RinEditorKeywordChip)، لذا لا layout_* هنا عمداً
         (LayoutParams تُضبط في الكود نفسه؛ سمات هذا الأسلوب تنطبق فقط على الـView لا الحاوية). -->
    <style name="RinEditorKeywordChip">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:focusable">false</item>
        <item name="android:background">@drawable/bg_keyword_chip</item>
        <item name="android:textColor">@color/rin_accent</item>
    </style>
</resources>
