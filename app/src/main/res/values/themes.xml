<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compatibility alias: older manifests/layout variants may still reference @style/RinLang.
         Keep it mapped to the current application theme so Android resource linking succeeds. -->
    <style name="RinLang" parent="Theme.RinLang" />
    <style name="Theme.RinLang" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rin_accent</item>
        <item name="colorPrimaryDark">@color/rin_toolbar</item>
        <item name="colorAccent">@color/rin_accent</item>
        <item name="android:windowBackground">@color/rin_background</item>
        <item name="android:statusBarColor">@color/rin_toolbar</item>
        <!-- نمط الزر الافتراضي لكل <Button> عادي بالتطبيق (نظام Widget.RinLang.Button.* في
             styles.xml): يرفع أي زر لم يُحدَّد له style أو background خاص تلقائياً لنفس
             المظهر الاحترافي الموحَّد (خلفية بنفسجية مدوَّرة الزوايا 12dp + حالة ضغط/تعطيل
             واضحة) بلا الحاجة للمس عشرات ملفات الـlayout واحداً واحداً. أزرار لها style= أو
             background صريح بالـlayout (زي RinEditorKeyButton) تبقى كما هي لأن قيم الـlayout
             الصريحة تتفوّق دائماً على نمط الثيم الافتراضي. -->
        <item name="materialButtonStyle">@style/Widget.RinLang.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.RinLang.Button.Outline</item>
        <!-- كل AlertDialog.Builder(this) عبر التطبيق (الألبومات/المشاريع/التأكيدات...) يرث
             تلقائياً هذا الثيم الموحّد بدل حوار النظام المسطّح الافتراضي — انظر
             Theme.RinLang.AlertDialog أسفله. تغيير واحد هنا يُحدِّث كل الحوارات دفعة واحدة. -->
        <item name="android:alertDialogTheme">@style/Theme.RinLang.AlertDialog</item>
        <!-- قوائم PopupMenu في كل الشاشات (المشاريع/الملفات/الصفوف...) بنفس البطاقة الموحّدة -->
        <item name="android:popupMenuStyle">@style/Widget.RinLang.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.RinLang.PopupMenu</item>
        <item name="android:textAppearanceLargePopupMenu">@style/RinLang.TextAppearance.PopupItem</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/RinLang.TextAppearance.PopupItem</item>
    </style>

    <!-- ثيم موحَّد لكل حوارات AlertDialog (هوية RinStudio): بطاقة 26dp بحدّ رفيع وتوهّج أخضر وخط نيون علوي
         (bg_dialog_card)، عنوان بارز، أزرار بنص أخضر بلا حروف كبيرة، وحركة ظهور بتكبير ناعم (anim/rin_dialog_*).
         يتبع النهاري/الليلي عبر rin_menu_*. تغيير واحد هنا يُحدِّث كل الحوارات دفعة واحدة. -->
    <style name="Theme.RinLang.AlertDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_card</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowAnimationStyle">@style/Animation.RinLang.Dialog</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:colorAccent">@color/rin_menu_accent</item>
        <item name="android:textColorPrimary">@color/rin_menu_text</item>
        <item name="android:textColorSecondary">@color/rin_menu_dim</item>
        <item name="android:textColorHint">@color/rin_menu_dim</item>
        <item name="android:colorControlActivated">@color/rin_menu_accent</item>
        <item name="android:colorControlHighlight">@color/rin_menu_ripple</item>
        <item name="android:windowTitleStyle">@style/RinLang.DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.RinLang.DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.RinLang.DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.RinLang.DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.RinLang.DialogButton</item>
    </style>

    <style name="Animation.RinLang.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/rin_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/rin_dialog_exit</item>
    </style>

    <style name="Animation.RinLang.Popup" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/rin_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/rin_popup_exit</item>
    </style>

    <!-- ثيم القوائم المنبثقة PopupMenu (File/Edit/View/Run في MainActivity.darkPopupMenu()): بطاقة 18dp بحدّ رفيع،
         عناصر أطول (46dp) بخط أوضح وحشوة أوسع، وحركة ظهور ناعمة. -->
    <style name="ThemeOverlay.RinLang.PopupMenu" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="android:popupMenuStyle">@style/Widget.RinLang.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.RinLang.PopupMenu</item>
        <item name="android:textColorPrimary">@color/rin_menu_text</item>
        <item name="android:textColorSecondary">@color/rin_menu_dim</item>
        <item name="android:textAppearanceLargePopupMenu">@style/RinLang.TextAppearance.PopupItem</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/RinLang.TextAppearance.PopupItem</item>
        <item name="android:listPreferredItemHeightSmall">46dp</item>
        <item name="android:listPreferredItemPaddingStart">18dp</item>
        <item name="android:listPreferredItemPaddingEnd">18dp</item>
        <item name="android:colorControlHighlight">@color/rin_menu_ripple</item>
        <item name="colorAccent">@color/rin_menu_accent</item>
    </style>

    <style name="Widget.RinLang.PopupMenu" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:popupAnimationStyle">@style/Animation.RinLang.Popup</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <!-- شاشة البداية (Splash): بلا شريط أدوات، خلفية سوداء بهوية RinStudio (أسود · أبيض · أخضر)، تختفي تلقائياً
         بعد لحظات قصيرة إلى MainActivity (انظر SplashActivity.kt). -->
    <style name="Theme.RinLang.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="colorPrimary">@color/rin_accent_green</item>
        <item name="colorAccent">@color/rin_accent_green</item>
    </style>

    <!-- Light theme dedicated to the Pipeline Runner screen: dark navy header,
         light body, green accents — independent from the IDE's dark theme. -->
    <style name="Theme.RinLang.Pipeline" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pipeline_green</item>
        <item name="colorPrimaryDark">@color/pipeline_header_bg</item>
        <item name="colorAccent">@color/pipeline_green</item>
        <item name="android:windowBackground">@color/pipeline_screen_bg</item>
        <item name="android:statusBarColor">@color/pipeline_header_bg</item>
    </style>

    <!-- ثيم شفاف لـ CrashReportActivity: النشاط نفسه بلا أي واجهة مرئية، فقط الـ Dialog
         الذي يعرضه فوق آخر ما كان ظاهراً على الشاشة (أو خلفية سوداء لو كان التطبيق كله
         قد أُغلق فعلاً بسبب الكراش). -->
    <style name="Theme.RinLang.Transparent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- شاشة Output: خلفية وأشرطة نظام داكنة دائماً (RinSystemBars يقرأ هذه السمات ليرسم خلف الأشرطة). -->
    <style name="Theme.RinLang.Output" parent="Theme.RinLang">
        <item name="android:windowBackground">@color/out_bg</item>
        <item name="android:statusBarColor">@color/out_bg</item>
        <item name="android:navigationBarColor">@color/out_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
