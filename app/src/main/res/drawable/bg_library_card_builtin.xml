<?xml version="1.0" encoding="utf-8"?>
<!-- نفس bg_library_card_mine، لكن بشريط تمييز أخضر بدل البنفسجي، للتمييز البصري الفوري بين
     "مكتباتي" (بنفسجي) و"مكتبات جاهزة مدمجة" (أخضر) دون الحاجة لقراءة النص. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rin_editor_bg" />
                    <stroke android:width="1dp" android:color="@color/rin_editor_surface_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:width="4dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rin_accent_green" />
                    <corners
                        android:topLeftRadius="16dp"
                        android:bottomLeftRadius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
