<?xml version="1.0" encoding="utf-8"?>
<!-- نفس أسلوب bg_list_card، لكن بحدّ (stroke) بلون التمييز البنفسجي الخافت، لتمييز بطاقة
     "متجر Rin" بصرياً عن بطاقات المكتبات العادية داخل نفس الشاشة. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_job_card_bg" />
            <stroke android:width="1dp" android:color="@color/rin_accent_border_subtle" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
