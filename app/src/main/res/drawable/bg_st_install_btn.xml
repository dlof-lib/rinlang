<?xml version="1.0" encoding="utf-8"?>
<!-- زر «تثبيت»: كبسولة بتدرّج أخضر نيون، بحالات ضغط/تعطيل واضحة. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_st_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14B873" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#2FE88C" android:endColor="#3DF59A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
