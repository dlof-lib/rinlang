<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية صف محدَّد داخل درج المستكشف (وضع التحديد المتعدد). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_accent_border_subtle" />
            <stroke android:width="1dp" android:color="@color/rin_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
