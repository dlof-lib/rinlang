<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة صف إعداد موحّدة لكل item_setting_*.xml: إطار خفيف + ripple بنفسجي عند اللمس، بدل
     bg_list_card العام (المستخدَم بشاشات تانية كتير) عشان صفوف الإعدادات تصير لها هوية بصرية
     خاصة فيها (بطاقة "مرتفعة" شوي بحد واضح) بدل خلفية مسطّحة بلا حدود. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_setting_card_pressed">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_setting_card_bg" />
            <stroke android:width="1dp" android:color="@color/rin_setting_card_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
