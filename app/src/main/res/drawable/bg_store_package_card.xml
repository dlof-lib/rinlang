<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية بطاقة الحزمة داخل متجر Rin: نفس أسلوب bg_list_card (خلفية داكنة + حدّ رفيع + تأثير
     موجي) مع إضافة شريط تمييز متدرّج على الحافة البادئة (start)، ليعطي البطاقة طابعاً أكثر
     احترافية دون المساس بخلفية البطاقات العامة (bg_list_card) المستخدمة في شاشات أخرى. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rin_job_card_bg" />
                    <stroke android:width="1dp" android:color="@color/rin_job_card_border" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item
                android:width="3.5dp"
                android:gravity="start">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="@color/rin_run_gradient_start"
                        android:endColor="@color/rin_run_gradient_end" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
