<?xml version="1.0" encoding="utf-8"?>
<!-- إطار رأس صفحة "تفاصيل الحزمة": زوايا 22dp موحّدة مع بطاقة الملف الشخصي، حدّ بنفسجي خافت + توهّج،
     كحاوية خارجية تُقص إليها صورة البانر العلوية (clipToOutline). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_job_card_bg" />
            <stroke android:width="1dp" android:color="@color/rin_accent_border_subtle" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
