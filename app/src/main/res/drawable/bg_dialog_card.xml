<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية موحّدة لكل حوارات AlertDialog (ألبوم/مشروع جديد/تأكيد/قوائم الأيقونات...): بطاقة بزوايا 26dp وحدّ رفيع،
     توهّج أخضر خافت من الأعلى، وخط نيون رفيع عند الحافة العلوية. تتبع النهاري/الليلي عبر rin_menu_*. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_menu_card" />
            <stroke android:width="1dp" android:color="@color/rin_menu_border" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="260dp"
                android:startColor="@color/rin_menu_glow" android:endColor="@android:color/transparent" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:left="40dp" android:right="40dp" android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@android:color/transparent"
                android:centerColor="@color/rin_menu_accent_fill" android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
