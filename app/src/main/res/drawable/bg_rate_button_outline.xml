<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية زر "قيّم" داخل بطاقة الحزمة: حدّ ذهبي رفيع على خلفية داكنة شفافة، متناسق مع
     شارة النجوم الذهبية بجانبه -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_star_gold_dim" />
            <stroke android:width="1dp" android:color="@color/rin_star_gold" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/rin_star_gold_dim" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
