<?xml version="1.0" encoding="utf-8"?>
<!-- نمط الزر "المحدَّد الخطر" (Outline Danger) — إطار أحمر بدل بنفسجي، لإجراء هدّام لكنه مو
     فوري/غير قابل للتراجع (زي "استعادة الإعدادات الافتراضية")، فما يستاهل خلفية حمراء كاملة
     (bg_btn_danger) لكنه لازم يبيّن إنه مختلف عن أزرار الإلغاء العادية. لون النص المناسب:
     @color/btn_text_outline_danger. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_btn_outline_danger_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.4dp" android:color="@color/rin_btn_danger" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
