<?xml version="1.0" encoding="utf-8"?>
<!-- نمط الزر "الثانوي" (Secondary) — لإجراء مساعد بنفس وزن Primary بصرياً لكن بهوية لون مختلفة
     (تيل)، لتمييزه عن الإجراء الرئيسي لما يكون فيه زرارين جنب بعض بنفس الأهمية تقريباً. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_btn_disabled_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_btn_secondary_pressed" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_btn_secondary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
