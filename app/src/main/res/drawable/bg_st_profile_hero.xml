<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة الملف الشخصي: داكنة بتدرّج وتوهّج نيون، زوايا 28dp، حدّ زجاجي. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/rin_st_hero_bottom" android:endColor="@color/rin_st_hero_top" />
            <stroke android:width="1dp" android:color="@color/rin_st_hero_stroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.12" android:gradientRadius="280dp"
                android:startColor="@color/rin_st_hero_glow" android:endColor="@android:color/transparent" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
