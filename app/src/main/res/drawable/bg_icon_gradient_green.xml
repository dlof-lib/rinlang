<?xml version="1.0" encoding="utf-8"?>
<!-- شارة أيقونة متدرّجة خضراء، نظير bg_package_icon_gradient البنفسجي — تُستخدم خلف أيقونة
     المكتبات الجاهزة (المدمجة) في شاشة "المكتبات" المُجدَّدة، بنفس تدرّج rin_gradient_green_*
     المستخدم أصلاً في مؤشرات "تم الانتساب"/الشارات الموثّقة، للحفاظ على هوية موحّدة. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/rin_gradient_green_start"
        android:endColor="@color/rin_gradient_green_end" />
    <corners android:radius="13dp" />
</shape>
