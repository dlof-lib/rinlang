<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية صف واحد داخل قائمة حوار "بنية الملف": بلا تعبئة في الحالة العادية (يندمج مع بطاقة
     الحوار bg_dialog_card نفسها بدل صندوق منفصل لكل صف)، مع تأثير موجي خفيف وزوايا دائرية
     عند اللمس — بنفس هوية bg_list_card لكن شفافة الخلفية لتلائم قائمة داخل حوار مضغوطة. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
