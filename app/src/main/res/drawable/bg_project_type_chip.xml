<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية شريحة اختيار نوع المشروع في حوار "مشروع جديد": حالة محدَّدة بحدود/تعبئة بلون
     rin_accent الأرجواني، وحالة غير محدَّدة بنفس مظهر بطاقات القوائم العادية. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_accent_border_subtle" />
            <stroke android:width="1.6dp" android:color="@color/rin_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_job_card_bg" />
            <stroke android:width="1dp" android:color="@color/rin_job_card_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
