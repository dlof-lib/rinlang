<?xml version="1.0" encoding="utf-8"?>
<!-- نمط الزر "المحدَّد" (Outline) — خلفية شفافة + إطار بلون rin_accent، لإجراء ثانوي مو أساسي
     (إلغاء، رجوع، خيار بديل). لون النص المناسب: @color/btn_text_outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_btn_outline_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.4dp" android:color="@color/rin_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
