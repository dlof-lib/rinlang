<?xml version="1.0" encoding="utf-8"?>
<!-- حقل البحث داخل الترويسة: زجاجي، ويتوهّج بحدّ أخضر عند التركيز. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="@color/rin_files_hero_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_files_hero_glass" />
            <stroke android:width="1dp" android:color="@color/rin_files_hero_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
