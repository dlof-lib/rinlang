<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة صف ملف/مجلد في شاشة الملفات: زوايا 16dp، حدّ رفيع، وموجة خضراء عند اللمس. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rin_files_pressed">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_files_card" />
            <stroke android:width="1dp" android:color="@color/rin_files_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
