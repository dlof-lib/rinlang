<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية زر الإعجاب: نفس شكل "حبّة" الإحصائيات (bg_stat_pill) لكن قابلة للّمس بتأثير موجي خفيف -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_download_chip_bg" />
            <stroke android:width="1dp" android:color="@color/rin_download_chip_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
