<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الشريط العلوي الموحّد (الشاشات الفرعية + شريط المحرر): سطح صلب أبيض/أسود مخضرّ بزوايا سفلية
     دائرية 24dp، وخط أخضر رفيع مرتفع قليلاً عن الحافة السفلية كتوقيع للعلامة. يتبع ألوان rin_nav_bar_*. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_nav_bar_bg" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
            <stroke android:width="1dp" android:color="@color/rin_nav_bar_border" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp" android:left="48dp" android:right="48dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_pg_accent_fill" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
