<?xml version="1.0" encoding="utf-8"?>
<!-- إطار بطاقة رأس الملف الشخصي: نفس أسلوب بطاقات القوائم (bg_list_card) لكن بلا تأثير موجي،
     لأنها الآن حاوية تُقص إليها صورة البانر (clipToOutline) وليست عنصراً قابلاً للّمس. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/rin_job_card_bg" />
    <stroke android:width="1dp" android:color="@color/rin_job_card_border" />
    <corners android:radius="18dp" />
</shape>
