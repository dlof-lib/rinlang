<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية رأس صفحة "تفاصيل الحزمة": بطاقة داكنة بحدّ بنفسجي خافت + توهّج تدرّجي خفيف من
     الأعلى، لإعطاء الرأس ثقلاً بصرياً مميزاً عن باقي البطاقات (README/الترخيص/الملفات). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_job_card_bg" />
            <stroke android:width="1dp" android:color="@color/rin_accent_border_subtle" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#267C5CFF"
                android:endColor="#00000000"
                android:centerY="0.55" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
