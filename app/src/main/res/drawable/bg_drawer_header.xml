<?xml version="1.0" encoding="utf-8"?>
<!-- رأس الدرج: تدرّج أخضر-أسود + توهّج نيون + خط مضيء سفلي. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/rin_menu_hero_bottom" android:endColor="@color/rin_menu_hero_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="240dp"
                android:startColor="#333DF59A" android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:left="20dp" android:right="20dp" android:height="2dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@android:color/transparent"
                android:centerColor="@color/rin_menu_accent_fill" android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
