<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة عامة (حزمة/معلومات/صف): زوايا 20dp، حدّ رفيع، وخط أخضر مضيء رفيع على الحافة العلوية. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rin_st_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rin_st_card" />
                    <stroke android:width="1dp" android:color="@color/rin_st_border" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="28dp" android:right="28dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="@android:color/transparent"
                        android:centerColor="@color/rin_st_accent_fill" android:endColor="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
