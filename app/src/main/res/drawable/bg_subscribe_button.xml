<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية زر "انتساب" (غير مُنتسِب بعد): إطار بلون العلامة (rin_accent) بلا تعبئة، مع تأثير
     موجي خفيف عند اللمس. نصف قطر الزوايا 14dp ليطابق نظام الاستدارة الموحّد الجديد (16-24dp).
     راجع bg_subscribe_button_active.xml لحالة "تم الانتساب ✓". -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/rin_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
