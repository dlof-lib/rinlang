<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية بطاقة إحصائية قابلة للضغط (منتسبين/انتسابات/حزم/تنزيلات/إعجابات) — بطاقة عائمة
     بحدّ خافت وتأثير موجي عند اللمس، موحّدة الشكل عبر كل الإحصائيات الخمس. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rin_ghost_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_stat_card_bg" />
            <stroke android:width="1dp" android:color="@color/rin_stat_card_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
