<?xml version="1.0" encoding="utf-8"?>
<!-- رأس بصري جديد لشاشة "المكتبات" (تجديد شامل للشكل): تدرّج بنفسجي بنفس هوية زر "تشغيل"
     الرئيسي (rin_run_gradient_*) حتى تبقى الهوية اللونية موحّدة مع بقية التطبيق، بزوايا سفلية
     دائرية كبيرة تفصله بصرياً عن بقية الصفحة البيضاء أسفله. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/rin_run_gradient_start"
        android:endColor="@color/rin_run_gradient_end" />
    <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
</shape>
