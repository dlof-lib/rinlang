<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة صف المجلد: تدرّج أخضر خافت يميّزها عن بطاقات الملفات البيضاء. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rin_files_pressed">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/rin_fd_card_top" android:endColor="@color/rin_fd_card_bottom" />
            <stroke android:width="1dp" android:color="@color/rin_fd_card_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
