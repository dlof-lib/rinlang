    <!-- ============================================================================
         نظام تلوين الصيغة النحوية الموحَّد (Unified Syntax Palette) — نظير مباشر لنفس
         المنظومة الست المعرَّفة في values/colors.xml (الثيم الفاتح)، بنفس تخصيص المفاهيم
         بالضبط، لكن بظلال أكثر سطوعاً تلائم خلفية المحرر الداكنة (rin_editor_bg):

           • أزرق    (Blue)   → الكلمات المفتاحية وتدفّق التحكّم
           • بنفسجي  (Purple) → الأنواع/الحاويات وتوجيهات وحدة make
           • أخضر    (Green)  → النصوص الحرفية (string literals)
           • برتقالي (Orange) → الأرقام وحقول الستايل و`item` الضمني في Reckon
           • ذهبي    (Gold)   → الدوال المُستدعاة (calls/builtins) و@tags/@decorators
           • أبيض    (White)  → التعليقات — رمادي مائل للبياض هنا فعلياً (لا حاجة لتخفيفه
                                 كما في الثيم الفاتح لأن الخلفية داكنة أصلاً) -->

    <!-- • أزرق -->
    <color name="syntax_keyword">#569CD6</color>

    <!-- • بنفسجي — الأنواع/الحاويات وتوجيهات وحدة make بهوية واحدة موحَّدة -->
    <color name="syntax_container_keyword">#C586C0</color>
    <color name="syntax_make_directive">#C586C0</color>

    <!-- • برتقالي — حقول تنسيق/ستايل الكائن (txt/img/object.file/Fonts/background/css3): نفس
         هوية "الستايل" في كونسول التشغيل (log_kind_style) -->
    <color name="syntax_style_keyword">#F2A65A</color>

    <!-- • أخضر — النصوص الحرفية -->
    <color name="syntax_string">#6FDC9E</color>

    <!-- • برتقالي — الأرقام -->
    <color name="syntax_number">#FFA95C</color>

    <!-- • أبيض — التعليقات؛ مائل (italic) في الرسم لتمييزه إضافياً عن النص العادي -->
    <color name="syntax_comment">#9AA0AB</color>

    <!-- • ذهبي — الدوال المُستدعاة (function calls / builtins) -->
    <color name="syntax_builtin">#E6C260</color>

    <!-- • ذهبي — وسوم/زخارف @tag، نفس هوية الدوال -->
    <color name="syntax_tag">#E6C260</color>

    <!-- • برتقالي (بظلّ مستقل عن الأرقام) — `item` الضمني داخل مفهوم Reckon الحسابي بسطرين
