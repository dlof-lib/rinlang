    <string name="ext_deleted_toast">Extension permanently deleted from the marketplace ✓</string>
    <string name="ext_delete_failed">Failed to delete the extension, try again</string>
    <string name="ext_delete_requires_connection">An internet connection is required to delete an extension from the marketplace</string>

