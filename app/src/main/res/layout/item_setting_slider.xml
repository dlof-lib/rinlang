<?xml version="1.0" encoding="utf-8"?>
<!-- صف شريط تمرير: عنوان (يحمل القيمة الحالية) + SeekBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/settingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/rin_pg_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/settingSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:progressTint="@color/rin_pg_accent_fill"
        android:thumbTint="@color/rin_pg_accent_fill" />
</LinearLayout>
