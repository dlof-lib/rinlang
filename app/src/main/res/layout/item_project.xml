<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة مشروع (هوية RinStudio): سطح محايد بحدّ رفيع، خط رفيع أعلاها بلون نوع المشروع، شارة نوع ملوّنة،
     الاسم والبيانات، وزر «فتح المشروع» أخضر نيون أسفلها. الألوان الخاصة بالنوع تُضبط من ProjectsAdapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/projectCover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_proj_card"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:minHeight="164dp"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- خط لون النوع على حافة البطاقة العلوية (يُلوَّن من الكود) -->
            <View
                android:id="@+id/viewProjectAccent"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="-14dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/bg_proj_accent_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/frameProjectTypeIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp">

                    <ImageView
                        android:id="@+id/imgProjectTypeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/imgProjectPin"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/proj_pin"
                    android:src="@drawable/rs_ic_pin"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnProjectMore"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/bg_proj_more_btn"
                    android:contentDescription="@string/project_more_actions"
                    android:padding="6dp"
                    android:src="@drawable/rs_ic_more_vert"
                    app:tint="@color/rin_proj_dim" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtProjectType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtProjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/rin_proj_text"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProjectMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rin_proj_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- زر صريح لفتح المشروع، إضافة إلى النقر على البطاقة كلها. -->
        <TextView
            android:id="@+id/btnOpenProject"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_proj_open_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/open_project_action"
            android:textColor="@color/rin_proj_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- شارة ✓ التحديد (ProjectsActivity: ضغطة مستمرة تبدأ التحديد) -->
    <ImageView
        android:id="@+id/imgProjectSelectCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_select_badge"
        android:contentDescription="@null"
        android:padding="3dp"
        android:src="@drawable/rs_ic_check"
        android:visibility="gone" />
</FrameLayout>
