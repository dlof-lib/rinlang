<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_list_card"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:padding="12dp">

    <!-- أيقونة "rin+" الرسمية للمشروع/المجلد بدل الشارة العامة السابقة -->
    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_rin_folder"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtProjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- شارة نوع المشروع (Container/Table/UI/Free Project)، مقروءة من project.og.urin -->
            <TextView
                android:id="@+id/txtProjectType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_project_type_badge"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/rin_accent"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtProjectMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12.5sp"
            android:textColor="@color/rin_editor_hint" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRenameProject"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="10dp"
        android:background="@drawable/bg_icon_btn"
        android:contentDescription="@string/rename_project_title"
        android:src="@drawable/ic_edit_pencil" />

    <ImageButton
        android:id="@+id/btnDeleteProject"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="2dp"
        android:padding="10dp"
        android:background="@drawable/bg_icon_btn"
        android:contentDescription="@string/delete_project_title"
        android:src="@drawable/ic_trash_red" />

</LinearLayout>
