<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى حوار "استيراد وتشغيل" داخل ClcActivity: مساحة اختيارية لكتابة كود Rin إضافي يُشغَّل
     مباشرة بعد libraryImport(path) (لاستدعاء دوال المكتبة المستورَدة)، ثم مساحة مخرجات تُظهر
     ناتج التشغيل الحقيقي أو رسالة الخطأ التشخيصية عند الفشل. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="420dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clc_run_code_hint"
            android:textColor="@color/rin_on_toolbar_dim"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtExtraCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="8"
            android:gravity="top|start"
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/rin_editor_text"
            android:textColorHint="@color/rin_editor_hint"
            android:textSize="13sp"
            android:hint="@string/clc_run_code_field_hint" />

        <TextView
            android:id="@+id/txtRunOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_editor_surface"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="12.5sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
