<?xml version="1.0" encoding="utf-8"?>
<!-- صف حزمة واحدة ضمن قسم "حزمي المنشورة" بشاشة الحساب (تجديد شامل للشكل): بطاقة بيضاء
     بشريط تمييز بنفسجي (نفس لغة بطاقات شاشة "المكتبات" الجديدة) + شارة خضراء "منشورة" تؤكّد
     أنّ هذه الحزمة مرئية للجميع الآن في متجر Rin، لا مجرد مكتبة محلية. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_library_card_mine"
    android:layout_marginBottom="8dp"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtMyPackageInitial"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_package_icon_gradient"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMyPackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar" />

            <TextView
                android:id="@+id/txtMyPackageMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/rin_editor_hint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteMyPackage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_toolbar_btn_ghost"
            android:src="@drawable/ic_trash_red"
            android:scaleType="center"
            android:padding="8dp"
            android:contentDescription="@string/action_delete_package" />
    </LinearLayout>

    <!-- شارة "منشورة" خضراء: تأكيد بصري بسيط أنّ هذه الحزمة ظاهرة في متجر Rin الآن -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="46dp"
        android:background="@drawable/bg_chip_published"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="@string/package_published_badge"
        android:textColor="@color/rin_accent_green"
        android:textStyle="bold"
        android:textSize="10.5sp" />

</LinearLayout>
