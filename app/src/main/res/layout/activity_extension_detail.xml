<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- رأس الإضافة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/txtDetailInitial"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_package_icon_gradient"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDetailName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rin_on_toolbar"
                        android:textStyle="bold"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/txtDetailDeveloper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/rin_editor_hint"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDetailMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/rin_editor_hint"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- وصف -->
            <TextView
                android:id="@+id/txtDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/rin_editor_text"
                android:textSize="13.5sp"
                android:lineSpacingExtra="3dp" />

            <!-- اللغات المستخدَمة -->
            <TextView
                android:id="@+id/txtDetailLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/rin_editor_hint"
                android:textSize="12sp" />

            <!-- لقطات الشاشة -->
            <TextView
                android:id="@+id/txtScreenshotsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/ext_detail_screenshots"
                android:textColor="@color/rin_on_toolbar"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvScreenshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- شريط تقدّم التثبيت -->
            <LinearLayout
                android:id="@+id/layoutInstallProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtInstallProgressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="@color/rin_editor_hint"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progressInstall"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progressTint="@color/rin_accent"
                    android:progressBackgroundTint="@color/rin_download_progress_track" />
            </LinearLayout>

            <!-- أزرار الإدارة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDetailInstall"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/action_install"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_toolbar_btn_primary"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btnDetailUpdate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ext_action_update"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_toolbar_btn_primary"
                    android:textColor="@android:color/white"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDetailEnableDisable"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_toolbar_btn_ghost"
                    android:textColor="@color/rin_on_toolbar"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDetailUninstall"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ext_action_uninstall"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_toolbar_btn_ghost"
                    android:textColor="@color/status_error"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- الصف الثاني: تصدير الإضافة كملف .rinex (متاح للجميع)، وحذفها نهائياً من المتجر
                 (متاح فقط لمطوّرها صاحب الإضافة، راجع ExtensionDetailActivity.refreshMetaAndButtons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDetailExportRinex"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ext_action_export_rinex"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_toolbar_btn_ghost"
                    android:textColor="@color/rin_on_toolbar" />

                <Button
                    android:id="@+id/btnDetailDeleteExtension"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ext_action_delete"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_toolbar_btn_ghost"
                    android:textColor="@color/status_error"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="@color/rin_divider" />

            <!-- سجل التحديثات -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ext_detail_changelog"
                android:textColor="@color/rin_on_toolbar"
                android:textStyle="bold"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/containerChangelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtNoChangelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ext_detail_no_changelog"
                android:textColor="@color/rin_editor_hint"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
