<?xml version="1.0" encoding="utf-8"?>
<!-- صف يفتح شاشة أخرى: أيقونة + عنوان + تلميح + سهم. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_lang_option_selected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/settingIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:textSize="27sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/settingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rin_on_toolbar"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/rin_editor_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="›"
        android:textColor="@color/rin_accent"
        android:textSize="27sp" />
</LinearLayout>
