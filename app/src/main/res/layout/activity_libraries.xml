<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة "المكتبات" الخاصة بمشروع واحد:
     - قسم "مكتباتي": مكتبات lib/*.og.rin التي أنشأها/رفعها المستخدم لهذا المشروع، قابلة
       للتعديل والحذف والإدراج (@import) مباشرة داخل كود المحرر.
     - قسم "مكتبات جاهزة": المكتبات القياسية الخمس المدمجة داخل محرّك Rin نفسه، تعمل فوراً
       بلا رفع، مع إمكانية إدراج سطر @import الخاص بها بضغطة واحدة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rin_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:text="@string/libraries_section_mine"
                android:textColor="@color/rin_on_toolbar"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/libraries_section_mine_hint"
                android:textColor="@color/rin_editor_hint"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserLibraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/txtEmptyLibraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:gravity="center"
                android:text="@string/no_libraries_yet"
                android:textColor="@color/rin_editor_hint"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@color/rin_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:text="@string/libraries_section_builtin"
                android:textColor="@color/rin_on_toolbar"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/libraries_section_builtin_hint"
                android:textColor="@color/rin_editor_hint"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBuiltinLibraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabUploadLibrary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/upload_library"
            app:srcCompat="@android:drawable/ic_menu_upload" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNewLibrary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/new_library_title"
            app:srcCompat="@android:drawable/ic_input_add" />

    </LinearLayout>

</FrameLayout>
