<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة "الملفات" الخاصة بمشروع واحد: شريط علوي موحّد (يعرض اسم المشروع) + قائمة ملفات المشروع
     (بما فيها الوسائط والملفات غير .rin) على شكل بطاقات + أزرار "ملف جديد" و"رفع ملف" و"رفع وسائط" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <!-- شريط مسار تفاعلي (breadcrumb): الضغط على أي مستوى ينتقل إليه، والضغط المستمر ينسخ مساره.
         زر "الأخيرة" يعرض آخر الملفات المفتوحة في هذا المشروع. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <HorizontalScrollView
            android:id="@+id/scrollBreadcrumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layoutBreadcrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnRecentFiles"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/rs_ic_timer"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/recent_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtFilesSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/rin_editor_hint"
        android:textSize="11.5sp" />

    <!-- شريط إجراءات التحديد المتعدد: يظهر فقط أثناء وضع التحديد (FilesActivity.updateSelectionBar).
         الإيماءات: ضغطة مستمرة على صف تبدأ التحديد، والسحب ↑↓ بعدها يحدّد نطاقاً. -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_list_card"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSelectionClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/selection_clear" />

        <TextView
            android:id="@+id/txtSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rin_on_toolbar"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSelectionAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_select_all"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/selection_select_all" />






        <ImageButton
            android:id="@+id/btnSelectionDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_trash_red"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/delete" />

        <ImageButton
            android:id="@+id/btnSelectionMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/rs_ic_more_vert"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/more_actions" />

    </LinearLayout>

    <!-- شريط البحث داخل ملفات المشروع كله (كل المجلدات الفرعية)؛ نفس نمط بحث المشاريع
         (bg_projects_search) لتناسق بصري. فارغ = تصفّح عادي مستوى بمستوى كما كان؛ أي نص
         يُبدّل القائمة إلى نتائج بحث مسطّحة عبر المشروع كله (انظر FilesActivity.performSearch). -->
    <EditText
        android:id="@+id/inputSearchFiles"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_projects_search"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="@color/rin_editor_hint"
        android:hint="@string/search_files_hint"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/rin_on_toolbar"
        android:textColorHint="@color/rin_editor_hint"
        android:textSize="13sp"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionDone" />

    <!-- تبديل نطاق البحث: الأسماء فقط ↔ الأسماء + محتوى الملفات -->
    <TextView
        android:id="@+id/btnSearchContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_icon_btn"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/rin_accent"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="88dp" />

        <LinearLayout
            android:id="@+id/txtEmptyFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_empty_folder"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtEmptyFilesMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:text="@string/no_files_yet"
                android:textColor="@color/rin_editor_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabPaste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/tool_paste"
                android:visibility="gone"
                app:backgroundTint="@color/rin_accent"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_accent_pressed"
                app:fabSize="mini"
                app:srcCompat="@drawable/rs_ic_download" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/sort_title"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/rs_ic_sort" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZipTools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/zip_tools_title"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_log_archive" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabUploadMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/upload_media"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_camera" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabUploadFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/upload_file"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_menu_upload" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabNewFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/new_folder_title"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_rin_folder" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/new_file_title"
                app:backgroundTint="@color/rin_accent"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_accent_pressed"
                app:srcCompat="@android:drawable/ic_input_add" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
