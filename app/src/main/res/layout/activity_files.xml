<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة "الملفات" الخاصة بمشروع واحد: شريط علوي موحّد (يعرض اسم المشروع) + قائمة ملفات .rin
     على شكل بطاقات + زرّي "ملف جديد" و"رفع ملف" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="88dp" />

        <LinearLayout
            android:id="@+id/txtEmptyFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_empty_folder"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:text="@string/no_files_yet"
                android:textColor="@color/rin_editor_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZipTools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/zip_tools_title"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_log_archive" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabUploadFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/upload_file"
                app:backgroundTint="@color/rin_toolbar_bottom"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_ghost_ripple"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_menu_upload" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/new_file_title"
                app:backgroundTint="@color/rin_accent"
                app:tint="@android:color/white"
                app:rippleColor="@color/rin_accent_pressed"
                app:srcCompat="@android:drawable/ic_input_add" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
