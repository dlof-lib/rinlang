                <Button android:id="@+id/btnKeyHash" style="@style/RinEditorKeyButton" android:text="#" android:contentDescription="#" />
                <Button android:id="@+id/btnKeyAt" style="@style/RinEditorKeyButton" android:text="\@" android:contentDescription="@" />
