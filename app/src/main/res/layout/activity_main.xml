                <Button android:id="@+id/btnKeySlash" style="@style/RinEditorKeyButton" android:text="/" android:contentDescription="/" />
                <Button android:id="@+id/btnKeyPercent" style="@style/RinEditorKeyButton" android:text="%" android:contentDescription="%" />
                <Button android:id="@+id/btnKeyBang" style="@style/RinEditorKeyButton" android:text="!" android:contentDescription="!" />
