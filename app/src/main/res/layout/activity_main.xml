                <Button android:id="@+id/btnKeyUndo" style="@style/RinEditorKeyButton" android:text="↶" android:contentDescription="@string/action_undo" />
                <Button android:id="@+id/btnKeyRedo" style="@style/RinEditorKeyButton" android:text="↷" android:contentDescription="@string/action_redo" />
