            </LinearLayout>
        </HorizontalScrollView>

        <!-- صف ثانٍ منفصل: كلمات Rin المحجوزة الحقيقية (let/fun/if/container/...)، تُملأ
             برمجيًا في MainActivity من RinKeywordDocs.allKeywords (نفس مصدر توثيق hover) بدل
             تكرارها يدويًا هنا — فتبقى القائمة مطابقة دومًا لـrin_lexer.cpp الحقيقي. حبّاتها
             بلون هوية التطبيق لتمييزها بصريًا عن رموز الترقيم العامة في الصف الأول. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rin_divider" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:background="@color/rin_console_header">

            <LinearLayout
                android:id="@+id/editorKeyboardKeywordsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
