<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginTop="8dp" android:background="@drawable/bg_list_card">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/preferenceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_show_toolbar" android:textStyle="bold" android:textSize="13.5sp" android:textColor="@color/rin_on_toolbar"/>
<TextView android:id="@+id/preferenceHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_show_toolbar_hint" android:textSize="11sp" android:textColor="@color/rin_editor_hint"/>
</LinearLayout>
<Switch android:id="@+id/switchShowToolbar" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>