<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPackageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_list_card"
    android:layout_margin="4dp"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- شارة بأول حرف من اسم الحزمة، بديل بصري خفيف الوزن عن أيقونة مخصصة لكل ناشر -->
        <TextView
            android:id="@+id/txtPackageInitial"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_icon_badge_accent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="220dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/rin_on_toolbar" />

                <ImageView
                    android:id="@+id/imgPackageVerifiedBadge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_verified_badge"
                    android:visibility="gone"
                    android:contentDescription="@string/verified_publisher_badge_description" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPackageMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/rin_editor_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPackageCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_download_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textSize="10.5sp"
            android:textColor="@color/rin_on_toolbar_dim" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPackageDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12.5sp"
        android:textColor="@color/rin_editor_text"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/txtPackageDependencies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/syntax_tag"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_rating_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <RatingBar
                android:id="@+id/ratingBarPackage"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.1"
                android:progressTint="@color/rin_star_gold"
                android:progressBackgroundTint="@color/rin_star_track"
                android:secondaryProgressTint="@color/rin_star_track" />

            <TextView
                android:id="@+id/txtPackageRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/rin_star_gold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRatePackage"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/action_rate_package"
            android:textAllCaps="false"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rate_button_outline"
            android:textColor="@color/rin_star_gold" />

        <ImageButton
            android:id="@+id/btnReportPackage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_toolbar_btn_ghost"
            android:src="@drawable/ic_report_flag"
            android:scaleType="center"
            android:padding="0dp"
            android:contentDescription="@string/action_report_package" />
    </LinearLayout>

    <Button
        android:id="@+id/btnInstallPackage"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/action_install"
        android:textAllCaps="false"
        android:textSize="12.5sp"
        android:background="@drawable/bg_toolbar_btn_primary"
        android:textColor="@android:color/white" />

</LinearLayout>
