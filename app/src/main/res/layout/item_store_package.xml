<?xml version="1.0" encoding="utf-8"?>
<!--
  بطاقة حزمة داخل متجر Rin — نسخة مطوَّرة بصرياً:
  • شريط تمييز متدرّج على الحافة البادئة للبطاقة (bg_store_package_card)
  • شارة حرف أول متدرّجة بدل اللون المسطّح
  • شريحة تصنيف بلون التمييز بدل الشريحة الرمادية المحايدة
  • سطر تبعيات على هيئة وسم (tag) واضح بدل نص عادي
  • زر تثبيت بتدرّج بنفسجي (نفس هوية زر "تشغيل" الرئيسي) + أيقونة
  كل معرّفات (id) العناصر المرتبطة بالكود (PackageAdapter.VH) بقيت كما هي بلا أي تغيير.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPackageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_store_package_card"
    android:layout_margin="5dp"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- شارة بأول حرف من اسم الحزمة (خلفية متدرّجة)، تُستبدَل بأيقونة الحزمة الحقيقية إن
             رفعها الناشر عند النشر (raw.iconBase64) — راجع PackageAdapter.onBindViewHolder. -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/txtPackageInitial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_package_icon_gradient"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imgPackageIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPackageName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/rin_on_toolbar" />

                <ImageView
                    android:id="@+id/imgPackageVerifiedBadge"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_verified_badge"
                    android:visibility="gone"
                    android:contentDescription="@string/verified_publisher_badge_description" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPackageMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="@color/rin_editor_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPackageCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_category_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/rin_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPackageDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12.5sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/rin_editor_text"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/txtPackageDependencies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dependency_chip"
        android:paddingHorizontal="9dp"
        android:paddingVertical="4dp"
        android:textSize="10.5sp"
        android:fontFamily="monospace"
        android:textColor="@color/syntax_tag"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/rin_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_rating_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <RatingBar
                android:id="@+id/ratingBarPackage"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.1"
                android:progressTint="@color/rin_star_gold"
                android:progressBackgroundTint="@color/rin_star_track"
                android:secondaryProgressTint="@color/rin_star_track" />

            <TextView
                android:id="@+id/txtPackageRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/rin_star_gold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRatePackage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="13dp"
            android:text="@string/action_rate_package"
            android:textAllCaps="false"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rate_button_outline"
            android:textColor="@color/rin_star_gold" />

        <ImageButton
            android:id="@+id/btnReportPackage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_toolbar_btn_ghost"
            android:src="@drawable/ic_report_flag"
            android:scaleType="center"
            android:padding="0dp"
            android:contentDescription="@string/action_report_package" />
    </LinearLayout>

    <Button
        android:id="@+id/btnInstallPackage"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:drawableStart="@drawable/ic_log_download"
        android:drawablePadding="8dp"
        android:text="@string/action_install"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_install_button_premium"
        android:textColor="@android:color/white" />

</LinearLayout>
