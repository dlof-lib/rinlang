<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة البداية (Splash Screen): تظهر لحظياً عند فتح التطبيق قبل الانتقال إلى المحرر.
     المحتوى الآن داخل بطاقة زجاجية منتصف الشاشة فوق خلفية الخلايا السداسية/الأرقام الثنائية،
     لمظهر أكثر تنظيماً واحترافية بدل النص العائم مباشرة فوق الخلفية. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_splash_card"
        android:paddingHorizontal="40dp"
        android:paddingVertical="32dp">

        <FrameLayout
            android:id="@+id/splashIconFrame"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_app_icon_frame">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/rin_on_toolbar"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/rin_on_toolbar_dim"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/rin_accent" />

    </LinearLayout>

</FrameLayout>
