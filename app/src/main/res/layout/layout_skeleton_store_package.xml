<?xml version="1.0" encoding="utf-8"?>
<!-- نسخة هيكلية (placeholder) من item_store_package.xml، بلا أي نص حقيقي، تُستخدم داخل
     ShimmerLayout أثناء تحميل قائمة المتجر لأول مرة. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_list_card"
    android:layout_margin="4dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_skeleton_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="150dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="100dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>

        <View
            android:layout_width="52dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="11dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="180dp"
        android:layout_height="11dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_skeleton_block" />

</LinearLayout>
