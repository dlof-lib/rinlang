<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة "مستكشف المشروع" المدمجة في محرّر Rin (MainActivity): تُفتَح كدرج جانبي فوق المحرر
     نفسه (androidx.drawerlayout.widget.DrawerLayout في activity_main.xml) بدل الانتقال إلى
     شاشة FilesActivity المنفصلة. تبويبان:
       • "الملفات": شجرة ملفات/مجلدات المشروع الحقيقية (ProjectExplorerAdapter + ProjectManager)،
         قابلة للتوسيع/الطي، والنقر على أي ملف يحمّله في نفس نسخة المحرر مباشرة.
       • "البنية": نفس شجرة "بنية الملف" (الحاويات/الأقسام) التي كانت سابقاً حواراً منفصلاً
         (OutlineDialogAdapter, RinContainerTags.buildOutline)، معروضة هنا داخل الدرج نفسه. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginEnd="48dp"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:background="@drawable/bg_drawer_panel"
    android:clipToOutline="true"
    android:elevation="12dp">

    <!-- رأس اللوحة: أيقونة + عنوان "المستكشف" + اسم المشروع الحالي + زر إغلاق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_drawer_header"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_drawer_icon_btn"
            android:padding="8dp"
            android:src="@drawable/ic_explorer"
            android:tint="@color/rin_menu_hero_text"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="@string/explorer_panel_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rin_menu_hero_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtExplorerProjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rin_menu_accent_fill"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:ellipsize="middle"
                android:singleLine="true" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExplorerPaste"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:padding="6dp"
            android:src="@drawable/rs_ic_download"
            android:tint="@color/rin_menu_accent_fill"
            android:background="@drawable/bg_drawer_icon_btn"
            android:contentDescription="@string/tool_paste"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnExplorerNewFolder"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:padding="6dp"
            android:src="@drawable/rs_folder_new"
            android:tint="@color/rin_menu_accent_fill"
            android:background="@drawable/bg_drawer_icon_btn"
            android:contentDescription="@string/new_folder_title" />

        <ImageButton
            android:id="@+id/btnExplorerClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="@color/rin_menu_hero_text"
            android:background="@drawable/bg_drawer_icon_btn"
            android:contentDescription="@string/explorer_close" />
    </LinearLayout>

    <!-- مفتاح التبويبين: الملفات / البنية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_drawer_tabtrack"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/btnExplorerTabFiles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/explorer_tab_files"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/rin_on_toolbar"
            android:background="@drawable/bg_explorer_tab_selected" />

        <TextView
            android:id="@+id/btnExplorerTabOutline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/explorer_tab_outline"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/rin_on_toolbar_dim"
            android:background="@drawable/bg_menubar_btn" />
    </LinearLayout>

    <!-- شريط إجراءات التحديد المتعدد داخل الدرج (ExplorerSelectionController): يظهر فقط أثناء
         وضع التحديد. ضغطة مستمرة على صف = بدء التحديد، ثم سحب ↑↓ = تحديد نطاق. -->
    <LinearLayout
        android:id="@+id/layoutExplorerSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_explorer_row_checked"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnExplorerSelClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/selection_clear" />

        <TextView
            android:id="@+id/txtExplorerSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rin_on_toolbar"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnExplorerSelAll"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_select_all"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/selection_select_all" />





        <ImageButton
            android:id="@+id/btnExplorerSelDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_trash_red"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/delete" />

        <ImageButton
            android:id="@+id/btnExplorerSelMore"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/rs_ic_more_vert"
            android:tint="@color/rin_on_toolbar"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/more_actions" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rin_menu_divider" />

    <!-- منطقة المحتوى: تبديل ظهور بين شجرة الملفات وشجرة البنية بدل صفحتين منفصلتين -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExplorerFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:overScrollMode="ifContentScrolls" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExplorerOutline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone" />

        <!-- حالة فارغة موحَّدة: "لا مشروع مفتوح"، "المجلد فارغ"، أو "لا بنية في الملف" -->
        <TextView
            android:id="@+id/txtExplorerEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="28dp"
            android:textSize="13sp"
            android:textColor="@color/rin_menu_dim"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnExplorerOpenProjects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="64dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/explorer_open_projects_action"
            android:textColor="@color/rin_menu_on_accent"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_drawer_cta"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
