<?xml version="1.0" encoding="utf-8"?>
<!-- صف مجلد فرعي داخل شاشة الملفات: نفس أسلوب item_file.xml بصرياً، لكن بأيقونة مجلد
     وبدون معلومات حجم (المجلد لا "حجم" مباشر له)، مع نفس زرَّي إعادة التسمية والحذف. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_file_card"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/frameFolderIcon"
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/imgFolderIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_file_tile"
            android:clipToOutline="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/rs_folder"
            android:contentDescription="@null" />

        <!-- شارة ✓ تظهر عند تحديد الصف (انظر FileSelection.kt) -->
        <ImageView
            android:id="@+id/imgFolderSelectCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_file_check_badge"
            android:padding="3dp"
            android:src="@drawable/rs_ic_check"
            android:tint="@color/rin_files_on_accent"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtFolderNameItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/rin_files_text"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtFolderMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12.5sp"
            android:textColor="@color/rin_files_dim" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMoreFolder"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="9dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_file_action"
        android:contentDescription="@string/more_actions"
        android:src="@drawable/ic_kebab_vertical"
        android:tint="@color/rin_files_dim" />

    <ImageButton
        android:id="@+id/btnRenameFolder"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="9dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_file_action"
        android:contentDescription="@string/rename"
        android:src="@drawable/ic_edit_pencil"
        android:tint="@color/rin_files_accent" />

    <ImageButton
        android:id="@+id/btnDeleteFolder"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:background="@drawable/bg_file_action_danger"
        android:contentDescription="@string/delete_folder_title"
        android:src="@drawable/ic_file_trash" />

</LinearLayout>
