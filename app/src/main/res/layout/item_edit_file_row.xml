<?xml version="1.0" encoding="utf-8"?>
<!-- صفّ ملف/مجلد واحد في مستكشف "تعديل الحزمة": أيقونة + اسم + معلومة (حجم/عدد ملفات) + زر ⋮ للإجراءات. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="14dp"
    android:paddingEnd="4dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/imgEditRowIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtEditRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/rin_on_toolbar"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txtEditRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/rin_editor_hint" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnEditRowMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="⋮"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/rin_editor_hint"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit_package_more_actions" />
</LinearLayout>
