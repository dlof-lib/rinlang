<?xml version="1.0" encoding="utf-8"?>
<!-- صف ملف في شاشة الملفات (هوية RinStudio: أسود · أبيض · أخضر).
     البلاطة imgFileIcon تعرض أيقونة النوع داخل مربّع مدوّر، وللصور والفيديو تتحوّل إلى مصغّرة حقيقية تملأ البلاطة بزوايا مقصوصة
     (انظر FileRowStyle.kt) مع لصيقة نوع (JPG/PNG/MP4) وزر تشغيل للفيديو. علامة "!" = خطأ صياغة حقيقي (FilesActivity.scanForErrors). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_file_card"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/frameFileIcon"
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/imgFileIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_file_tile"
            android:clipToOutline="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rin_file"
            android:contentDescription="@null" />

        <!-- لصيقة نوع الملف: تظهر فقط في وضع المصغّرة -->
        <TextView
            android:id="@+id/txtFileTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_file_type_badge"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- زر تشغيل فوق مصغّرة الفيديو -->
        <ImageView
            android:id="@+id/imgFilePlay"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_file_play_circle"
            android:padding="5dp"
            android:src="@drawable/rs_ic_play"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtErrorBadge"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_file_error_badge"
            android:gravity="center"
            android:text="!"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- شارة ✓ تظهر عند تحديد الصف (انظر FileSelection.kt) -->
        <ImageView
            android:id="@+id/imgFileSelectCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_file_check_badge"
            android:padding="3dp"
            android:src="@drawable/rs_ic_check"
            android:tint="@color/rin_files_on_accent"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtFileNameItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/rin_files_text"
                android:ellipsize="middle"
                android:maxLines="1" />

            <!-- نقطة "تعديل غير محفوظ" حقيقية (EditorDirtyState) -->
            <TextView
                android:id="@+id/txtDirtyDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/rs_dot_accent"
                android:textColor="@color/rin_files_accent"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtFileMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12.5sp"
            android:textColor="@color/rin_files_dim" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMoreFile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="9dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_file_action"
        android:contentDescription="@string/more_actions"
        android:src="@drawable/ic_kebab_vertical"
        android:tint="@color/rin_files_dim" />

    <ImageButton
        android:id="@+id/btnRenameFile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="9dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_file_action"
        android:contentDescription="@string/rename"
        android:src="@drawable/ic_edit_pencil"
        android:tint="@color/rin_files_accent" />

    <ImageButton
        android:id="@+id/btnDeleteFile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:background="@drawable/bg_file_action_danger"
        android:contentDescription="@string/delete_file_title"
        android:src="@drawable/ic_file_trash" />

</LinearLayout>
