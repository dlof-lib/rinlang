<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_list_card"
    android:layout_margin="5dp"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- أيقونة "rin+" داخل شارة دائرية بلون التمييز، لتمييزها بصرياً كمكتبة/حزمة -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_badge_accent"
                android:alpha="0.16" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rin_stack"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLibraryNameItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar" />

            <TextView
                android:id="@+id/txtLibraryMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="12sp"
                android:textColor="@color/rin_editor_hint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteLibrary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/delete_library_title"
            android:src="@drawable/ic_trash_red" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/rin_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditLibrary"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_edit_library"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn_ghost"
            android:textColor="@color/rin_on_toolbar" />

        <Button
            android:id="@+id/btnPublishLibrary"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_publish_library"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn_ghost"
            android:textColor="@color/rin_accent" />

        <Button
            android:id="@+id/btnInsertLibrary"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_insert_import"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
