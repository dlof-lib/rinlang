<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pipeline_code_card"
    android:layout_margin="4dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLibraryNameItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar" />

            <TextView
                android:id="@+id/txtLibraryMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/rin_editor_hint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteLibrary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_library_title"
            android:src="@android:drawable/ic_menu_delete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditLibrary"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_edit_library"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn_ghost"
            android:textColor="@color/rin_on_toolbar" />

        <Button
            android:id="@+id/btnInsertLibrary"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_insert_import"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
