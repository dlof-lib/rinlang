<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="7dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_album_project" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROJECT" android:textSize="9sp" android:textStyle="bold" android:textColor="@color/rin_accent" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/txtAlbumProjectName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/rin_on_toolbar" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/txtAlbumProjectType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/rin_accent_green" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtAlbumProjectMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/rin_editor_hint" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
