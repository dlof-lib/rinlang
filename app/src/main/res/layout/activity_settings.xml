<?xml version="1.0" encoding="utf-8"?>
<!--
    شاشة الإعدادات: هيكل ثابت فقط (شريط علوي + عنوان + حاوية + زر الاستعادة).
    الأقسام والصفوف تُبنى في SettingsActivity من مخطط واحد باستخدام
    item_setting_{section,switch,choice,slider,link}.xml بدل تكرار الصف نفسه عشرين مرة هنا.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rin_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/toolbar_app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_hero_title"
                android:textColor="@color/rin_on_toolbar"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/settings_hero_hint"
                android:textColor="@color/rin_editor_hint"
                android:textSize="12.5sp" />

            <!-- بحث + أقسام بأسلوب إعدادات الكمبيوتر: اكتب لتصفية الإعدادات أو اختر قسماً من الشريط -->
            <EditText
                android:id="@+id/settingsSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_field"
                android:drawablePadding="8dp"
                android:hint="@string/settings_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/rin_on_toolbar"
                android:textColorHint="@color/rin_editor_hint"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/settingsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/settings_no_results"
                android:textColor="@color/rin_editor_hint"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnResetDefaults"
                style="@style/Widget.RinLang.Button.OutlineDanger"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/action_reset_defaults" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
