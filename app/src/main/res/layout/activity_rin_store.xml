<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة "متجر Rin" — نسخة مطوَّرة بصرياً: شريط بحث وفرز أنيق داخل بطاقة موحّدة، تصنيفات
  أفقية بارزة، وقائمة حزم تستخدم البطاقة الجديدة (item_store_package.xml). كل معرّفات
  العناصر المرتبطة بـ RinStoreActivity.kt بقيت كما هي بلا أي تغيير.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <!-- شريط البحث + زر الفرز، داخل بطاقة موحّدة بحدّ خفيف لإحساس أكثر احترافية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_store_section_card"
        android:layout_margin="10dp"
        android:padding="6dp">

        <EditText
            android:id="@+id/edtStoreSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:hint="@string/store_search_hint"
            android:textColor="@color/rin_editor_text"
            android:textColorHint="@color/rin_editor_hint"
            android:textSize="13.5sp" />

        <!-- زر فرز نصّي (أيقونة + تسمية الوضع الحالي) بدل أيقونة مجرّدة، ليكون واضحاً دون حاجة
             لفتح القائمة لمعرفة الفرز الحالي — النص يتحدّث فوراً مع كل اختيار (انظر
             RinStoreActivity.showSortMenu). -->
        <Button
            android:id="@+id/btnStoreSort"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_sort_pill_button"
            android:drawableStart="@android:drawable/ic_menu_sort_by_size"
            android:drawableTint="@color/rin_accent"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/rin_accent"
            android:text="@string/store_sort_newest" />
    </LinearLayout>

    <!-- تصنيفات المتجر: تُبنى ديناميكياً من الحزم المُحمَّلة -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStoreCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:singleSelection="true"
            app:chipSpacingHorizontal="6dp" />
    </HorizontalScrollView>

    <!-- عدّاد النتائج: يظهر فقط بعد انتهاء التحميل (يبقى فارغاً أثناء عرض الهيكل التغبيشي)،
         يمنح إحساساً أوضح بحجم القائمة قبل التمرير فيها. -->
    <TextView
        android:id="@+id/txtStoreResultsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:textSize="11.5sp"
        android:textColor="@color/rin_editor_hint"
        android:visibility="invisible"
        tools:text="24 حزمة متاحة" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.dlof.rinlang.widgets.ShimmerLayout
                android:id="@+id/shimmerStoreSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <include layout="@layout/layout_skeleton_store_package" />
                <include layout="@layout/layout_skeleton_store_package" />
                <include layout="@layout/layout_skeleton_store_package" />
                <include layout="@layout/layout_skeleton_store_package" />
            </com.dlof.rinlang.widgets.ShimmerLayout>

            <!-- layoutAnimation: كل بطاقة تظهر بتلاشٍ + ارتفاع خفيف متتابع (انظر
                 anim/layout_animation_store_list.xml) بدل الظهور الدفعي المفاجئ فور استبدال
                 الهيكل التغبيشي بالقائمة الحقيقية — RinStoreActivity.hideSkeleton يستدعي
                 scheduleLayoutAnimation() صراحةً بعد كل submit جديد. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPackages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/layout_animation_store_list"
                android:alpha="0"
                android:visibility="gone"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/txtEmptyStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:alpha="0.55"
                    android:src="@drawable/ic_empty_library"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:gravity="center"
                    android:text="@string/store_empty"
                    android:textColor="@color/rin_editor_hint"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav_bar" />

</LinearLayout>
