<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة "متجر Rin" — نسخة مطوَّرة بصرياً: شريط بحث وفرز أنيق داخل بطاقة موحّدة، تصنيفات
  أفقية بارزة، وقائمة حزم تستخدم البطاقة الجديدة (item_store_package.xml). كل معرّفات
  العناصر المرتبطة بـ RinStoreActivity.kt بقيت كما هي بلا أي تغيير.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_st_bg">

    <!-- ترويسة المتجر (Hero): رجوع + شعار + العنوان، ثم البحث + الفرز داخل بطاقة داكنة متوهّجة.
         المعرّفات كما هي: btnToolbarBack, txtToolbarTitle, edtStoreSearch, btnStoreClearSearch, btnStoreSort. -->
    <LinearLayout
        android:id="@+id/layoutStoreHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_st_hero"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnToolbarBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_st_hero_btn"
                android:contentDescription="@string/action_back"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/rin_st_hero_accent" />

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_st_hero_logo">

                <ImageView
                    android:id="@+id/imgToolbarAppIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:padding="4dp"
                    android:src="@mipmap/ic_launcher_round" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/rin_st_hero_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtStoreSearch"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_st_hero_search"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/rs_ic_search"
                android:drawableTint="@color/rin_st_hero_accent"
                android:hint="@string/store_search_hint"
                android:imeOptions="actionSearch"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/rin_st_hero_text"
                android:textColorHint="@color/rin_st_hero_dim"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnStoreClearSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@null"
                android:contentDescription="@string/libs_clear_search"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="@color/rin_st_hero_dim" />

            <!-- فرز: أيقونة + تسمية الوضع الحالي (تتحدّث من RinStoreActivity.showSortMenu) -->
            <Button
                android:id="@+id/btnStoreSort"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_st_hero_pill"
                android:drawablePadding="6dp"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawableTint="@color/rin_st_hero_accent"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/store_sort_newest"
                android:textAllCaps="false"
                android:textColor="@color/rin_st_hero_accent"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- تصنيفات المتجر: تُبنى ديناميكياً من الحزم المُحمَّلة -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStoreCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:chipSpacingHorizontal="8dp" />
    </HorizontalScrollView>

    <!-- عدّاد النتائج: يظهر فقط بعد انتهاء التحميل (يبقى فارغاً أثناء عرض الهيكل التغبيشي)،
         يمنح إحساساً أوضح بحجم القائمة قبل التمرير فيها. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/txtStoreResultsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11.5sp"
            android:textColor="@color/rin_st_dim"
            android:visibility="invisible"
            tools:text="24 حزمة متاحة" />

        <!-- يظهر فقط عند وجود بحث/تصنيف فعّال: يعيد كل الفلاتر لوضعها الافتراضي بنقرة -->
        <TextView
            android:id="@+id/btnStoreResetFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_st_cat_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/store_reset_filters"
            android:textColor="@color/rin_st_accent"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshStore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <com.dlof.rinlang.widgets.ShimmerLayout
                    android:id="@+id/shimmerStoreSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <include layout="@layout/layout_skeleton_store_package" />
                    <include layout="@layout/layout_skeleton_store_package" />
                    <include layout="@layout/layout_skeleton_store_package" />
                    <include layout="@layout/layout_skeleton_store_package" />
                </com.dlof.rinlang.widgets.ShimmerLayout>

                <!-- layoutAnimation: كل بطاقة تظهر بتلاشٍ + ارتفاع خفيف متتابع (انظر
                     anim/layout_animation_store_list.xml) بدل الظهور الدفعي المفاجئ فور استبدال
                     الهيكل التغبيشي بالقائمة الحقيقية — RinStoreActivity.hideSkeleton يستدعي
                     scheduleLayoutAnimation() صراحةً بعد كل submit جديد. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPackages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutAnimation="@anim/layout_animation_store_list"
                    android:alpha="0"
                    android:visibility="gone"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:id="@+id/txtEmptyStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:alpha="0.55"
                        android:src="@drawable/ic_empty_library"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:gravity="center"
                        android:text="@string/store_empty"
                        android:textColor="@color/rin_st_dim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/bottom_nav_bar" />

</LinearLayout>
