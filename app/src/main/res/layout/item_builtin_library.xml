<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة "مكتبة جاهزة" الجديدة: نفس لغة item_library.xml البصرية، لكن بشريط تمييز أخضر
     (bg_library_card_builtin) وأيقونة متدرّجة خضراء، لتمييزها فوراً عن "مكتباتي" البنفسجية
     بلا الحاجة لقراءة النص أصلاً. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_library_card_builtin"
    android:layout_margin="6dp"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="13dp"
    android:paddingBottom="13dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_icon_gradient_green" />

        <ImageView
            android:id="@+id/imgBuiltinIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rin_stack"
            app:tint="@android:color/white"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtBuiltinNameItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/rin_on_toolbar" />

        <TextView
            android:id="@+id/txtBuiltinDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12sp"
            android:textColor="@color/rin_editor_hint" />

        <TextView
            android:id="@+id/txtBuiltinFunctions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip_meta"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/syntax_builtin" />
    </LinearLayout>

    <Button
        android:id="@+id/btnInsertBuiltin"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/action_insert_import"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_toolbar_btn_primary"
        android:textColor="@android:color/white" />

</LinearLayout>
