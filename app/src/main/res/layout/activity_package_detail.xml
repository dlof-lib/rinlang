<?xml version="1.0" encoding="utf-8"?>
<!--
  صفحة "تفاصيل الحزمة" — نسخة مطوَّرة بصرياً: رأس (hero) بخلفية متدرّجة خفيفة يجمع الاسم
  والوصف والناشر وشريط إحصائيات + زر تثبيت بارز، تليه بطاقات أقسام (README / الترخيص /
  الملفات) موحّدة الشكل بعناوين مرفقة بأيقونة. كل معرّفات العناصر المرتبطة بـ
  PackageDetailActivity.kt بقيت كما هي بلا أي تغيير.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- رأس الحزمة (Hero): بانر خلفية علوي (خلايا سداسية/أرقام ثنائية) ثم اسم الحزمة +
                 وصفها + صف الناشر + شريط إحصائيات + زر تثبيت -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detail_hero_frame"
                android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="84dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_hex_banner"
                        android:contentDescription="@null" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_banner_scrim" />
                </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtDetailPackageName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/rin_on_toolbar"
                    tools:text="mathlib" />

                <TextView
                    android:id="@+id/txtDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/rin_editor_text" />

                <!-- صف الناشر: صورة دائرية + اسم + شارة توثيق (تظهر فقط للناشرين المؤهلين) —
                     الصف كامل قابل للضغط لفتح الملف الشخصي العام لهذا الناشر -->
                <LinearLayout
                    android:id="@+id/rowDetailPublisher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_icon_btn">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp">

                        <ImageView
                            android:id="@+id/imgDetailPublisherAvatar"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:scaleType="centerCrop"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/txtDetailPublisherInitial"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtDetailPublisherName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/rin_on_toolbar" />

                    <ImageView
                        android:id="@+id/imgDetailVerifiedBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:src="@drawable/ic_verified_badge"
                        android:visibility="gone"
                        android:contentDescription="@string/verified_publisher_badge_description" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- زر الانتساب لهذا الناشر: يتبدّل نصه/شكله بين "انتساب" و"تم الانتساب".
                         مخفي افتراضياً (View.GONE) حتى تُحدَّد هوية الناشر مقابل المستخدم الحالي
                         داخل bindSubscribe() في PackageDetailActivity.kt (لا يظهر لناشر الحزمة نفسه). -->
                    <TextView
                        android:id="@+id/btnDetailSubscribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_subscribe_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/rin_accent"
                        android:text="@string/action_subscribe_publisher"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- شريط إحصائيات: إصدار / ترخيص / تنزيلات / تقييم + زر الإعجاب (قلب) بجانبه -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDetailMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/rin_editor_hint" />

                    <LinearLayout
                        android:id="@+id/btnDetailLike"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_like_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:contentDescription="@string/action_like_package">

                        <ImageView
                            android:id="@+id/imgDetailLikeIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_heart_outline"
                            app:tint="@color/rin_editor_hint"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/txtDetailLikeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/rin_editor_hint" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnDetailInstall"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:drawableStart="@drawable/ic_log_download"
                    android:drawablePadding="8dp"
                    android:text="@string/action_install"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_install_button_premium"
                    android:textColor="@android:color/white" />
            </LinearLayout>
            </LinearLayout>
            </FrameLayout>

            <!-- قسم README.md -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:drawableStart="@drawable/ic_readme_doc"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/package_detail_section_readme"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar" />

            <TextView
                android:id="@+id/txtDetailReadme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detail_section_card"
                android:padding="15dp"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/rin_editor_text"
                android:textColorLink="@color/rin_accent"
                android:autoLink="web" />

            <!-- قسم الترخيص -->
            <TextView
                android:id="@+id/txtDetailLicenseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:drawableStart="@drawable/ic_license_shield"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/package_detail_section_license"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar" />

            <TextView
                android:id="@+id/txtDetailLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detail_section_card"
                android:padding="15dp"
                android:fontFamily="monospace"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/rin_editor_hint" />

            <!-- قسم ملفات الحزمة -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:drawableStart="@drawable/ic_files_stack"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/package_detail_section_files"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/rin_on_toolbar" />

            <LinearLayout
                android:id="@+id/containerDetailFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_detail_section_card"
                android:divider="@drawable/divider_hairline"
                android:showDividers="middle" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
