<?xml version="1.0" encoding="utf-8"?>
<!-- صف واحد في شاشة Output: هامش أرقام + شريط حاوية + أيقونة النوع + نص يُكتب تدريجياً.
     layoutDirection="ltr" مقصود: الشاشة ترمنال (أرقام الأسطر يساراً دائماً) حتى في واجهة عربية RTL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layoutDirection="ltr"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/txtOutGutter"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingStart="0dp"
        android:fontFamily="monospace"
        android:textColor="@color/out_gutter"
        android:textSize="10.5sp"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/viewOutRail"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp" />

    <LinearLayout
        android:id="@+id/llOutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="14dp"
        android:paddingStart="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgOutIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/txtOutLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.12"
                android:textAlignment="viewStart"
                android:textColor="@color/out_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgOutThumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:maxHeight="220dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
