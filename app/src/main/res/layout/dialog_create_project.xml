<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى حوار "مشروع جديد": حقل اسم المشروع + شبكة 2×2 من شرائح اختيار النوع
     (Container / Table / UI / Free Project). التحديد الفعلي يُدار من ProjectsActivity
     بتبديل isSelected على كل شريحة (انظر bg_project_type_chip.xml). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <!-- حقل إدخال مربّع بحدّ وخلفية (bg_input_field) بدل خط سفلي مسطّح افتراضي، ليتطابق
             مع أسلوب حقول الإدخال المميّزة في بقية شاشات التطبيق (تسجيل الدخول/الحساب). -->
        <EditText
            android:id="@+id/inputProjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/project_name_hint"
            android:textColor="@color/rin_on_toolbar"
            android:textColorHint="@color/rin_editor_hint"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:maxLines="1"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/project_type_label"
            android:textSize="12.5sp"
            android:textColor="@color/rin_editor_hint" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/chipTypeContainer"
                style="@style/ProjectTypeChip"
                android:layout_row="0"
                android:layout_column="0">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_type_container"
                    android:tint="@color/selector_project_type_chip_text"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/ProjectTypeChipTitle"
                    android:duplicateParentState="true"
                    android:text="@string/project_type_container" />

                <TextView
                    style="@style/ProjectTypeChipSubtitle"
                    android:text="@string/project_type_container_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipTypeTable"
                style="@style/ProjectTypeChip"
                android:layout_row="0"
                android:layout_column="1">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_type_table"
                    android:tint="@color/selector_project_type_chip_text"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/ProjectTypeChipTitle"
                    android:duplicateParentState="true"
                    android:text="@string/project_type_table" />

                <TextView
                    style="@style/ProjectTypeChipSubtitle"
                    android:text="@string/project_type_table_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipTypeUi"
                style="@style/ProjectTypeChip"
                android:layout_row="1"
                android:layout_column="0">

                <!-- بدل أيقونة عامة: صورة مصغّرة فعلية من واجهة UI حقيقية (شريط علوي + قائمة
                     جانبية)، لتُظهر للمستخدم شكل النتيجة قبل الاختيار، بلا أيقونة. -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/thumb_type_ui"
                    app:shapeAppearanceOverlay="@style/ProjectTypeUiThumbShape"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/ProjectTypeChipTitle"
                    android:duplicateParentState="true"
                    android:text="@string/project_type_ui" />

                <TextView
                    style="@style/ProjectTypeChipSubtitle"
                    android:text="@string/project_type_ui_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipTypeFree"
                style="@style/ProjectTypeChip"
                android:layout_row="1"
                android:layout_column="1">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_type_free"
                    android:tint="@color/selector_project_type_chip_text"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/ProjectTypeChipTitle"
                    android:duplicateParentState="true"
                    android:text="@string/project_type_free" />

                <TextView
                    style="@style/ProjectTypeChipSubtitle"
                    android:text="@string/project_type_free_desc" />
            </LinearLayout>

            <!-- شريحة خامسة بعرض الصفّين معاً: نوع مشروع "Illust" الجاهز — لغة رسم/SVG
                 مضمَّنة كاملة (راجع BundledIllustLanguage.kt)، تُنشئ مشروعاً يعمل فوراً
                 (شغّل run.rin) بدل main.rin ترحيبي فارغ. -->
            <LinearLayout
                android:id="@+id/chipTypeIllust"
                style="@style/ProjectTypeChip"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_illust_file"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProjectTypeChipTitle"
                        android:duplicateParentState="true"
                        android:layout_marginTop="0dp"
                        android:text="@string/project_type_illust" />

                    <TextView
                        style="@style/ProjectTypeChipSubtitle"
                        android:text="@string/project_type_illust_desc" />
                </LinearLayout>
            </LinearLayout>
        </GridLayout>

        <!-- قسم "رسم الواجهة": يظهر فقط عند اختيار نوع المشروع UI (يُتحكَّم بـ visibility من
             ProjectsActivity.selectChip). يجمع خيارات توب بار/بلا توب بار، قائمة جانبية/بلا
             قائمة جانبية، ولون أساسي، لتُستخدم عند توليد main.rin (انظر
             ProjectManager.UiDesignOptions + mainRinTemplateFor). -->
        <LinearLayout
            android:id="@+id/sectionUiDesign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View style="@style/OptionsSectionAccent" android:backgroundTint="@color/project_type_ui_color" />
                <TextView style="@style/OptionsSectionTitle" android:text="@string/ui_design_section_title" />
            </LinearLayout>

            <TextView style="@style/OptionsSectionDesc" android:text="@string/ui_design_section_desc" />

            <LinearLayout style="@style/OptionsSectionCard">

                <!-- شريط علوي: تشغيل/إيقاف -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_design_topbar_label"
                            android:textColor="@color/rin_on_toolbar"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_design_topbar_desc"
                            android:textColor="@color/rin_editor_hint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchUiTopBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/rin_divider" />

                <!-- قائمة جانبية: تشغيل/إيقاف -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_design_sidebar_label"
                            android:textColor="@color/rin_on_toolbar"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_design_sidebar_desc"
                            android:textColor="@color/rin_editor_hint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchUiSidebar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/rin_divider" />

                <!-- الألوان: شبكة دوائر قابلة للاختيار، تُبنى برمجياً في ProjectsActivity
                     (انظر renderColorSwatches) بدل ثماني View ثابتة هنا. الشارة الأخيرة
                     "لون مخصص" تفتح عجلة ألوان كاملة (HueSaturationPickerView). -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/ui_design_colors_label"
                    android:textColor="@color/rin_on_toolbar"
                    android:textSize="13.5sp" />

                <LinearLayout
                    android:id="@+id/rowUiColors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:gravity="center" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/ui_design_more_options" android:textColor="@color/rin_on_toolbar" android:textSize="13.5sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_design_bottom_nav" android:textColor="@color/rin_on_toolbar" />
                    <Switch android:id="@+id/switchUiBottomNav" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_design_button_style" android:textColor="@color/rin_on_toolbar" />
                <RadioGroup android:id="@+id/groupUiButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <RadioButton android:id="@+id/radioUiFilled" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_design_button_filled" android:checked="true" />
                    <RadioButton android:id="@+id/radioUiSoft" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_design_button_soft" />
                    <RadioButton android:id="@+id/radioUiOutline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_design_button_outline" />
                </RadioGroup>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginTop="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_design_font" android:textColor="@color/rin_on_toolbar" />
                        <Spinner android:id="@+id/spinnerUiFont" android:layout_width="match_parent" android:layout_height="44dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_design_typography" android:textColor="@color/rin_on_toolbar" />
                        <Spinner android:id="@+id/spinnerUiTypography" android:layout_width="match_parent" android:layout_height="44dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_design_radius" android:textColor="@color/rin_on_toolbar" />
                        <Spinner android:id="@+id/spinnerUiRadius" android:layout_width="match_parent" android:layout_height="44dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ui_design_background" android:textColor="@color/rin_on_toolbar" />
                <LinearLayout android:id="@+id/rowUiBackground" android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="center_vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_design_text_color" android:textColor="@color/rin_on_toolbar" />
                <LinearLayout android:id="@+id/rowUiTextColor" android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="center_vertical" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ui_design_preview" android:textColor="@color/rin_on_toolbar" />
                <com.dlof.rinlang.UiDesignPreviewView android:id="@+id/uiDesignPreview" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- قسم "خيارات الحاوية": يظهر فقط عند اختيار نوع Container (انظر
             ProjectsActivity.selectChip + ProjectManager.ContainerOptions). -->
        <LinearLayout
            android:id="@+id/sectionContainerOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View style="@style/OptionsSectionAccent" android:backgroundTint="@color/project_type_container_color" />
                <TextView style="@style/OptionsSectionTitle" android:text="@string/container_options_section_title" />
            </LinearLayout>

            <TextView style="@style/OptionsSectionDesc" android:text="@string/container_options_section_desc" />

            <LinearLayout style="@style/OptionsSectionCard">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/container_var_name_label" android:textColor="@color/rin_on_toolbar" android:textSize="13.5sp" />
                <EditText
                    android:id="@+id/inputContainerVarName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="counter"
                    android:maxLines="1"
                    android:inputType="text"
                    android:textColor="@color/rin_on_toolbar"
                    android:textColorHint="@color/rin_editor_hint" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:background="@color/rin_divider" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/container_var_value_label" android:textColor="@color/rin_on_toolbar" android:textSize="13.5sp" />
                <EditText
                    android:id="@+id/inputContainerVarValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:maxLines="1"
                    android:inputType="text"
                    android:textColor="@color/rin_on_toolbar"
                    android:textColorHint="@color/rin_editor_hint" />
            </LinearLayout>
        </LinearLayout>

        <!-- قسم "خيارات الجدول": يظهر فقط عند اختيار نوع Table (انظر
             ProjectsActivity.selectChip + ProjectManager.TableOptions). -->
        <LinearLayout
            android:id="@+id/sectionTableOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View style="@style/OptionsSectionAccent" android:backgroundTint="@color/project_type_table_color" />
                <TextView style="@style/OptionsSectionTitle" android:text="@string/table_options_section_title" />
            </LinearLayout>

            <TextView style="@style/OptionsSectionDesc" android:text="@string/table_options_section_desc" />

            <LinearLayout style="@style/OptionsSectionCard" android:orientation="horizontal" android:weightSum="2">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/table_columns_label" android:textColor="@color/rin_on_toolbar" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerTableColumns" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/table_rows_label" android:textColor="@color/rin_on_toolbar" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerTableRows" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- قسم "خيارات المشروع" (Free Project): يظهر فقط عند اختيار نوع Free (انظر
             ProjectsActivity.selectChip + ProjectManager.FreeOptions). -->
        <LinearLayout
            android:id="@+id/sectionFreeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View style="@style/OptionsSectionAccent" android:backgroundTint="@color/project_type_free_color" />
                <TextView style="@style/OptionsSectionTitle" android:text="@string/free_options_section_title" />
            </LinearLayout>

            <TextView style="@style/OptionsSectionDesc" android:text="@string/free_options_section_desc" />

            <LinearLayout style="@style/OptionsSectionCard">
                <RadioGroup android:id="@+id/groupFreeTemplate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioButton android:id="@+id/radioFreeEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/free_template_empty" />
                    <RadioButton android:id="@+id/radioFreeGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/free_template_greeting" android:checked="true" />
                    <RadioButton android:id="@+id/radioFreeExample" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/free_template_example" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- قسم "خيارات الرسم" (Illust): يظهر فقط عند اختيار نوع Illust (انظر
             ProjectsActivity.selectChip + ProjectManager.IllustOptions). -->
        <LinearLayout
            android:id="@+id/sectionIllustOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View style="@style/OptionsSectionAccent" android:backgroundTint="@color/project_type_illust_color" />
                <TextView style="@style/OptionsSectionTitle" android:text="@string/illust_options_section_title" />
            </LinearLayout>

            <TextView style="@style/OptionsSectionDesc" android:text="@string/illust_options_section_desc" />

            <LinearLayout style="@style/OptionsSectionCard" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/illust_include_example_label" android:textColor="@color/rin_on_toolbar" android:textSize="13.5sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/illust_include_example_desc" android:textColor="@color/rin_editor_hint" android:textSize="10.5sp" />
                </LinearLayout>
                <Switch android:id="@+id/switchIllustExample" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
