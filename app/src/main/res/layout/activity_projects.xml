<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة «المشاريع»: ترويسة داكنة متوهّجة (Hero) + شبكة بطاقات مشاريع + زر «مشروع جديد» ممتد + الشريط السفلي.
     كل المعرّفات كما كانت فلا يتغيّر منطق ProjectsActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rin_proj_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutProjectsHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_proj_hero"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnToolbarBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_proj_hero_btn"
                android:contentDescription="@string/action_back"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/rin_proj_hero_accent" />

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_proj_hero_logo">

                <ImageView
                    android:id="@+id/imgToolbarAppIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:padding="4dp"
                    android:src="@mipmap/ic_launcher_round" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/rin_proj_hero_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtToolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/rin_proj_hero_dim"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- عدّاد المشاريع + فرز (نقر = قائمة الفرز، ضغطة مستمرة = تبديل الأعمدة) -->
            <LinearLayout
                android:id="@+id/btnProjectSort"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_proj_hero_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/txtProjectCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/projects_count_zero"
                    android:textColor="@color/rin_proj_hero_accent"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/sort_projects_action"
                    android:src="@drawable/ic_node_sort"
                    app:tint="@color/rin_proj_hero_accent" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnProjectImport"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_proj_hero_pill"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/rs_ic_download"
                android:drawableTint="@color/rin_proj_hero_accent"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="@string/import_project_action"
                android:textColor="@color/rin_proj_hero_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnProjectAlbums"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_proj_hero_pill"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/rs_ic_folder"
                android:drawableTint="@color/rin_proj_hero_accent"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="@string/albums_title"
                android:textColor="@color/rin_proj_hero_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputProjectSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_proj_hero_search"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/rs_ic_search"
            android:drawableTint="@color/rin_proj_hero_accent"
            android:hint="@string/search_projects_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/rin_proj_hero_text"
            android:textColorHint="@color/rin_proj_hero_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- شريط التحديد المتعدد للمشاريع: ضغطة مستمرة على بطاقة تبدأه، والسحب بعدها يحدّد نطاقاً. -->
    <LinearLayout
        android:id="@+id/layoutProjSelBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_proj_sel_bar"
        android:padding="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnProjSelClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/rin_proj_text"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/selection_clear" />

        <TextView
            android:id="@+id/txtProjSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rin_proj_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnProjSelAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_select_all"
            android:tint="@color/rin_proj_text"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/selection_select_all" />

        <ImageButton
            android:id="@+id/btnProjSelMove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/rs_ic_folder"
            android:tint="@color/rin_proj_text"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/action_move" />

        <!-- تنزيل المشاريع المحدّدة إلى الجهاز كأرشيف ZIP — DownloadExporter.saveProjects -->
        <ImageButton
            android:id="@+id/btnProjSelDownload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/rs_ic_download"
            android:tint="@color/rin_proj_text"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/dl_projects_zip" />

        <ImageButton
            android:id="@+id/btnProjSelDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_trash_red"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/delete" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- سحب لأسفل من أعلى القائمة = تحديث -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeProjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProjects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="104dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/txtEmptyProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_empty_folder"
                android:alpha="0.9"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtEmptyProjectsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/no_projects_yet"
                android:textColor="@color/rin_proj_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtEmptyProjectsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/no_projects_hint"
                android:textColor="@color/rin_proj_dim"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- زر «مشروع جديد» الممتد: أيقونة + نص، مربّع ناعم بتوهّج أخضر. ضغطة مستمرة = قائمة الاستيراد. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabNewProject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:contentDescription="@string/new_project_title"
            android:text="@string/new_project_title"
            android:textColor="@color/rin_proj_on_accent"
            android:textStyle="bold"
            app:backgroundTint="@color/rin_proj_accent_fill"
            app:cornerRadius="20dp"
            app:elevation="6dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="@color/rin_proj_on_accent"
            app:rippleColor="#33000000" />
    </FrameLayout>

    <include layout="@layout/bottom_nav_bar" />
</LinearLayout>
