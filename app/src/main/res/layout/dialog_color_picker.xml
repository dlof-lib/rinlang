<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى حوار "اختيار لون" الكامل: عجلة ألوان (Hue+Saturation) تفاعلية + معاينة دائرية +
     حقل هكس، يُفتح عند الضغط على شارة "لون مخصص" في حوار "مشروع جديد" (انظر
     ProjectsActivity.showColorPickerDialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <com.dlof.rinlang.HueSaturationPickerView
        android:id="@+id/hueSaturationPicker"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/imgColorPreview"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="#"
            android:textColor="@color/rin_editor_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/inputColorHex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:maxLength="6"
            android:inputType="textCapCharacters"
            android:textColor="@color/rin_on_toolbar"
            android:textColorHint="@color/rin_editor_hint"
            android:hint="FFFFFF" />
    </LinearLayout>
</LinearLayout>
