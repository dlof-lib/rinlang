<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- مطلوب فقط على أندرويد 9 وأقدم لكتابة الملفات الحقيقية داخل مجلد Downloads العام؛
         على أندرويد 10+ (API 29+) يُستخدم MediaStore بدلاً منه ولا يحتاج أي إذن. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- مطلوب لتسجيل الدخول/إنشاء الحساب عبر Firebase Auth، وإرسال كود التحقق عبر EmailJS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.RinLang"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true">

        <!-- يمكّن التخزين التلقائي للغة المختارة عبر AppCompatDelegate.setApplicationLocales
             (انظر LocaleHelper.kt) حتى تبقى اللغة محفوظة بين مرات فتح التطبيق بلا كود إضافي. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.RinLang.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PipelineRunnerActivity"
            android:exported="false"
            android:theme="@style/Theme.RinLang.Pipeline"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LoomPreviewActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RinLang" />

        <activity
            android:name=".ProjectsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".FilesActivity"
            android:exported="false" />

        <!-- معاينة صورة/فيديو مرفوعة داخل مشروع، بدل فتحها في المحرر النصّي أو تطبيق خارجي -->
        <activity
            android:name=".MediaPreviewActivity"
            android:exported="false" />

        <activity
            android:name=".MoreActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- شاشة "المكتبات" الجديدة: رفع/إنشاء/تعديل مكتبات lib/*.og.rin واستدعاؤها من المحرر -->
        <activity
            android:name=".LibrariesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- شاشة "الإعدادات" العامة (حجم الخط، أرقام الأسطر) — منفصلة عمداً عن ".store.AccountActivity" -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- ===== مرحلة 1 من "متجر Rin": تسجيل الدخول / إنشاء الحساب / كود التحقق (5 أرقام) =====
             Firebase Auth (Email/Password) لبيانات الدخول + Realtime Database لبيانات الحساب
             (الاسم، اسم المستخدم، حالة التحقق) وكود التحقق المؤقت. الإرسال الفعلي للبريد عبر EmailJS. -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.VerifyCodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ===== مرحلة 2 من "متجر Rin": تصفّح الحزم / نشر مكتبة كحزمة / حسابي ===== -->
        <activity
            android:name=".store.RinStoreActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".store.PackageDetailActivity"
            android:exported="false" />

        <activity
            android:name=".store.PublishPackageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".store.AccountActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- الملف الشخصي العام: عرض ملف أي مستخدم آخر (وليس حسابي فقط)، مع زر الانتساب -->
        <activity
            android:name=".store.PublicProfileActivity"
            android:exported="false" />

        <!-- قائمة "المنتسبين" أو "الانتسابات" لحساب ما -->
        <activity
            android:name=".store.UserListActivity"
            android:exported="false" />

        <!-- ===== "Rin Extensions Marketplace": متجر رسمي منفصل للإضافات والأدوات ===== -->
        <activity
            android:name=".store.extensions.RinExtensionsMarketplaceActivity"
            android:exported="false" />

        <activity
            android:name=".store.extensions.ExtensionDetailActivity"
            android:exported="false" />

        <!-- شاشة "انشر إضافتك": يفتحها أي مستخدم مسجَّل دخوله لنشر إضافة/مكتبة/سمة خاصة به -->
        <activity
            android:name=".store.extensions.PublishExtensionActivity"
            android:exported="false" />

        <!-- يمنح روابط content:// آمنة للملف المنزَّل قبل فتحه بـ ACTION_VIEW على أندرويد 9 وأقدم
             (على أندرويد 10+ نستخدم MediaStore أصلاً فيعطينا content:// Uri تلقائياً). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
