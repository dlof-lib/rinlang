<Container#app>
  <Element.button#run text="Run" />
  <Element.input#name placeholder="Your name" />
  <Rin>
    on.run.click=runCode();
  </Rin>
</Container>
<Rin>
fun runCode() {
    print "Rin UI";
}
</Rin>
<Loop#canvas width=390 height=700 background="#ffffff">
  <Element.text#title text="Rin Elements" />
  <Element.button#run text="Run" />
  <Element.input#name placeholder="Name" />
  <Element.progress#download value=50 max=100 />
</Loop>
