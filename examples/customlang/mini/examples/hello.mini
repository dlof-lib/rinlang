// مضروب وفيبوناتشي وحلقات وشروط
fun fact(n) {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}
fun fib(n) {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}
let i = 1;
while i <= 5 {
    print i, "! =", fact(i);
    i = i + 1;
}
print "fib(15) =", fib(15);
let name = "Rin";
print "hello " + name, len(name), upper(name);
print 2 ^ 3 ^ 2, (1 + 2) * 3, -4 + 10 % 4, 7 / 2;
if fact(5) == 120 and !false { print "ok"; } else { print "bad"; }
let total = 0;
let k = 0;
while k < 100 {
    k = k + 1;
    if k % 2 == 0 { total = total + k; }
}
print "even sum:", total;
