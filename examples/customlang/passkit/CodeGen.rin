// ============================================================================
//  CodeGen.rin — "Passkit": AST -> (1) formatted .passkit source  (2) standalone Rin script
//  The standalone script imports the interpreter and runs the formatted source, so it works on any ordinary Rin interpreter.
// ============================================================================

@import "./Parser.rin";

fun cgPad(depth) {
    return repeat("  ", depth);
}

fun cgAttrs(attrs) {
    let parts = [];
    for (let k in keys(attrs)) {
        if (attrs[k] == "true") { push(parts, k); }
        else { push(parts, k + "=\"" + attrs[k] + "\""); }
    }
    if (len(parts) == 0) { return ""; }
    return " " + join(parts, " ");
}

fun cgNode(node, depth) {
    let head = cgPad(depth) + "<" + node["name"] + cgAttrs(node["attrs"]);
    if (len(node["children"]) == 0) { return head + " />"; }
    let lines = [head + ">"];
    let i = 0;
    while (i < len(node["children"])) {
        push(lines, cgNode(node["children"][i], depth + 1));
        i = i + 1;
    }
    push(lines, cgPad(depth) + "</" + node["name"] + ">");
    return join(lines, "\n");
}

// formatted .passkit source (works as a formatter)
fun cgFormat(ast) {
    let lines = [];
    let i = 0;
    while (i < len(ast["body"])) {
        push(lines, cgNode(ast["body"][i], 0));
        i = i + 1;
    }
    return join(lines, "\n");
}

// standalone Rin script: embeds the formatted source and runs it through Interpreter.rin
fun generate(ast) {
    let src = replace(cgFormat(ast), "\\", "\\\\");
    src = replace(src, "\"", "\\\"");
    let out = [];
    push(out, "// generated by Passkit CodeGen - run it with an ordinary Rin interpreter");
    push(out, "@import \"./Interpreter.rin\";");
    push(out, "let SOURCE = \"" + replace(src, "\n", "\\n") + "\";");
    push(out, "let r = runSource(SOURCE);");
    push(out, "for (let line in r[\"output\"]) { print line; }");
    push(out, "if (r[\"ok\"] == false) { print formatLangError(r[\"error\"]); }");
    return join(out, "\n");
}
