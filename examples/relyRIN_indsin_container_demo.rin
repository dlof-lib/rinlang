<!-- ============================================================================ -->
<!-- RelyRIN + real Rin Container + real Rin Indsin -->
<!-- ============================================================================ -->
<!-- RelyRIN prepares the document; the existing Container/Indsin pipeline renders it. -->
<Import src="lib/relyRIN.og.rin" />
<Container#RelyDocument>
  <warp source={"# RelyRIN\n\n**Live Preview**\n\n::youtube https://www.youtube.com/watch?v=dQw4w9WgXcQ"} />
  <Rin>
    @theme=RelyGreen
        active=true;
        primary="#22c88e";
        background="#ffffff";
        text="#202124";
    .end/theme
  </Rin>
  <Column#Root padding=20 gap=16>
    <Text#Title text="RelyRIN + Indsin" size="title" />
    <Text#Markdown text={source} />
    <WebView#Preview html={relyRenderMarkdown(source)} />
  </Column>
</Container>
