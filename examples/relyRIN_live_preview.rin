@import "lib/relyRIN.og.rin";

let markdown = """
# RelyRIN

**Live Markdown Preview** from Rin.

::image https://example.com/rin.png | Rin

::youtube https://www.youtube.com/watch?v=dQw4w9WgXcQ

::audio audio.mp3

::video video.mp4
""";

let style = relyStyle({
    "accent": "#22c88e",
    "accent2": "#d4af37",
    "bg": "#ffffff",
    "maxWidth": "960px"
});

let preview = relyLiveDocument(
    markdown,
    style
);

writeFile(
    "rely_preview.html",
    preview
);

print relyInfo();
