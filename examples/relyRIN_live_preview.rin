// ============================================================================
//  examples/relyRIN_live_preview.rin
//  relyRIN turns Markdown (with ::image/::youtube/::audio/::video directives)
//  into a self-contained, styled HTML live-preview document. Style overrides
//  go through relyTheme(overrides), which layers them onto relyThemeDefault();
//  relyWritePreviewStyled writes the rendered page straight to disk.
//  See lib/relyRIN.og.rin for the full API (relyLive/relyDocument/relyMedia/...).
// ============================================================================
@import "lib/relyRIN.og.rin";

let markdown = "
# RelyRIN

**Live Markdown Preview** from Rin.

::image https://example.com/rin.png | Rin

::youtube https://www.youtube.com/watch?v=dQw4w9WgXcQ

::audio audio.mp3

::video video.mp4
";

let style = relyTheme({
    "accent": "#22c88e",
    "accent2": "#d4af37",
    "bg": "#ffffff",
    "maxWidth": "960px"
});

let preview = relyLiveStyled(markdown, style);

writeFile(
    "rely_preview.html",
    preview
);

print relyInfo();
