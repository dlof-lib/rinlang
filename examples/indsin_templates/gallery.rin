<!-- indsin/main.indsin — قالب "معرض صور" جاهز (محرّك indsin، @view.*) -->
<!-- استبدل قيم src= بروابط/أسماء ملفات صورك الفعلية داخل مجلد المشروع. -->
<warp selected={"photo1.jpg"} />
<Rin>
fun selectImage(src) { selected = src; }
</Rin>
<Column#root padding=16 gap=12>
  <Text#heading text="معرض الصور" size="title" />
  <Card#preview padding=8>
    <Image#big src={selected} width=340 height=220 />
  </Card>
  <Wrap#grid gap=8>
    <Image#t1 src="photo1.jpg" width=100 height=100 onTap={selectImage("photo1.jpg")} />
    <Image#t2 src="photo2.jpg" width=100 height=100 onTap={selectImage("photo2.jpg")} />
    <Image#t3 src="photo3.jpg" width=100 height=100 onTap={selectImage("photo3.jpg")} />
    <Image#t4 src="photo4.jpg" width=100 height=100 onTap={selectImage("photo4.jpg")} />
    <Image#t5 src="photo5.jpg" width=100 height=100 onTap={selectImage("photo5.jpg")} />
    <Image#t6 src="photo6.jpg" width=100 height=100 onTap={selectImage("photo6.jpg")} />
  </Wrap>
</Column>
