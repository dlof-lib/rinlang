<!-- indsin/main.indsin — قالب "ويب فيو" جاهز (محرّك indsin، @view.*) -->
<!-- استبدل روابط url= أدناه بروابطك الفعلية. -->
<warp url={"https://example.com"} />
<Rin>
fun openHome() { url = "https://example.com"; }
fun openDocs() { url = "https://example.com/docs"; }
fun openBlog() { url = "https://example.com/blog"; }
</Rin>
<Column#root padding=16 gap=10>
  <Text#heading text="متصفّح داخل التطبيق" size="title" />
  <Row#nav gap=8>
    <Button#bHome label="الرئيسية" onTap={openHome()} />
    <Button#bDocs label="التوثيق" onTap={openDocs()} />
    <Button#bBlog label="المدونة" onTap={openBlog()} />
  </Row>
  <Text#urlLabel text={url} size=12 />
  <Card#frame padding=4>
    <WebView#browser url={url} width=360 height=480 />
  </Card>
</Column>
