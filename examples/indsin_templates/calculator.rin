<!-- indsin/main.indsin — قالب "آلة حاسبة" جاهز (محرّك indsin، @view.*) -->
<warp display={"0"} />
<warp stored={0} />
<warp pendingOp={""} />
<warp freshEntry={true} />
<Rin>
fun inputDigit(d) {
    if (freshEntry) { display = d; freshEntry = false; }
    else if (display == "0") { display = d; }
    else { display = display + d; }
}
fun inputDot() {
    if (freshEntry) { display = "0."; freshEntry = false; }
    else if (!contains(display, ".")) { display = display + "."; }
}
fun applyPending() {
    let current = toNumber(display);
    if (pendingOp == "+") { stored = stored + current; }
    else if (pendingOp == "-") { stored = stored - current; }
    else if (pendingOp == "*") { stored = stored * current; }
    else if (pendingOp == "/") {
        if (current == 0) { stored = 0; } else { stored = stored / current; }
    }
    else { stored = current; }
}
fun chooseOp(op) {
    applyPending();
    pendingOp = op;
    freshEntry = true;
    display = toString(stored);
}
fun pressEquals() {
    applyPending();
    display = toString(stored);
    pendingOp = "";
    freshEntry = true;
}
fun clearAll() {
    display = "0"; stored = 0; pendingOp = ""; freshEntry = true;
}
</Rin>
<Column#root padding=16 gap=10>
  <Text#heading text="Calculator App" size="title" />
  <Card#screen padding=18>
    <Text#out text={display} size=32 />
  </Card>
  <Row#row1 gap=8>
    <Button#b7 label="7" sizing="expand" onTap={inputDigit("7")} />
    <Button#b8 label="8" sizing="expand" onTap={inputDigit("8")} />
    <Button#b9 label="9" sizing="expand" onTap={inputDigit("9")} />
    <Button#bDiv label="÷" sizing="expand" onTap={chooseOp("/")} />
  </Row>
  <Row#row2 gap=8>
    <Button#b4 label="4" sizing="expand" onTap={inputDigit("4")} />
    <Button#b5 label="5" sizing="expand" onTap={inputDigit("5")} />
    <Button#b6 label="6" sizing="expand" onTap={inputDigit("6")} />
    <Button#bMul label="×" sizing="expand" onTap={chooseOp("*")} />
  </Row>
  <Row#row3 gap=8>
    <Button#b1 label="1" sizing="expand" onTap={inputDigit("1")} />
    <Button#b2 label="2" sizing="expand" onTap={inputDigit("2")} />
    <Button#b3 label="3" sizing="expand" onTap={inputDigit("3")} />
    <Button#bSub label="-" sizing="expand" onTap={chooseOp("-")} />
  </Row>
  <Row#row4 gap=8>
    <Button#bClear label="C" sizing="expand" onTap={clearAll()} />
    <Button#b0 label="0" sizing="expand" onTap={inputDigit("0")} />
    <Button#bDot label="." sizing="expand" onTap={inputDot()} />
    <Button#bAdd label="+" sizing="expand" onTap={chooseOp("+")} />
  </Row>
  <Button#bEquals label="=" onTap={pressEquals()} />
</Column>
