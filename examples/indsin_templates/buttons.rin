<!-- indsin/main.indsin — قالب "أزرار" جاهز (محرّك indsin، @view.*) -->
<warp tapCount={0} />
<Rin>
fun bump() { tapCount = tapCount + 1; }
</Rin>
<Column#root padding=16 gap=14>
  <Text#heading text="معرض الأزرار" size="title" />
  <Text#lbl1 text="زر أساسي (Filled)" size=12 />
  <Button#btnPrimary label="زر أساسي" bg="#7c5cff" color="#ffffff" radius=12 />
  <Text#lbl2 text="زر بإطار (Outline)" size=12 />
  <Button#btnOutline label="زر بإطار" variant="outline" tone="primary" radius=12 />
  <Text#lbl3 text="زر مُعطَّل (Disabled)" size=12 />
  <Button#btnDisabled label="زر معطّل" state="disabled" radius=12 />
  <Text#lbl4 text="زر أيقونة" size=12 />
  <Button#btnIcon label="🔔 تنبيه" radius=20 />
  <Text#lbl5 text="زر عدّاد تفاعلي" size=12 />
  <Button#btnCounter label="اضغط هنا" onTap={bump()} radius=12 />
  <Text#counterOut text={"تم الضغط " + tapCount + " مرة"} size=14 />
</Column>
