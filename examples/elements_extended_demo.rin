<!-- examples/elements_extended_demo.rin — the ready-elements expansion (docs/RIN_ELEMENTS.md): -->
<!-- link/radio/slider/search/select/file/date/time/code_editor/calculator + an RTL row. -->
<!-- Same three-layer split every other Loop demo uses: @container owns behavior, @loop owns -->
<!-- geometry/colors/sizes, @element only describes semantic components + functional data. -->
<Container#app>
  <Element.button#saveBtn text="حفظ" />
  <Element.button#cancel text="إلغاء" />
  <Rin>
    on.saveBtn.click=saveForm();
  </Rin>
</Container>
<Rin>
fun saveForm() {
    print "Saved";
}
</Rin>
<Loop#canvas width=390 height=900 background="#ffffff" element_width=320 element_height=44 element_color="#111111" element_text_size=16>
  <Element.text#title text="Ready Elements" />
  <!-- Row (right-to-left): "save" sits flush right, "cancel" follows to its left — reading -->
  <!-- order for Arabic UIs, with no reordering of the children and no gap/align changes. -->
  <Element.row#actions direction="rtl">
    <Element.button#saveBtn text="حفظ" />
    <Element.button#cancel text="إلغاء" />
  </Element.row>
  <Element.link#more text="مزيد من المعلومات" />
  <Element.radio#optionA label="خيار أ" checked=true />
  <Element.radio#optionB label="خيار ب" />
  <Element.slider#volume min=0 max=100 value=40 />
  <Element.search#search placeholder="بحث..." />
  <Element.select#country placeholder="اختر الدولة" />
  <Element.file#attachment placeholder="لم يتم اختيار ملف" />
  <Element.date#dueDate placeholder="اختر التاريخ" />
  <Element.time#dueTime placeholder="اختر الوقت" />
  <Element.code_editor#snippet value={"print \"مرحبا\";"} />
  <Element.calculator#calc />
</Loop>
