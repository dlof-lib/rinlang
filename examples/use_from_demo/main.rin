<!-- ============================================================================ -->
<!-- examples/use_from_demo/main.rin -->
<!-- See docs/cross-file-containers.md: `use A, B from "file.rin";` is not real -->
<!-- Rin syntax (there is no named/selective import), and a previously-defined -->
<!-- @view cannot be called again later by bare name as a reusable component. -->
<!-- @import is the only real cross-file mechanism, and it simply runs the whole -->
<!-- target file inline -- so everything sidebar.rin defines (fun/@container) -->
<!-- becomes directly usable here after the @import line. -->
<!-- ============================================================================ -->
<Import src="examples/use_from_demo/sidebar.rin" />
<Scaffold#page>
  <Row#top role="topbar">
    <Text#title text="My App" />
  </Row>
  <Column#sidebar width=220 bg="#0F0F14">
    <Text#sidebarTitle text={sidebarLabel()} />
    <Text#navHome text="Home" />
    <Text#navSettings text="Settings" />
  </Column>
  <Column#content role="content">
    <Text#hello text="Hello!" />
  </Column>
</Scaffold>
<Rin>
print "sidebar open:", container.get("SidebarState", "open");
</Rin>
