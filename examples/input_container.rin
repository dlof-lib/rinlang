// input_container.rin — الإدخال داخل الحاويات: نموذج حقول، setState/on update، وإبقاء القيمة الحالية بـ Enter
@container=Profile
    state name = "Ali";
    state age = 30;
    let subscribed = false;
    let tags = [1, 2];
    on update(prev) { print "[hook] changed, prev=" + prev; }
.end/container

// وضع النموذج: يسأل name/age/subscribed (مرتبة أبجدياً) ويتخطى tags
let snap = input("Profile> ", "Profile");
print getField("Profile", "name") + "," + getField("Profile", "age") + "," + getField("Profile", "subscribed");
print snap.age + 1;
// Enter يُبقي القيمة الحالية
input("name2? ", "Profile", "name");
inputNumber("age2? ", "Profile", "age");
print getField("Profile", "name") + "," + getField("Profile", "age");
