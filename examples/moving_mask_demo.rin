// ============================================================================
//  examples/moving_mask_demo.rin — مثال تشغيلي شامل لمكتبة lib/movingmask.og.rin
//  شغّله بـ: rin examples/moving_mask_demo.rin
// ============================================================================

@import "lib/movingmask.og.rin";

print "=== 1) محرّك + حدود + ارتداد عند الحافة ===";
let world = mm_new();
mm_setBounds(world, 0, 0, 100, 100);

let bounceLog = [];
fun onBounce(payload) { push(bounceLog, payload); }
mm_on(world, "bounce", onBounce);

mm_spawn(world, "ball", 90, 50);
mm_setVelocity(world, "ball", 20, 0);
mm_runLoop(world, 3, 1, true, nil);
print "موضع الكرة بعد 3 دورات: " + toString(mm_position(world, "ball"));
print "عدد الارتدادات المُسجَّلة: " + toString(len(bounceLog));


print "\n=== 2) نقاط طريق (waypoints) ===";
mm_spawn(world, "guard", 0, 0);
mm_setPath(world, "guard", [{x: 10, y: 0}, {x: 10, y: 10}, {x: 0, y: 10}], true);
let steps = 0;
while (steps < 8) {
    mm_followPath(world, "guard", 4);
    steps = steps + 1;
}
print "موضع الحارس بعد 8 خطوات على مسار حلقي: " + toString(mm_position(world, "guard"));


print "\n=== 3) دورية بين نقطتين (patrol) ===";
mm_spawn(world, "sentry", 0, 0);
let p = 0;
while (p < 6) {
    mm_patrol(world, "sentry", 0, 0, 20, 0, 7);
    print "  دورية خطوة " + toString(p) + ": " + toString(mm_position(world, "sentry"));
    p = p + 1;
}


print "\n=== 4) التكامل مع الحاويات (منطقي + جسر فعلي) ===";
@container="hud"
mask = "hud-root";
.end/container

mm_spawn(world, "player", 5, 5);
mm_attach(world, "player", "teamA");
print "أعضاء teamA: " + toString(mm_membersOf(world, "teamA"));

mm_syncToNativeContainer(world, "player", "hud");
print "قراءة موضع اللاعب من حاوية hud الفعلية: (" + toString(getField("hud", "mm_x")) + ", " + toString(getField("hud", "mm_y")) + ")";


print "\n=== 5) قناع منزلق فوق مصفوفة (1D) ===";
let samples = [3, 7, 2, 8, 5, 9, 1];
print "المتوسط المنزلق (نافذة 3، أصلية movingAverage): " + toString(movingAverage(samples, 3));
print "المجموع المنزلق (نافذة 3): " + toString(mm_movingSum(samples, 3));
print "أقصى قيمة منزلقة (نافذة 3): " + toString(mm_movingMax(samples, 3));
print "كاشف حواف بسيط (kernel [1,0,-1]): " + toString(mm_convolve1D(samples, [1, 0, -1]));


print "\n=== 6) قناع منزلق فوق شبكة (2D) — بلور وختم قطعة ===";
let grid = [
    [10, 10, 10, 10],
    [10, 90, 90, 10],
    [10, 90, 90, 10],
    [10, 10, 10, 10]
];
let blurKernel = [[1/9, 1/9, 1/9], [1/9, 1/9, 1/9], [1/9, 1/9, 1/9]];
let blurred = mm_convolve2D(grid, blurKernel, -1);
print "الشبكة بعد بلور 3×3 (الحواف = -1):";
print blurred;

let board = [
    [".", ".", ".", "."],
    [".", ".", ".", "."],
    [".", ".", ".", "."],
    [".", ".", ".", "."]
];
let piece = [["#", "#"], ["#", "#"]];
mm_gridStamp(board, piece, 0, 0, nil);
print "اللوحة بعد ختم قطعة 2×2 عند (0,0):";
print board;
mm_gridMoveStamp(board, piece, 0, 0, 2, 2, nil, ".");
print "اللوحة بعد تحريك نفس القطعة إلى (2,2):";
print board;


print "\n=== 7) أثر الحركة والتصادم بين قناعين ===";
mm_spawn(world, "a", 0, 0);
mm_spawn(world, "b", 4, 3);
print "المسافة بين a و b: " + toString(mm_distanceTo(world, "a", "b"));
print "هل يتصادمان (صندوق 5×5 لكل منهما)؟ " + toString(mm_collidesAABB(world, "a", 5, 5, "b", 5, 5));

print "\n=== 8) التكامل مع Loom (Warp / Strand / Fabric / Needle / Shuttle) ===";

// -- Warp: تصدير حالة "a" كحقول جاهزة لخلايا warp --
print "أسماء خلايا warp المقترحة لـ a: " + toString(mm_warpFieldNames("a"));
print "حقول a الحالية: " + toString(mm_warpFields(world, "a", nil));
// في ملف .rin حقيقي تُعلن الخلايا مرة واحدة، ثم تُسند كل دورة من الحقول أعلاه، مثلاً:
//   warp a_x = 0; warp a_y = 0;
//   a_x = mm_warpFields(world, "a", nil)["x"];
//   a_y = mm_warpFields(world, "a", nil)["y"];

// -- Strand: تسمية بصرية اختيارية --
mm_setStrandKind(world, "player", "Icon");
mm_setStrandKind(world, "hud", "Card");
print "نوع player البصري المُقترَح: " + mm_strandKind(world, "player");

// -- Fabric: لقطة مسطَّحة بكل الأقنعة --
print "لقطة Fabric لكل الأقنعة الحالية:";
print mm_toFabric(world);

// -- Needle: اختبار إصابة نقطة لمس --
let tapLog = [];
fun onNeedleTap(payload) { push(tapLog, payload); }
mm_on(world, "needleTap", onNeedleTap);
let hitName = mm_dispatchNeedle(world, 5, 5, 3);
print "أقرب قناع لنقطة لمس (5,5) بنصف قطر 3: " + toString(hitName);
print "عدد أحداث needleTap المُسجَّلة: " + toString(len(tapLog));

// -- Shuttle: مقارنة لقطتين وإنتاج Patch[] --
let before = mm_snapshot(world);
mm_translate(world, "a", 50, 0);
mm_destroy(world, "b");
mm_spawn(world, "c", 1, 1);
let patches = mm_shuttleDiff(world, before);
print "Patches بين اللقطتين (Insert/Remove/Move):";
print patches;

print "\n=== 9) توسعة Loom: Actions / Navigation / Overlay / Dye / Theme / Object Inspector ===";

// -- Actions: فعل جاهز مبني + فعل مخصَّص مُسجَّل --
mm_applyAction(world, "player", "teleport", { x: 9, y: 9 });
print "موضع player بعد فعل teleport: " + toString(mm_position(world, "player"));
fun healAction(mmRef, name, payload) {
    mm_setMeta(mmRef, name, "hp", payload["amount"]);
    return true;
}
mm_defineAction(world, "heal", healAction);
mm_applyAction(world, "player", "heal", { amount: 100 });
print "hp بعد فعل heal مخصَّص: " + toString(mm_getMeta(world, "player", "hp", 0));

// -- Navigation: مشهدان (menu/game) مبنيان فوق الوسوم --
// (ملاحظة: مشهد لا يُدار إلا بعد أول mm_navigate/mm_navReplace إليه؛ لذا نُعرِّف المشهدين
//  أولاً بزيارة كل واحد مرة، ثم نُظهر التبديل الفعلي بينهما)
mm_addTag(world, "guard", "menu");
mm_addTag(world, "sentry", "game");
mm_navigate(world, "game");
mm_navigate(world, "menu");
print "نشاط guard/sentry داخل مشهد menu: " + toString(mm_isActive(world, "guard")) + " / " + toString(mm_isActive(world, "sentry"));
mm_navigate(world, "game");
print "نشاط guard/sentry داخل مشهد game: " + toString(mm_isActive(world, "guard")) + " / " + toString(mm_isActive(world, "sentry"));
mm_navBack(world);
print "بعد mm_navBack، المشهد الحالي: " + mm_currentScene(world);

// -- Overlay: قناع علوي يُصاب قبل غيره حتى لو لم يكن الأقرب --
mm_setActive(world, "sentry", true);
mm_setPosition(world, "sentry", 4, 4);
mm_spawn(world, "tooltip", 4, 4);
mm_setOverlay(world, "tooltip", true);
let topHit = mm_needleHitTopmost(world, 4, 4, 3);
print "إصابة طبقة علوية عند (4,4): " + toString(topHit["name"]);

// -- Dye + Theme: لون مباشر، ولون مُشتق من Theme نشط --
mm_defineTheme(world, "Midnight", { primary: "#7C5CFF", danger: "#D14545" });
mm_setActiveTheme(world, "Midnight");
mm_setColor(world, "player", mm_themeColor(world, "primary", "#000000"));
print "لون player من Theme النشط: " + mm_color(world, "player", "#000000");

// -- Object Inspector: بطاقة فحص كاملة لقناع واحد --
print "بطاقة فحص player:";
print mm_toObjectInspector(world, "player");

print "\n--- ملخص العالم النهائي ---";
print mm_summary(world);
