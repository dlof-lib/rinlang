// template_strings_demo.rin — النصوص القالبية: ضع المتغيّر داخل النص مباشرةً
// التشغيل:  rin run examples/template_strings_demo.rin
//
// القاعدة بسيطة:
//   1) اكتب النص بين علامتين ` ` (backtick) بدل " "
//   2) ضع أي متغيّر أو عملية داخل ${ ... }

// 1) متغيّر داخل نص
let name = "ريم";
print `مرحباً ${name}!`;

// 2) عمليات حسابية
let price = 25;
let qty = 3;
print `الإجمالي: ${price * qty} ريال`;

// 3) استدعاء دالة
fun double(x) { return x * 2; }
print `ضعف ${qty} هو ${double(qty)}`;

// 4) عناصر المصفوفة والقاموس
let fruits = ["تفاح", "موز"];
let user = {"city": "بيروت"};
print `أول فاكهة: ${fruits[0]} — المدينة: ${user["city"]}`;

// 5) شرط داخل النص
let age = 17;
print `الحالة: ${age >= 18 ? "بالغ" : "قاصر"}`;

// 6) عدة أسطر
print `السطر الأول
السطر الثاني: ${name}`;

// 7) طباعة علامة $ أو ` حرفياً: ضع \ قبلها
print `اكتب \${name} لعرض المتغيّر، و \` لعرض علامة backtick`;

// 8) النص العادي " " لا يتغيّر أبداً
print "هذا ${name} يبقى كما هو";

// 9) تخزينه في متغيّر واستعماله لاحقاً
let msg = `${name} عمرها ${age}`;
print len(msg);

// ───────────── تنسيق القيم:  ${القيمة:التنسيق} ─────────────
let total = 1234.5;
print `السعر: ${total:.2f}`;          // 1234.50   (خانتان عشريتان)
print `السعر: ${total:,.2f}`;         // 1,234.50  (فاصل آلاف)
print `رقم الفاتورة: ${7:05}`;        // 00007     (أصفار من اليسار)
print `النسبة: ${0.256:.1%}`;         // 25.6%
print `[${name:>8}] [${name:<8}] [${name:^8}]`; // محاذاة يمين / يسار / وسط
print `${"hello":upper} ${"HELLO":lower} [${"  x  ":trim}]`;

// ───────────── قيمة افتراضية:  ${متغيّر ?? بديل} ─────────────
let nick = nil;
print `أهلاً ${nick ?? "زائر"}`;       // أهلاً زائر  (لأن nick = nil)
print `أهلاً ${name ?? "زائر"}`;       // أهلاً ريم

// ───────────── قيم جاهزة:  ${#اسم} ─────────────
print `اليوم ${#date} الساعة ${#time}`;
print `Rin v${#version} — ${#file}:${#line}`;

// ───────────── متقدّم ─────────────
let digits = 3;
print `دقة ديناميكية: ${3.14159265:.${digits}f}`;     // 3.142
print `[${42:*^10}] [${255:x}] [${5:b}] [${"abcdef":.3}]`;
print `بالعربية: ${1234.5:,.2f|ar}`;                  // ١٬٢٣٤٫٥٠
print `تصحيح: ${total=} ${total * 2=}`;               // total=1234.5 total * 2=2469
print `سلسلة مراحل: [${"  hi ":trim|upper|>6}]`;
print `\u{1F600} \u{0645}\u{0631}\u{062D}\u{0628}\u{0627}`;

// ───────────── قوالب وقت التشغيل: render(نص, بيانات) ─────────────
let data = {"user": {"name": "ريم", "tags": ["a", "b"]}, "total": 1234.5};
let tpl = "مرحباً ${user.name}! مجموعك ${total:,.2f} — وسمك ${user.tags.1} — عمرك ${user.age ?? 18}";
print render(tpl, data);

// ───────────── داخل مفاهيم اللغة: الأحداث والترجمات ─────────────
@container=Chat
    let room = "general";
    on.event `chat:${room}` (msg) { print `[${room}] وصلت: ${msg}`; }

    @container=Sender
        fun send(msg) { emit `chat:general`, msg; }
        send("أهلاً بالجميع");
    .end/container

    Translations
        translation lang="ar" text=`مرحباً في غرفة ${room}`;
        translation lang="en" text=`Welcome to ${room}`;
    .end/Translations
.end/container
