// template_strings_demo.rin — النصوص القالبية: ضع المتغيّر داخل النص مباشرةً
// التشغيل:  rin run examples/template_strings_demo.rin
//
// القاعدة بسيطة:
//   1) اكتب النص بين علامتين ` ` (backtick) بدل " "
//   2) ضع أي متغيّر أو عملية داخل ${ ... }

// 1) متغيّر داخل نص
let name = "ريم";
print `مرحباً ${name}!`;

// 2) عمليات حسابية
let price = 25;
let qty = 3;
print `الإجمالي: ${price * qty} ريال`;

// 3) استدعاء دالة
fun double(x) { return x * 2; }
print `ضعف ${qty} هو ${double(qty)}`;

// 4) عناصر المصفوفة والقاموس
let fruits = ["تفاح", "موز"];
let user = {"city": "بيروت"};
print `أول فاكهة: ${fruits[0]} — المدينة: ${user["city"]}`;

// 5) شرط داخل النص
let age = 17;
print `الحالة: ${age >= 18 ? "بالغ" : "قاصر"}`;

// 6) عدة أسطر
print `السطر الأول
السطر الثاني: ${name}`;

// 7) طباعة علامة $ أو ` حرفياً: ضع \ قبلها
print `اكتب \${name} لعرض المتغيّر، و \` لعرض علامة backtick`;

// 8) النص العادي " " لا يتغيّر أبداً
print "هذا ${name} يبقى كما هو";

// 9) تخزينه في متغيّر واستعماله لاحقاً
let msg = `${name} عمرها ${age}`;
print len(msg);
