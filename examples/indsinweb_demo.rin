<!-- ============================================================================ -->
<!-- IndsinWeb demo — WebView + safe links inside an indsin @container -->
<!-- ============================================================================ -->
<Import src="lib/indsinweb.og.rin" />
<Container#IndsinWebDemo>
  <warp site={"youtube.com/watch?v=dQw4w9WgXcQ"} />
  <warp untrusted={"javascript:alert(1)"} />
  <warp address={"how to learn rin"} />
  <Column#Root padding=16 gap=12>
    <Text#Title text="IndsinWeb" size="title" />
    <WebView#Player url={iwEmbedUrl(iwNormalize(site))} ratio="16:9" />
    <WebView#Browser url={iwResolveInput(address, {"engine": "duckduckgo"})["url"]} height=220 />
    <WebView#Card html={iwFragment(iwCardHtml("Rin", "لغة واجهات", "https://dlof-lib.github.io/rinlang/", ""), {"theme": "dark", "padding": 8})} height=110 />
    <WebView#VideoScreen html={iwLinkScreen(site, {"lang": "ar"})} height=360 />
    <WebView#PageScreen html={iwLinkScreen("https://dlof-lib.github.io/rinlang/", {"lang": "ar", "theme": "light"})} height=260 />
    <WebView#Links html={iwFragment(iwLinkHtml("Rin library", iwRinLibrary("majd", "math")) + " · " + iwLinkHtml("Mail", iwMailto("hi@example.com", {"subject": "مرحبا"})) + " · " + iwLinkHtml("Blocked", untrusted), {"dir": "rtl", "padding": 12})} height=80 />
  </Column>
</Container>
