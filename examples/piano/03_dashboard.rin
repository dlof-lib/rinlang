// piano — لوحة بيانات: أعمدة + خطوط + دونات + رادار + مقياس + خط مصغّر
@import "piano";

let c = pn_canvas(900, 560);
pn_theme(c, "dark");
pn_title(c, "لوحة مؤشرات");
let card = {"fill": "#111a33", "stroke": "#1e293b", "sw": 1};

pn_rrect(c, 20, 20, 520, 270, 14, card);
pn_bar_chart(c, 30, 24, 500, 262, ["يناير", "فبراير", "مارس", "أبريل", "مايو"],
             [[12, 19, 14, 22, 27], [8, 11, 16, 13, 19]], {"title": "المبيعات", "names": ["2025", "2026"], "rx": 4});

pn_rrect(c, 560, 20, 320, 270, 14, card);
pn_pie_chart(c, 720, 165, 90, ["أ", "ب", "ج", "د"], [40, 25, 20, 15], {"inner": 0.62, "gap": 3, "center": "100"});
pn_text(c, 580, 48, "الحصص", {"size": 15, "weight": 700});

pn_rrect(c, 20, 310, 520, 230, 14, card);
pn_line_chart(c, 30, 314, 500, 222, ["س1", "س2", "س3", "س4", "س5", "س6"],
              [[3, 9, 6, 14, 11, 18], [2, 5, 8, 7, 12, 10]], {"title": "النمو", "smooth": true, "area": true, "names": ["مستخدمون", "طلبات"]});

pn_rrect(c, 560, 310, 150, 230, 14, card);
pn_gauge(c, 635, 440, 52, 72, 100, {"label": "الأداء", "color": "#34d399"});
pn_sparkline(c, 580, 480, 110, 40, [4, 7, 5, 9, 8, 12, 10, 15], {"color": "#22d3ee"});

pn_rrect(c, 730, 310, 150, 230, 14, card);
pn_radar_chart(c, 805, 430, 40, ["سرعة", "جودة", "سعر", "دعم", "أمان"], [[8, 7, 5, 9, 6]], {"max": 10});
pn_save(c, "examples/piano/out/03_dashboard.svg");
pn_save(c, "examples/piano/out/03_dashboard.puo");
