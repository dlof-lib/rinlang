// piano — معرض الأشكال: نجوم ومضلعات وحلزون وموجة وسهم وشبكة
@import "piano";

let c = pn_canvas(640, 360);
pn_theme(c, "light");
pn_grid(c, 0, 0, 640, 360, 20, {"op": 0.6});

pn_star(c, 90, 90, 5, 55, 24, {"fill": "#f59e0b", "stroke": "#b45309", "sw": 3, "join": "round", "rot": 8});
pn_ngon(c, 230, 90, 6, 50, {"grad": ["#06b6d4", "#4f46e5"], "angle": 45, "shadow": true});
pn_ngon(c, 360, 90, 3, 55, {"fill": "#ef4444", "rot": 20});
pn_ring(c, 490, 90, 28, 55, -90, 150, {"fill": "#10b981"});
pn_slice(c, 590, 90, 45, -30, 200, {"fill": "#8b5cf6"});

pn_spiral(c, 90, 250, 70, 3.5, {"stroke": "#ec4899", "sw": 2.5});
pn_wave(c, 190, 250, 200, 28, 2.5, {"stroke": "#0284c7"});
pn_wave(c, 190, 250, 200, 14, 5, {"stroke": "#4f46e5", "sw": 2, "dash": [6, 5]});
pn_arrow(c, 430, 300, 610, 200, {"stroke": "#111827", "sw": 3, "head": 16});
pn_smooth(c, [[430, 330], [480, 290], [530, 335], [585, 300], [620, 340]], {"stroke": "#10b981", "sw": 4});
pn_text(c, 320, 345, "pn_star · pn_ngon · pn_ring · pn_slice · pn_spiral · pn_wave · pn_arrow", {"size": 11, "anchor": "middle", "fill": "#6b7280"});
pn_save(c, "examples/piano/out/02_shapes.svg");
pn_save(c, "examples/piano/out/02_shapes.puo");
