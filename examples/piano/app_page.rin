// piano + container.app: صفحة ويب بهوية كاملة (title/SEO/OG/أيقونات/manifest/JSON-LD) حول مشهد piano
// التشغيل من جذر المشروع:  rin examples/piano/app_page.rin   → _piano_app/index.html
@import "piano";
@container.app=piano_demo
    let name = "لوحة بيانو";
    let version = "1.0.0";
    let lang = "ar";
    let homepage = "https://rinlang.dev/piano-demo/";
    let description = "مشهد متجهي مرسوم بمكتبة piano ومُصدَّر كصفحة ويب جاهزة لمحركات البحث.";
    let theme_color = "#12121c";
    let icons = {"192": "icons/192.png", "512": "icons/512.png"};
    let seo = {title: "لوحة بيانو — رسم متجهي بلغة Rin", keywords: ["piano", "SVG", "Rin"]};
.end/container.app

let c = pn_canvas(480, 270);
pn_theme(c, "dark");
pn_circle(c, 240, 135, 80, {"grad": ["#818cf8", "#22d3ee"], "shadow": true});
pn_text(c, 240, 142, "piano", {"size": 34, "anchor": "middle", "weight": 700});
pn_app_apply(c, "piano_demo");                                   // <title> داخل SVG
print pn_app_save(c, "_piano_app", "piano_demo", {"favicon_scene": true, "paths": ["/"]});
