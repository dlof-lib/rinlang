# Rin Loop System
# each: تكرار على العناصر
# repeat: تكرار بعدد محدد
# loop: تكرار طالما الشرط صحيح

let names = ["Rin", "Loom", "Container"];

each name in names {
    print name;
}

repeat 3 {
    print "tick";
}

let i = 0;
loop (i < 5) {
    print i;
    i = i + 1;
}

let n = 0;
repeat 20 {
    n = n + 1;
    if (n == 3) { continue; }
    if (n == 8) { break; }
}

print n;
