// Rin Loop System
// for (let x in arr): تكرار على العناصر
// for (init; cond; step): تكرار بعدد محدد على طراز C
// while: تكرار طالما الشرط صحيح

let names = ["Rin", "Loom", "Container"];

for (let name in names) {
    print name;
}

for (let k = 0; k < 3; k = k + 1) {
    print "tick";
}

let i = 0;
while (i < 5) {
    print i;
    i = i + 1;
}

let n = 0;
while (n < 20) {
    n = n + 1;
    if (n == 3) { continue; }
    if (n == 8) { break; }
}

print n;
