<!-- indsin_media_demo.rin — اختيار صورة ومعاينتها ثم رفعها (docs/indsin_media.md) -->
<warp photo={""} />
<Column#root padding=16 gap=12>
  <Text#title text="رفع صورة" />
  <Image#preview src={photo} width=240 height=240 alt="الصورة المختارة" />
  <Text#info text={photo_name} />
  <Text#sizeInfo text={photo_sizeText} />
  <Button#choose label="اختيار صورة" onTap={pickMedia("image", photo, false, 10)} />
  <Button#shoot label="التقاط بالكاميرا" onTap={pickMedia("camera", photo, false, 10, 1600, 80)} />
  <Button#send label="رفع" onTap={uploadMedia(photo, "https://example.com/upload", "file", "", 3)} />
  <Text#status text={photo_status} />
  <Text#pct text={photo_progress} />
  <Text#attempt text={photo_attempt} />
  <Button#stop label="إيقاف" onTap={cancelUpload(photo)} />
  <Text#err text={photo_error} />
  <Button#clear label="مسح" onTap={clearMedia(photo)} />
</Column>
