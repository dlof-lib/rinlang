<!-- indsin_button_library_demo.rin — Rin Indsin's Button component: variants, sizes, states, a11y. -->
<!-- Run: ./indsinc samples/indsin_button_library_demo.rin -->
<!-- Note: attribute values here are quoted string literals throughout (tone="primary", not -->
<!-- tone=primary) even where the identifier form would also parse -- this sidesteps any future -->
<!-- collision with a reserved Rin keyword (e.g. variant="link" -- 'link' is already a keyword -->
<!-- for the container-linking statement, so the unquoted identifier form does NOT parse there). -->
<warp busy={false} />
<Column#root gap="normal" padding="comfortable">
  <Row#variants gap="compact">
    <Button#b1 label="Primary" tone="primary" />
    <Button#b2 label="Outline" tone="primary" variant="outline" />
    <Button#b3 label="Ghost" tone="danger" variant="ghost" />
    <Button#b4 label="Link" tone="info" variant="link" />
    <Button#b5 label="Glass" tone="success" variant="glass" />
    <Button#b6 label="Gradient" tone="primary" variant="gradient" />
  </Row>
  <Row#sizes gap="compact">
    <Button#xs label="XS" tone="secondary" size="xs" />
    <Button#sm label="Small" tone="secondary" size="small" />
    <Button#md label="Medium" tone="secondary" size="medium" />
    <Button#lg label="Large" tone="secondary" size="large" />
    <Button#xl label="XL" tone="secondary" size="xl" />
  </Row>
  <Row#states gap="compact">
    <Button#normal label="Save" tone="primary" onTap={toggle(busy)} />
    <Button#disabled label="Save" tone="primary" disabled=true onTap={toggle(busy)} />
    <Button#loading label="Saving" tone="primary" loading=true />
    <Button#selected label="Selected" tone="primary" variant="outline" state="selected" />
    <Button#a11y label="Save document" tone="primary" a11y_label="Save the current document to disk" />
  </Row>
</Column>
