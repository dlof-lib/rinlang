<!-- indsin_showcase.rin — جولة سريعة على محرّك العرض Indsintime (Rendering Engine) الجديد. -->
<!-- امتداد إضافي بحت فوق لغة الحاويات: warp لخلايا الحالة التفاعلية، @view.<Kind>=name -->
<!-- لأشجار الواجهة (Column/Row/Stack/Card/Text/Button/Image/Divider مبدئياً، وأي وسم آخر -->
<!-- يُحلّ لاحقاً عبر نظام الإضافات Bolt). شغّله عبر أداة indsinc (انظر CMakeLists.txt) أو من -->
<!-- خلال RinEngine.renderView(source) على جانب Kotlin. -->
<warp count={0} />
<Column#root gap=16 padding=20>
  <Card#header padding=16 shadow=10>
    <Text#title text="Welcome to Rin" size=22 />
    <Text#subtitle text="Indsintime rendering engine" size=14 color="#8b899c" />
  </Card>
  <Row#actions gap=12>
    <Button#cta label="Continue" />
    <Button#incBtn label="Tap to increment" onTap={increment(count)} />
  </Row>
  <Card#counter padding=16 gradient="#2c2140,#241a30">
    <Text#countText text={"Count: " + count} size=18 />
  </Card>
  <Row#media gap=10>
    <Image#thumb src="poster.png" width=120 height=72 />
    <Card#blurCard padding=14>
      <Text#blurLabel text="Effects: shadow / gradient / color" size=12 color="#c9c6dd" />
    </Card>
  </Row>
</Column>
