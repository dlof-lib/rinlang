<!-- indsin_missing_components_demo.rin — Grid, Wrap, Spacer, Box (Container), Badge, Progress, -->
<!-- Checkbox, Switch, Avatar, Input, TextArea, Dialog, Tabs/TabItem, Tooltip — all composed -->
<!-- through the same @view.<Tag> pipeline every other Indsin Strand goes through. -->
<!-- Run: ./indsinc samples/indsin_missing_components_demo.rin -->
<warp dialogOpen={false} />
<warp activeTab={"home"} />
<Column#root gap="comfortable" padding="comfortable">
  <Box#intro padding="comfortable">
    <Text#hello text="Rin Indsin — missing components" size="title" />
  </Box>
  <!-- Row + Spacer: a toolbar with the actions pinned to the far right. -->
  <Row#toolbar>
    <Text#title text="Dashboard" size="subtitle" />
    <Spacer#push />
    <Button#openDialog label="New item" tone="primary" onTap={toggle(dialogOpen)} />
  </Row>
  <!-- Tabs: a Row of TabItem, highlighted via the same state="selected" every other Strand uses. -->
  <View.Tabs#tabs>
    <TabItem#tabHome label="Home" variant="ghost" state="selected" />
    <TabItem#tabSettings label="Settings" variant="ghost" />
  </View.Tabs>
  <!-- Grid: a 3-column card grid. -->
  <Grid#cards columns=3 gap="normal">
    <Box#c1 padding="normal">
      <Text#t1 text="Card 1" />
    </Box>
    <Box#c2 padding="normal">
      <Text#t2 text="Card 2" />
    </Box>
    <Box#c3 padding="normal">
      <Text#t3 text="Card 3" />
    </Box>
  </Grid>
  <!-- Wrap: tags that flow onto new lines instead of overflowing. -->
  <Wrap#tags gap="compact">
    <View.Badge#tag1 text="design-system" tone="primary" />
    <View.Badge#tag2 text="indsin" tone="success" />
    <View.Badge#tag3 text="rin" tone="info" />
  </Wrap>
  <!-- Form controls: Input, TextArea, Checkbox, Switch, Progress, Avatar. -->
  <Column#form gap="normal">
    <Input#name placeholder="Full name" />
    <TextArea#bio placeholder="Short bio..." />
    <Row#toggles gap="normal">
      <Checkbox#agree checked=false onTap={toggle(dialogOpen)} />
      <Switch#notify checked=true />
      <Avatar#me size="medium" initials="RL" />
    </Row>
    <Progress#upload value=62 />
  </Column>
  <Tooltip#hint text="Progress updates automatically." />
  <!-- Dialog: collapses to zero size until open=true (bound to the same warp cell the -->
  <!-- "New item" button toggles above). -->
  <Dialog#confirm open={dialogOpen} padding="spacious">
    <Text#confirmTitle text="Create new item?" size="title" />
    <Row#confirmActions gap="compact">
      <Button#cancel label="Cancel" variant="ghost" onTap={toggle(dialogOpen)} />
      <Button#confirmBtn label="Create" tone="primary" onTap={toggle(dialogOpen)} />
    </Row>
  </Dialog>
</Column>
