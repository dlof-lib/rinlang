<!-- الخطوط · حركة النص · إمكانية الوصول — مثال كامل بكل المفاهيم الجديدة
     الدليل: docs/indsin_typography_motion_a11y.md · التشغيل: ./indsinc samples/indsin_typography_motion_a11y.rin -->

<!-- ═════════ CustomFont · FontLoad · FontDisplay · VariableFont (إعلان الخطوط في أعلى الملف) ═════════ -->
<Font#Brand src="fonts/brand.woff2, fonts/brand.ttf" weight="100 900" display=swap axes="wght 100 900, wdth 75 125" />
<Font#Mono  src="fonts/mono.woff2" load=lazy display=optional />
<Font#Kufi  src="fonts/kufi.woff2" load=preload display=block />

<warp tagline="Fast" />

<!-- LanguageTag: lang على الجذر (يرث) → dir=rtl تلقائياً للغات RTL -->
<Column#root lang="en" gap=16 padding=comfortable>

  <!-- ═════════ SemanticText + AccessibleName ═════════ -->
  <Text#title semantic=heading heading_level=1 font="Brand, system" weight=800
        text_transform=uppercase text_shadow="0 2 6 #00000055"
        text_animation="fade-in" text_duration=800>Typography · Motion · A11y</Text>

  <Text#intro semantic=paragraph font_variant="small-caps" font_feature="liga, kern">
    A readable, accessible, animated text system.
  </Text>

  <!-- ═════════ SystemFont ═════════ -->
  <Row#sys gap=12>
    <Text#sys1 font="system">system-ui</Text>
    <Text#sys2 font="mono">monospace</Text>
    <Text#sys3 font="serif">serif</Text>
    <Text#sys4 font="Helvetica Neue, sans">named</Text>
  </Row>

  <!-- ═════════ FontVariant · FontFeature · VariableFont ═════════ -->
  <Text#var1 font="Brand" font_variation="wght 650, wdth 85">Variable weight 650 / width 85</Text>
  <Text#var2 font="Brand" weight=semibold font_stretch=condensed slant=-8>Condensed semibold slanted</Text>
  <Text#var3 font="Mono" font_variant="tabular-nums" font_feature="'ss01', zero">0123456789 tabular</Text>
  <Text#var4 font_style="oblique 12deg">Oblique 12deg</Text>

  <!-- ═════════ TextTransform ═════════ -->
  <Text#tt1 text_transform=capitalize>capitalize each word</Text>
  <Text#tt2 text_transform=uppercase>straße → STRASSE</Text>
  <Text#tt3 text_transform=uppercase lang="tr">istanbul</Text>
  <Text#tt4 text_transform=full-width>Full width</Text>

  <!-- ═════════ TypeWriter ═════════ -->
  <Text#typer typewriter=true type_speed=14 type_cursor="|" type_cursor_blink=500
        aria_live="off">Rin writes this letter by letter…</Text>

  <!-- ═════════ FadeText ═════════ -->
  <Text#fade1 fade_text="in" text_duration=1200>Fade in as a whole</Text>
  <Text#fade2 fade_text="chars" text_duration=1500>Fade letter by letter</Text>

  <!-- ═════════ TextReveal ═════════ -->
  <Text#rev1 text_reveal="left" text_duration=1200>Revealed from the left</Text>
  <Text#rev2 text_reveal="center" text_duration=1200>Revealed from the center</Text>
  <Text#rev3 text_reveal="words" text_duration=1500>One word at a time</Text>

  <!-- ═════════ TextRotate ═════════ -->
  <Row#rot gap=24>
    <Text#spin text_rotate="spin" text_rotate_duration=3000>spin</Text>
    <Text#tilt text_rotate=-6 text_rotate_to=6 text_rotate_duration=1500>tilt</Text>
  </Row>

  <!-- ═════════ Rotator + TextTransition ═════════ -->
  <Row#rotator gap=6>
    <Text#pre>Build it</Text>
    <Text#words text_rotator="Fast|Simple|Fun" text_rotator_interval=1800
          text_rotator_effect=slide-up text_transition_duration=300 weight=bold></Text>
  </Row>
  <Text#trans text_transition="fade" text_transition_duration=400 text={tagline} />
  <Button#swap height=44 label="Change tagline" onTap={set(tagline, "Accessible")} />

  <!-- ═════════ TextShadowAnimation ═════════ -->
  <Text#glow text_shadow_animation="glow" text_shadow_color="#00E5A0" text_shadow_duration=1600 size=heading>Glow</Text>
  <Text#neon text_shadow_animation="neon" size=heading>Neon</Text>
  <Text#orbit text_animation="orbit" text_amplitude=4 size=heading>Orbit</Text>
  <Text#shadowTo text_shadow="0 0 0 #ff3366" text_shadow_to="0 0 18 #3366ff"
        text_shadow_animation="custom" text_shadow_duration=2000 size=heading>From → To</Text>

  <!-- ═════════ Arabic: كلمات لا حروف + dir=rtl تلقائي ═════════ -->
  <Column#ar lang="ar" gap=8>
    <Text#ar1 font="Kufi, kufi" fade_text="chars" text_duration=1500>مرحباً بك في عالم ريـن</Text>
    <Text#ar2 text_reveal="words" text_duration=1500>نص عربي متحرّك بلا كسر اتصال الحروف</Text>
  </Column>

  <!-- ═════════ AriaLabel · AltText · AccessibleName ═════════ -->
  <Text#emailLabel>Email address</Text>
  <Input#email height=44 aria-labelledby="emailLabel" aria-describedby="hint" placeholder="you@example.com" />
  <Text#hint size=small>We never share your email.</Text>
  <Button#close ariaLabel="Close dialog" label="✕" height=44 />
  <Image#logo alt_text="Rin company logo" src="logo.png" />
  <Image#divider decorative=true src="line.png" />

  <!-- ═════════ ScreenReader: sr_only · aria_hidden · aria_live ═════════ -->
  <Text#skip sr_only=true>Skip to main content</Text>
  <Text#deco aria_hidden=true>★ ★ ★</Text>
  <Text#status aria_live="polite" text={tagline} />

  <!-- ═════════ SemanticText + ReadingOrder ═════════ -->
  <Column#article reading_order="visual">
    <Text#h2 semantic=h2>Section heading</Text>
    <Text#strong semantic=strong>Important sentence.</Text>
    <Text#em semantic=em>Emphasised sentence.</Text>
  </Column>
  <Row#order>
    <Text#second reading_order=2>Read second</Text>
    <Text#first reading_order=1>Read first</Text>
  </Row>
</Column>
