<!-- indsin_tokens_demo.rin — Rin Indsin's Design Tokens + Color Engine, exercised end to end. -->
<!-- Run: ./indsinc samples/indsin_tokens_demo.rin -->
<Rin>
@theme=Midnight
  active=true;
  primary="#7C5CFF";
  danger="#E5484D";
  success="#2FB35B";
  surface="#1C1E2A";
.end/theme
</Rin>
<Column#root gap={normal} padding={comfortable}>
  <Card#alert padding={comfortable} radius={round}>
    <Text#title text="Storage almost full" size={title} />
    <Text#body text="You are using 92% of your space." size={body} />
  </Card>
  <Row#actions gap={compact}>
    <Button#confirm label="Upgrade plan" tone={primary} />
    <Button#cancel label="Dismiss" tone={neutral} />
    <Button#danger label="Delete files" tone={danger} />
  </Row>
</Column>
