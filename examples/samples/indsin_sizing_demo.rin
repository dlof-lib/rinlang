<!-- indsin_sizing_demo.rin — Rin Indsin's Constraint System: sizing="fill", min_width/max_width. -->
<!-- Run: ./indsinc samples/indsin_sizing_demo.rin 500 -->
<Column#root gap="normal" padding="comfortable">
  <Card#hugs padding="compact" tone_debug="auto (hugs content)">
    <Text#t1 text="I hug my content" />
  </Card>
  <Card#fills sizing="fill" padding="compact">
    <Text#t2 text="I fill the full available width" />
  </Card>
  <Card#floored min_width="300" padding="compact">
    <Text#t3 text="short" />
  </Card>
</Column>
