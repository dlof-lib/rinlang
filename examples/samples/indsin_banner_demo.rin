<!-- indsin_banner_demo.rin — Rin Indsin's Banner: title=/message= shorthand, nested actions, closable=. -->
<!-- Run: ./indsinc samples/indsin_banner_demo.rin 420 -->
<Column#root gap="normal" padding="comfortable">
  <Banner#simple tone="info" title="Heads up" message="A new version of Rin is available." />
  <!-- Full composition still works: nested actions (a Row of Buttons), same as before Indsin's -->
  <!-- Banner conveniences existed. Combined here with the title=/message= shorthand too. -->
  <Banner#update tone="success" title="Update ready" message="Version 2.4 is ready to install." closable=true>
    <Row#actions gap="compact">
      <Button#install label="Install now" tone="success" />
      <Button#later label="Later" tone="neutral" variant="ghost" />
    </Row>
  </Banner>
  <!-- Dismissible with no title/message at all -- just an icon-and-text composed by hand, plus -->
  <!-- closable=true doing the rest (auto warp cell + close button + visible= wiring). -->
  <Banner#cookie tone="neutral" closable=true>
    <Text#t text="This site uses cookies." size="body" />
  </Banner>
</Column>
