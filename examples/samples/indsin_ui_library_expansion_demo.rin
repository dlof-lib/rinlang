<!-- indsin_ui_library_expansion_demo.rin — جولة على المكوّنات التسعة الجديدة من توسعة مكتبة -->
<!-- UI/UX: Tag/Chip (قابل للحذف), Kbd, Rating, Skeleton, Spinner, Steps/StepItem, -->
<!-- Timeline/TimelineItem, Breadcrumb, Pagination — كلها تمرّ عبر نفس أنبوب @view.<Tag> الذي -->
<!-- يمر عليه أي Strand آخر (انظر rin_indsin_components_ext.h لمنطق التوليف التلقائي). -->
<!-- شغّله عبر: ./indsinc samples/indsin_ui_library_expansion_demo.rin -->
<Column#root gap="comfortable" padding="comfortable">
  <Text#heading text="UI/UX Library Expansion" size="title" />
  <!-- Breadcrumb: items="..." مفصولة بفواصل -> عناصر Text حقيقية مفصولة بـ "›"، -->
  <!-- آخر عنصر (الصفحة الحالية) بلون text، والباقي بلون text_muted. -->
  <View.Breadcrumb#crumbs items="Home, Projects, Atlas App, Settings" />
  <!-- Tag/Chip: text= يُصنّع تسمية Text، و removable="true" يُصنّع زر إغلاق (×) مربوط -->
  <!-- تلقائيًا بخلية Warp باسم "<name>_visible" — النقر عليه يُخفي الوسم فعليًا (حجمه يصبح صفرًا). -->
  <Row#tags gap="compact">
    <Tag#tagDesign text="Design" tone="primary" />
    <Tag#tagIndsin text="indsin" tone="success" />
    <Tag#tagRemovable text="React" tone="info" removable=true />
  </Row>
  <!-- Kbd: صندوق مفتاح لوحة مفاتيح صغير — مفيد لعرض اختصارات لوحة المفاتيح. -->
  <Row#shortcut gap="compact">
    <Text#shortcutLabel text="Save:" size=13 />
    <Kbd#kbdCtrl text="Ctrl" />
    <Text#plus text="+" size=13 />
    <Kbd#kbdS text="S" />
  </Row>
  <!-- Rating: max=/value= -> نجوم مملوءة/فارغة، للقراءة فقط (سلوك مثل Progress). -->
  <Row#ratingRow gap="compact">
    <Rating#productRating max=5 value=4 />
    <Text#ratingCount text="(128 reviews)" size=12 color="#8b899c" />
  </Row>
  <!-- Skeleton / Spinner: حالتا تحميل — صندوق نائب ثابت، وحلقة تحميل ثابتة (لا أنيميشن -->
  <!-- حقيقي داخل هذا المحرّك؛ انظر الملاحظة الصريحة في rin_indsin_paint.h). -->
  <Row#loadingRow gap="normal">
    <Column#skeletonBlock gap="compact">
      <Skeleton#skTitle width=160 height=18 />
      <Skeleton#skLine width=220 height=12 />
    </Column>
    <Spinner#loadingSpinner size="medium" />
  </Row>
  <!-- Steps/Stepper: current= (0-based) يُحدَّد تلقائيًا حالة كل StepItem -->
  <!-- (done / active / upcoming) وفهرسه. -->
  <Steps#checkoutSteps current=1>
    <StepItem#stepAccount label="Account" />
    <StepItem#stepShipping label="Shipping" />
    <StepItem#stepPayment label="Payment" />
    <StepItem#stepConfirm label="Confirm" />
  </Steps>
  <!-- Timeline/TimelineItem: date=/title=/desc= — كل عنصر صفّ واحد مع نقطة ووصلة. -->
  <Timeline#activityLog>
    <TimelineItem#logDeploy date="09:41" title="Deployed to production" desc="v2.3.0 shipped successfully" />
    <TimelineItem#logReview date="09:12" title="Code review approved" desc="by @teammate" />
    <TimelineItem#logOpen date="08:55" title="Pull request opened" />
  </Timeline>
  <!-- Pagination: current=/total= -> أزرار السابق/مرقّمة/التالي، مربوطة بخلية Warp -->
  <!-- باسم "<name>_page" عبر onTap=set(cell, N) حقيقي (أو bind="cell" لإعادة استخدام خلية موجودة). -->
  <View.Pagination#resultsPager current=2 total=5 />
</Column>
