<!-- ============================================================================= -->
<!-- site.rin — الموقع الرسمي للغة Rin (إعادة تصميم كاملة من الصفر) -->
<!-- ----------------------------------------------------------------------------- -->
<!-- مكتوب بالكامل بلغة Rin + Indsin: صفر HTML وصفر JavaScript في المحتوى. كل وسم أدناه -->
<!-- هو Strand حقيقي يقيسه محرّك Indsintime الرسمي (نفس rin_lexer/rin_parser/rin_interpreter) -->
<!-- ثم يُرسَل كشجرة JSON إلى web/index.html (المحمّل العام) ليرسمها المتصفح. -->
<!--  -->
<!-- البنية: الجزء الأول برنامج Rin كامل يُنفَّذ قبل بناء الواجهة (حاويات NoSQL + for/make)، -->
<!-- والجزء الثاني شجرة Indsin بوسوم الأقواس تقرأ نتائجه عبر خلايا warp. -->
<!--  -->
<!-- هوية التصميم: زمرّدي على حبر داكن · عناوين مرقّمة · كود أحادي الخط · مزاج «طرفية». -->
<!-- الأقسام: hero · stats · why · platforms · tour · indsin · pipeline · learn · -->
<!--          ecosystem · fit · faq · cta · footer -->
<!-- ============================================================================= -->
<Rin>
// ---- برمجة Rin حقيقية تُنفَّذ قبل رسم أي عنصر: حاويات NoSQL تصف هذه الصفحة نفسها ----
@container.doc=siteSections
  document id="s0" fields={ name: "hero", kind: "section" };
  document id="s1" fields={ name: "stats", kind: "section" };
  document id="s2" fields={ name: "why", kind: "section" };
  document id="s3" fields={ name: "platforms", kind: "section" };
  document id="s4" fields={ name: "tour", kind: "section" };
  document id="s5" fields={ name: "indsin", kind: "section" };
  document id="s6" fields={ name: "pipeline", kind: "section" };
  document id="s7" fields={ name: "learn", kind: "section" };
  document id="s8" fields={ name: "ecosystem", kind: "section" };
  document id="s9" fields={ name: "fit", kind: "section" };
  document id="s10" fields={ name: "faq", kind: "section" };
  document id="s11" fields={ name: "cta", kind: "section" };
.end/container.doc
@container.doc=siteTargets
  document id="t0" fields={ name: "CLI",         kind: "platform" };
  document id="t1" fields={ name: "Android",     kind: "platform" };
  document id="t2" fields={ name: "WebAssembly", kind: "platform" };
.end/container.doc
let sectionCount = len(queryDocs("siteSections", "kind", "section"));
let platformCount = len(queryDocs("siteTargets", "kind", "platform"));
// حلقة for + make: تُنشئ حاوية ديناميكية لكل مرحلة من مسار التنفيذ ثم تقرأها رجوعاً بـ getField()
let stages = ["Lexer", "Parser", "Interpreter", "Indsin", "Fabric"];
for (let i = 0; i < len(stages); i = i + 1) {
    make kind = "pipelineStage";
    make name = "stage_" + i;
    create(kind, name);
    setField(name, "index", i);
    setField(name, "title", stages[i]);
}
let totalContainers = len(containerNames());
let livePipeline = "";
for (let i = 0; i < len(stages); i = i + 1) {
    livePipeline = livePipeline + getField("stage_" + i, "title");
    if (i < len(stages) - 1) { livePipeline = livePipeline + "  →  "; }
}
</Rin>
<warp navOpen={"false"} />
<warp sectionCountStr={"" + sectionCount} />
<warp platformCountStr={"" + platformCount} />
<warp totalContainersStr={"" + totalContainers} />
<warp livePipelineStr={livePipeline} />
<warp copyTick={"false"} />
<warp tabBasics={"true"} />
<warp tabFlow={"false"} />
<warp tabData={"false"} />
<warp tabDb={"false"} />
<warp tabUi={"false"} />
<warp faq1={"false"} />
<warp faq2={"false"} />
<warp faq3={"false"} />
<warp faq4={"false"} />
<warp faq5={"false"} />
<warp faq6={"false"} />
<Scaffold#page>
  <View.TopBar#nav role="topbar" padding=14 bg="#05080ae6" shadow="true">
    <Row#navRow gap=8 valign="center">
      <Text#brand text="rin" size=22 color="#2de08f" weight="900" mono="true" />
      <Button#navLibs label="المكتبات" bg="#111b17" color="#2de08f" weight="700" url="?view=libraries" />
      <Button#navDocs label="التوثيق" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/" />
      <Button#navMenu label="☰" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(navOpen)} />
    </Row>
  </View.TopBar>
  <Drawer#mobileMenu role="drawer" open={navOpen} width=270 bg="#09100d">
    <Column#drawerCol gap=2 padding=20 align="stretch">
      <Text#drawerLabel text="التنقّل" size=12 color="#5a6d62" weight="800" />
      <MenuItem#dm label="📚 مكتبات Rin" url="?view=libraries" onTap={toggle(navOpen)} color="#2de08f" />
      <MenuItem#dm2 label="لماذا Rin" url="#why" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm3 label="المنصّات" url="#platforms" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm4 label="جولة في اللغة" url="#tour" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm5 label="Indsin للواجهات" url="#indsin" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm6 label="مسار التنفيذ" url="#pipeline" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm7 label="مسار التعلّم" url="#learn" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm8 label="المنظومة" url="#ecosystem" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm9 label="متى تناسبك؟" url="#fit" onTap={toggle(navOpen)} color="#edf5f0" />
      <MenuItem#dm10 label="الأسئلة الشائعة" url="#faq" onTap={toggle(navOpen)} color="#edf5f0" />
      <Divider#dmDiv height=1 color="#17261f" />
      <MenuItem#dm11 label="GitHub" url="https://github.com/dlof-lib/rinlang" onTap={toggle(navOpen)} color="#2de08f" />
    </Column>
  </Drawer>
  <Column#content gap=40 padding=20 bg="#05080a" align="stretch">
    <Column#hero gap=18 padding=26 gradient="#0b1a13,#06100c" radius=24 shadow="true" align="stretch">
      <Row#heroTags gap=8>
        <Card#heroV padding=8 bg="#111b17" radius=999>
          <Text#heroVt text="v1.0.0" size=12 color="#2de08f" weight="700" mono="true" />
        </Card>
        <Card#heroL padding=8 bg="#111b17" radius=999>
          <Text#heroLt text="MIT" size=12 color="#ffc857" weight="700" mono="true" />
        </Card>
        <Card#heroE padding=8 bg="#111b17" radius=999>
          <Text#heroEt text="C++23" size=12 color="#7cc4ff" weight="700" mono="true" />
        </Card>
      </Row>
      <Text#heroTitle text={"اكتب أقل.\nشغّل في كل مكان."} size=36 color="#edf5f0" weight="900" />
      <Text#heroDesc text="Rin لغة برمجة صغيرة وواضحة بمحرّك واحد: تعمل من سطر الأوامر، وعلى الهاتف داخل RinStudio، وفي المتصفح عبر WebAssembly — والنتيجة نفسها في كل مكان." size=14.5 color="#8fa398" />
      <Card#heroTerm padding=16 bg="#070d0b" radius=16>
        <Column#heroTermC gap=8 align="stretch">
          <Text#heroDots text="●  ●  ●" size=11 color="#5a6d62" weight="700" />
          <Text#heroCmd text="$ rin run hello.rin" size=12.5 color="#2de08f" weight="700" mono="true" />
          <Text#heroCode text={"fun greet(name) {\n    return \"مرحباً يا \" + name + \"!\";\n}\n\nprint greet(\"Rin\");\nprint 6 * 20;"} size=12.5 color="#cfe9da" mono="true" />
          <Text#heroOutLbl text="← المخرجات" size=11 color="#5a6d62" weight="700" />
          <Text#heroOut text={"مرحباً يا Rin!\n120"} size=12.5 color="#ffc857" weight="700" mono="true" />
        </Column>
      </Card>
      <Column#heroCtas gap=10 align="stretch">
        <Button#ctaTry label="جرّب في المتصفح — بلا تثبيت" bg="#2de08f" color="#04110b" weight="800" url="https://dlof-lib.github.io/rinlang/" />
        <Button#ctaLibs label="📚 تصفّح مكتبات Rin" bg="#111b17" color="#edf5f0" weight="700" url="?view=libraries" />
        <Button#ctaStart label="ابدأ من هنا ↓" bg="#111b17" color="#edf5f0" weight="700" url="#tour" />
      </Column>
    </Column>
    <Column#stats gap=14 align="stretch">
      <Text#statsEy text="٠١ — بالأرقام" size=12 color="#2de08f" weight="800" />
      <Grid#statsGrid columns=2 gap=12>
        <Card#st1 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#st1c gap=8 align="stretch">
            <Text#st1n text="1" size=26 color="#2de08f" weight="900" mono="true" />
            <Text#st1l text="محرّك C++23 واحد لكل شيء" size=12 color="#8fa398" />
          </Column>
        </Card>
        <Card#st2 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#st2c gap=8 align="stretch">
            <Text#st2n text={platformCountStr} size=26 color="#2de08f" weight="900" mono="true" />
            <Text#st2l text="منصّات تشغيل: CLI · Android · Web" size=12 color="#8fa398" />
          </Column>
        </Card>
        <Card#st3 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#st3c gap=8 align="stretch">
            <Text#st3n text="80+" size=26 color="#7cc4ff" weight="900" mono="true" />
            <Text#st3l text="مكتبة رسمية ومدير حزم RinPM" size=12 color="#8fa398" />
          </Column>
        </Card>
        <Card#st4 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#st4c gap=8 align="stretch">
            <Text#st4n text={sectionCountStr} size=26 color="#ffc857" weight="900" mono="true" />
            <Text#st4l text="قسماً في هذه الصفحة — مُحصاة الآن من حاوية حيّة" size=12 color="#8fa398" />
          </Column>
        </Card>
      </Grid>
      <Text#statsNote text={"الرقمان الأخيران يأتيان من برنامج Rin يعمل فعلاً قبل رسم الصفحة (container.doc + queryDocs). مجموع الحاويات المُنشأة وقت التشغيل: " + totalContainersStr} size=12 color="#5a6d62" />
    </Column>
    <Divider#d1 height=1 color="#17261f" />
    <Column#why gap=14 align="stretch">
      <Text#whyEy text="٠٢ — لماذا Rin" size=12 color="#2de08f" weight="800" />
      <Text#whyTitle text="لغة صغيرة، لكنها كاملة" size=25 color="#edf5f0" weight="900" />
      <Text#whyDesc text="كل ما تحتاجه لبناء أداة أو واجهة أو خدمة صغيرة، دون طبقات من الإطارات والإعدادات." size=13.5 color="#8fa398" />
      <Grid#whyGrid columns=2 gap=12>
        <Card#f1 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#f1c gap=8 align="stretch">
            <Text#f1i text="◇" size=22 color="#2de08f" weight="900" />
            <Text#f1t text="صياغة واضحة" size=15 color="#edf5f0" weight="800" />
            <Text#f1d text={"متغيّرات ودوال وenum وmatch وأنابيب |> تُقرأ كما تُكتب."} size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#f2 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#f2c gap=8 align="stretch">
            <Text#f2i text="◈" size=22 color="#2de08f" weight="900" />
            <Text#f2t text="محرّك واحد" size=15 color="#edf5f0" weight="800" />
            <Text#f2d text="النتيجة نفسها على CLI وأندرويد والمتصفح، بلا نسخ مكرَّرة." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#f3 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#f3c gap=8 align="stretch">
            <Text#f3i text="▣" size=22 color="#2de08f" weight="900" />
            <Text#f3t text="واجهات مدمجة" size=15 color="#edf5f0" weight="800" />
            <Text#f3d text="لغة Indsin ترسم الواجهات وتعرضها بمعاينة حيّة." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#f4 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#f4c gap=8 align="stretch">
            <Text#f4i text="▤" size=22 color="#2de08f" weight="900" />
            <Text#f4t text="حاويات بيانات" size=15 color="#edf5f0" weight="800" />
            <Text#f4d text="قواعد NoSQL وSQL مدمجة بصياغة @container." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#f5 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#f5c gap=8 align="stretch">
            <Text#f5i text="❖" size=22 color="#2de08f" weight="900" />
            <Text#f5t text="منظومة جاهزة" size=15 color="#edf5f0" weight="800" />
            <Text#f5d text="أكثر من 80 مكتبة رسمية ومدير حزم ومتجر على الويب." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#f6 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#f6c gap=8 align="stretch">
            <Text#f6i text="⇄" size=22 color="#2de08f" weight="900" />
            <Text#f6t text="ربط خارجي" size=15 color="#edf5f0" weight="800" />
            <Text#f6d text="جسور مع Python وNode.js وC عند الحاجة." size=12.5 color="#8fa398" />
          </Column>
        </Card>
      </Grid>
    </Column>
    <Divider#d2 height=1 color="#17261f" />
    <Column#platforms gap=14 align="stretch">
      <Text#platEy text="٠٣ — ثلاث منصّات" size=12 color="#2de08f" weight="800" />
      <Text#platTitle text="اختر مكانك، الكود لا يتغيّر" size=25 color="#edf5f0" weight="900" />
      <Card#pCli padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#pClic gap=8 align="stretch">
          <Text#pCliT text="سطر الأوامر" size=16 color="#edf5f0" weight="800" />
          <Text#pCliD text="Linux وmacOS وWindows. يلزم cmake وg++ وzlib للبناء من المصدر." size=13 color="#8fa398" />
          <Card#pCliCode padding=14 bg="#070d0b" radius=14>
            <Column#pCliCodec gap=10 align="stretch">
              <Text#pCliCodesrc text={"git clone https://github.com/dlof-lib/rinlang.git\ncd rinlang/cli/linux && ./build.sh"} size=12.5 color="#cfe9da" mono="true" />
              <Button#pCliCodecp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"git clone https://github.com/dlof-lib/rinlang.git\ncd rinlang/cli/linux && ./build.sh"} onTap={toggle(copyTick)} />
            </Column>
          </Card>
          <Card#pCliCmd padding=14 bg="#070d0b" radius=14>
            <Column#pCliCmdc gap=10 align="stretch">
              <Text#pCliCmdsrc text={"rin -c 'print 1 + 1;'\nrin run hello.rin\nrin check hello.rin\nrin new myproj\nrin doctor"} size=12.5 color="#cfe9da" mono="true" />
              <Button#pCliCmdcp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"rin -c 'print 1 + 1;'\nrin run hello.rin\nrin check hello.rin\nrin new myproj\nrin doctor"} onTap={toggle(copyTick)} />
            </Column>
          </Card>
        </Column>
      </Card>
      <Card#pAnd padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#pAndc gap=8 align="stretch">
          <Text#pAndT text="RinStudio على أندرويد" size=16 color="#edf5f0" weight="800" />
          <Text#pAndD text="بيئة تطوير كاملة على الهاتف: محرّر بإكمال ذكي، تشغيل، معاينة حيّة لـ Indsin، ونشر الحزم عبر RinPM." size=13 color="#8fa398" />
          <Button#pAndB label="دليل أندرويد" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/android.md" />
        </Column>
      </Card>
      <Card#pWeb padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#pWebc gap=8 align="stretch">
          <Text#pWebT text="المتصفح عبر WebAssembly" size=16 color="#edf5f0" weight="800" />
          <Text#pWebD text="الموقع الذي تتصفّحه الآن يعمل بنفس المحرّك مُصرَّفاً إلى WASM. وبـ RinHTML تشغّل ملفات .rin داخل أي صفحة." size=13 color="#8fa398" />
          <Button#pWebB label="جرّب الـ Playground" bg="#2de08f" color="#04110b" weight="800" url="https://dlof-lib.github.io/rinlang/" />
        </Column>
      </Card>
    </Column>
    <Divider#d3 height=1 color="#17261f" />
    <Column#tour gap=14 align="stretch">
      <Text#tourEy text="٠٤ — جولة في اللغة" size=12 color="#2de08f" weight="800" />
      <Text#tourTitle text="خمس لقطات، كود حقيقي" size=25 color="#edf5f0" weight="900" />
      <Text#tourDesc text="المقتطفات مأخوذة من التوثيق الرسمي. اضغط تبويباً لتبديل اللقطة — التبديل نفسه مكتوب بإجراءات Indsin (show/hide/seq)." size=13.5 color="#8fa398" />
      <Wrap#tourTabs gap=8>
        <Button#tbBasics label="الأساسيات" bg="#111b17" color="#edf5f0" weight="700" onTap={seq(show(tabBasics), hide(tabFlow), hide(tabData), hide(tabDb), hide(tabUi))} />
        <Button#tbFlow label="التحكّم والدوال" bg="#111b17" color="#edf5f0" weight="700" onTap={seq(hide(tabBasics), show(tabFlow), hide(tabData), hide(tabDb), hide(tabUi))} />
        <Button#tbData label="البيانات والأنابيب" bg="#111b17" color="#edf5f0" weight="700" onTap={seq(hide(tabBasics), hide(tabFlow), show(tabData), hide(tabDb), hide(tabUi))} />
        <Button#tbDb label="الحاويات" bg="#111b17" color="#edf5f0" weight="700" onTap={seq(hide(tabBasics), hide(tabFlow), hide(tabData), show(tabDb), hide(tabUi))} />
        <Button#tbUi label="الواجهات" bg="#111b17" color="#edf5f0" weight="700" onTap={seq(hide(tabBasics), hide(tabFlow), hide(tabData), hide(tabDb), show(tabUi))} />
      </Wrap>
      <Column#paneBasics gap=10 visible={tabBasics} align="stretch">
        <Text#paneBasicst text="متغيّرات وطباعة" size=16 color="#edf5f0" weight="800" />
        <Text#paneBasicsd text="let لأي قيمة، وprint للإخراج." size=13 color="#8fa398" />
        <Card#paneBasicscode padding=14 bg="#070d0b" radius=14>
          <Column#paneBasicscodec gap=10 align="stretch">
            <Text#paneBasicscodesrc text={"let name = \"Rin\";\nlet x = 10;\n\nprint \"Hello, \" + name + \"!\";\nprint x * 2;"} size=12.5 color="#cfe9da" mono="true" />
            <Button#paneBasicscodecp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"let name = \"Rin\";\nlet x = 10;\n\nprint \"Hello, \" + name + \"!\";\nprint x * 2;"} onTap={toggle(copyTick)} />
          </Column>
        </Card>
      </Column>
      <Column#paneFlow gap=10 visible={tabFlow} align="stretch">
        <Text#paneFlowt text="شروط ودوال" size=16 color="#edf5f0" weight="800" />
        <Text#paneFlowd text="if/else وwhen/otherwise متكافئان — اختر ما يقرؤه فريقك بسهولة." size=13 color="#8fa398" />
        <Card#paneFlowcode padding=14 bg="#070d0b" radius=14>
          <Column#paneFlowcodec gap=10 align="stretch">
            <Text#paneFlowcodesrc text={"fun fib(n) {\n    if (n < 2) { return n; }\n    return fib(n - 1) + fib(n - 2);\n}\nprint fib(10);\n\nwhen (age >= 18) {\n    print \"بالغ\";\n} otherwise {\n    print \"قاصر\";\n}"} size=12.5 color="#cfe9da" mono="true" />
            <Button#paneFlowcodecp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"fun fib(n) {\n    if (n < 2) { return n; }\n    return fib(n - 1) + fib(n - 2);\n}\nprint fib(10);\n\nwhen (age >= 18) {\n    print \"بالغ\";\n} otherwise {\n    print \"قاصر\";\n}"} onTap={toggle(copyTick)} />
          </Column>
        </Card>
      </Column>
      <Column#paneData gap=10 visible={tabData} align="stretch">
        <Text#paneDatat text="مصفوفات وقواميس وأنابيب" size=16 color="#edf5f0" weight="800" />
        <Text#paneDatad text={"الأنبوب |> يُغني عن تعشيش الاستدعاءات."} size=13 color="#8fa398" />
        <Card#paneDatacode padding=14 bg="#070d0b" radius=14>
          <Column#paneDatacodec gap=10 align="stretch">
            <Text#paneDatacodesrc text={"let data = [10, 20, 30, 40, 50];\nlet result = data |> normalize() |> mean();\nprint result;\n\nlet m = { name: \"Rin\", age: 2 };\nprint m[\"name\"];\nprint keys(m);"} size=12.5 color="#cfe9da" mono="true" />
            <Button#paneDatacodecp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"let data = [10, 20, 30, 40, 50];\nlet result = data |> normalize() |> mean();\nprint result;\n\nlet m = { name: \"Rin\", age: 2 };\nprint m[\"name\"];\nprint keys(m);"} onTap={toggle(copyTick)} />
          </Column>
        </Card>
      </Column>
      <Column#paneDb gap=10 visible={tabDb} align="stretch">
        <Text#paneDbt text="قاعدة NoSQL مدمجة" size=16 color="#edf5f0" weight="800" />
        <Text#paneDbd text="حاويات المستندات جزء من اللغة، لا مكتبة خارجية." size=13 color="#8fa398" />
        <Card#paneDbcode padding=14 bg="#070d0b" radius=14>
          <Column#paneDbcodec gap=10 align="stretch">
            <Text#paneDbcodesrc text={"@Containers.Group=shop_db\n  @container.doc=users\n    document id=\"u1\" fields={ name: \"سارة\", city: \"الرياض\" };\n  .end/container.doc\n.end/Containers.Group\n\nprint queryDocs(\"users\", \"city\", \"الرياض\");"} size=12.5 color="#cfe9da" mono="true" />
            <Button#paneDbcodecp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"@Containers.Group=shop_db\n  @container.doc=users\n    document id=\"u1\" fields={ name: \"سارة\", city: \"الرياض\" };\n  .end/container.doc\n.end/Containers.Group\n\nprint queryDocs(\"users\", \"city\", \"الرياض\");"} onTap={toggle(copyTick)} />
          </Column>
        </Card>
      </Column>
      <Column#paneUi gap=10 visible={tabUi} align="stretch">
        <Text#paneUit text="واجهة تفاعلية بـ Indsin" size=16 color="#edf5f0" weight="800" />
        <Text#paneUid text="حالة reactive عبر warp، وزر يعدّلها — وكل شيء يُعاد رسمه تلقائياً." size=13 color="#8fa398" />
        <Card#paneUicode padding=14 bg="#070d0b" radius=14>
          <Column#paneUicodec gap=10 align="stretch">
            <Text#paneUicodesrc text={"<warp count={0} />\n<Column#app gap=12 padding=20>\n  <Text#t size=22>Count: {count}</Text>\n  <Button#inc onTap={count = count + 1}>Add</Button>\n</Column>"} size=12.5 color="#cfe9da" mono="true" />
            <Button#paneUicodecp label="نسخ الكود" bg="#111b17" color="#edf5f0" weight="700" copyText={"<warp count={0} />\n<Column#app gap=12 padding=20>\n  <Text#t size=22>Count: {count}</Text>\n  <Button#inc onTap={count = count + 1}>Add</Button>\n</Column>"} onTap={toggle(copyTick)} />
          </Column>
        </Card>
      </Column>
    </Column>
    <Divider#d4 height=1 color="#17261f" />
    <Column#indsin gap=14 align="stretch">
      <Text#indsinEy text="٠٥ — Indsin" size=12 color="#7cc4ff" weight="800" />
      <Text#indsinTitle text="لغة الواجهات: Interface Design" size=25 color="#edf5f0" weight="900" />
      <Text#indsinDesc text="Indsin هو محرّك عرض الواجهات في Rin. تكتب وسوماً بسيطة، فيقيسها المحرّك ويخطّطها ويرسمها — على أندرويد وسطح المكتب وCLI والمتصفح بالمسار نفسه." size=13.5 color="#8fa398" />
      <Card#indsinProof padding=18 bg="#08141c" radius=18 shadow="true">
        <Column#indsinProofc gap=8 align="stretch">
          <Text#indsinProofT text="هذه الصفحة هي الدليل" size=15 color="#7cc4ff" weight="800" />
          <Text#indsinProofD text="كل ما تراه هنا — الأزرار والتبويبات والدرج والأسئلة المنسدلة — شجرة Indsin مكتوبة في ملف واحد اسمه site.rin، بلا سطر HTML واحد." size=13 color="#8fa398" />
          <Button#indsinProofB label="اقرأ دليل Indsin" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/indsin.md" />
        </Column>
      </Card>
      <Grid#indsinGrid columns=2 gap=12>
        <Card#ig1 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#ig1c gap=8 align="stretch">
            <Text#ig1i text="⟡" size=22 color="#2de08f" weight="900" />
            <Text#ig1t text="Warp" size=15 color="#edf5f0" weight="800" />
            <Text#ig1d text="خلايا حالة تفاعلية؛ تغيّر قيمة فيُعاد رسم ما يرتبط بها فقط." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#ig2 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#ig2c gap=8 align="stretch">
            <Text#ig2i text="⟢" size=22 color="#2de08f" weight="900" />
            <Text#ig2t text="إجراءات" size=15 color="#edf5f0" weight="800" />
            <Text#ig2d text="toggle وset وshow وhide وseq جاهزة دون كتابة دوال." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#ig3 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#ig3c gap=8 align="stretch">
            <Text#ig3i text="⟣" size=22 color="#2de08f" weight="900" />
            <Text#ig3t text="تخطيط" size=15 color="#edf5f0" weight="800" />
            <Text#ig3d text="Column وRow وGrid وWrap وCard وDrawer وغيرها." size=12.5 color="#8fa398" />
          </Column>
        </Card>
        <Card#ig4 padding=16 bg="#0b1210" radius=16 shadow="true">
          <Column#ig4c gap=8 align="stretch">
            <Text#ig4i text="⟤" size=22 color="#2de08f" weight="900" />
            <Text#ig4t text="معاينة حيّة" size=15 color="#edf5f0" weight="800" />
            <Text#ig4d text="تعديل الملف ينعكس فوراً على الهاتف أو المتصفح." size=12.5 color="#8fa398" />
          </Column>
        </Card>
      </Grid>
      <Button#indsinElems label="كتالوج العناصر الكامل" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/RIN_ELEMENTS.md" />
    </Column>
    <Divider#d5 height=1 color="#17261f" />
    <Column#pipeline gap=14 align="stretch">
      <Text#pipeEy text="٠٦ — كيف تعمل" size=12 color="#2de08f" weight="800" />
      <Text#pipeTitle text="خمس مراحل، محرّك واحد" size=25 color="#edf5f0" weight="900" />
      <Text#pipeDesc text="من السطر الأول في ملفك إلى البكسل على الشاشة." size=13.5 color="#8fa398" />
      <Card#sg1 padding=14 bg="#0b1210" radius=14 shadow="true">
        <Column#sg1c gap=8 align="stretch">
          <Row#sg1h gap=12>
            <Text#sg1n text="01" size=20 color="#2de08f" weight="900" mono="true" />
            <Text#sg1t text="Lexer" size=15 color="#edf5f0" weight="800" mono="true" />
          </Row>
          <Text#sg1d text="يقطّع المصدر إلى رموز (tokens)." size=12.5 color="#8fa398" />
        </Column>
      </Card>
      <Card#sg2 padding=14 bg="#0b1210" radius=14 shadow="true">
        <Column#sg2c gap=8 align="stretch">
          <Row#sg2h gap=12>
            <Text#sg2n text="02" size=20 color="#2de08f" weight="900" mono="true" />
            <Text#sg2t text="Parser" size=15 color="#edf5f0" weight="800" mono="true" />
          </Row>
          <Text#sg2d text="يبني شجرة الصياغة AST." size=12.5 color="#8fa398" />
        </Column>
      </Card>
      <Card#sg3 padding=14 bg="#0b1210" radius=14 shadow="true">
        <Column#sg3c gap=8 align="stretch">
          <Row#sg3h gap=12>
            <Text#sg3n text="03" size=20 color="#2de08f" weight="900" mono="true" />
            <Text#sg3t text="Interpreter" size=15 color="#edf5f0" weight="800" mono="true" />
          </Row>
          <Text#sg3d text="ينفّذ برنامج Rin كاملاً: الحاويات والحلقات وmake." size=12.5 color="#8fa398" />
        </Column>
      </Card>
      <Card#sg4 padding=14 bg="#0b1210" radius=14 shadow="true">
        <Column#sg4c gap=8 align="stretch">
          <Row#sg4h gap=12>
            <Text#sg4n text="04" size=20 color="#2de08f" weight="900" mono="true" />
            <Text#sg4t text="Indsin" size=15 color="#edf5f0" weight="800" mono="true" />
          </Row>
          <Text#sg4d text="يقيس شجرة Strand ويخطّطها." size=12.5 color="#8fa398" />
        </Column>
      </Card>
      <Card#sg5 padding=14 bg="#0b1210" radius=14 shadow="true">
        <Column#sg5c gap=8 align="stretch">
          <Row#sg5h gap=12>
            <Text#sg5n text="05" size=20 color="#2de08f" weight="900" mono="true" />
            <Text#sg5t text="Fabric" size=15 color="#edf5f0" weight="800" mono="true" />
          </Row>
          <Text#sg5d text="يُخرج شجرة العرض ليرسمها المضيف: أندرويد أو CLI أو المتصفح." size=12.5 color="#8fa398" />
        </Column>
      </Card>
      <Card#pipeLive padding=14 bg="#070d0b" radius=14>
        <Column#pipeLiveC gap=6 align="stretch">
          <Text#pipeLiveL text="مولَّد الآن بحلقة for + make داخل هذه الصفحة:" size=11.5 color="#5a6d62" weight="700" />
          <Text#pipeLiveT text={livePipelineStr} size=12.5 color="#2de08f" weight="700" mono="true" />
        </Column>
      </Card>
    </Column>
    <Divider#d6 height=1 color="#17261f" />
    <Column#learn gap=14 align="stretch">
      <Text#learnEy text="٠٧ — تعلّم" size=12 color="#2de08f" weight="800" />
      <Text#learnTitle text="من الصفر إلى أول تطبيق" size=25 color="#edf5f0" weight="900" />
      <Text#learnDesc text="ستّ محطات مرتّبة. كل محطة وثيقة رسمية قصيرة." size=13.5 color="#8fa398" />
      <Card#ln1 padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#ln1c gap=8 align="stretch">
          <Row#ln1h gap=12>
            <Text#ln1n text="1" size=22 color="#2de08f" weight="900" mono="true" />
            <Text#ln1t text="التثبيت والأوامر" size=15.5 color="#edf5f0" weight="800" />
          </Row>
          <Text#ln1d text="ابنِ rin وجرّب rin doctor." size=13 color="#8fa398" />
          <Button#ln1b label="افتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/getting-started.md" />
        </Column>
      </Card>
      <Card#ln2 padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#ln2c gap=8 align="stretch">
          <Row#ln2h gap=12>
            <Text#ln2n text="2" size=22 color="#2de08f" weight="900" mono="true" />
            <Text#ln2t text="الصياغة والمتغيّرات" size=15.5 color="#edf5f0" weight="800" />
          </Row>
          <Text#ln2d text="let وprint والتعابير والأنواع." size=13 color="#8fa398" />
          <Button#ln2b label="افتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/syntax.md" />
        </Column>
      </Card>
      <Card#ln3 padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#ln3c gap=8 align="stretch">
          <Row#ln3h gap=12>
            <Text#ln3n text="3" size=22 color="#2de08f" weight="900" mono="true" />
            <Text#ln3t text="الدوال والتحكّم" size=15.5 color="#edf5f0" weight="800" />
          </Row>
          <Text#ln3d text="fun وif وwhen وwhile وfor." size=13 color="#8fa398" />
          <Button#ln3b label="افتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/functions.md" />
        </Column>
      </Card>
      <Card#ln4 padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#ln4c gap=8 align="stretch">
          <Row#ln4h gap=12>
            <Text#ln4n text="4" size=22 color="#2de08f" weight="900" mono="true" />
            <Text#ln4t text="الحاويات" size=15.5 color="#edf5f0" weight="800" />
          </Row>
          <Text#ln4d text="@container وقواعد البيانات المدمجة." size=13 color="#8fa398" />
          <Button#ln4b label="افتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/containers.md" />
        </Column>
      </Card>
      <Card#ln5 padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#ln5c gap=8 align="stretch">
          <Row#ln5h gap=12>
            <Text#ln5n text="5" size=22 color="#2de08f" weight="900" mono="true" />
            <Text#ln5t text="الواجهات" size=15.5 color="#edf5f0" weight="800" />
          </Row>
          <Text#ln5d text="Indsin والعناصر والمعاينة الحيّة." size=13 color="#8fa398" />
          <Button#ln5b label="افتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/indsin.md" />
        </Column>
      </Card>
      <Card#ln6 padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#ln6c gap=8 align="stretch">
          <Row#ln6h gap=12>
            <Text#ln6n text="6" size=22 color="#2de08f" weight="900" mono="true" />
            <Text#ln6t text="مشروعك الأول" size=15.5 color="#edf5f0" weight="800" />
          </Row>
          <Text#ln6d text="تصفّح الأمثلة الجاهزة وعدّل عليها." size=13 color="#8fa398" />
          <Button#ln6b label="افتح الأمثلة" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/tree/main/examples" />
        </Column>
      </Card>
      <Button#learnRef label="المرجع الشامل للغة" bg="#2de08f" color="#04110b" weight="800" url="https://github.com/dlof-lib/rinlang/blob/main/docs/language-reference.md" />
    </Column>
    <Divider#d7 height=1 color="#17261f" />
    <Column#ecosystem gap=14 align="stretch">
      <Text#ecoEy text="٠٨ — المنظومة" size=12 color="#2de08f" weight="800" />
      <Text#ecoTitle text="كل ما حول اللغة" size=25 color="#edf5f0" weight="900" />
      <Grid#ecoGrid columns=2 gap=12>
        <Card#e1 padding=14 bg="#0b1210" radius=14 shadow="true">
          <Column#e1c gap=8 align="stretch">
            <Text#e1t text="المكتبات" size=14.5 color="#edf5f0" weight="800" />
            <Text#e1d text="أكثر من 80 مكتبة رسمية." size=12 color="#8fa398" />
            <Button#e1b label="فتح" bg="#111b17" color="#edf5f0" weight="700" url="?view=libraries" />
          </Column>
        </Card>
        <Card#e2 padding=14 bg="#0b1210" radius=14 shadow="true">
          <Column#e2c gap=8 align="stretch">
            <Text#e2t text="RinStudio" size=14.5 color="#edf5f0" weight="800" />
            <Text#e2d text="IDE كامل على أندرويد." size=12 color="#8fa398" />
            <Button#e2b label="فتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/android.md" />
          </Column>
        </Card>
        <Card#e3 padding=14 bg="#0b1210" radius=14 shadow="true">
          <Column#e3c gap=8 align="stretch">
            <Text#e3t text="RinPM" size=14.5 color="#edf5f0" weight="800" />
            <Text#e3d text="مدير الحزم والمتجر." size=12 color="#8fa398" />
            <Button#e3b label="فتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/lib/README.md" />
          </Column>
        </Card>
        <Card#e4 padding=14 bg="#0b1210" radius=14 shadow="true">
          <Column#e4c gap=8 align="stretch">
            <Text#e4t text="الربط" size=14.5 color="#edf5f0" weight="800" />
            <Text#e4d text="Python وNode.js وC." size=12 color="#8fa398" />
            <Button#e4b label="فتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/bindings/README.md" />
          </Column>
        </Card>
        <Card#e5 padding=14 bg="#0b1210" radius=14 shadow="true">
          <Column#e5c gap=8 align="stretch">
            <Text#e5t text="RinHTML" size=14.5 color="#edf5f0" weight="800" />
            <Text#e5d text="شغّل .rin داخل HTML." size=12 color="#8fa398" />
            <Button#e5b label="فتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/html-projects.md" />
          </Column>
        </Card>
        <Card#e6 padding=14 bg="#0b1210" radius=14 shadow="true">
          <Column#e6c gap=8 align="stretch">
            <Text#e6t text="حزم المحتوى" size=14.5 color="#edf5f0" weight="800" />
            <Text#e6d text="لغات وأصول قابلة للتنزيل." size=12 color="#8fa398" />
            <Button#e6b label="فتح" bg="#111b17" color="#edf5f0" weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/CONTENT_PACKS.md" />
          </Column>
        </Card>
      </Grid>
    </Column>
    <Divider#d8 height=1 color="#17261f" />
    <Column#fit gap=14 align="stretch">
      <Text#fitEy text="٠٩ — الصراحة أولاً" size=12 color="#2de08f" weight="800" />
      <Text#fitTitle text="متى تناسبك Rin؟" size=25 color="#edf5f0" weight="900" />
      <Card#fitYes padding=18 bg="#0a1f16" radius=18 shadow="true">
        <Column#fitYesc gap=8 align="stretch">
          <Text#fitYesT text="✓ اختَرها إذا" size=15 color="#2de08f" weight="800" />
          <Text#fitYesD text="أردت لغة صغيرة تتعلّمها في أيام · تبني أدوات وواجهات خفيفة · تبرمج من الهاتف · تحتاج النتيجة نفسها على CLI وأندرويد والويب." size=13 color="#8fa398" />
        </Column>
      </Card>
      <Card#fitNo padding=18 bg="#0b1210" radius=18 shadow="true">
        <Column#fitNoc gap=8 align="stretch">
          <Text#fitNoT text="✕ ربما لا إذا" size=15 color="#ffc857" weight="800" />
          <Text#fitNoD text="احتجت منظومة مكتبات ضخمة جاهزة لكل مجال · أو أداءً حرجاً لا يقبل مفسّراً · أو فريقاً كبيراً مرتبطاً بلغة أخرى أصلاً." size=13 color="#8fa398" />
        </Column>
      </Card>
    </Column>
    <Divider#d9 height=1 color="#17261f" />
    <Column#faq gap=14 align="stretch">
      <Text#faqEy text="١٠ — أسئلة شائعة" size=12 color="#2de08f" weight="800" />
      <Text#faqTitle text="إجابات سريعة" size=25 color="#edf5f0" weight="900" />
      <Card#fq1 padding=12 bg="#0b1210" radius=14 shadow="true">
        <Column#fq1c gap=8 align="stretch">
          <Button#fq1q label="ما هي Rin؟" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(faq1)} />
          <Column#fq1a gap=6 visible={faq1} align="stretch">
            <Text#fq1at text="لغة برمجة صغيرة بمحرّك C++23 واحد يعمل من سطر الأوامر وفي IDE أندرويد وفي المتصفح عبر WebAssembly." size=13 color="#8fa398" />
          </Column>
        </Column>
      </Card>
      <Card#fq2 padding=12 bg="#0b1210" radius=14 shadow="true">
        <Column#fq2c gap=8 align="stretch">
          <Button#fq2q label="هل أحتاج إلى تثبيت؟" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(faq2)} />
          <Column#fq2a gap=6 visible={faq2} align="stretch">
            <Text#fq2at text="لا للتجربة: افتح الـ Playground في المتصفح. للاستخدام اليومي ابنِ rin من المصدر أو ثبّت RinStudio على أندرويد." size=13 color="#8fa398" />
          </Column>
        </Column>
      </Card>
      <Card#fq3 padding=12 bg="#0b1210" radius=14 shadow="true">
        <Column#fq3c gap=8 align="stretch">
          <Button#fq3q label="كيف أنشر مكتبتي؟" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(faq3)} />
          <Column#fq3a gap=6 visible={faq3} align="stretch">
            <Text#fq3at text="من RinStudio عبر RinPM؛ تظهر تلقائياً في متجر المكتبات على الموقع مع رابط مباشر لها." size=13 color="#8fa398" />
          </Column>
        </Column>
      </Card>
      <Card#fq4 padding=12 bg="#0b1210" radius=14 shadow="true">
        <Column#fq4c gap=8 align="stretch">
          <Button#fq4q label="ما هو Indsin؟" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(faq4)} />
          <Column#fq4a gap=6 visible={faq4} align="stretch">
            <Text#fq4at text="محرّك واجهات Rin (Interface Design): تكتب الوسوم فيقيسها ويرسمها بالمسار نفسه على كل المنصّات." size=13 color="#8fa398" />
          </Column>
        </Column>
      </Card>
      <Card#fq5 padding=12 bg="#0b1210" radius=14 shadow="true">
        <Column#fq5c gap=8 align="stretch">
          <Button#fq5q label="ما الترخيص؟" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(faq5)} />
          <Column#fq5a gap=6 visible={faq5} align="stretch">
            <Text#fq5at text="رخصة MIT. الاسم والشعار غير مشمولين بالترخيص — راجع TRADEMARKS.md." size=13 color="#8fa398" />
          </Column>
        </Column>
      </Card>
      <Card#fq6 padding=12 bg="#0b1210" radius=14 shadow="true">
        <Column#fq6c gap=8 align="stretch">
          <Button#fq6q label="كيف أساهم؟" bg="#111b17" color="#edf5f0" weight="700" onTap={toggle(faq6)} />
          <Column#fq6a gap=6 visible={faq6} align="stretch">
            <Text#fq6at text="اقرأ CONTRIBUTING.md وقواعد السلوك ثم افتح Issue أو Pull Request على GitHub." size=13 color="#8fa398" />
          </Column>
        </Column>
      </Card>
    </Column>
    <Card#cta padding=24 gradient="#0b1a13,#071811" radius=22 shadow="true">
      <Column#ctaCol gap=12 align="stretch">
        <Text#ctaTitle text="جاهز لأول برنامج Rin؟" size=22 color="#edf5f0" weight="900" />
        <Text#ctaDesc text="الشيفرة كاملة ومفتوحة ومنشورة تلقائياً بلغة Rin عبر GitHub Actions." size=13.5 color="#8fa398" />
        <Button#ctaRepo label="افتح المستودع على GitHub" bg="#2de08f" color="#04110b" weight="800" url="https://github.com/dlof-lib/rinlang" />
        <Button#ctaLibs2 label="📚 مكتبات Rin" bg="#111b17" color="#edf5f0" weight="700" url="?view=libraries" />
      </Column>
    </Card>
    <Divider#d10 height=1 color="#17261f" />
    <Column#footer gap=10 align="stretch">
      <Text#footCopy text="© 2026 Rin Project Contributors — MIT" size=12 color="#5a6d62" />
      <Row#footL1 gap=16>
        <Text#fl1 text="GitHub" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang" />
        <Text#fl2 text="التوثيق" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang/blob/main/docs/" />
        <Text#fl3 text="الأمثلة" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang/tree/main/examples" />
      </Row>
      <Row#footL2 gap=16>
        <Text#fl4 text="المشاكل" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang/issues" />
        <Text#fl5 text="المساهمة" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang/blob/main/CONTRIBUTING.md" />
        <Text#fl6 text="الأمان" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang/blob/main/SECURITY.md" />
        <Text#fl7 text="العلامة" size=12 color="#8fa398" url="https://github.com/dlof-lib/rinlang/blob/main/TRADEMARKS.md" />
      </Row>
    </Column>
  </Column>
</Scaffold>
