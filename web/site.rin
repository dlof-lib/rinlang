<!-- ============================================================================= -->
<!-- site.rin — الموقع الرسمي للغة Rin · الإصدار الثاني (إعادة تصميم وتطوير كاملة)     -->
<!-- ----------------------------------------------------------------------------- -->
<!-- مكتوب بالكامل بلغة Rin + Indsin: صفر HTML وصفر JavaScript في المحتوى.            -->
<!-- • برنامج Rin حقيقي يُنفَّذ قبل رسم الواجهة (حاويات NoSQL + حلقات + بيانات الصفحة).  -->
<!-- • قوالب <Define> تُوسَّع وقت الترجمة، فكل بطاقة تُكتب مرة واحدة وتُستعمل بسطر.    -->
<!-- • تصميم متجاوب: لاحقات _md/_lg على الخصائص (جوال ← لوحي ← سطح مكتب).            -->
<!-- • حالة تفاعلية بخلايا warp: لون التمييز، تبويبات الكود، الأسئلة، عدّاد حيّ.        -->
<!--                                                                               -->
<!-- هوية التصميم: حبر داكن · لون تمييز قابل للتبديل · عناوين مرقّمة · مزاج «طرفية».   -->
<!-- الأقسام: hero · stats · why · platforms · tour · playground · indsin · pipeline · -->
<!--          learn · ecosystem · fit · faq · cta · footer  (+ quickstart · examples)   -->
<!-- ============================================================================= -->
<Rin>
// ---- حاويات NoSQL تصف هذه الصفحة نفسها (تُنفَّذ فعلاً قبل رسم أي عنصر) ----
@container.doc=siteSections
  document id="s0"  fields={ name: "hero",       kind: "section" };
  document id="s1"  fields={ name: "stats",      kind: "section" };
  document id="s2"  fields={ name: "why",        kind: "section" };
  document id="s3"  fields={ name: "platforms",  kind: "section" };
  document id="s4"  fields={ name: "tour",       kind: "section" };
  document id="s5"  fields={ name: "playground", kind: "section" };
  document id="s6"  fields={ name: "indsin",     kind: "section" };
  document id="s7"  fields={ name: "pipeline",   kind: "section" };
  document id="s8"  fields={ name: "learn",      kind: "section" };
  document id="s9"  fields={ name: "ecosystem",  kind: "section" };
  document id="s10" fields={ name: "fit",        kind: "section" };
  document id="s11" fields={ name: "faq",        kind: "section" };
  document id="s12" fields={ name: "cta",        kind: "section" };
  document id="s13" fields={ name: "quickstart", kind: "section" };
  document id="s14" fields={ name: "examples",   kind: "section" };
.end/container.doc
@container.doc=siteTargets
  document id="t0" fields={ name: "CLI",         kind: "platform" };
  document id="t1" fields={ name: "Android",     kind: "platform" };
  document id="t2" fields={ name: "WebAssembly", kind: "platform" };
.end/container.doc
let sectionCount = len(queryDocs("siteSections", "kind", "section"));
let platformCount = len(queryDocs("siteTargets", "kind", "platform"));

// ---- مراحل التنفيذ: حلقة for + make تُنشئ حاوية ديناميكية لكل مرحلة ----
let stages = ["Lexer", "Parser", "Interpreter", "Indsin", "Fabric"];
for (let i = 0; i < len(stages); i = i + 1) {
    make kind = "pipelineStage";
    make name = "stage_" + i;
    create(kind, name);
    setField(name, "index", i);
    setField(name, "title", stages[i]);
}
let totalContainers = len(containerNames());
let livePipeline = "";
for (let i = 0; i < len(stages); i = i + 1) {
    livePipeline = livePipeline + getField("stage_" + i, "title");
    if (i < len(stages) - 1) { livePipeline = livePipeline + "  →  "; }
}

// ---- مقتطفات «جولة في اللغة»: بيانات Rin تُعرض بتبويب واحد ----
let tourTitles = ["الأساسيات", "التحكّم والدوال", "البيانات والأنابيب", "الحاويات", "الواجهات"];
let tourHeads = [
    "متغيّرات وطباعة",
    "شروط ودوال",
    "مصفوفات وقواميس وأنابيب",
    "قاعدة NoSQL مدمجة",
    "واجهة تفاعلية بـ Indsin"
];
let tourNotes = [
    "let لأي قيمة، وprint للإخراج. لا فواصل منقوطة مفروضة على أحد سوى الوضوح.",
    "if/else وwhen/otherwise متكافئان — اختر ما يقرؤه فريقك بسهولة.",
    "الأنبوب |> يُغني عن تعشيش الاستدعاءات ويجعل القراءة من اليسار إلى اليمين.",
    "حاويات المستندات جزء من اللغة نفسها، لا مكتبة خارجية.",
    "حالة reactive عبر warp، وزر يعدّلها — ويُعاد رسم ما ارتبط بها تلقائياً."
];
let tourCode = [
    "let name = \"Rin\";\nlet x = 10;\n\nprint \"Hello, \" + name + \"!\";\nprint x * 2;",
    "fun fib(n) {\n    if (n < 2) { return n; }\n    return fib(n - 1) + fib(n - 2);\n}\nprint fib(10);\n\nwhen (age >= 18) {\n    print \"بالغ\";\n} otherwise {\n    print \"قاصر\";\n}",
    "let data = [10, 20, 30, 40, 50];\nlet result = data |> normalize() |> mean();\nprint result;\n\nlet m = { name: \"Rin\", age: 2 };\nprint m[\"name\"];\nprint keys(m);",
    "@Containers.Group=shop_db\n  @container.doc=users\n    document id=\"u1\" fields={ name: \"سارة\", city: \"الرياض\" };\n  .end/container.doc\n.end/Containers.Group\n\nprint queryDocs(\"users\", \"city\", \"الرياض\");",
    "<warp count={0} />\n<Column#app gap=12 padding=20>\n  <Text#t size=22>Count: {count}</Text>\n  <Button#inc onTap={count = count + 1}>Add</Button>\n</Column>"
];

// ---- معرض الأمثلة: كل مثال شُغِّل فعلاً بمحرّك Rin والمخرجات أدناه هي الناتج الحقيقي ----
let exTitles = ["حلقات", "دوال", "حاويات", "قواميس"];
let exNotes = [
    "for … in للتكرار على العناصر، وfor الكلاسيكية للعدّ.",
    "دالة تعاودية ومصفوفة تُملأ بحلقة — #add يضيف عنصراً للمصفوفة.",
    "ثلاثة مستندات في حاوية، ثم استعلام بحقل واحد: queryDocs.",
    "القاموس { مفتاح: قيمة } مع keys وlen للاستكشاف."
];
let exCode = [
    "let names = [\"Rin\", \"Loom\", \"Container\"];\nfor (let name in names) {\n    print name;\n}\n\nlet total = 0;\nfor (let k = 1; k <= 5; k = k + 1) {\n    total = total + k;\n}\nprint \"المجموع = \" + total;",
    "fun fib(n) {\n    if (n < 2) { return n; }\n    return fib(n - 1) + fib(n - 2);\n}\n\nlet seq = [];\nfor (let i = 0; i < 8; i = i + 1) {\n    #add(seq, fib(i));\n}\nprint seq;\nprint fib(10);",
    "@container.doc=users\n  document id=\"u1\" fields={ name: \"سارة\", city: \"الرياض\" };\n  document id=\"u2\" fields={ name: \"خالد\", city: \"جدة\" };\n  document id=\"u3\" fields={ name: \"منى\", city: \"الرياض\" };\n.end/container.doc\n\nlet hits = queryDocs(\"users\", \"city\", \"الرياض\");\nprint len(hits);\nprint hits;",
    "let m = { name: \"Rin\", age: 2 };\nprint m[\"name\"];\nprint keys(m);\n\nlet data = [10, 20, 30, 40, 50];\nprint len(data);"
];
let exOut = [
    "Rin\nLoom\nContainer\nالمجموع = 15",
    "[0, 1, 1, 2, 3, 5, 8, 13]\n55",
    "2\n[{\"name\": \"سارة\", \"city\": \"الرياض\"}, {\"name\": \"منى\", \"city\": \"الرياض\"}]",
    "Rin\n[\"name\", \"age\"]\n5"
];

// ---- ألوان التمييز المتاحة في «الملعب» ----
let accents = ["#34d27b", "#6cb6ff", "#ffb84d", "#ff7eb6", "#b794ff", "#ff6b6b"];
let accentNames = ["زمرّد", "سماء", "عنبر", "وردي", "بنفسجي", "مرجان"];

// دالة تلوين: تعيد لون الخلفية حسب كون التبويب نشطاً
// pick: يختار لون الوضع الداكن (d) أو الفاتح (w) بحسب خلية light
fun pick(l, d, w) {
    if (l) { return w; }
    return d;
}
fun tabBg(cur, idx, l) {
    if (cur == idx) { return pick(l, "#1b2530", "#c4d7ce"); }
    return pick(l, "#10161d", "#e3eae7");
}
fun tabFg(cur, idx, l) {
    if (cur == idx) { return pick(l, "#ffffff", "#10201a"); }
    return pick(l, "#93a1ab", "#4b5a63");
}
</Rin>

<warp navOpen={false} />
<warp copyTick={false} />
<warp light={false} />
<warp tab={0} />
<warp ex={0} />
<warp openFaq={0} />
<warp count={0} />
<warp acc={"#34d27b"} />
<warp sectionCountStr={"" + sectionCount} />
<warp platformCountStr={"" + platformCount} />
<warp totalContainersStr={"" + totalContainers} />
<warp livePipelineStr={livePipeline} />

<!-- ============================ قوالب المكوّنات ============================ -->

<!-- ترويسة قسم: رقم + اسم + عنوان + وصف -->
<Define#Head num="٠١" tag="" title="" desc="">
  <Column#hd gap=10 align="stretch">
    <Text#hdEy text={num + " — " + tag} size=12 color={acc} weight="800" />
    <Text#hdT text={title} size=26 size_lg=38 color={pick(light, "#eef3f1", "#10201a")} weight="900" />
    <Text#hdD text={desc} size=14 size_lg=16 color={pick(light, "#93a1ab", "#4b5a63")} />
  </Column>
</Define>

<!-- بطاقة ميزة -->
<Define#Feature icon="◇" title="" desc="">
  <Card#fc padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=20 shadow="true">
    <Column#fcc gap=10 align="stretch">
      <Text#fci text={icon} size=26 color={acc} weight="900" />
      <Text#fct text={title} size=16 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
      <Text#fcd text={desc} size=13 color={pick(light, "#93a1ab", "#4b5a63")} />
    </Column>
  </Card>
</Define>

<!-- بطاقة رقم -->
<Define#Stat value="" label="" tint="#34d27b">
  <Card#sc padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=20 shadow="true">
    <Column#scc gap=6 align="stretch">
      <Text#scn text={value} size=32 color={tint} weight="900" mono="true" />
      <Text#scl text={label} size=12.5 color={pick(light, "#93a1ab", "#4b5a63")} />
    </Column>
  </Card>
</Define>

<!-- بطاقة رابط (مورد/وثيقة) -->
<Define#Link title="" desc="" label="افتح" href="">
  <Card#lc padding=18 bg={pick(light, "#0e1218", "#ffffff")} radius=18 shadow="true">
    <Column#lcc gap=8 align="stretch">
      <Text#lct text={title} size=15 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
      <Text#lcd text={desc} size=12.5 color={pick(light, "#93a1ab", "#4b5a63")} />
      <Button#lcb label={label} bg={pick(light, "#151c25", "#d9e2de")} color={acc} weight="700" url={href} />
    </Column>
  </Card>
</Define>

<!-- خطوة مرقّمة -->
<Define#Step n="1" title="" desc="" href="">
  <Card#stp padding=18 bg={pick(light, "#0e1218", "#ffffff")} radius=18 shadow="true">
    <Column#stpc gap=8 align="stretch">
      <Row#stph gap=12 valign="center">
        <Text#stpn text={n} size=22 color={acc} weight="900" mono="true" />
        <Text#stpt text={title} size=15.5 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
      </Row>
      <Text#stpd text={desc} size=13 color={pick(light, "#93a1ab", "#4b5a63")} />
      <Button#stpb label="افتح" bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url={href} />
    </Column>
  </Card>
</Define>

<!-- مرحلة في مسار التنفيذ -->
<Define#Stage n="01" title="" desc="">
  <Card#sg padding=16 bg={pick(light, "#0e1218", "#ffffff")} radius=16 shadow="true">
    <Column#sgc gap=8 align="stretch">
      <Text#sgn text={n} size=20 color={acc} weight="900" mono="true" />
      <Text#sgt text={title} size=15 color={pick(light, "#eef3f1", "#10201a")} weight="800" mono="true" />
      <Text#sgd text={desc} size=12.5 color={pick(light, "#93a1ab", "#4b5a63")} />
    </Column>
  </Card>
</Define>

<!-- سؤال شائع: الفهرس idx يقارَن بخلية openFaq (واحد مفتوح في كل مرة) -->
<Define#Faq idx="1" q="" a="">
  <Card#fq padding=12 bg={pick(light, "#0e1218", "#ffffff")} radius=16 shadow="true">
    <Column#fqc gap=8 align="stretch">
      <Button#fqq label={q} bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={openFaq = (openFaq == idx) ? 0 : idx} />
      <Column#fqa gap=6 visible={openFaq == idx} align="stretch">
        <Text#fqat text={a} size=13.5 color={pick(light, "#93a1ab", "#4b5a63")} />
      </Column>
    </Column>
  </Card>
</Define>

<!-- نافذة كود مع زر نسخ -->
<Define#Code src="" cmd="">
  <Card#cd padding=16 bg="#080b0f" radius=16>
    <Column#cdc gap=10 align="stretch">
      <Text#cdd text="●  ●  ●" size=11 color="#4a5863" weight="700" />
      <Text#cdt text={src} size=12.5 color="#cfe9da" mono="true" />
      <Button#cdb label="نسخ الكود" bg="#151c25" color="#eef3f1" weight="700" copyText={src} onTap={toggle(copyTick)} />
    </Column>
  </Card>
</Define>

<!-- ============================== الصفحة ============================== -->
<Scaffold#page>
  <View.TopBar#nav role="topbar" padding=14 padding_lg=18 bg={pick(light, "#07090de6", "#f4f7f5e6")} shadow="true">
    <Row#navRow gap=8 valign="center">
      <Text#brand text="rin" size=24 color={acc} weight="900" mono="true" />
      <Button#themeBtn label={pick(light, "☀ فاتح", "☾ داكن")} bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={toggle(light)} />
      <Button#navLibs label="المكتبات" bg={pick(light, "#10161d", "#e3eae7")} color={acc} weight="700" url="?view=libraries" />
      <Button#navDocs label="التوثيق" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/" />
      <Button#navWhy label="لماذا Rin" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="#why" visible=false visible_lg=true />
      <Button#navTour label="الجولة" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="#tour" visible=false visible_lg=true />
      <Button#navLearn label="تعلّم" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="#learn" visible=false visible_lg=true />
      <Button#navFaq label="الأسئلة" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="#faq" visible=false visible_lg=true />
      <Button#navGh label="GitHub" bg={acc} color="#04110b" weight="800" url="https://github.com/dlof-lib/rinlang" visible=false visible_md=true />
      <Button#menuBtn label="☰" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={toggle(navOpen)} />
    </Row>
  </View.TopBar>

  <Drawer#mobileMenu role="drawer" open={navOpen} width=300 bg={pick(light, "#0a0e13", "#f0f4f2")}>
    <Column#drawerCol gap=4 padding=20 align="stretch">
      <Row#drawerHead gap=10 valign="center">
        <Text#drawerBrand text="rin" size=26 color={acc} weight="900" mono="true" />
        <Button#drawerClose width=120 label="✕ إغلاق" bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={toggle(navOpen)} />
      </Row>
      <Text#drawerSub margin_bottom=6 text="لغة برمجة صغيرة · محرّك واحد" size=12 color="#5d6b75" />
      <Divider#dmDiv0 height=1 color={pick(light, "#1a232d", "#d5dedb")} />

      <Text#dmG1 text="ابدأ" size=11.5 color="#5d6b75" weight="800" />
      <MenuItem#dm1 label="📚 مكتبات Rin" url="?view=libraries" onTap={toggle(navOpen)} color={acc} />
      <MenuItem#dm2 label="لماذا Rin" url="#why" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm3 label="المنصّات" url="#platforms" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm13 label="ابدأ في ٣ خطوات" url="#quickstart" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />

      <Text#dmG2 margin_top=14 text="جرّب" size=11.5 color="#5d6b75" weight="800" />
      <MenuItem#dm4 label="جولة في اللغة" url="#tour" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm5 label="الملعب التفاعلي" url="#playground" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm14 label="أمثلة جاهزة" url="#examples" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />

      <Text#dmG3 margin_top=14 text="تعمّق" size=11.5 color="#5d6b75" weight="800" />
      <MenuItem#dm6 label="Indsin للواجهات" url="#indsin" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm7 label="مسار التنفيذ" url="#pipeline" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm8 label="مسار التعلّم" url="#learn" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm9 label="المنظومة" url="#ecosystem" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm10 label="متى تناسبك؟" url="#fit" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />
      <MenuItem#dm11 label="الأسئلة الشائعة" url="#faq" onTap={toggle(navOpen)} color={pick(light, "#eef3f1", "#10201a")} />

      <Divider#dmDiv margin_top=8 height=1 color={pick(light, "#1a232d", "#d5dedb")} />
      <Text#dmG4 margin_top=14 text="المظهر" size=11.5 color="#5d6b75" weight="800" />
      <Button#dmTheme label={pick(light, "☀ التبديل إلى الوضع الفاتح", "☾ التبديل إلى الوضع الداكن")} bg={pick(light, "#10161d", "#e3eae7")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={toggle(light)} />
      <Wrap#dmSw gap=8>
        <<each accents as ac, ai>>
          <Button#dsw label="●" bg={ac} color="#04110b" weight="900" onTap={acc = ac} />
        <</each>>
      </Wrap>
      <Button#dmGh margin_top=10 label="GitHub ↗" bg={acc} color="#04110b" weight="800" url="https://github.com/dlof-lib/rinlang" onTap={toggle(navOpen)} />
    </Column>
  </Drawer>

  <Column#content gap=56 gap_lg=88 padding=20 padding_md=32 padding_lg=48 bg={pick(light, "#07090d", "#f4f7f5")} align="stretch">

    <!-- ============ 00 · البطل ============ -->
    <Grid#hero columns=1 columns_lg=2 gap=24 gap_lg=40 padding=26 padding_lg=48 gradient="#0d1a14,#080d11" radius=28 shadow="true">
      <Column#heroTxt gap=18 align="stretch">
        <Row#heroTags gap=8>
          <Card#heroV padding=8 bg="#10161d" radius=999>
            <Text#heroVt text="v1.0.0" size=12 color={acc} weight="700" mono="true" />
          </Card>
          <Card#heroL padding=8 bg="#10161d" radius=999>
            <Text#heroLt text="MIT" size=12 color="#ffc857" weight="700" mono="true" />
          </Card>
          <Card#heroE padding=8 bg="#10161d" radius=999>
            <Text#heroEt text="C++23" size=12 color="#7cc4ff" weight="700" mono="true" />
          </Card>
        </Row>
        <Text#heroTitle text={"اكتب أقل.\nشغّل في كل مكان."} size=38 size_md=48 size_lg=60 color="#eef3f1" weight="900" />
        <Text#heroDesc text="Rin لغة برمجة صغيرة وواضحة بمحرّك واحد: تعمل من سطر الأوامر، وعلى الهاتف داخل RinStudio، وفي المتصفح عبر WebAssembly — والنتيجة نفسها في كل مكان." size=15 size_lg=17 color="#93a1ab" />
        <Wrap#heroCtas gap=10>
          <Button#ctaTry label="جرّب في المتصفح — بلا تثبيت" bg={acc} color="#04110b" weight="800" url="https://dlof-lib.github.io/rinlang/" />
          <Button#ctaLibs label="📚 تصفّح المكتبات" bg="#10161d" color="#eef3f1" weight="700" url="?view=libraries" />
          <Button#ctaStart label="ابدأ من هنا ↓" bg="#10161d" color="#eef3f1" weight="700" url="#tour" />
        </Wrap>
      </Column>
      <Card#heroTerm padding=18 bg="#080b0f" radius=20 shadow="true">
        <Column#heroTermC gap=10 align="stretch">
          <Text#heroDots text="●  ●  ●" size=11 color="#4a5863" weight="700" />
          <Text#heroCmd text="$ rin run hello.rin" size=13 color={acc} weight="700" mono="true" />
          <Text#heroCode text={"fun greet(name) {\n    return \"مرحباً يا \" + name + \"!\";\n}\n\nprint greet(\"Rin\");\nprint 6 * 20;"} size=13 color="#cfe9da" mono="true" />
          <Text#heroOutLbl text="← المخرجات" size=11 color="#5d6b75" weight="700" />
          <Text#heroOut text={"مرحباً يا Rin!\n120"} size=13 color="#ffc857" weight="700" mono="true" />
        </Column>
      </Card>
    </Grid>

    <!-- ============ 01 · بالأرقام ============ -->
    <Column#stats gap=16 align="stretch">
      <Head#h1 num="٠١" tag="بالأرقام" title="صغيرة في الحجم، واسعة في الأثر" desc="" />
      <Grid#statsGrid columns=2 columns_lg=4 gap=12 gap_lg=18>
        <Stat#a1 value="1" label="محرّك C++23 واحد لكل شيء" tint="#34d27b" />
        <Stat#a2 value={platformCountStr} label="منصّات تشغيل: CLI · Android · Web" tint="#6cb6ff" />
        <Stat#a3 value="80+" label="مكتبة رسمية ومدير حزم RinPM" tint="#ffb84d" />
        <Stat#a4 value={sectionCountStr} label="قسماً في هذه الصفحة — مُحصاة من حاوية حيّة" tint="#ff7eb6" />
      </Grid>
      <Text#statsNote text={"الرقمان الثاني والرابع يأتيان من برنامج Rin يعمل فعلاً قبل رسم الصفحة (container.doc + queryDocs). مجموع الحاويات المُنشأة وقت التشغيل: " + totalContainersStr} size=12 color="#5d6b75" />
    </Column>

    <!-- ============ 02 · لماذا Rin ============ -->
    <Column#why gap=22 align="stretch">
      <Head#h2 num="٠٢" tag="لماذا Rin" title="لغة صغيرة، لكنها كاملة" desc="كل ما تحتاجه لبناء أداة أو واجهة أو خدمة صغيرة، دون طبقات من الإطارات والإعدادات." />
      <Grid#whyGrid columns=1 columns_md=2 columns_lg=3 gap=14 gap_lg=20>
        <Feature#f1 icon="◇" title="صياغة واضحة" desc="متغيّرات ودوال وenum وmatch وأنابيب تُقرأ كما تُكتب." />
        <Feature#f2 icon="◈" title="محرّك واحد" desc="النتيجة نفسها على CLI وأندرويد والمتصفح، بلا نسخ مكرَّرة من المنطق." />
        <Feature#f3 icon="▣" title="واجهات مدمجة" desc="لغة Indsin ترسم الواجهات وتعرضها بمعاينة حيّة على كل المنصّات." />
        <Feature#f4 icon="▤" title="حاويات بيانات" desc="قواعد NoSQL وSQL مدمجة بصياغة @container — بلا خادم ولا إعداد." />
        <Feature#f5 icon="❖" title="منظومة جاهزة" desc="أكثر من 80 مكتبة رسمية ومدير حزم ومتجر على الويب." />
        <Feature#f6 icon="⇄" title="ربط خارجي" desc="جسور مع Python وNode.js وC عند الحاجة، دون التخلّي عن اللغة." />
      </Grid>
    </Column>

    <!-- ============ 03 · المنصّات ============ -->
    <Column#platforms gap=22 align="stretch">
      <Head#h3 num="٠٣" tag="ثلاث منصّات" title="اختر مكانك، الكود لا يتغيّر" desc="Linux وmacOS وWindows وأندرويد والمتصفح — بنفس الملف .rin ونفس النتيجة." />
      <Grid#platGrid columns=1 columns_lg=3 gap=14 gap_lg=20>
        <Card#pCli padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#pClic gap=10 align="stretch">
            <Text#pCliI text="⌘" size=26 color={acc} weight="900" mono="true" />
            <Text#pCliT text="سطر الأوامر" size=17 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Text#pCliD text="Linux وmacOS وWindows. يلزم cmake وg++ وzlib للبناء من المصدر." size=13 color={pick(light, "#93a1ab", "#4b5a63")} />
            <Code#pCliCode src={"git clone https://github.com/dlof-lib/rinlang.git\ncd rinlang/cli/linux && ./build.sh"} />
            <Code#pCliCmd src={"rin -c 'print 1 + 1;'\nrin run hello.rin\nrin check hello.rin\nrin new myproj\nrin doctor"} />
          </Column>
        </Card>
        <Card#pAnd padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#pAndc gap=10 align="stretch">
            <Text#pAndI text="▭" size=26 color={acc} weight="900" mono="true" />
            <Text#pAndT text="RinStudio على أندرويد" size=17 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Text#pAndD text="بيئة تطوير كاملة على الهاتف: محرّر بإكمال ذكي، تشغيل، معاينة حيّة لـ Indsin، ونشر الحزم عبر RinPM." size=13 color={pick(light, "#93a1ab", "#4b5a63")} />
            <Button#pAndB label="دليل أندرويد" bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/android.md" />
          </Column>
        </Card>
        <Card#pWeb padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#pWebc gap=10 align="stretch">
            <Text#pWebI text="◎" size=26 color={acc} weight="900" mono="true" />
            <Text#pWebT text="المتصفح عبر WebAssembly" size=17 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Text#pWebD text="الموقع الذي تتصفّحه الآن يعمل بنفس المحرّك مُصرَّفاً إلى WASM. وبـ RinHTML تشغّل ملفات .rin داخل أي صفحة." size=13 color={pick(light, "#93a1ab", "#4b5a63")} />
            <Button#pWebB label="جرّب الـ Playground" bg={acc} color="#04110b" weight="800" url="https://dlof-lib.github.io/rinlang/" />
          </Column>
        </Card>
      </Grid>
    </Column>

    <!-- ============ 04 · ابدأ في ثلاث خطوات ============ -->
    <Column#quickstart gap=22 align="stretch">
      <Head#h4q num="٠٤" tag="ابدأ بسرعة" title="من الصفر إلى أول مخرجات في ثلاث خطوات" desc="الأوامر نفسها على Linux وmacOS؛ وعلى ويندوز استعمل ملف البناء الخاص بالمنصّة." />
      <Grid#qsGrid columns=1 columns_lg=3 gap=14 gap_lg=20>
        <Card#qs1 padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#qs1c gap=10 align="stretch">
            <Text#qs1n text="1" size=28 color={acc} weight="900" mono="true" />
            <Text#qs1t text="ابنِ المحرّك" size=16 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Code#qs1code src={"git clone https://github.com/dlof-lib/rinlang.git\ncd rinlang/cli/linux && ./build.sh"} />
          </Column>
        </Card>
        <Card#qs2 padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#qs2c gap=10 align="stretch">
            <Text#qs2n text="2" size=28 color={acc} weight="900" mono="true" />
            <Text#qs2t text="اكتب أول ملف" size=16 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Code#qs2code src={"let name = \"Rin\";\nprint \"Hello, \" + name + \"!\";"} />
          </Column>
        </Card>
        <Card#qs3 padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#qs3c gap=10 align="stretch">
            <Text#qs3n text="3" size=28 color={acc} weight="900" mono="true" />
            <Text#qs3t text="شغّله وافحصه" size=16 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Code#qs3code src={"rin run hello.rin\nrin check hello.rin\nrin doctor"} />
          </Column>
        </Card>
      </Grid>
    </Column>

    <!-- ============ 05 · جولة في اللغة ============ -->
    <Column#tour gap=20 align="stretch">
      <Head#h4 num="٠٥" tag="جولة في اللغة" title="خمس لقطات، كود حقيقي" desc="المقتطفات مأخوذة من التوثيق الرسمي. اضغط تبويباً لتبديل اللقطة — والتبديل نفسه مكتوب بخلية warp واحدة." />
      <Wrap#tourTabs gap=8>
        <<each tourTitles as tt, ti>>
          <Button#tb label={tt} bg={tabBg(tab, ti, light)} color={tabFg(tab, ti, light)} weight="700" onTap={tab = ti} />
        <</each>>
      </Wrap>
      <Card#tourPane padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
        <Column#tourPaneC gap=12 align="stretch">
          <Text#tourHead text={tourHeads[tab]} size=18 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
          <Text#tourNote text={tourNotes[tab]} size=13.5 color={pick(light, "#93a1ab", "#4b5a63")} />
          <Code#tourCode src={tourCode[tab]} />
        </Column>
      </Card>
    </Column>

    <!-- ============ 06 · الملعب التفاعلي ============ -->
    <Column#playground gap=22 align="stretch">
      <Head#h5 num="٠٦" tag="الملعب التفاعلي" title="الصفحة نفسها برنامج حيّ" desc="غيّر لون التمييز أو اضغط العدّاد — كل ما ترتبط به الخلية يُعاد رسمه فوراً، بلا سطر JavaScript." />
      <Grid#pgGrid columns=1 columns_lg=2 gap=14 gap_lg=20>
        <Card#pgColor padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#pgColorC gap=12 align="stretch">
            <Text#pgColorT text="لون التمييز" size=16 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Text#pgColorD text="يُخزَّن في خلية warp اسمها acc، وتقرؤه عشرات العناصر في الصفحة." size=13 color={pick(light, "#93a1ab", "#4b5a63")} />
            <Wrap#pgSw gap=8>
              <<each accents as ac, ai>>
                <Button#sw label={accentNames[ai]} bg={ac} color="#04110b" weight="800" onTap={acc = ac} />
              <</each>>
            </Wrap>
          </Column>
        </Card>
        <Card#pgCount padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#pgCountC gap=12 align="stretch">
            <Text#pgCountT text="عدّاد حيّ" size=16 color={pick(light, "#eef3f1", "#10201a")} weight="800" />
            <Text#pgCountV text={"" + count} size=48 color={acc} weight="900" mono="true" />
            <Wrap#pgBtns gap=8>
              <Button#cInc label="+ زِد" bg={acc} color="#04110b" weight="800" onTap={count = count + 1} />
              <Button#cDec label="− أنقص" bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={count = count - 1} />
              <Button#cRst label="صفر" bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" onTap={count = 0} />
            </Wrap>
          </Column>
        </Card>
      </Grid>
    </Column>

    <!-- ============ 07 · معرض الأمثلة ============ -->
    <Column#examples gap=20 align="stretch">
      <Head#h7x num="٠٧" tag="أمثلة جاهزة" title="شغّلها بنفسك، وقارن المخرجات" desc="كل مثال هنا نُفِّذ فعلاً بمحرّك Rin، والمخرجات المعروضة هي الناتج الحقيقي — لا مُنمَّقة ولا مُختصرة." />
      <Wrap#exTabs gap=8>
        <<each exTitles as et, ei>>
          <Button#eb label={et} bg={tabBg(ex, ei, light)} color={tabFg(ex, ei, light)} weight="700" onTap={ex = ei} />
        <</each>>
      </Wrap>
      <Grid#exGrid columns=1 columns_lg=2 gap=14 gap_lg=20>
        <Card#exPane padding=20 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#exPaneC gap=12 align="stretch">
            <Text#exNote text={exNotes[ex]} size=13.5 color={pick(light, "#93a1ab", "#4b5a63")} />
            <Code#exCodeBox src={exCode[ex]} />
          </Column>
        </Card>
        <Card#exOutCard padding=20 bg="#080b0f" radius=22 shadow="true">
          <Column#exOutC gap=12 align="stretch">
            <Text#exOutL text="← المخرجات الفعلية" size=12 color="#5d6b75" weight="800" />
            <Text#exOutT text={exOut[ex]} size=13.5 color={pick(light, "#ffc857", "#8a5a00")} weight="700" mono="true" />
            <Button#exMore label="مزيد من الأمثلة في المستودع" bg={pick(light, "#151c25", "#d9e2de")} color={acc} weight="700" url="https://github.com/dlof-lib/rinlang/tree/main/examples" />
          </Column>
        </Card>
      </Grid>
    </Column>

    <!-- ============ 08 · Indsin ============ -->
    <Column#indsin gap=22 align="stretch">
      <Head#h6 num="٠٨" tag="Indsin" title="لغة الواجهات: Interface Design" desc="Indsin هو محرّك عرض الواجهات في Rin. تكتب وسوماً بسيطة، فيقيسها المحرّك ويخطّطها ويرسمها — على أندرويد وسطح المكتب وCLI والمتصفح بالمسار نفسه." />
      <Card#indsinProof padding=22 bg={pick(light, "#0a1620", "#e8f3fb")} radius=22 shadow="true">
        <Column#indsinProofc gap=10 align="stretch">
          <Text#indsinProofT text="هذه الصفحة هي الدليل" size=17 color={pick(light, "#7cc4ff", "#0b5c99")} weight="800" />
          <Text#indsinProofD text="كل ما تراه هنا — الأزرار والتبويبات والدرج والأسئلة المنسدلة — شجرة Indsin مكتوبة في ملف واحد اسمه site.rin، بلا سطر HTML واحد." size=13.5 color={pick(light, "#93a1ab", "#4b5a63")} />
          <Button#indsinProofB label="اقرأ دليل Indsin" bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/indsin.md" />
        </Column>
      </Card>
      <Grid#indsinGrid columns=1 columns_md=2 columns_lg=4 gap=14 gap_lg=20>
        <Feature#g1 icon="⟡" title="Warp" desc="خلايا حالة تفاعلية؛ تغيّر قيمة فيُعاد رسم ما يرتبط بها فقط." />
        <Feature#g2 icon="⟢" title="إجراءات" desc="toggle وset وshow وhide وseq جاهزة دون كتابة دوال." />
        <Feature#g3 icon="⟣" title="تخطيط متجاوب" desc="Column وRow وGrid وWrap، ولاحقات _md و_lg لكل خاصية." />
        <Feature#g4 icon="⟤" title="معاينة حيّة" desc="تعديل الملف ينعكس فوراً على الهاتف أو المتصفح." />
      </Grid>
      <Button#indsinElems label="كتالوج العناصر الكامل" bg={pick(light, "#151c25", "#d9e2de")} color={pick(light, "#eef3f1", "#10201a")} weight="700" url="https://github.com/dlof-lib/rinlang/blob/main/docs/RIN_ELEMENTS.md" />
    </Column>

    <!-- ============ 09 · مسار التنفيذ ============ -->
    <Column#pipeline gap=22 align="stretch">
      <Head#h7 num="٠٩" tag="كيف تعمل" title="خمس مراحل، محرّك واحد" desc="من السطر الأول في ملفك إلى البكسل على الشاشة." />
      <Grid#pipeGrid columns=1 columns_md=2 columns_lg=5 gap=12 gap_lg=14>
        <Stage#sg1 n="01" title="Lexer" desc="يقطّع المصدر إلى رموز (tokens)." />
        <Stage#sg2 n="02" title="Parser" desc="يبني شجرة الصياغة AST." />
        <Stage#sg3 n="03" title="Interpreter" desc="ينفّذ برنامج Rin كاملاً: الحاويات والحلقات وmake." />
        <Stage#sg4 n="04" title="Indsin" desc="يقيس شجرة Strand ويخطّطها." />
        <Stage#sg5 n="05" title="Fabric" desc="يُخرج شجرة العرض ليرسمها المضيف: أندرويد أو CLI أو المتصفح." />
      </Grid>
      <Card#pipeLive padding=16 bg="#080b0f" radius=16>
        <Column#pipeLiveC gap=6 align="stretch">
          <Text#pipeLiveL text="مولَّد الآن بحلقة for + make داخل هذه الصفحة:" size=11.5 color="#5d6b75" weight="700" />
          <Text#pipeLiveT text={livePipelineStr} size=13 color={acc} weight="700" mono="true" />
        </Column>
      </Card>
    </Column>

    <!-- ============ 10 · تعلّم ============ -->
    <Column#learn gap=22 align="stretch">
      <Head#h8 num="١٠" tag="تعلّم" title="من الصفر إلى أول تطبيق" desc="ستّ محطات مرتّبة. كل محطة وثيقة رسمية قصيرة." />
      <Grid#learnGrid columns=1 columns_md=2 columns_lg=3 gap=14 gap_lg=20>
        <Step#ln1 n="1" title="التثبيت والأوامر" desc="ابنِ rin وجرّب rin doctor." href="https://github.com/dlof-lib/rinlang/blob/main/docs/getting-started.md" />
        <Step#ln2 n="2" title="الصياغة والمتغيّرات" desc="let وprint والتعابير والأنواع." href="https://github.com/dlof-lib/rinlang/blob/main/docs/syntax.md" />
        <Step#ln3 n="3" title="الدوال والتحكّم" desc="fun وif وwhen وwhile وfor." href="https://github.com/dlof-lib/rinlang/blob/main/docs/functions.md" />
        <Step#ln4 n="4" title="الحاويات" desc="@container وقواعد البيانات المدمجة." href="https://github.com/dlof-lib/rinlang/blob/main/docs/containers.md" />
        <Step#ln5 n="5" title="الواجهات" desc="Indsin والعناصر والمعاينة الحيّة." href="https://github.com/dlof-lib/rinlang/blob/main/indsin.md" />
        <Step#ln6 n="6" title="مشروعك الأول" desc="تصفّح الأمثلة الجاهزة وعدّل عليها." href="https://github.com/dlof-lib/rinlang/tree/main/examples" />
      </Grid>
      <Button#learnRef label="المرجع الشامل للغة" bg={acc} color="#04110b" weight="800" url="https://github.com/dlof-lib/rinlang/blob/main/docs/language-reference.md" />
    </Column>

    <!-- ============ 11 · المنظومة ============ -->
    <Column#ecosystem gap=22 align="stretch">
      <Head#h9 num="١١" tag="المنظومة" title="كل ما حول اللغة" desc="أدوات ومكتبات وجسور تجعل Rin جاهزة للعمل اليومي." />
      <Grid#ecoGrid columns=1 columns_md=2 columns_lg=3 gap=14 gap_lg=20>
        <Link#e1 title="المكتبات" desc="أكثر من 80 مكتبة رسمية وحزم المجتمع في المتجر." label="فتح المتجر" href="?view=libraries" />
        <Link#e2 title="RinStudio" desc="IDE كامل على أندرويد." label="فتح" href="https://github.com/dlof-lib/rinlang/blob/main/docs/android.md" />
        <Link#e3 title="RinPM" desc="مدير الحزم والمتجر." label="فتح" href="https://github.com/dlof-lib/rinlang/blob/main/lib/README.md" />
        <Link#e4 title="الربط" desc="جسور Python وNode.js وC." label="فتح" href="https://github.com/dlof-lib/rinlang/blob/main/bindings/README.md" />
        <Link#e5 title="RinHTML" desc="شغّل ملفات .rin داخل أي صفحة HTML." label="فتح" href="https://github.com/dlof-lib/rinlang/blob/main/docs/html-projects.md" />
        <Link#e6 title="حزم المحتوى" desc="لغات وأصول قابلة للتنزيل." label="فتح" href="https://github.com/dlof-lib/rinlang/blob/main/docs/CONTENT_PACKS.md" />
      </Grid>
    </Column>

    <!-- ============ 12 · الصراحة أولاً ============ -->
    <Column#fit gap=22 align="stretch">
      <Head#h10 num="١٢" tag="الصراحة أولاً" title="متى تناسبك Rin؟" desc="" />
      <Grid#fitGrid columns=1 columns_lg=2 gap=14 gap_lg=20>
        <Card#fitYes padding=22 bg={pick(light, "#0a1f16", "#e6f6ec")} radius=22 shadow="true">
          <Column#fitYesc gap=10 align="stretch">
            <Text#fitYesT text="✓ اختَرها إذا" size=16 color="#34d27b" weight="800" />
            <Text#fitYesD text="أردت لغة صغيرة تتعلّمها في أيام · تبني أدوات وواجهات خفيفة · تبرمج من الهاتف · تحتاج النتيجة نفسها على CLI وأندرويد والويب." size=13.5 color={pick(light, "#a7b8ae", "#3c4f45")} />
          </Column>
        </Card>
        <Card#fitNo padding=22 bg={pick(light, "#0e1218", "#ffffff")} radius=22 shadow="true">
          <Column#fitNoc gap=10 align="stretch">
            <Text#fitNoT text="✕ ربما لا إذا" size=16 color={pick(light, "#ffc857", "#8a5a00")} weight="800" />
            <Text#fitNoD text="احتجت منظومة مكتبات ضخمة جاهزة لكل مجال · أو أداءً حرجاً لا يقبل مفسّراً · أو فريقاً كبيراً مرتبطاً بلغة أخرى أصلاً." size=13.5 color={pick(light, "#93a1ab", "#4b5a63")} />
          </Column>
        </Card>
      </Grid>
    </Column>

    <!-- ============ 13 · الأسئلة الشائعة ============ -->
    <Column#faq gap=22 align="stretch">
      <Head#h11 num="١٣" tag="أسئلة شائعة" title="إجابات سريعة" desc="اضغط السؤال لفتح الجواب — يُغلق ما قبله تلقائياً." />
      <Column#faqList gap=10 align="stretch">
        <Faq#q1 idx=1 q="ما هي Rin؟" a="لغة برمجة صغيرة بمحرّك C++23 واحد يعمل من سطر الأوامر وفي IDE أندرويد وفي المتصفح عبر WebAssembly." />
        <Faq#q2 idx=2 q="هل أحتاج إلى تثبيت؟" a="لا للتجربة: افتح الـ Playground في المتصفح. للاستخدام اليومي ابنِ rin من المصدر أو ثبّت RinStudio على أندرويد." />
        <Faq#q3 idx=3 q="كيف أنشر مكتبتي؟" a="من RinStudio عبر RinPM؛ تظهر تلقائياً في متجر المكتبات على الموقع مع رابط مباشر لها." />
        <Faq#q4 idx=4 q="ما هو Indsin؟" a="محرّك واجهات Rin (Interface Design): تكتب الوسوم فيقيسها ويرسمها بالمسار نفسه على كل المنصّات." />
        <Faq#q5 idx=5 q="ما الترخيص؟" a="رخصة MIT. الاسم والشعار غير مشمولين بالترخيص — راجع TRADEMARKS.md." />
        <Faq#q6 idx=6 q="كيف أساهم؟" a="اقرأ CONTRIBUTING.md وقواعد السلوك ثم افتح Issue أو Pull Request على GitHub." />
        <Faq#q7 idx=7 q="هل يعمل الاتصال بالشبكة (HTTP) في المتصفح؟" a="نعم: في نسخة WebAssembly تُنفَّذ الطلبات عبر fetch() الحقيقية في المتصفح، فتخضع لسياسة CORS. على سطر الأوامر يُستخدم curl، لذا يلزم وجوده في PATH." />
        <Faq#q8 idx=8 q="كيف أتحقق من سلامة بيئتي؟" a="شغّل rin doctor لفحص التثبيت، وrin check ملف.rin لفحص ملف دون تنفيذه." />
        <Faq#q9 idx=9 q="هل يمكنني تنزيل ملفات كبيرة من برنامج Rin؟" a="على سطر الأوامر يُكتب التنزيل مباشرة إلى القرص مع استئناف وحدّ حجم اختياريين. في المتصفح يُجلب الملف كاملاً إلى ذاكرة الصفحة ثم يُكتب في نظام ملفات افتراضي، فلا استئناف هناك." />
      </Column>
    </Column>

    <!-- ============ 14 · دعوة للعمل ============ -->
    <Card#cta padding=28 padding_lg=48 gradient="#0d1a14,#08140f" radius=28 shadow="true">
      <Column#ctaCol gap=14 align="stretch">
        <Text#ctaTitle text="جاهز لأول برنامج Rin؟" size=26 size_lg=38 color="#eef3f1" weight="900" />
        <Text#ctaDesc text="الشيفرة كاملة ومفتوحة، والموقع نفسه يُبنى وينشر تلقائياً بلغة Rin عبر GitHub Actions." size=14 size_lg=16 color="#93a1ab" />
        <Wrap#ctaBtns gap=10>
          <Button#ctaRepo label="افتح المستودع على GitHub" bg={acc} color="#04110b" weight="800" url="https://github.com/dlof-lib/rinlang" />
          <Button#ctaLibs2 label="📚 مكتبات Rin" bg="#10161d" color="#eef3f1" weight="700" url="?view=libraries" />
        </Wrap>
      </Column>
    </Card>

    <!-- ============ التذييل ============ -->
    <Divider#dFoot height=1 color={pick(light, "#1a232d", "#d5dedb")} />
    <Grid#footer columns=1 columns_lg=3 gap=18 align="stretch">
      <Column#footBrand gap=8 align="stretch">
        <Text#footLogo text="rin" size=22 color={acc} weight="900" mono="true" />
        <Text#footCopy text="© 2026 Rin Project Contributors — MIT" size=12 color="#5d6b75" />
        <Button#toTop label="↑ إلى الأعلى" bg={pick(light, "#10161d", "#e3eae7")} color={acc} weight="700" url="#hero" />
      </Column>
      <Column#footC1 gap=10 align="stretch">
        <Text#footH1 text="المشروع" size=12 color={pick(light, "#93a1ab", "#4b5a63")} weight="800" />
        <Row#footL1 gap=16>
          <Text#fl1 text="GitHub" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang" />
          <Text#fl2 text="التوثيق" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang/blob/main/docs/" />
          <Text#fl3 text="الأمثلة" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang/tree/main/examples" />
        </Row>
      </Column>
      <Column#footC2 gap=10 align="stretch">
        <Text#footH2 text="المجتمع" size=12 color={pick(light, "#93a1ab", "#4b5a63")} weight="800" />
        <Row#footL2 gap=16>
          <Text#fl4 text="المشاكل" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang/issues" />
          <Text#fl5 text="المساهمة" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang/blob/main/CONTRIBUTING.md" />
          <Text#fl6 text="الأمان" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang/blob/main/SECURITY.md" />
          <Text#fl7 text="العلامة" size=12.5 color={pick(light, "#cfd8d4", "#2a3a33")} url="https://github.com/dlof-lib/rinlang/blob/main/TRADEMARKS.md" />
        </Row>
      </Column>
    </Grid>
  </Column>
</Scaffold>
