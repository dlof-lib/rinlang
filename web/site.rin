// =============================================================================
// site.rin — الصفحة الرسمية للغة Rin (إعادة بناء كاملة، احترافية، موسّعة)
// -----------------------------------------------------------------------------
// مكتوبة بالكامل بلغة Rin — صفر أسطر HTML، صفر سلاسل نصية مبنية بالدمج. كل
// عنصر أدناه (@view.Kind=name) هو Strand حقيقي يبنيه ويخطّطه محرك Loomtime
// الرسمي (نفس rin_lexer/rin_parser/rin_interpreter المستخدمة في rin_run
// وتطبيق أندرويد)، ثم يُرسل كشجرة JSON إلى web/index.html (المحمّل العام
// البحت) ليرسمها المتصفح. راجع docs/loomtime/RIN_LOOM_ENGINE_ARCHITECTURE.md.
//
// ملاحظة لغوية: داخل @view، قيم السمات تُقيَّم عبر مُقيِّم مصغّر يفهم فقط:
// حرفيات، خلايا warp، عمليات + - * / على نصوص/أرقام، ونداءات onTap=fn(...).
// لذلك لا توجد حلقات/شروط هنا؛ كل بطاقة مكتوبة يدوياً — بالضبط كما تكتب أي
// تطبيق Loomtime حقيقي آخر.
//
// لكن كل ما *قبل* @view.Scaffold أدناه هو برنامج Rin كامل وحقيقي — يُنفَّذ
// بالكامل عبر rin::Interpreter::run() (@container، for، make، الدوال، كل شيء)
// قبل أن يبني Loom الشجرة إطلاقاً (انظر runColdPipelineWithRuntime في
// loom/rin_loom_pipeline.h). لذلك نستخدمه هنا فعلياً بدل الاكتفاء بعرضه في
// قسم "جولة في اللغة": حاوية container.doc حقيقية تُعدّ أقسام هذه الصفحة، ثم
// حلقة for + make تُنشئ حاويات ديناميكية إضافية وقت التشغيل — والنتيجتان
// تُقرآن حيّاً في warp cells يعرضهما شريط الإحصاءات أدناه (بطاقة رابعة).
//
// خريطة الأقسام: topbar · drawer · hero · stats · features · tour (جولة في
// اللغة، أمثلة كود حقيقية) · thisPage (هذه الصفحة نفسها) · rinhtml ·
// quickstart · ecosystem · compare (لماذا Rin) · faq · finalCta · footer
// =============================================================================

// ---- برمجة حقيقية قبل أي @view: حاوية NoSQL تُعدّ أقسام هذه الصفحة نفسها ----
@container.doc=pageSections
  document id="s0" fields={ name: "hero",        kind: "section" };
  document id="s1" fields={ name: "stats",       kind: "section" };
  document id="s2" fields={ name: "features",    kind: "section" };
  document id="s3" fields={ name: "tour",        kind: "section" };
  document id="s4" fields={ name: "code",        kind: "section" };
  document id="s5" fields={ name: "rinhtml",     kind: "section" };
  document id="s6" fields={ name: "quickstart",  kind: "section" };
  document id="s7" fields={ name: "ecosystem",   kind: "section" };
  document id="s8" fields={ name: "compare",     kind: "section" };
  document id="s9" fields={ name: "faq",         kind: "section" };
.end/container.doc

let sectionCount = len(queryDocs("pageSections", "kind", "section"));

// حلقة for + make + create(): تبني حاوية ديناميكية منفصلة لكل مقتطف كود حقيقي
// في قسم "جولة في اللغة" (سبعة مقتطفات)، وتكتب عنوانه الحقيقي بـ setField() —
// بدل عدّها يدوياً أو الاكتفاء برقم فارغ.
let tourTitles = [
    "متغيّرات وطباعة",
    "شرطان متكافئان: if/else وwhen/otherwise",
    "دوال، تكرار ذاتي، وحلقات",
    "مصفوفات وقواميس (كائنات)",
    "الأنابيب |> بدل تعشيش الاستدعاءات",
    "قاعدة بيانات NoSQL مدمجة",
    "for + make: حاويات ديناميكية وقت التشغيل"
];

for (let i = 0; i < len(tourTitles); i = i + 1) {
    make kind = "tourSnippet";
    make name = "tourSnippet_" + i;
    create(kind, name);
    setField(name, "index", i);
    setField(name, "title", tourTitles[i]);
}
let totalContainers = len(containerNames());

// قراءة حيّة: العناوين السبعة تُجمَع رجوعاً من الحاويات نفسها عبر getField() —
// وليس من مصفوفة tourTitles مباشرة — لإثبات أن الكتابة والقراءة وقت التشغيل
// حقيقيتان فعلاً، لا مجرد نسخ نص ثابت. النتيجة تُعرض حرفياً في قسم "معاينة حية".
let liveTitles = "";
for (let i = 0; i < len(tourTitles); i = i + 1) {
    liveTitles = liveTitles + (i + 1) + ") " + getField("tourSnippet_" + i, "title");
    if (i < len(tourTitles) - 1) { liveTitles = liveTitles + "\n"; }
}

warp navOpen    = "false";

warp sectionCountStr    = "" + sectionCount;
warp totalContainersStr = "" + totalContainers;
warp liveTitlesStr      = liveTitles;

warp copyVars   = "false";
warp copyFlow   = "false";
warp copyFun    = "false";
warp copyData   = "false";
warp copyPipe   = "false";
warp copyDb     = "false";
warp copyMake   = "false";
warp copyPage   = "false";
warp copyHtml   = "false";

@view.Scaffold=page

  // ================================ الشريط العلوي ================================
  @view.TopBar=nav
    role="topbar"; padding=14; bg="#0a0c0acc"; shadow="true";
    @view.Row=navRow
      gap=10; valign="center";
      @view.Text=brand text="⧉ Rin"; size=19; weight="800"; color="#f4f6f3"; .end/view
      @view.Button=docsTop label="التوثيق"; url="https://github.com/dlof-lib/rinlang/tree/main/docs"; bg="#10130f"; color="#f4f6f3"; .end/view
      @view.Button=ghTop label="GitHub"; url="https://github.com/dlof-lib/rinlang"; bg="#10130f"; color="#f4f6f3"; .end/view
      @view.Button=menuBtn label="☰"; onTap=toggle(navOpen); bg="#10130f"; color="#f4f6f3"; .end/view
    .end/view
  .end/view

  // ============================== درج التنقّل (جوال) ==============================
  @view.Drawer=mobileMenu
    role="drawer"; open=navOpen; width=270; bg="#0d100d";
    @view.Column=drawerCol
      gap=2; padding=20;
      @view.Text=drawerLabel text="التنقّل"; size=12; color="#5b655d"; weight="700"; .end/view
      @view.MenuItem=dm1  label="لماذا Rin";        url="#features";   onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm2  label="جولة في اللغة";     url="#tour";       onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm3  label="هذه الصفحة كودها"; url="#code";       onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm4  label="Rin في المتصفح";    url="#rinhtml";    onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm5  label="البدء السريع";      url="#quickstart"; onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm6  label="المنظومة";          url="#ecosystem";  onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm7  label="لماذا لا لغة أخرى؟"; url="#compare";   onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.MenuItem=dm8  label="الأسئلة الشائعة";    url="#faq";       onTap=toggle(navOpen); color="#f4f6f3"; .end/view
      @view.Divider=dmDiv height=1; color="#1c231d"; .end/view
      @view.MenuItem=dm9  label="التوثيق الكامل"; url="https://github.com/dlof-lib/rinlang/tree/main/docs"; onTap=toggle(navOpen); color="#9aa39c"; .end/view
      @view.MenuItem=dm10 label="GitHub"; url="https://github.com/dlof-lib/rinlang"; onTap=toggle(navOpen); color="#22c55e"; .end/view
    .end/view
  .end/view

  // ==================================== المحتوى ====================================
  @view.Column=content
    gap=44; padding=20;

    // ------------------------------------ Hero ------------------------------------
    @view.Column=hero
      gap=16; padding=30; align="center"; gradient="#0d100d,#0a140d"; radius=20; shadow="true";

      @view.Text=heroEyebrow text="لغة برمجة صغيرة، حقيقية بالكامل"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=heroTitle
        text="Rin — لغة واحدة، محرّك C++17 واحد، ثلاث منصّات";
        size=27; weight="900"; color="#f4f6f3";
      .end/view
      @view.Text=heroDesc
        text="Lexer وParser وInterpreter حقيقية بلا أي إطار خارجي، تعمل كسطر أوامر، داخل IDE أندرويد كامل بـ Kotlin، وداخل المتصفح مباشرة عبر WebAssembly — نفس الملفات الثلاثة، بلا نسخ ولا إعادة كتابة. حتى هذه الصفحة التي تقرأها الآن مكتوبة بها.";
        size=14; color="#9aa39c";
      .end/view

      @view.Wrap=heroBadges
        gap=8;
        @view.Card=badge1 padding=8; bg="#141a15"; radius=999;
          @view.Text=badge1t text="C++17"; size=12; color="#4ade80"; mono="true"; .end/view
        .end/view
        @view.Card=badge2 padding=8; bg="#141a15"; radius=999;
          @view.Text=badge2t text="Kotlin"; size=12; color="#4ade80"; mono="true"; .end/view
        .end/view
        @view.Card=badge3 padding=8; bg="#141a15"; radius=999;
          @view.Text=badge3t text="WebAssembly"; size=12; color="#4ade80"; mono="true"; .end/view
        .end/view
        @view.Card=badge4 padding=8; bg="#141a15"; radius=999;
          @view.Text=badge4t text="NoSQL"; size=12; color="#4ade80"; mono="true"; .end/view
        .end/view
        @view.Card=badge5 padding=8; bg="#141a15"; radius=999;
          @view.Text=badge5t text="MIT"; size=12; color="#4ade80"; mono="true"; .end/view
        .end/view
      .end/view

      @view.Column=heroCtas
        gap=10;
        @view.Button=ctaRepo
          label="افتح المستودع على GitHub";
          url="https://github.com/dlof-lib/rinlang";
          bg="#22c55e"; color="#0a0c0a"; weight="800";
        .end/view
        @view.Button=ctaQuickstart
          label="ابدأ الآن ↓";
          url="#quickstart";
          bg="#141a15"; color="#f4f6f3"; weight="700";
        .end/view
      .end/view
    .end/view

    // -------------------------------- شريط إحصاءات ---------------------------------
    @view.Grid=statsRow
      columns=2; gap=12;
      @view.Card=stat1 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=stat1c gap=2;
          @view.Text=stat1n text="1"; size=22; weight="900"; color="#22c55e"; .end/view
          @view.Text=stat1l text="محرّك C++17 واحد لكل شيء"; size=12; color="#9aa39c"; .end/view
        .end/view
      .end/view
      @view.Card=stat2 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=stat2c gap=2;
          @view.Text=stat2n text="3"; size=22; weight="900"; color="#22c55e"; .end/view
          @view.Text=stat2l text="منصّات تشغيل: CLI / Android / Web"; size=12; color="#9aa39c"; .end/view
        .end/view
      .end/view
      @view.Card=stat3 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=stat3c gap=2;
          @view.Text=stat3n text="0"; size=22; weight="900"; color="#22c55e"; .end/view
          @view.Text=stat3l text="أسطر جافاسكربت داخل main.rin"; size=12; color="#9aa39c"; .end/view
        .end/view
      .end/view
      @view.Card=stat4 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=stat4c gap=2;
          @view.Text=stat4n text=sectionCountStr; size=22; weight="900"; color="#22c55e"; .end/view
          @view.Text=stat4l
            text="قسم في هذه الصفحة — مُحصاة الآن حيّاً عبر container.doc حقيقي (والمجموع مع حاويات for+make الديناميكية: " + totalContainersStr + ")";
            size=12; color="#9aa39c";
          .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv1 height=1; color="#1c231d"; .end/view

    // -------------------------------- لماذا Rin --------------------------------
    @view.Column=features
      gap=14;
      @view.Text=featuresEyebrow text="لماذا Rin"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=featuresTitle text="أكثر من مجرّد لغة برمجة عامة"; size=21; weight="800"; color="#f4f6f3"; .end/view

      @view.Card=f1 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f1c gap=4;
          @view.Text=f1icon text="🧠 مفسّر C++17 مستقل"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f1desc text="Lexer وParser وInterpreter كاملة بلغة C++ نقية، تعمل على أي جهاز فيه g++ بمعزل تام عن أندرويد."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f2 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f2c gap=4;
          @view.Text=f2icon text="📱 IDE أندرويد كامل"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f2desc text="محرر أكواد بتلوين نحوي، حفظ وفتح عبر SAF، مشاريع متعددة، وقوائم File/Edit/View/Run احترافية."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f3 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f3c gap=4;
          @view.Text=f3icon text="📦 لغة حاويات بيانات"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f3desc text="container وContainers.Group وVolume وSection، مع link وtying وmerge لربط ودمج البيانات."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f4 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f4c gap=4;
          @view.Text=f4icon text="🗄️ قاعدة بيانات NoSQL مدمجة"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f4desc text="container.doc مع CRUD كامل: insertDoc وupdateDoc وdeleteDoc وqueryDocs، وعلاقات عبر defineRelation."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f5 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f5c gap=4;
          @view.Text=f5icon text="🔀 خط أنابيب وإحصاء (RinFlow)"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f5desc text="مُشغّل |> يبني Flow Graph حقيقياً قابلاً للبث والإعادة، مع دوال إحصائية جاهزة: mean وstddev وnormalize."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f6 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f6c gap=4;
          @view.Text=f6icon text="🧵 محرّك واجهات Loomtime"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f6desc text="Fabric وLoom وWarp وShuttle وDye — نفس المحرّك الذي يبني هذه الصفحة بالذات، شجرة @view حقيقية بلا HTML."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f7 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f7c gap=4;
          @view.Text=f7icon text="🩺 نظام تشخيصات (Diagnostics)"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f7desc text="أخطاء برمز ومكان دقيق واقتراحات 'did you mean'، بدل رسائل C++ خام عند كتابة برنامج Rin خاطئ."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f8 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f8c gap=4;
          @view.Text=f8icon text="🌐 RinHTML — Rin داخل المتصفح"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f8desc text="عناصر <rin-app> وتوجيهات rin-click/rin-text تشغّل ملف .rin فعلياً كمنطق صفحة HTML، بلا كتابة جافاسكربت."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=f9 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=f9c gap=4;
          @view.Text=f9icon text="🗣️ صياغة إنجليزية طبيعية اختيارية"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=f9desc text="when (x > 5) { ... } otherwise { ... } مطابقة تماماً لـ if/else — نفس السلوك، صياغة أقرب للمبتدئين، ويمكن مزجهما بحرّية."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv2 height=1; color="#1c231d"; .end/view

    // ================================ جولة في اللغة ================================
    @view.Column=tour
      gap=14;
      @view.Text=tourEyebrow text="جولة في اللغة"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=tourTitle text="سبع بطاقات، كود حقيقي، صفر تبسيط مخلّ"; size=21; weight="800"; color="#f4f6f3"; .end/view
      @view.Text=tourDesc
        text="كل مقتطف أدناه مأخوذ حرفياً من التوثيق الرسمي (docs/) أو من samples/showcase.rin، ويعمل فعلياً عبر rin_run — بلا تبسيط تسويقي.";
        size=13; color="#9aa39c";
      .end/view

      // ---- 1) متغيّرات وطباعة ----
      @view.Card=tour1 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour1c gap=8;
          @view.Text=tour1t text="1 — متغيّرات وطباعة"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour1d text="let لأي قيمة، وtext لسلسلة نصية مُنمَّطة الاستخدام."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour1code
            mono="true"; size=12.5; color="#cfd6cf";
            text="let name = \"Rin\";\nlet x = 10;\n\nprint \"Hello, \" + name + \"!\";\nprint x * 2;";
          .end/view
          @view.Button=tour1btn label="نسخ الكود"; onTap=toggle(copyVars);
            copyText="let name = \"Rin\";\nlet x = 10;\n\nprint \"Hello, \" + name + \"!\";\nprint x * 2;";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view

      // ---- 2) شروط: if/else وwhen/otherwise ----
      @view.Card=tour2 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour2c gap=8;
          @view.Text=tour2t text="2 — شرطان متكافئان: if/else وwhen/otherwise"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour2d text="صياغة كلاسيكية وصياغة إنجليزية طبيعية، بنفس المعنى تماماً — اختر ما يناسب من يقرأ الكود."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour2code
            mono="true"; size=12.5; color="#cfd6cf";
            text="if (x > 5) {\n    print \"big\";\n} else {\n    print \"small\";\n}\n\nwhen (age >= 18) {\n    print \"بالغ\";\n} otherwise {\n    print \"قاصر\";\n}";
          .end/view
          @view.Button=tour2btn label="نسخ الكود"; onTap=toggle(copyFlow);
            copyText="if (x > 5) {\n    print \"big\";\n} else {\n    print \"small\";\n}\n\nwhen (age >= 18) {\n    print \"بالغ\";\n} otherwise {\n    print \"قاصر\";\n}";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view

      // ---- 3) دوال وتكرار ----
      @view.Card=tour3 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour3c gap=8;
          @view.Text=tour3t text="3 — دوال، تكرار ذاتي، وحلقات"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour3d text="fun عادية، تدعم الاستدعاء الذاتي (recursion) بلا قيود اصطناعية."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour3code
            mono="true"; size=12.5; color="#cfd6cf";
            text="fun fib(n) {\n    if (n < 2) { return n; }\n    return fib(n - 1) + fib(n - 2);\n}\nprint fib(10);\n\nlet i = 0;\nwhile (i < 5) {\n    print i;\n    i = i + 1;\n}";
          .end/view
          @view.Button=tour3btn label="نسخ الكود"; onTap=toggle(copyFun);
            copyText="fun fib(n) {\n    if (n < 2) { return n; }\n    return fib(n - 1) + fib(n - 2);\n}\nprint fib(10);\n\nlet i = 0;\nwhile (i < 5) {\n    print i;\n    i = i + 1;\n}";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view

      // ---- 4) مصفوفات وقواميس ----
      @view.Card=tour4 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour4c gap=8;
          @view.Text=tour4t text="4 — مصفوفات وقواميس (كائنات)"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour4d text="push وsort جاهزتان للمصفوفات، وفهرسة [\"key\"] عادية للقواميس/الكائنات."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour4code
            mono="true"; size=12.5; color="#cfd6cf";
            text="let arr = [1, 2, 3];\npush(arr, 4);\nprint sort([3, 1, 2]);\n\nlet m = { name: \"Rin\", age: 2 };\nprint m[\"name\"];\nprint keys(m);";
          .end/view
          @view.Button=tour4btn label="نسخ الكود"; onTap=toggle(copyData);
            copyText="let arr = [1, 2, 3];\npush(arr, 4);\nprint sort([3, 1, 2]);\n\nlet m = { name: \"Rin\", age: 2 };\nprint m[\"name\"];\nprint keys(m);";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view

      // ---- 5) الأنابيب |> ----
      @view.Card=tour5 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour5c gap=8;
          @view.Text=tour5t text="5 — الأنابيب |> بدل تعشيش الاستدعاءات"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour5d text="يمرّر |> القيمة على يساره كمُدخل ضمني للدالة على يمينه — سلسلة خطوات مقروءة في سطر واحد."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour5code
            mono="true"; size=12.5; color="#cfd6cf";
            text="let data = [10, 20, 30, 40, 50];\nlet result = data |> normalize() |> mean();\nprint result;\n\nif (result > 0) { print \"طبيعي\"; }";
          .end/view
          @view.Button=tour5btn label="نسخ الكود"; onTap=toggle(copyPipe);
            copyText="let data = [10, 20, 30, 40, 50];\nlet result = data |> normalize() |> mean();\nprint result;\n\nif (result > 0) { print \"طبيعي\"; }";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view

      // ---- 6) حاويات NoSQL ----
      @view.Card=tour6 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour6c gap=8;
          @view.Text=tour6t text="6 — قاعدة بيانات NoSQL مدمجة"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour6d text="Containers.Group وcontainer.doc يبنيان مستندات JSON حقيقية، تُستعلَم عبر queryDocs بلا أي خادم خارجي."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour6code
            mono="true"; size=12.5; color="#cfd6cf";
            text="@Containers.Group=shop_db\n  @container.doc=users\n    document id=\"u1\" fields={ name: \"سارة\", city: \"الرياض\" };\n  .end/container.doc\n.end/Containers.Group\n\nprint queryDocs(\"users\", \"city\", \"الرياض\");";
          .end/view
          @view.Button=tour6btn label="نسخ الكود"; onTap=toggle(copyDb);
            copyText="@Containers.Group=shop_db\n  @container.doc=users\n    document id=\"u1\" fields={ name: \"سارة\", city: \"الرياض\" };\n  .end/container.doc\n.end/Containers.Group\n\nprint queryDocs(\"users\", \"city\", \"الرياض\");";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view
      // ---- 7) حلقة + make + حاويات ديناميكية ----
      @view.Card=tour7 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=tour7c gap=8;
          @view.Text=tour7t text="7 — for + make: إنشاء حاويات ديناميكياً وقت التشغيل"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=tour7d text="داخل حلقة for عادية، make مرادفة تماماً لـ let، وcreate() (أو spawn) تبني حاوية جديدة بنوع/اسم مُحسوبَين في كل دورة — لا حاجة لمعرفة العدد أو الاسم وقت الكتابة."; size=13; color="#9aa39c"; .end/view
          @view.Text=tour7code
            mono="true"; size=12.5; color="#cfd6cf";
            text="for (make i = 0; i < 3; i = i + 1) {\n    make kind = \"table\";\n    if (i == 1) { kind = \"doc\"; }\n    if (i == 2) { kind = \"chatbot\"; }\n    make name = \"dyn_\" + i;\n\n    create(kind, name);\n    setField(name, \"index\", i);\n}\n\nshow containerNames();\nshow kindOf(\"dyn_1\");        // \"doc\"\nshow getField(\"dyn_1\", \"index\"); // 1";
          .end/view
          @view.Button=tour7btn label="نسخ الكود"; onTap=toggle(copyMake);
            copyText="for (make i = 0; i < 3; i = i + 1) {\n    make kind = \"table\";\n    if (i == 1) { kind = \"doc\"; }\n    if (i == 2) { kind = \"chatbot\"; }\n    make name = \"dyn_\" + i;\n\n    create(kind, name);\n    setField(name, \"index\", i);\n}\n\nshow containerNames();\nshow kindOf(\"dyn_1\");\nshow getField(\"dyn_1\", \"index\");";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view
    .end/view

    // ------------------------------ معاينة حية (هذه الصفحة) ------------------------------
    @view.Column=code
      gap=14;
      @view.Text=codeEyebrow text="معاينة حية"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=codeTitle text="حلقة for متكاملة: تكتب، ثم تُقرأ، ثم تُعرض"; size=21; weight="800"; color="#f4f6f3"; .end/view
      @view.Text=codeDesc
        text="نسخ حرفي لأعلى هذا الملف: حلقة for + make + create() تبني حاوية لكل مقتطف كود، وsetField() تكتب عنوانه فيها — كلاهما عبر rin::Interpreter::run() قبل أن يبني Loom أي @view. تحتها مباشرة: نفس العناوين، لكن مقروءة رجوعاً من الحاويات عبر getField() لا من المصفوفة الأصلية — إثبات أن الكتابة والقراءة حقيقيتان وقت التشغيل.";
        size=13; color="#9aa39c";
      .end/view

      @view.Card=codeCard padding=16; bg="#0d100d"; radius=16; shadow="true";
        @view.Column=codeCardCol gap=10;
          @view.Text=codeSnippet
            mono="true"; size=12.5; color="#cfd6cf";
            text="let tourTitles = [ \"متغيّرات وطباعة\", ... ]; // سبعة عناوين حقيقية\n\nfor (let i = 0; i < len(tourTitles); i = i + 1) {\n    make kind = \"tourSnippet\";\n    make name = \"tourSnippet_\" + i;\n    create(kind, name);\n    setField(name, \"title\", tourTitles[i]);\n}\n\n// قراءة حيّة رجوعاً من الحاويات نفسها:\nlet liveTitles = \"\";\nfor (let i = 0; i < len(tourTitles); i = i + 1) {\n    liveTitles = liveTitles + (i + 1) + \") \"\n        + getField(\"tourSnippet_\" + i, \"title\");\n}";
          .end/view
          @view.Button=copyBtn
            label="نسخ الكود";
            onTap=toggle(copyPage);
            copyText="for (let i = 0; i < len(tourTitles); i = i + 1) {\n    make kind = \"tourSnippet\";\n    make name = \"tourSnippet_\" + i;\n    create(kind, name);\n    setField(name, \"title\", tourTitles[i]);\n}\n\nlet liveTitles = \"\";\nfor (let i = 0; i < len(tourTitles); i = i + 1) {\n    liveTitles = liveTitles + (i + 1) + \") \" + getField(\"tourSnippet_\" + i, \"title\");\n}";
            bg="#141a15"; color="#f4f6f3";
          .end/view

          @view.Divider=codeOutDiv height=1; color="#1c231d"; .end/view

          @view.Text=codeOutLabel text="↓ الخرج الفعلي وقت التشغيل (مقروء عبر getField، وليس نصاً ثابتاً)"; size=11; color="#22c55e"; weight="700"; .end/view
          @view.Text=codeOut
            mono="true"; size=12.5; color="#4ade80";
            text=liveTitlesStr;
          .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv4 height=1; color="#1c231d"; .end/view

    // -------------------------------- Rin في المتصفح (RinHTML) --------------------------------
    @view.Column=rinhtml
      gap=14;
      @view.Text=rinhtmlEyebrow text="ميزة"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=rinhtmlTitle text="RinHTML: تشغيل .rin مباشرة داخل صفحة HTML"; size=21; weight="800"; color="#f4f6f3"; .end/view
      @view.Text=rinhtmlDesc
        text="HTML يبقى واجهة عرض فقط، وRin هو من ينفّذ المنطق — بلا جافاسكربت وسيط. عنصر <rin-app> يحمّل ملف .rin ويشغّله عبر نفس محرّك C++17 (WebAssembly)، وتوجيهات rin-click / rin-text تربط الحالة مباشرة بعناصر الصفحة.";
        size=13; color="#9aa39c";
      .end/view

      @view.Card=rinhtmlCard padding=16; bg="#0d100d"; radius=16; shadow="true";
        @view.Column=rinhtmlCardCol gap=10;
          @view.Text=rinhtmlSnippet
            mono="true"; size=12.5; color="#cfd6cf";
            text="<rin-app src=\"main.rin\" allow=\"dom\"></rin-app>\n\n<button rin-click=\"add()\">+1</button>\n<div rin-text=\"count\"></div>\n\n// main.rin\nlet count = 0;\nfun add() { count = count + 1; }";
          .end/view
          @view.Button=copyBtn2
            label="نسخ الكود";
            onTap=toggle(copyHtml);
            copyText="<rin-app src=\"main.rin\" allow=\"dom\"></rin-app>\n\n<button rin-click=\"add()\">+1</button>\n<div rin-text=\"count\"></div>\n\n// main.rin\nlet count = 0;\nfun add() { count = count + 1; }";
            bg="#141a15"; color="#f4f6f3";
          .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv5 height=1; color="#1c231d"; .end/view

    // ------------------------------ البدء السريع -------------------------------
    @view.Column=quickstart
      gap=14;
      @view.Text=qsEyebrow text="ابدأ الآن"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=qsTitle text="أربع خطوات لتشغيل Rin"; size=21; weight="800"; color="#f4f6f3"; .end/view

      @view.Card=s1 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=s1c gap=6;
          @view.Text=s1t text="1 — استنسخ المستودع"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=s1d text="احصل على الشيفرة المصدرية الكاملة للغة والمفسّر."; size=13; color="#9aa39c"; .end/view
          @view.Text=s1code mono="true"; size=12; color="#4ade80";
            text="git clone https://github.com/dlof-lib/rinlang.git";
          .end/view
        .end/view
      .end/view

      @view.Card=s2 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=s2c gap=6;
          @view.Text=s2t text="2 — ابنِ المفسّر الرسمي"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=s2d text="بناء واحد بسيط باستخدام g++ لتفعيل rin_run."; size=13; color="#9aa39c"; .end/view
          @view.Text=s2code mono="true"; size=12; color="#4ade80";
            text="g++ -O2 -std=c++17 -o rin_run tools/rin_run.cpp \\\n  app/src/main/cpp/rin_lexer.cpp \\\n  app/src/main/cpp/rin_parser.cpp \\\n  app/src/main/cpp/rin_interpreter.cpp \\\n  -I app/src/main/cpp";
          .end/view
        .end/view
      .end/view

      @view.Card=s3 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=s3c gap=6;
          @view.Text=s3t text="3 — شغّل أي ملف Rin"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=s3d text="نفّذ برنامجك مباشرة عبر سطر الأوامر."; size=13; color="#9aa39c"; .end/view
          @view.Text=s3code mono="true"; size=12; color="#4ade80";
            text="./rin_run your_program.rin";
          .end/view
        .end/view
      .end/view

      @view.Card=s4 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=s4c gap=6;
          @view.Text=s4t text="4 — جرّب الأمثلة الجاهزة"; size=15; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=s4d text="مجلد examples/ فيه عشرات ملفات .rin الحقيقية: حاويات، NoSQL، Loomtime، دردشة."; size=13; color="#9aa39c"; .end/view
          @view.Text=s4code mono="true"; size=12; color="#4ade80";
            text="./rin_run examples/container_loom_api_demo.rin";
          .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv6 height=1; color="#1c231d"; .end/view

    // ------------------------------- المنظومة ----------------------------------
    @view.Column=ecosystem
      gap=14;
      @view.Text=ecoEyebrow text="منظومة اللغة"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=ecoTitle text="مبنية كمنصّة كاملة، لا لغة معزولة"; size=21; weight="800"; color="#f4f6f3"; .end/view

      @view.Grid=ecoGrid
        columns=2; gap=12;
      @view.Card=e1 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e1t text="🧩 نظام مكتبات @import + حزم CLC مضغوطة (.rcl)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e2 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e2t text="🛍️ متجر حزم داخل التطبيق (RinPM)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e3 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e3t text="🗄️ حاويات بيانات NoSQL (container.doc)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e4 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e4t text="🌐 container.api وroute — محاكاة أو طلب شبكة حقيقي"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e5 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e5t text="🧵 محرّك واجهات Loomtime (هذه الصفحة نفسها)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e6 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e6t text="🌍 RinHTML — تشغيل .rin كمنطق صفحة HTML مباشرة"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e7 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e7t text="⚙️ بناء ونشر تلقائي عبر GitHub Actions (native + WASM + هذه الصفحة)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e8 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e8t text="🖥️ إضافة Visual Studio لتلوين الصياغة"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e9 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e9t text="🔤 ربط مع C / Node.js / Python (bindings/)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      @view.Card=e10 padding=14; bg="#10130f"; radius=14; shadow="true";
        @view.Text=e10t text="🩺 نظام تشخيصات أخطاء برموز ومواقع دقيقة (diagnostics/)"; size=13; color="#cfd6cf"; .end/view
      .end/view
      .end/view
    .end/view

    @view.Divider=secDiv7 height=1; color="#1c231d"; .end/view

    // ------------------------------ لماذا لا لغة أخرى؟ ------------------------------
    @view.Column=compare
      gap=14;
      @view.Text=compareEyebrow text="لماذا Rin تحديداً"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=compareTitle text="لماذا لا Python أو JavaScript فقط؟"; size=21; weight="800"; color="#f4f6f3"; .end/view
      @view.Text=compareDesc
        text="Rin لا تنافس هذه اللغات على العمومية — هي تجمع أربعة أشياء نادراً ما تجدها معاً في مكان واحد:";
        size=13; color="#9aa39c";
      .end/view

      @view.Card=c1 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=c1c gap=4;
          @view.Text=c1t text="⚡ محرّك واحد، لا ثلاث لغات مختلفة"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=c1d text="نفس rin_lexer/rin_parser/rin_interpreter يعمل حرفياً على CLI وAndroid وWeb — لا حاجة لكتابة نفس المنطق ثلاث مرات بثلاث لغات مختلفة."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=c2 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=c2c gap=4;
          @view.Text=c2t text="🗄️ بيانات وواجهة من نفس اللغة"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=c2d text="حاويات NoSQL وأنابيب إحصاء ومحرّك واجهات Loomtime كلها امتدادات أصيلة للغة نفسها، لا مكتبات خارجية منفصلة."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=c3 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=c3c gap=4;
          @view.Text=c3t text="🪶 بلا أي إطار خارجي (Zero-dependency)"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=c3d text="المفسّر يبنى بـ g++ فقط، بلا npm ولا pip ولا مدير حزم إلزامي — ملف واحد وأمر بناء واحد يكفيان."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=c4 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=c4c gap=4;
          @view.Text=c4t text="🗣️ صياغة قابلة للتخصيص للمبتدئين"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=c4d text="when/otherwise إلى جانب if/else — نفس اللغة، بابان مختلفان لدخولها، بلا تجزئة في السلوك أو الأداء."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv8 height=1; color="#1c231d"; .end/view

    // ------------------------------ الأسئلة الشائعة ------------------------------
    @view.Column=faq
      gap=14;
      @view.Text=faqEyebrow text="أسئلة شائعة"; size=12; color="#22c55e"; weight="700"; .end/view
      @view.Text=faqTitle text="قبل ما تبدأ"; size=21; weight="800"; color="#f4f6f3"; .end/view

      @view.Card=q1 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=q1c gap=4;
          @view.Text=q1q text="هل Rin مجرد DSL محدود؟"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=q1a text="لا. لديها متغيرات وشروط وحلقات ودوال ومصفوفات وقواميس كأي لغة عامة، بالإضافة إلى امتدادات حاويات البيانات وLoomtime."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=q2 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=q2c gap=4;
          @view.Text=q2q text="أين تعمل؟"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=q2a text="أي جهاز فيه g++ (سطر أوامر Linux/macOS/Windows)، داخل تطبيق أندرويد عبر JNI، وداخل المتصفح عبر WebAssembly — نفس محرك اللغة بلا تعديل."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=q3 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=q3c gap=4;
          @view.Text=q3q text="ما الرخصة؟"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=q3a text="MIT — الشيفرة المصدرية كاملة ومفتوحة على GitHub، يمكنك استخدامها وتعديلها بحرية."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=q4 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=q4c gap=4;
          @view.Text=q4q text="كيف أشغّل Rin داخل موقع HTML بدون جافاسكربت؟"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=q4a text="عبر RinHTML: أضف <rin-app src=\"file.rin\"> وربطها بعناصر rin-click/rin-text — انظر قسم 'Rin في المتصفح' أعلاه."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=q5 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=q5c gap=4;
          @view.Text=q5q text="هل توجد حزم جاهزة أستخدمها مباشرة؟"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=q5a text="نعم عبر @import للمكتبات القياسية (مثل math)، وعبر RinPM كمتجر حزم داخل تطبيق أندرويد، بالإضافة إلى حزم CLC مضغوطة (.rcl) قابلة للاستيراد من ملف أو مسار."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view

      @view.Card=q6 padding=16; bg="#10130f"; radius=16; shadow="true";
        @view.Column=q6c gap=4;
          @view.Text=q6q text="هل يمكنني المساهمة في المشروع؟"; size=14; weight="700"; color="#f4f6f3"; .end/view
          @view.Text=q6a text="بالتأكيد — المستودع مفتوح على GitHub، ودليل المساهمة موجود في CONTRIBUTING.md مع قواعد سلوك واضحة في CODE_OF_CONDUCT.md."; size=13; color="#9aa39c"; .end/view
        .end/view
      .end/view
    .end/view

    @view.Divider=secDiv9 height=1; color="#1c231d"; .end/view

    // -------------------------------- الدعوة الختامية --------------------------------
    @view.Card=finalCta padding=22; gradient="#0d100d,#0a1610"; radius=20; align="center"; shadow="true";
      @view.Column=finalCtaCol gap=10; align="center";
        @view.Text=finalCtaTitle text="جاهز تكتب أول برنامج Rin؟"; size=18; weight="800"; color="#f4f6f3"; .end/view
        @view.Text=finalCtaDesc text="الشيفرة المصدرية كاملة، موثّقة، ومفتوحة تحت رخصة MIT."; size=13; color="#9aa39c"; .end/view
        @view.Button=finalCtaBtn label="افتح المستودع على GitHub"; url="https://github.com/dlof-lib/rinlang"; bg="#22c55e"; color="#0a0c0a"; weight="800"; .end/view
      .end/view
    .end/view

    // --------------------------------- الفوتر ----------------------------------
    @view.Divider=footerDiv height=1; color="#1c231d"; .end/view
    @view.Column=footer
      gap=10;
      @view.Text=footerCopy text="© 2026 Rin — مبنية ومنشورة تلقائياً بلغة Rin عبر GitHub Actions."; size=12; color="#5b655d"; .end/view
      @view.Row=footerLinks1
        gap=16;
        @view.Text=fl1 text="GitHub"; size=12; color="#9aa39c"; url="https://github.com/dlof-lib/rinlang"; .end/view
        @view.Text=fl2 text="التوثيق"; size=12; color="#9aa39c"; url="https://github.com/dlof-lib/rinlang/tree/main/docs"; .end/view
        @view.Text=fl3 text="الأمثلة"; size=12; color="#9aa39c"; url="https://github.com/dlof-lib/rinlang/tree/main/examples"; .end/view
      .end/view
      @view.Row=footerLinks2
        gap=16;
        @view.Text=fl4 text="الإبلاغ عن مشكلة"; size=12; color="#9aa39c"; url="https://github.com/dlof-lib/rinlang/issues"; .end/view
        @view.Text=fl5 text="المساهمة"; size=12; color="#9aa39c"; url="https://github.com/dlof-lib/rinlang/blob/main/CONTRIBUTING.md"; .end/view
        @view.Text=fl6 text="الرخصة (MIT)"; size=12; color="#9aa39c"; url="https://github.com/dlof-lib/rinlang/blob/main/LICENSE"; .end/view
      .end/view
    .end/view

  .end/view
.end/view
