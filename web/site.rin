// =============================================================================
// site.rin — الصفحة الرسمية للغة Rin
// -----------------------------------------------------------------------------
// هذا الملف مكتوب بالكامل بلغة Rin — ولا يحتوي على سطر HTML واحد، لا كنص حرفي
// ولا كسلسلة مبنية بالدمج (+). النسخة السابقة كانت تبني صفحة HTML كسلسلة نصية
// (buildHead/buildCss/buildNav/...) ثم تكتبها عبر writeFile()؛ هذا استخدام
// "لغة برمجة عامة لتوليد HTML"، وليس "موقعاً مكتوباً بلغة Rin نفسها".
//
// هذه النسخة تستخدم بدل ذلك نحو الواجهات الأصلي في اللغة: @view.<Kind>=name
// (محرّك العرض Loomtime، انظر docs/loomtime/RIN_LOOM_ENGINE_ARCHITECTURE.md
// وapp/src/main/cpp/loom/). الصفحة هنا هي فعلياً شجرة Strand حقيقية
// (Scaffold/TopBar/Drawer/Column/Row/Card/Text/Button/Divider) يبنيها ويخطّطها
// (Loom) نفس المفسّر الرسمي (rin_lexer + rin_parser + rin_ast) المستخدم في
// تطبيق أندرويد وفي rin_run — وليس أي "مولّد HTML" منفصل.
//
// المتصفح لا يفهم إلا HTML/JS/WASM، لذا web/index.html يبقى "محمّلاً" (bootloader)
// عاماً بحتاً: يشغّل محرّك Rin (WASM)، يمرّر له نص هذا الملف عبر
// rin_loom_session_create()، ثم يرسم أي شجرة Strand يُعيدها عبر دالة عرض عامة
// واحدة (map: Strand.kind -> عنصر DOM، Strand.attrs -> تنسيقه) — تلك الدالة
// عامة تماماً (لا تعرف شيئاً عن "Rin" أو "المميزات" أو "GitHub")، مطابقة تماماً
// لِما تفعله بالفعل tools/mirror-loom-preview/*.html كمرجع لنفس المحرّك.
// كل كلمة ولون ورقم وسلوك تفاعل (onTap) في الصفحة قرارُه هنا، لا هناك.
//
// ملاحظة لغوية مهمة: داخل @view، قيم السمات تُقيَّم عبر مُقيِّم مصغّر
// (rin_loom_eval.h) يفهم فقط: حرفيات، خلايا warp، عمليات + - * / على النصوص/
// الأرقام، ونداءات onTap=fn(...)‎. متغيّرات let العادية لا تُستبدَل بقيمتها هنا
// (خاصة بالمفسّر الكامل فقط) — لذلك كل نص أدناه حرفي مباشرة، وأي حالة تفاعلية
// (فتح/إغلاق القائمة، رسالة "تم النسخ") مُخزَّنة في خلايا warp حقيقية.
// =============================================================================

warp navOpen   = "false";
warp copyState = "";

@view.Scaffold=page

  // ------------------------------- الشريط العلوي --------------------------------
  @view.TopBar=nav
    role="topbar"; padding=14; bg="#0a0a10cc";

    @view.Row=navRow
      gap=12; valign="center";
      @view.Text=brand text="⧉ Rin"; size=19; weight="800"; color="#eceef7"; .end/view
      @view.Button=ghTop label="GitHub"; url="https://github.com/dlof-lib/rinlang"; bg="#14141f"; color="#eceef7"; .end/view
      @view.Button=menuBtn label="☰"; onTap=toggle(navOpen); bg="#14141f"; color="#eceef7"; .end/view
    .end/view
  .end/view

  // ------------------------- درج القائمة (تنقّل الجوال) -------------------------
  @view.Drawer=mobileMenu
    role="drawer"; open=navOpen; width=250; bg="#101018";
    @view.Column=drawerCol
      gap=2; padding=20;
      @view.Text=drawerLabel text="التنقّل"; size=12; color="#565768"; weight="700"; .end/view
      @view.MenuItem=dm1 label="المميزات";     url="#features";   onTap=toggle(navOpen); color="#eceef7"; .end/view
      @view.MenuItem=dm2 label="الكود";         url="#code";       onTap=toggle(navOpen); color="#eceef7"; .end/view
      @view.MenuItem=dm3 label="البدء السريع";  url="#quickstart"; onTap=toggle(navOpen); color="#eceef7"; .end/view
      @view.MenuItem=dm4 label="المنظومة";      url="#ecosystem";  onTap=toggle(navOpen); color="#eceef7"; .end/view
      @view.Divider=dmDiv height=1; color="#232336"; .end/view
      @view.MenuItem=dm5 label="GitHub"; url="https://github.com/dlof-lib/rinlang"; onTap=toggle(navOpen); color="#7c5cff"; .end/view
    .end/view
  .end/view

  // ------------------------------- محتوى الصفحة ----------------------------------
  @view.Column=content
    gap=56; padding=20;

    // --------------------------------- Hero ----------------------------------
    @view.Column=hero
      gap=16; padding=28; align="center"; bg="#101018"; radius=18;

      @view.Text=heroEyebrow text="لغة برمجة صغيرة، حقيقية بالكامل"; size=12; color="#7c5cff"; weight="700"; .end/view
      @view.Text=heroTitle
        text="Rin — تكتبها من جوالك، تُصرَّف بمحرّك C++17 حقيقي";
        size=27; weight="900"; color="#eceef7";
      .end/view
      @view.Text=heroDesc
        text="Lexer وParser وInterpreter كاملة، IDE أندرويد بـKotlin، لغة حاويات بيانات، قاعدة NoSQL مدمجة، وخط أنابيب إحصائي — ومحرّك واجهات Loomtime الذي يبني هذه الصفحة نفسها، بلا سطر HTML واحد.";
        size=14; color="#9a9ab0";
      .end/view

      @view.Row=heroBadges
        gap=8;
        @view.Card=badge1 padding=8; bg="#191926"; radius=999;
          @view.Text=badge1t text="C++17"; size=12; color="#00d4ff"; mono="true"; .end/view
        .end/view
        @view.Card=badge2 padding=8; bg="#191926"; radius=999;
          @view.Text=badge2t text="Kotlin"; size=12; color="#00d4ff"; mono="true"; .end/view
        .end/view
        @view.Card=badge3 padding=8; bg="#191926"; radius=999;
          @view.Text=badge3t text="NoSQL"; size=12; color="#00d4ff"; mono="true"; .end/view
        .end/view
        @view.Card=badge4 padding=8; bg="#191926"; radius=999;
          @view.Text=badge4t text="MIT"; size=12; color="#00d4ff"; mono="true"; .end/view
        .end/view
      .end/view

      @view.Button=ctaRepo
        label="افتح المستودع على GitHub";
        url="https://github.com/dlof-lib/rinlang";
        bg="#7c5cff"; color="#0a0a10"; weight="800";
      .end/view
    .end/view

    // ------------------------------- المميزات ---------------------------------
    @view.Column=features
      gap=14;
      @view.Text=featuresEyebrow text="لماذا Rin"; size=12; color="#7c5cff"; weight="700"; .end/view
      @view.Text=featuresTitle text="أكثر من مجرّد لغة برمجة عامة"; size=21; weight="800"; color="#eceef7"; .end/view

      @view.Card=f1 padding=16; bg="#14141f"; radius=14;
        @view.Column=f1c gap=4;
          @view.Text=f1icon text="🧠 مفسّر C++17 مستقل"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=f1desc text="Lexer وParser وInterpreter كاملة بلغة C++ نقية، تعمل على أي جهاز فيه g++ بمعزل تام عن أندرويد."; size=13; color="#9a9ab0"; .end/view
        .end/view
      .end/view

      @view.Card=f2 padding=16; bg="#14141f"; radius=14;
        @view.Column=f2c gap=4;
          @view.Text=f2icon text="📱 IDE أندرويد كامل"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=f2desc text="محرر أكواد بتلوين نحوي، حفظ وفتح عبر SAF، مشاريع متعددة، وقوائم File/Edit/View/Run احترافية."; size=13; color="#9a9ab0"; .end/view
        .end/view
      .end/view

      @view.Card=f3 padding=16; bg="#14141f"; radius=14;
        @view.Column=f3c gap=4;
          @view.Text=f3icon text="📦 لغة حاويات بيانات"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=f3desc text="container وContainers.Group وVolume وSection، مع link وtying وmerge لربط ودمج البيانات."; size=13; color="#9a9ab0"; .end/view
        .end/view
      .end/view

      @view.Card=f4 padding=16; bg="#14141f"; radius=14;
        @view.Column=f4c gap=4;
          @view.Text=f4icon text="🗄️ قاعدة بيانات NoSQL"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=f4desc text="container.doc وdoc مع CRUD كامل: insertDoc وupdateDoc وdeleteDoc وqueryDocs."; size=13; color="#9a9ab0"; .end/view
        .end/view
      .end/view

      @view.Card=f5 padding=16; bg="#14141f"; radius=14;
        @view.Column=f5c gap=4;
          @view.Text=f5icon text="🔀 خط أنابيب وإحصاء"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=f5desc text="مُشغّل |> مع دوال إحصائية جاهزة: mean وstddev وnormalize وscale وغيرها."; size=13; color="#9a9ab0"; .end/view
        .end/view
      .end/view

      @view.Card=f6 padding=16; bg="#14141f"; radius=14;
        @view.Column=f6c gap=4;
          @view.Text=f6icon text="🧵 محرّك واجهات Loomtime"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=f6desc text="Fabric وLoom وWarp وShuttle وDye وNeedle — نفس المحرّك الذي يبني هذه الصفحة، شجرة @view حقيقية بلا HTML."; size=13; color="#9a9ab0"; .end/view
        .end/view
      .end/view
    .end/view

    // ---------------------------- معاينة الشيفرة -------------------------------
    @view.Column=code
      gap=14;
      @view.Text=codeEyebrow text="معاينة حية"; size=12; color="#7c5cff"; weight="700"; .end/view
      @view.Text=codeTitle text="هذه الصفحة نفسها مكتوبة بلغة Rin"; size=21; weight="800"; color="#eceef7"; .end/view
      @view.Text=codeDesc
        text="لا يوجد HTML مكتوب يدوياً ولا سلسلة HTML مبنيّة بالدمج — كل عنصر أدناه (@view.Card وview.Text وview.Button) هو Strand حقيقي بُني وخُطِّط ورُسم عبر Fabric وLoom وDye، تماماً كأي تطبيق Rin آخر على أندرويد.";
        size=13; color="#9a9ab0";
      .end/view

      @view.Card=codeCard padding=16; bg="#101018"; radius=14;
        @view.Column=codeCardCol gap=10;
          @view.Text=codeSnippet
            mono="true"; size=12.5; color="#c9c6dd";
            text="// مقتطف حقيقي من هذا الملف نفسه\nwarp navOpen = \"false\";\n\n@view.Button=menuBtn\n  label=\"☰\";\n  onTap=toggle(navOpen);\n.end/view\n\n// لا HTML — Strand حقيقي، بحالة Warp حقيقية،\n// يُخطَّط برمّته عبر Loom ثم يُرسل كـ JSON إلى المتصفح.";
          .end/view
          @view.Button=copyBtn
            label="نسخ " + copyState;
            onTap=toggle(copyState);
            copyText="warp navOpen = \"false\";\n\n@view.Button=menuBtn\n  label=\"☰\";\n  onTap=toggle(navOpen);\n.end/view";
            bg="#191926"; color="#eceef7";
          .end/view
        .end/view
      .end/view
    .end/view

    // ------------------------------ البدء السريع -------------------------------
    @view.Column=quickstart
      gap=14;
      @view.Text=qsEyebrow text="ابدأ الآن"; size=12; color="#7c5cff"; weight="700"; .end/view
      @view.Text=qsTitle text="ثلاث خطوات فقط لتشغيل Rin"; size=21; weight="800"; color="#eceef7"; .end/view

      @view.Card=s1 padding=16; bg="#14141f"; radius=14;
        @view.Column=s1c gap=6;
          @view.Text=s1t text="1 — استنسخ المستودع"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=s1d text="احصل على الشيفرة المصدرية الكاملة للغة والمفسّر."; size=13; color="#9a9ab0"; .end/view
          @view.Text=s1code mono="true"; size=12; color="#00d4ff";
            text="git clone https://github.com/dlof-lib/rinlang.git";
          .end/view
        .end/view
      .end/view

      @view.Card=s2 padding=16; bg="#14141f"; radius=14;
        @view.Column=s2c gap=6;
          @view.Text=s2t text="2 — ابنِ المفسّر الرسمي"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=s2d text="بناء واحد بسيط باستخدام g++ لتفعيل rin_run."; size=13; color="#9a9ab0"; .end/view
          @view.Text=s2code mono="true"; size=12; color="#00d4ff";
            text="g++ -O2 -std=c++17 -o rin_run tools/rin_run.cpp \\\n  app/src/main/cpp/rin_lexer.cpp \\\n  app/src/main/cpp/rin_parser.cpp \\\n  app/src/main/cpp/rin_interpreter.cpp \\\n  -I app/src/main/cpp";
          .end/view
        .end/view
      .end/view

      @view.Card=s3 padding=16; bg="#14141f"; radius=14;
        @view.Column=s3c gap=6;
          @view.Text=s3t text="3 — شغّل أي ملف Rin"; size=15; weight="700"; color="#eceef7"; .end/view
          @view.Text=s3d text="نفّذ برنامجك مباشرة عبر سطر الأوامر."; size=13; color="#9a9ab0"; .end/view
          @view.Text=s3code mono="true"; size=12; color="#00d4ff";
            text="./rin_run your_program.rin";
          .end/view
        .end/view
      .end/view
    .end/view

    // ------------------------------- المنظومة ----------------------------------
    @view.Column=ecosystem
      gap=14;
      @view.Text=ecoEyebrow text="منظومة اللغة"; size=12; color="#7c5cff"; weight="700"; .end/view
      @view.Text=ecoTitle text="مبنية كمنصّة كاملة، لا لغة معزولة"; size=21; weight="800"; color="#eceef7"; .end/view

      @view.Card=e1 padding=12; bg="#14141f"; radius=12;
        @view.Text=e1t text="🧩 نظام مكتبات @import"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e2 padding=12; bg="#14141f"; radius=12;
        @view.Text=e2t text="🛍️ متجر حزم داخل التطبيق"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e3 padding=12; bg="#14141f"; radius=12;
        @view.Text=e3t text="🗄️ حاويات بيانات NoSQL (container.doc)"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e4 padding=12; bg="#14141f"; radius=12;
        @view.Text=e4t text="🌐 container.api وroute"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e5 padding=12; bg="#14141f"; radius=12;
        @view.Text=e5t text="🧵 محرّك واجهات Loomtime (هذه الصفحة نفسها)"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e6 padding=12; bg="#14141f"; radius=12;
        @view.Text=e6t text="⚙️ بناء ونشر تلقائي عبر GitHub Actions (native + WASM)"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e7 padding=12; bg="#14141f"; radius=12;
        @view.Text=e7t text="🖥️ إضافة Visual Studio لتلوين الصياغة"; size=13; color="#c9c6dd"; .end/view
      .end/view
      @view.Card=e8 padding=12; bg="#14141f"; radius=12;
        @view.Text=e8t text="🔤 ربط مع C / Node.js / Python"; size=13; color="#c9c6dd"; .end/view
      .end/view

      @view.Card=finalCta padding=20; bg="#101018"; radius=18; align="center";
        @view.Column=finalCtaCol gap=10; align="center";
          @view.Text=finalCtaTitle text="جاهز تكتب أول برنامج Rin؟"; size=18; weight="800"; color="#eceef7"; .end/view
          @view.Text=finalCtaDesc text="الشيفرة المصدرية كاملة، موثّقة، ومفتوحة تحت رخصة MIT."; size=13; color="#9a9ab0"; .end/view
          @view.Button=finalCtaBtn label="افتح المستودع على GitHub"; url="https://github.com/dlof-lib/rinlang"; bg="#7c5cff"; color="#0a0a10"; weight="800"; .end/view
        .end/view
      .end/view
    .end/view

    // --------------------------------- الفوتر ----------------------------------
    @view.Divider=footerDiv height=1; color="#232336"; .end/view
    @view.Column=footer
      gap=10;
      @view.Text=footerCopy text="© 2026 Rin — مبنية ومنشورة تلقائياً بلغة Rin عبر GitHub Actions."; size=12; color="#565768"; .end/view
      @view.Row=footerLinks
        gap=16;
        @view.Text=fl1 text="GitHub"; size=12; color="#9a9ab0"; url="https://github.com/dlof-lib/rinlang"; .end/view
        @view.Text=fl2 text="الإبلاغ عن مشكلة"; size=12; color="#9a9ab0"; url="https://github.com/dlof-lib/rinlang/issues"; .end/view
        @view.Text=fl3 text="الرخصة (MIT)"; size=12; color="#9a9ab0"; url="https://github.com/dlof-lib/rinlang/blob/main/LICENSE"; .end/view
      .end/view
    .end/view

  .end/view
.end/view
