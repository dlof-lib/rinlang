@import "compiler_clude";
let s = cc_parse("$token[ ( ) \",\" ; ]\n$infix.2[ or ]\n$infix.3[ and ]\n$infix.5[ == != < > <= >= ]\n$infix.10[ + - ]\n$infix.20[ * / % ]\n$infixr.30[ ^ ]\n$prefix.40[ - ! ]\n$kw[ true false nil ]");
print s["errors"], s["warnings"];
print cc_stats(s)["infix"], cc_stats(s)["prefix"];
print cc_ast_format(cc_parse_statements(s, "1 + 2 * 3")["asts"][0]);
print cc_ast_format(cc_parse_statements(s, "a - b - c")["asts"][0]);
print cc_ast_format(cc_parse_statements(s, "a ^ b ^ c")["asts"][0]);
print cc_ast_format(cc_parse_statements(s, "-a ^ 2 + f(1, x * 2)")["asts"][0]);
print cc_run_expr(s, "1 + 2 * 3", {});
print cc_run_expr(s, "(1 + 2) * 3 - -4", {});
print cc_run_expr(s, "2 ^ 3 ^ 2", {});
print cc_run_expr(s, "x * 2 + min(3, 1) ; x + 1", {"x": 5});
print cc_run_expr(s, "1 < 2 and 3 == 3", {});
print cc_run_expr(s, "false or 4 > 9", {});
print cc_run_expr(s, "\"ab\" + \"cd\"", {});
print cc_run_expr(s, "10 / 0", {});
print cc_run_expr(s, "!true", {});
let p = cc_parse_statements(s, "1 + * 2; (3");
print p["errors"];
print len(cc_parse_statements(s, "1; 2; 3;")["asts"]);
