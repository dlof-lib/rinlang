:sh printf 'let a = 1; // TODO: x\nprint a;\n' > a.rin
:sh cp a.rin b.rin; mkdir -p sub emptyd; : > zero.txt; printf '3 1 4 1 5\n' > n.txt
:sh printf 'name,qty\nfig,7\n"pear, green",10\n' > t.csv; printf '{"u":[{"n":"ann"},{"n":"bob"}],"ok":true}' > d.json
:sh sha256sum a.rin > sums.txt
$ dupes
$ empty
$ todo
$ loc
$ stats n.txt
$ context a.rin 2 -C 1
$ json d.json u[1].n
$ json -m d.json
$ json -c d.json
$ csv t.csv
$ verify sums.txt
$ rename -n '(.*)\.rin' '$1_v2.rin' *.rin
$ rename '(.*)\.rin' '$1_v2.rin' b.rin
$ ls
$ sync -n . ~/mirror
$ sync . ~/mirror
$ sync . ~/mirror
$ backup -d ~/bk n.txt
$ trash zero.txt
$ ls
$ trash -e
$ json nope.json
