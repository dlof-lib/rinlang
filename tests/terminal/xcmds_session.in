:sh printf 'banana\napple\ncherry\napple\n' > fruits.txt
$ cat -n fruits.txt
$ cat fruits.txt -r 2:3
$ head -n 1 fruits.txt
$ tail -1 fruits.txt
$ wc fruits.txt
$ grep -n apple fruits.txt
$ sort -u fruits.txt
$ uniq -c -e "a\na\nb"
$ cut -d , -f 2:3 -e "x,y,z"
$ seq 1…10:3
$ seq -s , 3:1
$ echo -e "a\tb" *.txt
$ mkdir -p d/e
$ cp *.txt d
$ find . -name *.txt
$ mv d/fruits.txt d/f2.txt
$ cmp fruits.txt d/f2.txt
$ rm -r d
$ sha256 -e abc
$ crc32 -e 123456789
$ base64 -e hello
$ base64 -d -e aGVsbG8=
$ rev -e abc
$ upper -e abc
$ alias ll='cat -n'
$ ll fruits.txt -r 1:1
$ unalias ll
$ rm -rf /
$ cat missing.txt
$ help seq
$ calc 2*(3+4)^2 / sqrt(16)
$ calc 1/0
$ conv 255 -t 2
$ factor 360
$ primes 1:20
$ gcd -l 4 6
$ md5 -e abc
$ sha1 -e abc
$ tr a-z A-Z -e "hello"
$ replace hello bye -e "hello world"
$ wordfreq -n 1 -e "a b a"
$ urlencode -e "a b"
$ hex -e Hi
$ timestamp 0 -u
$ cal 2 2024
$ datediff 2026-10-17 2027-01-01
$ numfmt 1536
$ diff fruits.txt fruits.txt
$ exists -f fruits.txt
$ comm -12 fruits.txt fruits.txt
$ yes hi -n 2
$ false
