$ addmonths 2024-01-31 1
$ parsedur 1d 2h 30m
$ datefmt 2024-03-11 %A %d %B %Y
$ dice d1
$ lottery 3 3
$ tree
$ eol crlf.txt f.txt
$ fixeol crlf.txt
$ eol crlf.txt
$ magic a.rin j.json
$ countin one f.txt
$ lines 1,3 f.txt
$ linefreq f.txt
$ rinlint a.rin
$ rinblocks a.rin
$ rinelements a.rin
$ rinids a.rin
$ rinstrings a.rin
$ rindepth a.rin
$ csvcol 1,3 p.csv
$ csvsort -n -k age p.csv
$ csv2json p.csv
$ csv2md p.csv
$ jsonkeys j.json
$ iniget c.ini main k
$ columns a bb ccc
$ spark 1 5 3 8
$ barchart a 3 b 6
