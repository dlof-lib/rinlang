:sh printf '@view.Column=root\n  @view.Text=t1 text="Hi"; .end/view\n  @view.Text=t1 text="Dup"\n.end/view\n' > a.rin
:sh printf 'name,age,city\nAnn,30,Rome\nBob,25,"New, York"\n' > p.csv; printf '{"a":{"b":[1,2]},"c":"x"}' > j.json; printf '[main]\nk=v\n' > c.ini
:sh printf 'a\r\nb\r\n' > crlf.txt; printf 'one\ntwo\none\n' > f.txt
