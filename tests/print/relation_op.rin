// المعامل <!=g=?> : مقارنة شاملة ثلاثية (-1 | 0 | 1) لأي نوعين — docs/container_blend.md · docs/shorthand.md
// 1) أرقام ونصوص
print 1 <!=g=?> 2, 2 <!=g=?> 2, 3 <!=g=?> 2;
print "a" <!=g=?> "b", "b" <!=g=?> "a";
// 2) أنواع مختلطة وبنى مركّبة (نفس ترتيب compare)
print nil <!=g=?> 0, true <!=g=?> 1, [1, 2] <!=g=?> [1, 3], {a: 1} <!=g=?> {a: 1}, Set(1) <!=g=?> Set(1, 2);
// 3) الأسبقية: في مستوى المقارنة، أدنى من + وأعلى من ==
print 1 + 1 <!=g=?> 3 - 1, (1 <!=g=?> 2) == -1, 5 <!=g=?> 3 == 1;
// 4) يتكامل مع كائنات __cmp__ (مفهوم موجود كان غير مستعمل خارج < > <= >=)
class Ver {
    let n = 0;
    fun __cmp__(other) { return self.n - other.n; }
}
let a = Ver(); a.n = 3;
let b = Ver(); b.n = 7;
print a <!=g=?> b, b <!=g=?> a, a <!=g=?> a;
print compare(a, b), compare(b, a);
// 5) في أي مكان يقبل تعبيراً: شرط، match بسيط، دوال
fun order(x, y) { let r = x <!=g=?> y; if (r < 0) { return "أصغر"; } if (r > 0) { return "أكبر"; } return "يساوي"; }
print order(1, 2), order(2, 2), order(3, 2), order("z", "a");
let rows = [3, 1, 2];
let sorted = orderBy(rows);
print (sorted[0] <!=g=?> sorted[2]);
// 6) داخل النصوص لا يتغيّر شيء
print "<!=g=?>";
