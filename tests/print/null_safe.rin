print n ?? n ?? "c";
let m = n ?? "x"; print m;
let c = nil; c ??= 5; print c; c ??= 7; print c;
let d = {}; d.k ??= "set"; d.k ??= "again"; print d.k;
let arr = [nil, 2]; arr[0] ??= 10; arr[1] ??= 20; print arr;
fun f() { print "evaluated"; return 1; }
print 5 ?? f();
