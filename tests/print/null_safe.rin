print `v=${n ?? "tpl"}`;
class Box {
  fun init(v) { self.v = v; self.next = nil; }
  fun get() { return self.v; }
  fun tail() { return self.next?.get() ?? "none"; }
}
let b = Box(1);
print b.tail();
b.next = Box(2);
print b.tail();
let e = nil;
print e?.get();
print b?.next?.get();
print b?.next?.next?.get();
