// <==  ==>  {<=>}  {X,A}  {{"[, ]"}}  (docs/arrows.md)
let a = 0; let b = 0;
a <== 5;
$ a;
a + 1 ==> b;
$ b;
7 ==> a ==> b;
$ a, b;
let x = 1; let y = 2;
x <=> y;
$ x, y;
{x <=> y}
$ x, y;
let arr = [10 20 30];
arr[0] <=> arr[2];
$ arr;
let X = 1; let A = "hi";
$ {X, A};
$ {X, X};
$ {A,A};
$ {X, A: 9};
{{"(, )"}}
$ [1 2 3];
{{"[, ]"}}
$ [1 2 3];
