// الدمج العام لأي مفهوم: blend / blendWith / blendInto / blendRecipe+blendCook — docs/container_blend.md
class Point { let x = 1; let y = 2; }

// map عميق، array لصق، Set اتحاد، نص، رقم
let m = blend({a: 1, in: {x: 1, y: 2}}, {b: 2, in: {y: 9, z: 3}});
print m["a"], m["b"], m["in"]["x"], m["in"]["y"], m["in"]["z"];
print blend([1, 2], [2, 3], [4]);
print len(blend(Set(1, 2), Set(2, 3))), blend(Set(1), Set(2)).has(2);
print blend("ab", "cd"), blend(1, 2, 3), blend(nil, 5, nil);

// سياسات
print blendWith("keep", {a: 1}, {a: 2, b: 3})["a"], blendWith("override", {a: 1}, {a: 2})["a"];
print blendWith({sep: "-"}, "x", "y", "z");
print blendWith({unique: true}, [1, 2], [2, 3]);
try { blendWith("error", {a: 1}, {a: 2}); } catch (e) { print "تعارض مرفوض"; }
print blendWith("error", {a: 1}, {a: 1, b: 2})["b"];

// المصادر لا تتأثر (نسخ عميقة)
let src = {k: [1]};
let out = blend(src, {k: [2]});
print src["k"], out["k"];

// أنواع غير متوافقة / دوال
try { blend({a: 1}, [1]); } catch (e) { print "أنواع غير متوافقة"; }
fun f(x) { return x; }
print blend(f, f)(3);   // الدوال تُدمج الآن (chain) — التفاصيل في blend_power.rin

// instance → map حقوله
let p = Point();
let pm = blend(p, {z: 9});
print pm["x"], pm["y"], pm["z"];

// blendInto: في المكان
let target = {a: 1};
let same = blendInto(target, {b: 2});
print target["b"], len(target);
let arr = [1];
blendInto(arr, [2], [3]);
print arr;
blendInto(p, {y: 7, w: 5});
print p.x, p.y, p.w;
@container=ca
    let v = 1;
.end/container
@container=cb
    let w = 2;
.end/container
let rep = blendInto("cc", ["ca", "cb"]);
print rep["target"], container.get("cc", "v") + container.get("cc", "w");

// وصفات قيم عامة
blendRecipe("base", {parts: [{theme: "dark"}, {lang: "ar"}]});
blendRecipe("full", {include: ["base"], parts: [{lang: "en", size: 3}], policy: "override"});
let cooked = blendCook("full");
print cooked["theme"], cooked["lang"], cooked["size"];
blendRecipe("l1", {include: ["l2"]});
blendRecipe("l2", {include: ["l1"]});
try { blendCook("l1"); } catch (e) { print "دوران مكشوف"; }
