// لهجات print (docs/print_dialects.md): كلها تعطي النتيجة نفسها
let x = 3;
print "كلاسيكية:", x, true;          // اللهجة الكلاسيكية
print("استدعاء:", x, true);           // لهجة الاستدعاء بأقواس
$ "اختصار:", x, true;                 // اختصار $
print("فاصل", "مخصص", x, sep="-");    // سمات داخل القوسين
print("بلا سطر", end="");
print(" | تابع");
print "سمة كلاسيكية", x sep="/";
print(x, x + 1, upper=true, label="L");
print (x + 1) * 2;                    // تعبير بين قوسين يبقى كما كان
print(x + 1) * 2 sep="-";
print("فاصلة أخيرة", x,);
print();
print("بعد الفراغ");
print("شرط", x, if=x > 5);           // لا يُطبع
print("شرط", x, if=x > 1);
