@import "lib/nite.moje.og.rin";

print enumerate(["a", "b"]);
print enumerateFrom(["a", "b"], 1);
print zipArrays([1, 2, 3], ["x", "y"]);
print unzipPairs([[1, "x"], [2, "y"]]);
print compact([1, nil, 0, false, ""]);
print cumsum([1, 2, 3, 4]);
print windowed([1, 2, 3, 4], 2);
print pairwise([1, 2, 3]);
print transpose([[1, 2], [3, 4], [5, 6]]);
print rotate([1, 2, 3, 4], 1);
print rotate([1, 2, 3, 4], -1);
print nth([10, 20, 30], -1);
print nthOr([10, 20, 30], 5, "none");
print interleave([1, 2, 3], ["a", "b"]);
print frequencies(["a", "b", "a"]);
print keyBy([{id: 1, n: "x"}, {id: 2, n: "y"}], fun(o) { return o.id; });
print rangeOf(0, 5);
print rangeStep(0, 10, 3);
print rangeStep(5, 0, -2);
print fillArr(3, 0);
print toArray(nil);
print toArray(5);
print toArray([1]);
print mapValues({a: 1, b: 2}, fun(v, k) { return v * 10; });
print filterValues({a: 1, b: 2, c: 3}, fun(v, k) { return v > 1; });
print invert({a: "x", b: "y"});
print toEntries({a: 1, b: 2});
print deepEqual({a: [1, {b: 2}]}, {a: [1, {b: 2}]});
print deepEqual({a: [1, {b: 2}]}, {a: [1, {b: 3}]});
print deepEqual(nil, nil);
print deepEqual([1, 2], [1, 2, 3]);
let cfg = {db: {hosts: [{name: "h1"}, {name: "h2"}]}};
print tryGet(cfg, "db.hosts.0.name", "?");
print tryGet(cfg, "db.hosts.-1.name", "?");
print tryGet(cfg, "db.hosts.9.name", "?");
print tryGet(cfg, "db.port", 5432);
print tryGet(nil, "a.b", "dflt");
print tryGet(cfg, ["db", "hosts"], nil) ?.[1] ?? "x";
print words("  hello   big\nworld ");
print lines("a\nb\r\nc\n");
print snakeCase("helloWorldFoo");
print snakeCase("Hello World");
print camelCase("hello_world_foo");
print kebabCase("helloWorld");
print substring("abcdef", 1, 3);
print substringFrom("abcdef", -2);
print substring("abcdef", 4, 99);
print substring("abcdef", 3, 1);
print divmod(17, 5);
print approxEqual(0.1 + 0.2, 0.3);
print approxEqual(1, 2);
fun inc(x) { return x + 1; }
fun dbl(x) { return x * 2; }
print pipeThrough(5, [inc, dbl, inc]);
let calls = {n: 0};
let init = once(fun() { calls["n"] = calls["n"] + 1; return "ready"; });
print init();
print init();
print calls["n"];
