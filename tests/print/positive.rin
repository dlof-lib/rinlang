// =[×]= و positive — اختبار / مقارنة / إسناد ضربي مشروط (docs/positive.md)

// 1) اختبار (postfix): x =[×]=  ≡  positive(x)
let a = 5;
let b = -2;
print a =[×]=;          // true
print b =[x]=;          // false  (مفتاح سهل =[x]=)
print 0 =[*]=;          // false  (الصفر ليس موجباً)
if (a =[×]= and b < 0) { print "mixed"; }

// 2) مقارنة داخل شرط: a =[×]= b  ≡  كلاهما موجب
print 3 =[×]= 4;        // true
print 3 =[×]= -4;       // false
if (a =[X]= 10) { print "both positive"; }

// 3) إسناد ضربي مشروط كعبارة: x =[×]= e;  ≡  x = (x*e > 0 ? x*e : x)
let x = 4;
x =[×]= 3;
print x;                // 12
x =[×]= -1;             // النتيجة -12 سالبة ← يبقى 12
print x;                // 12
let arr = [2, 5];
arr[1] =[×]= 2;
print arr;              // [2, 10]

// 4) الدالة السهلة positive(...)
print positive(1, 2, 3);      // true
print positive(1, 0);         // false
print positive([1, 2, 3]);    // true
print positive([]);           // false
print positive("7");          // false
