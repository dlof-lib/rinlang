repeat 3 { print "hi"; }
repeat 3 as i { print "i=" + i; }
let n = 2;
repeat n times as k { print "k=" + k; }
repeat 0 { print "never"; }
repeat 5 { }  #done { print "rep done"; }
repeat 5 as i { if (i == 2) { break; } } #done { print "never2"; }
repeat (1 + 2) as j { print "j" + j; }
let c = 0;
loop (c < 3) { print "c" + c; c = c + 1; }
let d = 0;
loop { d = d + 1; if (d == 3) { break; } }
print "d=" + d;
let e = 0;
loop until (e == 2) { e = e + 1; }
print "e=" + e;
print repeat("ab", 2);
try { let bad = -1; repeat bad { print "x"; } } catch (err) { print "caught: " + err["message"]; }
