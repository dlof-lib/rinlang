each c in [1, 2, 3, 4, 5] by 2 { print c; }
each c, n in "abcdef" by 3 { print n + ":" + c; }
each w in [1, 2, 3, 4] window 2 { print w; }
each w, i in [1, 2, 3] window 3 { print i + "|" + w; }
each x, i in ["a", "b", "c", "d", "e"] every 2 { print i + x; }
each a, b in [1, 2, 3] zip ["x", "y"] { print a + b; }
each a, b in "ab" zip [10, 20] { print a + b; }
each w in [1, 2, 3, 4, 5] window 2 where w[0] % 2 == 1 { print "odd-start " + w; }
print [each w in [1, 2, 3, 4] window 2 yield w[0] + w[1]];
print [each a, b in [1, 2] zip [3, 4] yield a * b];
each c in [1, 2, 3, 4] by 2 { if (c[0] == 1) { continue; } print "second " + c; }
each c in [1, 2] by 5 { print c; } #done { print "done"; }
outer: each r in [[1, 2], [3, 4]] {
    each w in r window 1 { if (w[0] == 3) { break outer; } print "w" + w; }
}
for x in [7, 8] { print "for " + x; }
for i in 1 to 3 { print "to " + i; }
for let y in "ab" { print y; }
for k, v in {"p": 1} { print k + v; }
for (let i = 0; i < 2; i = i + 1) { print "c" + i; }
try { each x in [1, 2] by 0 { } } catch (e) { print e["message"]; }
try { each x in {"a": 1} window 2 { } } catch (e) { print e["message"]; }
