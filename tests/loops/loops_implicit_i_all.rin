// i الضمني في كل أنواع الحلقات: رقم الدورة المنفَّذة من 0
// while: i يبدأ من 0، والعدّاد الخارجي c لا يتأثر
let c = 0;
while (c < 3) { c = c + 1; print "w" + i; }
// =until= / loop (cond) / loop until
let u = 0;
=until=(u >= 2) { u = u + 1; print "u" + i; }
let l = 0;
loop (l < 2) { l = l + 1; print "l" + i; }
let lu = 0;
loop until (lu >= 2) { lu = lu + 1; print "lu" + i; }
// loop { } مع break: i قبل break
let k = 0;
loop { k = k + 1; if (i == 2) { break; } }
print "loop:" + k;
// continue لا يكسر العدّ (الدورة المنفَّذة تُحسب عند البداية)
let n = 0;
while (n < 5) { n = n + 1; if (n % 2 == 0) { continue; } print "c" + i; }
// for C-style بلا تعريف i: الفهرس = رقم الدورة
for (let a = 10; a < 13; a = a + 1) { print "f" + i + ":" + a; }
// for (let x in xs) و for (let [a, b] in pairs)
for (let x in ["p", "q"]) { print "fi" + i + x; }
for (let [a, b] in [[1, 2], [3, 4]]) { print "fp" + i + ":" + (a + b); }
// #do ... #while
let d = 0;
#do { d = d + 1; print "d" + i; } #while (d < 3);
// retry: i = رقم المحاولة من 0
let tries = 0;
retry 3 { tries = tries + 1; print "r" + i; if (tries < 3) { throw "x"; } }
// إغلاق يلتقط قيمة دورته
let fs = [];
let z = 0;
while (z < 3) { z = z + 1; push(fs, fun() { return i; }); }
print fs[0]() + "," + fs[1]() + "," + fs[2]();
// جسم عبارة واحدة بلا كتلة
let s = 0;
while (s < 2) s = s + 1;
let s2 = 0;
while (s2 < 2) { s2 = s2 + 1; }
// تداخل: i للداخلية، والخارجية تحتفظ بعدّادها الخاص حين تذكر i خارج الداخلية
let o = 0;
while (o < 2) { o = o + 1; let m = 0; while (m < 2) { m = m + 1; print "n" + i; } print "o" + i; }
// من يعرّف i بنفسه يبقى كما كان
let j = 0;
while (j < 2) { let i = j * 10; print "own" + i; j = j + 1; }
// i معرَّف قبل الحلقة: يبقى للخارج (لا تغيّر)
let i = 10;
let q = 0;
while (q < 2) { q = q + 1; print "outer" + i; i = i + 1; }
for (let w = 0; w < 1; w = w + 1) { print "keep" + i; }
for (let [i, v] in [[5, 6]]) { print "pat" + i + v; }
// i في ترويسة الحلقة: لا عدّاد ضمني
fun g(i) { let t = 0; while (t < 2) { t = t + 1; print "param" + i; } }
g(9);
