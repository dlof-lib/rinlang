// i / y في كل أشكال each: for بلا أقواس، التجميع، الاختزال، القاموس
for x in [1, 4, 9] { if (y != nil) { print x - y; } }                 // 3 5
for x in ["a", "b"] { print i; }                                       // 0 1
let diffs = [each x in [1, 4, 9, 16] yield (y == nil ? 0 : x - y)];
print diffs;                                                           // [0, 3, 5, 7]
let tagged = [each s in ["a", "b", "c"] yield s + i];
print tagged;                                                          // [a0, b1, c2]
print sum each x in [1, 4, 9, 16] yield (i > 0 ? x - y : 0);          // 15
print count each x in [3, 3, 5, 5, 5, 8] yield x == y;                 // 3
let m = {each s in ["p", "q"] yield s : i};
print m;
// تجاهل ما عُرِّف قبلاً
let y = 7;
print [each x in [1, 2] yield y];                                      // [7, 7]
