eq("private 192.168", iwIsPrivateHost("192.168.0.1"), true);
eq("private meta", iwIsPrivateHost("169.254.169.254"), true);
eq("private v6", iwIsPrivateHost("[::1]"), true);
eq("private .local", iwIsPrivateHost("printer.local"), true);
eq("public host", iwIsPrivateHost("example.com"), false);
eq("public web", iwIsPublicWeb("https://example.com/"), true);
eq("public web local", iwIsPublicWeb("http://127.0.0.1:8080/"), false);
eq("filename", iwFileName("https://a.com/d/My%20File.PDF?x=1"), "My File.PDF");
eq("ext", iwExtension("https://a.com/d/My%20File.PDF?x=1"), "pdf");
eq("ext none", iwExtension("https://a.com/d/"), "");
eq("media image", iwMediaKind("https://a.com/x.PNG"), "image");
eq("media video", iwMediaKind("https://a.com/x.mp4"), "video");
eq("media yt", iwMediaKind("https://youtu.be/dQw4w9WgXcQ"), "video");
eq("media pdf", iwMediaKind("https://a.com/x.pdf"), "pdf");
eq("media page", iwMediaKind("https://a.com/x"), "page");

