// ---- صفحات
eq("card", contains(iwCardHtml("T<", "d", "https://a.com/x", "https://a.com/i.png"), "<img src=\"https://a.com/i.png\""), true);
eq("card escape", contains(iwCardHtml("T<", "d", "https://a.com/x", ""), "T&lt;"), true);
eq("card bad img", contains(iwCardHtml("T", "d", "https://a.com/x", "javascript:1"), "<img"), false);
eq("card bad url", contains(iwCardHtml("T", "d", "javascript:1", ""), "href"), false);
eq("error html", contains(iwErrorHtml("Oops", "No net", {"retry": "Retry"}), "RinPreview.tap()"), true);
eq("loading html", contains(iwLoadingHtml("Loading", {"theme": "dark"}), "#181920"), true);
eq("theme dark", contains(iwFragment("x", {"theme": "dark"}), "background:#181920"), true);
let wp = iwWebViewAttrs("http://192.168.1.5/admin", {"blockPrivate": true});
eq("wv private", wp["mode"], "blocked");
eq("wv strip", iwWebViewAttrs("https://a.com/?utm_source=x&k=1", {"stripTracking": true})["attrs"]["url"], "https://a.com/?k=1");

// ---- مفضّلة
let bm = iwBookmarksNew();
eq("bm add", iwBookmarkAdd(bm, "a.com", "Site A"), true);
eq("bm add2", iwBookmarkAdd(bm, "https://b.com/Docs", ""), true);
eq("bm bad", iwBookmarkAdd(bm, "javascript:1", "x"), false);
eq("bm update", iwBookmarkAdd(bm, "https://a.com/", "Renamed"), true);
eq("bm count", len(bm["items"]), 2);
eq("bm title default", bm["items"][1]["title"], "b.com/Docs");
eq("bm has", iwBookmarkHas(bm, "a.com"), true);
eq("bm list q", len(iwBookmarkList(bm, "RENAMED")), 1);
eq("bm list all", len(iwBookmarkList(bm, "")), 2);
let saved = iwBookmarksSave(bm);
let bm2 = iwBookmarksLoad(saved);
eq("bm roundtrip", len(bm2["items"]), 2);
eq("bm load evil", len(iwBookmarksLoad("[{\"url\": \"javascript:1\"}, 5, {\"url\": \"https://ok.com\"}]")["items"]), 1);
eq("bm remove", iwBookmarkRemove(bm, "a.com"), true);
eq("bm remove none", iwBookmarkRemove(bm, "a.com"), false);
eq("bm after remove", len(bm["items"]), 1);
eq("info ver", iwInfo()["version"], "1.0.0");

// ---- شاشة الربط
eq("screen kind video", iwScreenKind("https://youtu.be/dQw4w9WgXcQ"), "video");
eq("screen kind web", iwScreenKind("https://a.com/x"), "web");
eq("screen kind image", iwScreenKind("https://a.com/x.jpg"), "image");
eq("screen kind spotify", iwScreenKind("https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKUQC"), "audio");
eq("screen kind drive", iwScreenKind("https://drive.google.com/file/d/1AbCdEfGhIjKlMn/view"), "document");
eq("screen kind mail", iwScreenKind("mailto:a@b.co"), "mail");
eq("screen kind rin", iwScreenKind("https://dlof-lib.github.io/rinlang/@majd/math.og.rin"), "rin");
let sv = iwLinkScreen("https://youtu.be/dQw4w9WgXcQ", {});
eq("screen video thumb", contains(sv, "https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg"), true);
eq("screen video play href", contains(sv, "href=\"https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ"), true);
eq("screen video label", contains(sv, "Video") and contains(sv, "Play"), true);
eq("screen video embed mode", contains(iwLinkScreen("https://youtu.be/dQw4w9WgXcQ", {"mode": "embed"}), "<iframe"), true);
let sw = iwLinkScreen("https://example.com/a?b=1", {"lang": "ar", "theme": "light"});
eq("screen web ar", contains(sw, "صفحة ويب") and contains(sw, "فتح"), true);
eq("screen web secure", contains(sw, "🔒"), true);
eq("screen web rtl", contains(sw, "dir=\"rtl\""), true);
eq("screen http warn", contains(iwLinkScreen("http://example.com", {}), "⚠️"), true);
eq("screen image", contains(iwLinkScreen("https://a.com/x.png", {}), "<img src=\"https://a.com/x.png\""), true);
eq("screen mail", contains(iwLinkScreen("mailto:me@b.co?subject=x", {}), "me@b.co") and contains(iwLinkScreen("mailto:me@b.co", {}), "Send email"), true);
eq("screen tel", contains(iwLinkScreen("tel:+9613123456", {}), "+9613123456") and contains(iwLinkScreen("tel:+9613123456", {}), "Call"), true);
eq("screen pdf", contains(iwLinkScreen("https://a.com/My%20Doc.pdf", {}), "My Doc.pdf") and contains(iwLinkScreen("https://a.com/d.pdf", {}), "Download"), true);
eq("screen rin", contains(iwLinkScreen("https://dlof-lib.github.io/rinlang/@majd/math.og.rin", {}), "@majd / math"), true);
eq("screen blocked", contains(iwLinkScreen("javascript:alert(1)", {}), "Link blocked"), true);
eq("screen blocked no href", contains(iwLinkScreen("javascript:alert(1)", {}), "href"), false);
eq("screen blocked private", contains(iwLinkScreen("http://127.0.0.1/", {}), "Link blocked"), true);
eq("screen xss title", contains(iwLinkScreen("https://a.com/", {"title": "<script>x</script>"}), "<script>"), false);
eq("screen no js", contains(iwLinkScreen("https://a.com/", {}), "onclick"), false);
let sa = iwLinkScreenAttrs("https://youtu.be/dQw4w9WgXcQ", {"height": 320});
eq("screen attrs ok", sa["ok"], true);
eq("screen attrs kind", sa["kind"], "video");
eq("screen attrs height", sa["attrs"]["height"], 320);
eq("screen attrs blocked", iwLinkScreenAttrs("javascript:1", {})["ok"], false);
eq("screen source", startsWith(iwLinkScreenSource("Screen", "https://a.com", {"height": 300}), "@view.WebView=Screen\n    html=\""), true);
eq("screen source end", endsWith(iwLinkScreenSource("Screen", "https://a.com", {"height": 300}), "    height=300;\n.end/view\n"), true);
eq("screen source bad name", iwLinkScreenSource("a b", "https://a.com", {}), "");



print("indsinweb: " + toString(__pass) + " passed, " + toString(__fail) + " failed");
if (__fail > 0) { fail("indsinweb tests failed"); }
