// hash_swap.rin — #swap
let a = 1; let b = 2;
#swap a, b;
print a; print b;
#swap(a, b);
print a; print b;
let arr = [10, 20, 30];
#swap arr[0], arr[2];
print arr;
print #swap(arr, 0, 1);
print #swap(arr, 0, -1);
let m = {"x": 1, "y": 2};
print #swap(m, "x", "y");
let p = #swap(1, 2);
print p;
try { #swap(arr, 0, 9); } catch (e) { print e.code; }
