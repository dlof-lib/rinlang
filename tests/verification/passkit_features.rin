let t15 = run1("<db name=\"s\" table=\"pf_l5\" op=\"session.create\" user=\"u1\" ttl=\"100\" now=\"1000\"/><db name=\"c\" table=\"pf_l5\" op=\"session.check\" token=\"$s.token\" now=\"1050\"/><db name=\"d\" table=\"pf_l5\" op=\"session.check\" token=\"$s.token\" now=\"1200\"/><return value=\"{c.userId}|{d.reason}\"/>");
