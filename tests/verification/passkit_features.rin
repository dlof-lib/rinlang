let t11 = run1("<db table=\"pf_l1\" op=\"insert\" id=\"a\" set.name=\"Rima\" set.email=\"r@x.com\"/><db name=\"g\" table=\"pf_l1\" op=\"get\" id=\"a\"/><db name=\"f\" table=\"pf_l1\" op=\"find\" field=\"email\" equals=\"r@x.com\"/><db name=\"c\" table=\"pf_l1\" op=\"count\"/><return value=\"{g.doc.name}|{f.0.name}|{c}\"/>");
