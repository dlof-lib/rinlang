// ======================= Standard primitives: AES-GCM, PBKDF2, CSPRNG =======================
let GK = "feffe9928665731c6d6a8f9467308308";
let GN = "cafebabefacedbaddecaf888";
let GP = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39";
let GA = "feedfacedeadbeeffeedfacedeadbeefabaddad2";
let GC = sec.aesGcmSeal(GK, GN, GP, GA);
feat("F168", "sec.aesGcmSeal: NIST SP 800-38D test case 4 (AES-128-GCM with AAD)", GC == "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47");
feat("F169", "sec.aesGcmSeal: NIST test case 1 (empty message, tag only)", sec.aesGcmSeal("00000000000000000000000000000000", "000000000000000000000000", "", "") == "58e2fccefa7e3061367f1d57a4e7455a");
feat("F170", "sec.aesGcmSeal: NIST test case 15 (AES-256-GCM)", sec.aesGcmSeal("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308", GN, "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255", "") == "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015adb094dac5d93471bdec1a502270e3cc6c");
feat("F171", "sec.aesGcmOpen: round trip returns the plaintext", sec.aesGcmOpen(GK, GN, GC, GA) == GP);
feat("F172", "sec.aesGcmOpen: wrong AAD returns nil (authentication fails)", sec.aesGcmOpen(GK, GN, GC, "00") == nil);
feat("F173", "sec.aesGcmOpen: a flipped ciphertext bit returns nil", sec.aesGcmOpen(GK, GN, "00" + substr(GC, 2, len(GC) - 2), GA) == nil);
feat("F174", "sec.pbkdf2Sha256: RFC 7914 vector (c=1, 64 bytes)", sec.pbkdf2Sha256("passwd", sec.hexEncode("salt"), 1, 64) == "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783");
feat("F175", "sec.pbkdf2Sha256: RFC 7914 vector (c=80000)", sec.pbkdf2Sha256("Password", sec.hexEncode("NaCl"), 80000, 64) == "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d");
feat("F176", "pcPbkdf2 (Rin API) matches the native primitive", pcPbkdf2("passwd", sec.hexEncode("salt"), 1, 32) == "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc");
let AK = pcGenerateKey(32);
let AS = pcSeal(AK, "attack at dawn", "ctx");
feat("F177", "pcSeal now produces AES-256-GCM (format pc2)", AS["ok"] and indexOf(AS["sealed"], "pc2.") == 0 and len(split(AS["sealed"], ".")[1]) == 24);
feat("F178", "pcOpen opens pc2 and rejects a wrong AAD", pcOpen(AK, AS["sealed"], "ctx")["plaintext"] == "attack at dawn" and pcOpen(AK, AS["sealed"], "other")["ok"] == false);
let ASP = split(AS["sealed"], ".");
ASP[2] = "00" + substr(ASP[2], 2, len(ASP[2]) - 2);
feat("F179", "pcOpen rejects a modified pc2 ciphertext", pcOpen(AK, join(ASP, "."), "ctx")["ok"] == false);
let LG = pcSealLegacy(AK, "old data", nil);
feat("F180", "pcOpen still reads legacy pc1 data (backward compatible)", LG["ok"] and indexOf(LG["sealed"], "pc1.") == 0 and pcOpen(AK, LG["sealed"], nil)["plaintext"] == "old data");
feat("F181", "pcSeal uses a fresh random nonce each time", pcSeal(AK, "x", nil)["sealed"] != pcSeal(AK, "x", nil)["sealed"]);
let HV = pkHash("Zt7!mQ4pLw", { iterations: 1000 });
feat("F182", "pkHash now produces pk2 (PBKDF2-HMAC-SHA256) and verifies", indexOf(HV, "pk2$1000$") == 0 and pkVerify("Zt7!mQ4pLw", HV) and pkVerify("wrong", HV) == false);
let HL = pkHash("Zt7!mQ4pLw", { iterations: 50, legacy: true });
feat("F183", "legacy pk1 hashes still verify and are flagged for re-hash", indexOf(HL, "pk1$50$") == 0 and pkVerify("Zt7!mQ4pLw", HL) and pkNeedsRehash(HL, nil) == true);
feat("F184", "pk2 hash with the default iterations is not flagged; lower iterations are", pkNeedsRehash(pkHash("a", { iterations: PK_DEFAULT_ITERATIONS }), nil) == false and pkNeedsRehash(HV, nil) == true);
feat("F185", "sec.randomToken uses the OS CSPRNG: correct length, never repeats", len(sec.randomToken(32)) == 64 and sec.randomToken(16) != sec.randomToken(16));

print "";
print "FEATURES: " + toString(FEAT_TOTAL) + "  FAILED: " + toString(FEAT_FAIL);
if (FEAT_FAIL == 0) { print "ALL PASSED"; }
