let values = [10, 20, 30];
for (let value in values) {
    print value;
}

for (let k = 0; k < 2; k = k + 1) {
    print "repeat";
}

let i = 0;
while (i < 3) {
    print i;
    i = i + 1;
}

let n = 0;
while (n < 10) {
    n = n + 1;
    if (n == 3) { continue; }
    if (n == 6) { break; }
}
print n;
