@import "lib/compose.og.rin";
class P { let n = 1; let m = "x"; }
class A { let v = 1; }
class B { let w = 0; let label = ""; }
enum Color { Red, Green }
fun inc(x) { return x + 1; }
fun dbl(x) { return x * 2; }
fun lbl(x) { return "<" + str(x) + ">"; }

// 1) تحويل
print valueKind(P()); print valueKind(Set([1])); print valueKind(inc);
print asMap([10, 20]); print asMap(P()); print asArray(Set([1, 2])); print asSet({"a": 1});
// 2) تركيب
print chain([inc, dbl])(3); print compose([inc, dbl])(3);
print through(3, [inc, [10, 20, 30, 40, 50], dbl]);
print through("Red", [Color, lbl]);
print juxt([inc, dbl])(5);
print branch(Set([1, 2]), dbl, inc)(2); print branch(Set([1, 2]), dbl, inc)(9);
print attempt(fun(x) { throw "boom"; }, "fallback")(1);
print allOf([fun(x) { return x > 0; }, fun(x) { return x < 10; }])(5);
print anyOf([Set([1]), Set([2])])(2); print neitherOf([Set([1])])(3);
// 3) دمج
print combine({"a": 1, "b": {"x": 1}}, {"b": {"y": 2}, "c": 3});
print combine([1, 2], [3]); print combine(Set([1]), Set([2])); print combine(P(), {"k": 1});
print mergeWith({"a": 1}, {"a": 2, "b": 3}, "keep");
print mergeWith({"a": 1}, {"a": 2}, fun(o, n, k) { return o + n; });
print mergeAll([{"a": 1}, {"b": 2}, {"a": 9}]);
let t = {"a": 1}; mergeInto(t, {"b": 2}); print t;
let p = P(); mergeInto(p, {"n": 42}); print p.n;
print joinRecords([{"id": 1, "n": "a"}, {"id": 2, "n": "b"}], [{"id": 2, "s": 50}, {"id": 3, "n": "c"}], "id");
// 4) تفاعل
print mapOver([1, 2], dbl); print mapOver(Set([1, 2]), dbl); print mapOver({"a": 1}, inc); print mapOver("ab", lbl);
print filterOver([1, 2, 3], Set([1, 3])); print filterOver("hello", Set(["l"]));
print reduceOver(Set([1, 2, 3]), fun(a, v) { return a + v; }, 0);
let a = A(); let b = B();
connect(a, "v", b, "w"); a.v = 5; print b.w;
connectWith(a, "v", b, "label", fun(x) { return "v=" + str(x); }); a.v = 6; print b.label;
// 5) token <-> number
print numbersIn("let x = 4 + 5.5;"); print identifiersIn("let x = y + z;");
