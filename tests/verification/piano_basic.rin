// مكتبة piano: أرقام، ألوان، أشكال، JSON ذهاباً وإياباً، تصميم، أقنعة، تكامل indsin
@import "piano";

print pn_nf(3.14159, 2), pn_nf(-0.001, 2), pn_nf(2.5, 0), pn_nf(1234.5678, 3), pn_n(0.1 + 0.2), pn_nf(100, 2);
print pn_alpha("#f00", 0.5), pn_norm_color("#abc"), pn_esc("a<b & \"c\"");
print pn_nice(0, 27, 5)["max"], pn_nice(3, 97, 5)["step"];

let c = pn_canvas(100, 60);
pn_title(c, "t&t");
pn_bg(c, "#102030");
pn_rect(c, 1, 2, 30, 20, {"fill": "#ff000080", "rx": 4, "dash": [2, 3], "rot": 10});
pn_text(c, 5, 50, "a\nb", {"size": 10});
let p = pn_pen(); pn_move(p, 0, 0); pn_lineto(p, 10, 0); pn_arcto(p, 5, 5, 0, 0, 1, 10, 10); pn_close(p);
pn_path(c, p, {});
print pn_svg(c);

let back = pn_from_json(pn_json(c));
print pn_svg(back) == pn_svg(c);
pn_circle(back, 50, 30, 5, {});
print len(back["nodes"]);

// تصميم: تخطيط، قناع، أيقونة، موصل، عرض متجاوب
let d = pn_canvas(200, 120);
let cells = pn_grid_cells(0, 0, 200, 120, 2, 2, 10);
print len(cells), cells[3]["x"], cells[3]["w"];
let sp = pn_split(0, 0, 100, 40, [1, 3], 0, "row");
print sp[0]["w"], sp[1]["x"];
pn_group(d, {"mask": pn_fade_mask(d, 0, 0, 200, 120, "right")});
pn_icon(d, "check", 4, 4, 24, {"stroke": "#10b981"});
pn_connect(d, 10, 10, 90, 50, {});
pn_display_w(d, 100);
let ds = pn_svg(d);
print substr(ds, 0, 80);
print len(pn_icon_names());
print len(pn_tokens("dark")["palette"]), pn_tokens("ocean")["radius"];
print substr(pn_indsin_image("a", "data:x", 10, 20), 0, 44);

try { pn_theme(c, "nope"); } catch (e) { print "err:", e["message"]; }
try { pn_from_json("{\"a\":1}"); } catch (e) { print "err:", e["message"]; }
try { pn_save(c, "x.png"); } catch (e) { print "err:", e["message"]; }
try { pn_icon(d, "zzz", 0, 0, 10, {}); } catch (e) { print "err:", e["message"]; }
try { pn_chart_uri("zzz", [], [], 10, 10, "light", {}); } catch (e) { print "err:", e["message"]; }
