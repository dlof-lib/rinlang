// hash_loops.rin — #for #in #to #while #do #done #return
#for (let i #in 1 #to 4) { print i; }
#for (let i #in 10 #to 4 step 3) { print i; }
let n = 0;
#while (n < 3) { n = n + 1; } #done { print "while done " + n; }
#while (true) { #done; }
#for (let i #in 1 #to 5) { if (i == 3) { break; } } #done { print "never"; }
#for (let i #in 1 #to 2) { } #done { print "for done"; }
let k = 10;
#do { print "do " + k; k = k + 1; } #while (k < 10);
let j = 0;
#do { j = j + 1; if (j == 2) { continue; } print "j " + j; } #while (j < 4);
fun first_even(list) {
    #for (let v #in list) { if (v % 2 == 0) { #return v; } }
    #return nil;
}
print first_even([1, 3, 4, 6]);
print first_even([1, 3]);
for (let c in "ab") { print c; } #done { print "chars done"; }
print #to(1, 3);
print #to(5, 1);
