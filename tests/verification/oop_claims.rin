fun fails(f) { try { f(); } catch (e) { return true; } return false; }
// private constructor + singleton via static
class Single { private fun init() {} static let inst = nil;
  static fun get() { if (Single.inst == nil) { Single.inst = Single(); } return Single.inst; } }
assert(fails(fun() { Single(); }), "private init blocked outside");
assert(oop.same(Single.get(), Single.get()), "static factory works with private init");
// static inheritance + static holding object + chained
class P { static let n = 0; static let list = [1,2]; }
class C extends P {}
C.n = 5; assertEq(P.n, 5, "static shared via child");
assertEq(len(P.list), 2, "static.field chain read");
// interface extends interface
interface A { fun a(); } interface B extends A { fun b(); }
class Impl implements B { fun a() { return 1; } fun b() { return 2; } }
assert(Impl() instanceof A, "interface inheritance"); 
class Half implements B { fun b() { return 2; } }
assert(fails(fun() { Half(); }), "inherited iface method required");
// trait abstract
trait NeedsX { abstract fun x(); fun twice() { return self.x() * 2; } }
class UX uses NeedsX { fun x() { return 4; } } class NoX uses NeedsX {}
assertEq(UX().twice(), 8, "trait abstract satisfied"); assert(fails(fun() { NoX(); }), "trait abstract missing");
// magic
class M { let v = 1; fun __contains__(x) { return x == self.v; } fun __cmp__(o) { return self.v - o.v; } fun __ne__(o) { return true; } fun init(v) { self.v = v; } }
assert(contains(M(3), 3), "__contains__"); assert(M(1) < M(2), "__cmp__ <"); assert(M(2) >= M(2), "__cmp__ >="); assert(M(1) != M(1), "__ne__");
// lambda inside method sees private
class L { private let s = 7; fun run() { let f = fun() { return self.s; }; return f(); } }
assertEq(L().run(), 7, "lambda keeps class ctx");
// final assigned in init OK
class F { final let k = 0; fun init() { self.k = 5; } } assertEq(F().k, 5, "final in init");
// name as variable still works
let abstract = 3; let final = 4; let get = 5; let static = 6; let trait = 7; let uses = 1; let interface = 2;
assertEq(abstract + final + get + static + trait + uses + interface, 28, "contextual words remain identifiers");
fun override(x) { return x; } assertEq(override(9), 9, "override as fn name");
print "CLAIMS OK";
