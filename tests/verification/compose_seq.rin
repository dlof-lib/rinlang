@import "compose_seq";
print sortAsc([3, 1, 2]); print sortDesc(["b", "a", "c"]); print sortAsc(["banana","apple","Apple","app"]);
let people = [{"n":"a","age":30},{"n":"b","age":20},{"n":"c","age":30}];
print sortBy(people, fun(p){ return p["age"]; });
print groupOver(people, fun(p){ return p["age"]; });
print countBy([1,2,2,3,3,3], identity); print tally("hello");
print partitionOver([1,2,3,4], fun(x){ return x % 2 == 0; });
print uniqOver([1,2,1,3,2]);
print takeOver(Set([1,2,3]), 2); print dropOver([1,2,3], 1); print chunkOver([1,2,3,4,5], 2);
print windowOver([1,2,3,4], 2); print rangeOf(0, 10, 3); print rangeOf(5, 0, -2);
print zipAll([1,2,3], ["a","b"]); print flattenDeep([1,[2,[3,[4]]],5]);
print minOver(people, fun(p){ return p["age"]; }); print maxOver(["aa","b","cccc"], fun(s){ return len(s); });
print scan([1,2,3], fun(a,v){ return a+v; }, 0); print intersperse([1,2,3], 0);
print findOver([1,2,3], fun(x){ return x > 1; }); print anyOver([1,2], Set([2])); print allOver([1,2], Set([1]));
print sumBy(people, fun(p){ return p["age"]; });
print isSorted([1,2,2,3]); print cmpValues([1,2],[1,3]); print cmpValues("b","a");
print indexBy(people, fun(p){ return p["n"]; });
print takeWhileOver([1,2,5,1], fun(x){ return x < 3; }); print dropWhileOver([1,2,5,1], fun(x){ return x < 3; });
print flatMapOver([1,2], fun(x){ return [x, x*10]; }); print sliceOver([1,2,3,4], 1, 3);
