// Exercises the real number-related helpers from lib/math.og.rin and
// lib/functional.og.rin. The original version of this file called several
// names (mod, frac, root, degrees, radians, mapRange, sumRange, isInteger)
// that were never actually defined anywhere in the standard library or the
// interpreter's natives -- this uses the functions that really exist
// (fract, hypot, degToRad/radToDeg, remap, approxEqual, the `%` operator,
// a local sumRange/isIntegerValue helper), and imports the libraries they
// live in, which the original file never did either.
@import "functional.og.rin";
@import "math.og.rin";

fun sumRange(a, b) {
    let total = 0;
    let i = a;
    while (i <= b) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fun isIntegerValue(n) {
    return n == floor(n);
}

print isEven(10);
print isOdd(7);
print isIntegerValue(3.0);
print 17 % 5;
print fract(-3.75);
print gcd(84, 30);
print lcm(12, 18);
print factorial(6);
print isPrime(97);
print hypot(3, 4);
print pow(27, 1 / 3);
print radToDeg(3.141592653589793);
print degToRad(180);
print remap(5, 0, 10, 0, 100);
print approxEqual(0.3, 0.3000000001);
print sumRange(1, 5);
