// معامل تطابق الشكل: =::=  (نفس البنية والأنواع، القيم الورقية تُتجاهل)
print 1 =::= 2, 1 =::= "a", "x" =::= "y", true =::= false, nil =::= nil, nil =::= 0;
print [1, 2, 3] =::= [9, 8, 7], [1, 2] =::= [1, 2, 3], [1, "a"] =::= [2, "b"], [1, "a"] =::= ["a", 1];
print [] =::= [], [[1, 2], [3]] =::= [[0, 0], [0]], [[1, 2], [3]] =::= [[0], [0, 0]];
let u = {"name": "Ana", "age": 30};
let v = {"age": 41, "name": "Omar"};
let w = {"name": "Ana", "age": "30"};
let z = {"name": "Ana"};
print u =::= v, u =::= w, u =::= z, u =::= [1, 2];
let n = {"user": {"id": 1, "tags": ["a", "b"]}};
let m = {"user": {"id": 99, "tags": ["x", "y"]}};
let k = {"user": {"id": 99, "tags": ["x"]}};
print n =::= m, n =::= k;
let s1 = Set([1, 2]);
print s1 =::= Set([7, 8]), s1 =::= Set([7]);
print (1 + 1) =::= 5, [1] =::= [2] and [3] =::= [4], 3 =::= 4 == true;
let ok = [1, 2] =::= [3, 4];
print ok;
// ---- shapeOf / shapeDiff / الدوال / المجموعات ----
print shapeOf({"b": 1, "a": ["x"]});
print shapeOf([1, "a", nil, true]);
let d = shapeDiff({"user": {"id": 1, "tags": ["a", 2]}, "extra": 1}, {"user": {"id": 0, "tags": ["", ""]}, "ok": true});
print len(d);
print d[0]["path"], d[0]["reason"];
print d[1]["path"], d[1]["reason"];
print d[2]["path"], d[2]["reason"];
print d[1]["expected"], d[1]["actual"];
print len(shapeDiff([1, 2], [3, 4])), len(shapeDiff([1, 2], [3]));
fun f1(a) { return a; }
fun f2(b) { return b; }
fun f3(a, b) { return a; }
print f1 =::= f2, f1 =::= f3;
print Set([1, 2]) =::= Set(["a", "b"]), Set([1, 2]) =::= Set([5, 6]);
