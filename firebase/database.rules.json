{
  "rules": {
    "users": {
      ".indexOn": ["username"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "verification_codes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "packages": {
      ".read": true,
      ".indexOn": ["category", "createdAt", "publisherUid"],
      "$packageId": {
        ".write": "auth != null && (!data.exists() || data.child('publisherUid').val() === auth.uid)",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "base64Data": { ".validate": "newData.isString() && newData.val().length <= 8000000" },
        "downloadCount": { ".write": "auth != null" },
        "ratingSum": { ".write": "auth != null" },
        "ratingCount": { ".write": "auth != null" },
        "ratings": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "reportCount": { ".write": "auth != null" },
        "reports": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "likeCount": { ".write": "auth != null" },
        "likes": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      }
    },
    "extensions": {
      ".read": true,
      ".indexOn": ["type", "releaseDate", "developerUid"],
      "$extensionId": {
        ".write": "auth != null && (!data.exists() || data.child('developerUid').val() === auth.uid)",
        "downloadCount": { ".write": "auth != null" },
        "ratingSum": { ".write": "auth != null" },
        "ratingCount": { ".write": "auth != null" },
        "ratings": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "reportCount": { ".write": "auth != null" },
        "reports": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "likeCount": { ".write": "auth != null" },
        "likes": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      }
    }
  }
}
