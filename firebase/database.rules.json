{
  "rules": {
    "users": {
      ".indexOn": [
        "username"
      ],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "subscribers": {
          "$subscriberUid": {
            ".write": "auth != null && auth.uid === $subscriberUid"
          }
        },
        "subscriberCount": {
          ".write": "auth != null"
        }
      }
    },
    "verification_codes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "pairing_codes": {
      "$token": {
        ".read": true,
        ".write": "(auth != null && auth.uid === newData.child('uid').val() && !data.exists()) || (data.exists() && data.child('confirmed').val() === false && data.child('expiresAt').val() > now && newData.child('uid').val() === data.child('uid').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('expiresAt').val() === data.child('expiresAt').val())",
        ".validate": "newData.hasChildren(['uid', 'createdAt', 'expiresAt', 'confirmed'])"
      }
    },
    "packages": {
      ".read": true,
      ".indexOn": [
        "category",
        "createdAt",
        "publisherUid"
      ],
      "$packageId": {
        ".write": "auth != null && (!data.exists() || data.child('publisherUid').val() === auth.uid)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "base64Data": {
          ".validate": "newData.isString() && newData.val().length <= 8000000"
        },
        "downloadCount": {
          ".write": "auth != null"
        },
        "ratingSum": {
          ".write": "auth != null"
        },
        "ratingCount": {
          ".write": "auth != null"
        },
        "ratings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "reportCount": {
          ".write": "auth != null"
        },
        "reports": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "likeCount": {
          ".write": "auth != null"
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "extensions": {
      ".read": true,
      ".indexOn": [
        "type",
        "releaseDate",
        "developerUid"
      ],
      "$extensionId": {
        ".write": "auth != null && (!data.exists() || data.child('developerUid').val() === auth.uid)",
        "downloadCount": {
          ".write": "auth != null"
        },
        "ratingSum": {
          ".write": "auth != null"
        },
        "ratingCount": {
          ".write": "auth != null"
        },
        "ratings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "reportCount": {
          ".write": "auth != null"
        },
        "reports": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "likeCount": {
          ".write": "auth != null"
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "isOfficial": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean() && (newData.val() === false || (data.exists() && data.child('isOfficial').val() === true))"
        }
      }
    }
  }
}