{
  "rules": {
    "users": {
      ".indexOn": [
        "username"
      ],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "subscribers": {
          "$subscriberUid": {
            ".write": "auth != null && auth.uid === $subscriberUid"
          }
        },
        "subscriberCount": {
          ".write": "auth != null"
        }
      }
    },
    "verification_codes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "packages": {
      ".read": true,
      ".indexOn": [
        "category",
        "createdAt",
        "publisherUid",
        "likeCount",
        "downloadCount",
        "publisherName"
      ],
      "$packageId": {
        ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && ((!data.exists() && newData.child('publisherUid').val() === auth.uid) || data.child('publisherUid').val() === auth.uid)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "base64Data": {
          ".validate": "newData.isString() && newData.val().length <= 8000000"
        },
        "ratingSum": {
          ".write": "auth != null"
        },
        "ratingCount": {
          ".write": "auth != null"
        },
        "ratings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "reportCount": {
          ".write": "auth != null"
        },
        "reports": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        ".validate": "newData.hasChildren(['name','version','publisherUid','fileName','base64Data']) && newData.child('publisherUid').val() === (data.exists() ? data.child('publisherUid').val() : auth.uid)",
        "version": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "publisherUid": {
          ".validate": "newData.isString()"
        },
        "publisherName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "fileName": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "sizeBytes": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "iconBase64": {
          ".validate": "newData.isString() && newData.val().length <= 2000000"
        },
        "thumbnailBase64": {
          ".validate": "newData.isString() && newData.val().length <= 4000000"
        },
        "likeCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + (newData.parent().child('likes').child(auth.uid).exists() ? 1 : 0) - (data.parent().child('likes').child(auth.uid).exists() ? 1 : 0)"
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "downloadCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + (newData.parent().child('downloaders').child(auth.uid).exists() ? 1 : 0) - (data.parent().child('downloaders').child(auth.uid).exists() ? 1 : 0)"
        },
        "downloaders": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "extensions": {
      ".read": true,
      ".indexOn": [
        "type",
        "releaseDate",
        "developerUid"
      ],
      "$extensionId": {
        ".write": "auth != null && (!data.exists() || data.child('developerUid').val() === auth.uid)",
        "downloadCount": {
          ".write": "auth != null"
        },
        "ratingSum": {
          ".write": "auth != null"
        },
        "ratingCount": {
          ".write": "auth != null"
        },
        "ratings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "reportCount": {
          ".write": "auth != null"
        },
        "reports": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "likeCount": {
          ".write": "auth != null"
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "isOfficial": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean() && (newData.val() === false || (data.exists() && data.child('isOfficial').val() === true))"
        }
      }
    },
    "libraries": {
      ".read": true,
      ".write": false,
      ".indexOn": [
        "updatedAt",
        "name"
      ],
      "$libKey": {
        ".write": false,
        "likeCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + (newData.parent().child('likes').child(auth.uid).exists() ? 1 : 0) - (data.parent().child('likes').child(auth.uid).exists() ? 1 : 0)"
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "downloadCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + (newData.parent().child('downloaders').child(auth.uid).exists() ? 1 : 0) - (data.parent().child('downloaders').child(auth.uid).exists() ? 1 : 0)"
        },
        "downloaders": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
