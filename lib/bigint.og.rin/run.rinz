// فحص ذاتي سريع عند الاستيراد: يفشل مبكراً وبوضوح إن كان الحساب الأساسي معطوباً
if (big_str(big_mul("99999999999999", "99999999999999")) != "9999999999999800000000000001") { bi_fail("self-test failed (mul)"); }
if (big_str(big_div("100000000000000000000", "7")) != "14285714285714285714") { bi_fail("self-test failed (div)"); }
