// ============================================================================
//  lib/nite.moje.og.rin — «نايت موجي»: ما كانت تنقصه اللغة
//  استيراد:
//    @import "lib/nite.moje.og.rin";
//    @import "lib/nite.moje.og.rin" as nm;
//
//  دوال صغيرة مشتركة لم تكن موجودة لا في اللغة ولا في المكتبات الرسمية الأخرى
//  (فُحصت الأسماء كلها قبل إضافتها)، مكتوبة بـ Rin خالصة فوق ميزة السلامة من nil
//  (`?.` و`??`، انظر docs/null_safe.md). لا شيء منها يعدّل مدخلاته: كلها تُعيد قيماً جديدة.
//
//  مصفوفات : enumerate/enumerateFrom · zipArrays · unzipPairs · compact · cumsum · windowed · pairwise
//            transpose · rotate · nth/nthOr · interleave · frequencies · keyBy · rangeOf/rangeStep · fillArr · toArray
//  كائنات  : mapValues · filterValues · invert · toEntries · deepEqual · tryGet
//  نصوص    : words · lines · snakeCase · camelCase · kebabCase · substring/substringFrom
//  أرقام   : divmod · approxEqual/approxWithin
//  تدفّق   : pipe · once
// ============================================================================

// ملاحظة: دوال Rin ثابتة العدد (لا وسائط افتراضية)، لذا للصيغ الاختيارية دالتان بأسمين.

// ---------------------------------------------------------------- مصفوفات

// [[0, x0], [1, x1], …] — الفهرس مع العنصر
fun enumerate(arr) { return enumerateFrom(arr, 0); }

// نفس enumerate لكن يبدأ العدّ من s (مثلاً 1)
fun enumerateFrom(arr, s) {
    let out = [];
    for (let i = 0; i < len(arr); i++) { push(out, [s + i, arr[i]]); }
    return out;
}

// [[a0, b0], [a1, b1], …] بطول أقصر المصفوفتين
fun zipArrays(a, b) {
    let n = len(a);
    if (len(b) < n) { n = len(b); }
    let out = [];
    for (let i = 0; i < n; i++) { push(out, [a[i], b[i]]); }
    return out;
}

// عكس zipArrays: [[a0,b0],[a1,b1]] ← [[a0,a1],[b0,b1]]
fun unzipPairs(pairs) {
    let left = [];
    let right = [];
    for (let p in pairs) { push(left, p[0]); push(right, p[1]); }
    return [left, right];
}

// يحذف nil فقط (يُبقي 0 و false و "")
fun compact(arr) {
    let out = [];
    for (let x in arr) { if (x != nil) { push(out, x); } }
    return out;
}

// مجموع تراكمي: [1,2,3] ← [1,3,6]
fun cumsum(arr) {
    let out = [];
    let acc = 0;
    for (let x in arr) { acc = acc + x; push(out, acc); }
    return out;
}

// نوافذ منزلقة بطول size: ([1,2,3,4], 2) ← [[1,2],[2,3],[3,4]]
fun windowed(arr, size) {
    let out = [];
    if (size <= 0) { return out; }
    for (let i = 0; i + size <= len(arr); i++) { push(out, slice(arr, i, i + size)); }
    return out;
}

// أزواج متجاورة: [1,2,3] ← [[1,2],[2,3]]
fun pairwise(arr) {
    return windowed(arr, 2);
}

// تبديل الصفوف بالأعمدة: [[1,2],[3,4]] ← [[1,3],[2,4]]
fun transpose(rows) {
    let out = [];
    if (len(rows) == 0) { return out; }
    let cols = len(rows[0]);
    for (let c = 0; c < cols; c++) {
        let col = [];
        for (let r in rows) { push(col, r[c]); }
        push(out, col);
    }
    return out;
}

// تدوير العناصر: ([1,2,3,4], 1) ← [2,3,4,1] ؛ العدد السالب يدوّر يميناً
fun rotate(arr, k) {
    let n = len(arr);
    if (n == 0) { return []; }
    let s = k % n;
    if (s < 0) { s = s + n; }
    let out = [];
    for (let i = 0; i < n; i++) { push(out, arr[(i + s) % n]); }
    return out;
}

// عنصر بالفهرس والسالب من النهاية؛ خارج المدى ← nil بدل خطأ
fun nth(arr, i) { return nthOr(arr, i, nil); }

// مثل nth لكن خارج المدى ← fallback
fun nthOr(arr, i, fallback) {
    let n = len(arr);
    let j = i;
    if (j < 0) { j = n + j; }
    if (j < 0 or j >= n) { return fallback; }
    return arr[j];
}

// تشبيك بالتناوب: ([1,2,3], ["a","b"]) ← [1,"a",2,"b",3]
fun interleave(a, b) {
    let out = [];
    let n = len(a);
    if (len(b) > n) { n = len(b); }
    for (let i = 0; i < n; i++) {
        if (i < len(a)) { push(out, a[i]); }
        if (i < len(b)) { push(out, b[i]); }
    }
    return out;
}

// عدّ تكرار كل قيمة: ["a","b","a"] ← {a: 2, b: 1}
fun frequencies(arr) {
    let out = {};
    for (let x in arr) {
        let k = str(x);
        out[k] = (out[k] ?? 0) + 1;
    }
    return out;
}

// فهرسة العناصر بمفتاح تحسبه fn(item) (الأخير يغلب عند التكرار)
fun keyBy(arr, fn) {
    let out = {};
    for (let x in arr) { out[str(fn(x))] = x; }
    return out;
}

// مدى أرقام [first, stop) بخطوة 1
fun rangeOf(first, stop) { return rangeStep(first, stop, 1); }

// مدى أرقام [first, stop) بخطوة st (تقبل السالب)
fun rangeStep(first, stop, st) {
    let out = [];
    if (st == 0) { return out; }
    let i = first;
    if (st > 0) { while (i < stop) { push(out, i); i = i + st; } }
    else { while (i > stop) { push(out, i); i = i + st; } }
    return out;
}

// مصفوفة من n نسخة من القيمة v
fun fillArr(n, v) {
    let out = [];
    for (let i = 0; i < n; i++) { push(out, v); }
    return out;
}

// تغليف قيمة مفردة بمصفوفة؛ المصفوفة تبقى كما هي؛ nil ← []
fun toArray(v) {
    if (v == nil) { return []; }
    if (type(v) == "array") { return v; }
    return [v];
}

// ---------------------------------------------------------------- كائنات (خرائط)

// يطبّق fn(value, key) على كل قيمة ويُبقي المفاتيح
fun mapValues(m, fn) {
    let out = {};
    for (let k in keys(m)) { out[k] = fn(m[k], k); }
    return out;
}

// يُبقي المدخلات التي يعيد فيها fn(value, key) قيمة صحيحة
fun filterValues(m, fn) {
    let out = {};
    for (let k in keys(m)) { if (fn(m[k], k)) { out[k] = m[k]; } }
    return out;
}

// تبديل المفاتيح بالقيم ({a: "x"} ← {x: "a"}) ؛ القيم تُحوَّل لنصوص
fun invert(m) {
    let out = {};
    for (let k in keys(m)) { out[str(m[k])] = k; }
    return out;
}

// {a: 1, b: 2} ← [["a", 1], ["b", 2]]
fun toEntries(m) {
    let out = [];
    for (let k in keys(m)) { push(out, [k, m[k]]); }
    return out;
}

// مساواة بالقيمة للمصفوفات والخرائط المتداخلة
fun deepEqual(a, b) {
    if (a == nil or b == nil) { return a == nil and b == nil; }
    let ta = type(a);
    if (ta != type(b)) { return false; }
    if (ta == "array") {
        if (len(a) != len(b)) { return false; }
        for (let i = 0; i < len(a); i++) { if (!deepEqual(a[i], b[i])) { return false; } }
        return true;
    }
    if (ta == "map") {
        let ka = keys(a);
        if (len(ka) != len(keys(b))) { return false; }
        for (let k in ka) {
            if (!has(b, k)) { return false; }
            if (!deepEqual(a[k], b[k])) { return false; }
        }
        return true;
    }
    return a == b;
}

// قراءة آمنة بمسار: tryGet(cfg, "db.hosts.0.name", "؟") — لا خطأ أبداً؛ المفقود ← fallback.
// المسار نص بنقاط أو مصفوفة مقاطع؛ المقطع الرقمي فهرس لمصفوفة (والسالب من النهاية).
fun tryGet(root, path, fallback) {
    let parts = path;
    if (type(path) == "string") { parts = split(path, "."); }
    let cur = root;
    for (let seg in parts) {
        if (cur == nil) { return fallback; }
        let t = type(cur);
        if (t == "array") {
            let i = toNumber(seg);
            if (i == nil) { return fallback; }
            if (i < 0) { i = len(cur) + i; }
            if (i < 0 or i >= len(cur)) { return fallback; }
            cur = cur[i];
        } else if (t == "map") {
            if (!has(cur, str(seg))) { return fallback; }
            cur = cur[str(seg)];
        } else {
            return fallback;
        }
    }
    return cur ?? fallback;
}

// ---------------------------------------------------------------- نصوص

// يقسم النص على الفراغات (مسافة/سطر/جدولة) ويتجاهل الفارغ
fun words(s) {
    let out = [];
    let cur = "";
    for (let i = 0; i < len(s); i++) {
        let c = charAt(s, i);
        if (c == " " or c == "\n" or c == "\t" or c == "\r") {
            if (len(cur) > 0) { push(out, cur); cur = ""; }
        } else { cur = cur + c; }
    }
    if (len(cur) > 0) { push(out, cur); }
    return out;
}

// أسطر النص (يتعامل مع \n و\r\n) بلا سطر أخير فارغ
fun lines(s) {
    let out = [];
    let cur = "";
    for (let i = 0; i < len(s); i++) {
        let c = charAt(s, i);
        if (c == "\n") { push(out, cur); cur = ""; }
        else if (c != "\r") { cur = cur + c; }
    }
    if (len(cur) > 0) { push(out, cur); }
    return out;
}

// تقسيم نص إلى كلمات صغيرة من camelCase أو snake_case أو kebab-case أو مسافات
fun _nmSplitWords(s) {
    let out = [];
    let cur = "";
    for (let i = 0; i < len(s); i++) {
        let c = charAt(s, i);
        if (c == "_" or c == "-" or c == " " or c == "\t") {
            if (len(cur) > 0) { push(out, lower(cur)); cur = ""; }
        } else if (upper(c) == c and lower(c) != c) {
            if (len(cur) > 0) { push(out, lower(cur)); }
            cur = c;
        } else { cur = cur + c; }
    }
    if (len(cur) > 0) { push(out, lower(cur)); }
    return out;
}

// helloWorld / Hello World / hello-world ← hello_world
fun snakeCase(s) { return join(_nmSplitWords(s), "_"); }

// hello_world ← helloWorld
fun camelCase(s) {
    let ws = _nmSplitWords(s);
    let out = "";
    for (let i = 0; i < len(ws); i++) {
        if (i == 0) { out = ws[i]; }
        else { out = out + upper(charAt(ws[i], 0)) + substr(ws[i], 1, len(ws[i]) - 1); }
    }
    return out;
}

// helloWorld ← hello-world
fun kebabCase(s) { return join(_nmSplitWords(s), "-"); }

// من lo حتى نهاية النص (السالب من النهاية)
fun substringFrom(s, lo) { return substring(s, lo, len(s)); }

// جزء نص بنمط JavaScript: [lo, hi) ؛ السالب من النهاية؛ خارج المدى يُقصّ بلا خطأ
fun substring(s, lo, hi) {
    let n = len(s);
    let a = lo;
    let b = hi;
    if (a < 0) { a = n + a; }
    if (b < 0) { b = n + b; }
    if (a < 0) { a = 0; }
    if (b > n) { b = n; }
    if (a >= b) { return ""; }
    return substr(s, a, b - a);
}

// ---------------------------------------------------------------- أرقام

// [قسمة صحيحة, باقي] بإشارة المقسوم (نفس سلوك %)
fun divmod(a, b) {
    let r = a % b;
    return [(a - r) / b, r];
}

// تساوٍ تقريبي للأعداد العشرية: |a-b| <= 1e-9
fun approxEqual(a, b) { return approxWithin(a, b, 0.000000001); }

// تساوٍ تقريبي بهامش eps يحدّده المستدعي
fun approxWithin(a, b, eps) { return abs(a - b) <= eps; }

// ---------------------------------------------------------------- تدفّق

// pipeThrough(5, [f, g, h]) ≡ h(g(f(5)))
fun pipeThrough(value, fns) {
    let v = value;
    for (let f in fns) { v = f(v); }
    return v;
}

// دالة تُنفَّذ مرة واحدة فقط وتُعيد النتيجة نفسها في كل نداء لاحق
fun once(fn) {
    let state = { done: false, value: nil };
    return fun() {
        if (!state["done"]) {
            state["value"] = fn();
            state["done"] = true;
        }
        return state["value"];
    };
}
