// الإعدادات الافتراضية تأتي من RINTWIST (لا تحتاج ضبطاً): انظر core/context.zpp و lt_config().

// تُرجعها دالة الحلقة (callback) لإيقاف التكرار مبكراً: return LT_STOP;
export let LT_STOP = "@@looptwist.stop@@";
export let LT_VERSION = "1.0.0";
