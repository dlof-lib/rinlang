// ============================================================================
// relyRIN — Rin-native Markdown / Media / Live Preview bridge
// ============================================================================
// RelyRIN does NOT replace Container or Loom.
// It prepares document/media data and emits Rin Loom source that is consumed by
// Rin's existing @container + @view pipeline.
//
// Flow:
// Markdown -> RelyRIN -> @container -> @view -> Loom/Fabric/Dye
// ============================================================================

// ---------------------------------------------------------------------------
// core
// ---------------------------------------------------------------------------
fun relyEscape(value) {
    let s = toString(value);
    s = replace(s, "&", "&amp;");
    s = replace(s, "<", "&lt;");
    s = replace(s, ">", "&gt;");
    s = replace(s, "\"", "&quot;");
    return s;
}

fun relyQuote(value) {
    let s = toString(value);
    s = replace(s, "\\", "\\\\");
    s = replace(s, "\"", "\\\"");
    s = replace(s, "\r", "");
    s = replace(s, "\n", "\\n");
    return "\"" + s + "\"";
}

fun relyLines(markdown) {
    return split(replace(markdown, "\r\n", "\n"), "\n");
}

fun relyHeadingLevel(line) {
    let n = 0;
    while (n < len(line) and charAt(line, n) == "#") {
        n = n + 1;
    }
    return n;
}

fun relyHeadingText(line, level) {
    let s = substr(line, level);
    if (startsWith(s, " ")) {
        s = substr(s, 1);
    }
    return trim(s);
}

// ---------------------------------------------------------------------------
// markdown inline
// ---------------------------------------------------------------------------
fun relyInline(text) {
    let s = relyEscape(text);

    // Markdown links.
    while (true) {
        let p = indexOf(s, "[");
        if (p < 0) break;
        let a = indexOf(s, "](");
        if (a < 0) break;
        if (a < p) break;
        let e = indexOf(substr(s, a + 2), ")");
        if (e < 0) break;
        e = e + a + 2;

        let label = substr(s, p + 1, a - p - 1);
        let href = substr(s, a + 2, e - a - 2);
        let link = "<a href=\"" + relyEscape(href) + "\" target=\"_blank\" rel=\"noopener noreferrer\">" + label + "</a>";
        s = substr(s, 0, p) + link + substr(s, e + 1);
    }

    s = relyPair(s, "**", "<strong>", "</strong>");
    s = relyPair(s, "__", "<strong>", "</strong>");
    s = relyPair(s, "~~", "<del>", "</del>");
    s = relyPair(s, "*", "<em>", "</em>");
    s = relyPair(s, "_", "<em>", "</em>");

    return s;
}

fun relyPair(text, marker, openTag, closeTag) {
    let s = text;
    let p = indexOf(s, marker);
    while (p >= 0) {
        let tail = substr(s, p + len(marker));
        let r = indexOf(tail, marker);
        if (r < 0) break;
        let e = p + len(marker) + r;
        let inner = substr(s, p + len(marker), e - p - len(marker));
        s = substr(s, 0, p) + openTag + inner + closeTag + substr(s, e + len(marker));
        p = indexOf(s, marker);
    }
    return s;
}

// ---------------------------------------------------------------------------
// markdown -> HTML fragment
// ---------------------------------------------------------------------------
fun relyMdRender(markdown) {
    let lines = relyLines(markdown);
    let out = "";
    let i = 0;
    let code = false;
    let codeText = "";
    let codeLang = "";

    while (i < len(lines)) {
        let raw = lines[i];
        let line = trim(raw);

        if (startsWith(line, "```")) {
            if (code) {
                out = out + "<pre class=\"rely-code\" data-lang=\"" + relyEscape(codeLang) + "\"><code>" + relyEscape(codeText) + "</code></pre>\n";
                code = false;
                codeText = "";
                codeLang = "";
            } else {
                code = true;
                codeLang = trim(substr(line, 3));
            }
            i = i + 1;
            continue;
        }

        if (code) {
            if (codeText != "") codeText = codeText + "\n";
            codeText = codeText + raw;
            i = i + 1;
            continue;
        }

        if (line == "") {
            i = i + 1;
            continue;
        }

        if (startsWith(line, "::youtube ")) {
            out = out + "<div class=\"rely-youtube\"><iframe src=\"https://www.youtube-nocookie.com/embed/" + relyEscape(relyYoutubeId(substr(line, 10))) + "?rel=0\" title=\"YouTube\" allowfullscreen></iframe></div>\n";
            i = i + 1;
            continue;
        }

        if (startsWith(line, "::image ")) {
            let spec = split(substr(line, 8), "|");
            let src = trim(spec[0]);
            let alt = "image";
            if (len(spec) > 1) alt = trim(spec[1]);
            out = out + "<figure class=\"rely-media\"><img src=\"" + relyEscape(src) + "\" alt=\"" + relyEscape(alt) + "\" loading=\"lazy\"></figure>\n";
            i = i + 1;
            continue;
        }

        if (startsWith(line, "::audio ")) {
            out = out + "<audio class=\"rely-audio\" src=\"" + relyEscape(trim(substr(line, 8))) + "\" controls preload=\"metadata\"></audio>\n";
            i = i + 1;
            continue;
        }

        if (startsWith(line, "::video ")) {
            out = out + "<video class=\"rely-video\" src=\"" + relyEscape(trim(substr(line, 8))) + "\" controls playsinline preload=\"metadata\"></video>\n";
            i = i + 1;
            continue;
        }

        let level = relyHeadingLevel(line);
        if (level > 0 and level <= 6 and (len(line) == level or charAt(line, level) == " ")) {
            let title = relyHeadingText(line, level);
            out = out + "<h" + toString(level) + ">" + relyInline(title) + "</h" + toString(level) + ">\n";
            i = i + 1;
            continue;
        }

        if (line == "---" or line == "***" or line == "___") {
            out = out + "<hr class=\"rely-hr\">\n";
            i = i + 1;
            continue;
        }

        if (startsWith(line, ">")) {
            out = out + "<blockquote class=\"rely-quote\">" + relyInline(trim(substr(line, 1))) + "</blockquote>\n";
            i = i + 1;
            continue;
        }

        if (startsWith(line, "- ") or startsWith(line, "* ") or startsWith(line, "+ ")) {
            let item = trim(substr(line, 2));
            out = out + "<ul><li>" + relyInline(item) + "</li></ul>\n";
            i = i + 1;
            continue;
        }

        out = out + "<p>" + relyInline(line) + "</p>\n";
        i = i + 1;
    }

    return out;
}

// ---------------------------------------------------------------------------
// media descriptors — data only; Loom remains the renderer.
// ---------------------------------------------------------------------------
fun relyMediaImage(src, alt) {
    return { kind: "image", src: src, alt: alt };
}

fun relyMediaAudio(src) {
    return { kind: "audio", src: src };
}

fun relyMediaVideo(src) {
    return { kind: "video", src: src };
}

fun relyYoutubeId(url) {
    let s = trim(url);
    let p = indexOf(s, "youtu.be/");
    if (p >= 0) return relyCutUrl(substr(s, p + 9));
    p = indexOf(s, "v=");
    if (p >= 0) return relyCutUrl(substr(s, p + 2));
    p = indexOf(s, "/embed/");
    if (p >= 0) return relyCutUrl(substr(s, p + 7));
    p = indexOf(s, "/shorts/");
    if (p >= 0) return relyCutUrl(substr(s, p + 7));
    return "";
}

fun relyCutUrl(value) {
    let s = value;
    let p = indexOf(s, "?");
    if (p >= 0) s = substr(s, 0, p);
    p = indexOf(s, "&");
    if (p >= 0) s = substr(s, 0, p);
    p = indexOf(s, "#");
    if (p >= 0) s = substr(s, 0, p);
    return s;
}

fun relyMediaYoutube(url) {
    return { kind: "youtube", src: url, id: relyYoutubeId(url) };
}

// ---------------------------------------------------------------------------
// Loom bridge
// ---------------------------------------------------------------------------
// This function creates a REAL Rin source fragment containing @container and
// @view declarations. The existing Loom pipeline consumes that source.
fun relyLoomSource(markdown, containerName, viewName, title) {
    let html = relyMdRender(markdown);

    let source = "@container=" + containerName + "\n";
    source = source + "    @view.Column=" + viewName + "\n";
    source = source + "        padding=20;\n";
    source = source + "        gap=16;\n";
    source = source + "\n";
    source = source + "        @view.Text=Title\n";
    source = source + "            text=" + relyQuote(title) + ";\n";
    source = source + "            size=\"title\";\n";
    source = source + "        .end/view\n";
    source = source + "\n";
    source = source + "        @view.WebView=Document\n";
    source = source + "            html=" + relyQuote(html) + ";\n";
    source = source + "        .end/view\n";
    source = source + "    .end/view\n";
    source = source + ".end/container\n";

    return source;
}

fun relyLoomDocument(markdown) {
    return relyLoomSource(markdown, "RelyPreview", "Root", "RelyRIN Preview");
}

fun relyLoomFile(path) {
    return relyLoomDocument(readFile(path));
}

// Live preview contract: the returned source is intended for the existing
// Loom cold/hot pipeline, which performs Fabric diffing on edits.
fun relyLive(markdown) {
    return relyLoomDocument(markdown);
}

fun relyLiveFile(path) {
    return relyLoomFile(path);
}

fun relyWriteLoomPreview(markdown, path) {
    let source = relyLoomDocument(markdown);
    writeFile(path, source);
    return path;
}

// ---------------------------------------------------------------------------
// styling — emits a Loom @theme block, never a second renderer.
// ---------------------------------------------------------------------------
fun relyThemeSource(themeName, primary, background, text) {
    return "@theme=" + themeName + "\n" +
           "    active=true;\n" +
           "    primary=" + relyQuote(primary) + ";\n" +
           "    background=" + relyQuote(background) + ";\n" +
           "    text=" + relyQuote(text) + ";\n" +
           ".end/theme\n";
}

fun relyStyledLoom(markdown, themeName, primary, background, text) {
    return relyThemeSource(themeName, primary, background, text) +
           relyLoomSource(markdown, "RelyPreview", "Root", "RelyRIN Preview");
}

// ---------------------------------------------------------------------------
// media -> Loom source
// ---------------------------------------------------------------------------
fun relyMediaLoomSource(kind, src, name) {
    let out = "@container=RelyMedia\n";
    out = out + "    @view.Column=Root\n";
    out = out + "        gap=16;\n";

    if (kind == "image") {
        out = out + "        @view.Image=" + name + "\n";
        out = out + "            src=" + relyQuote(src) + ";\n";
        out = out + "        .end/view\n";
    } else if (kind == "video") {
        out = out + "        @view.Video=" + name + "\n";
        out = out + "            src=" + relyQuote(src) + ";\n";
        out = out + "            controls=true;\n";
        out = out + "        .end/view\n";
    } else if (kind == "audio") {
        out = out + "        @view.Audio=" + name + "\n";
        out = out + "            src=" + relyQuote(src) + ";\n";
        out = out + "            controls=true;\n";
        out = out + "        .end/view\n";
    } else if (kind == "youtube") {
        out = out + "        @view.WebView=" + name + "\n";
        out = out + "            src=" + relyQuote("https://www.youtube-nocookie.com/embed/" + relyYoutubeId(src) + "?rel=0") + ";\n";
        out = out + "        .end/view\n";
    }

    out = out + "    .end/view\n";
    out = out + ".end/container\n";
    return out;
}

// ---------------------------------------------------------------------------
// metadata
// ---------------------------------------------------------------------------
fun relyInfo() {
    return {
        name: "relyRIN",
        version: "1.1.0",
        architecture: "RelyRIN -> Container -> Loom -> Fabric/Dye",
        markdown: true,
        livePreview: true,
        styles: true,
        image: true,
        audio: true,
        video: true,
        youtube: true,
        usesContainer: true,
        usesLoom: true,
        replacesLoom: false,
        replacesContainer: false
    };
}
