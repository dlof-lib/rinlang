// Rin Statistics Pro — descriptive statistics.
fun stat_sum(arr){let s=0;let i=0;while(i<len(arr)){s=s+arr[i];i=i+1;}return s;}
fun stat_min(arr){if(len(arr)==0){return nil;}let m=arr[0];let i=1;while(i<len(arr)){if(arr[i]<m){m=arr[i];}i=i+1;}return m;}
fun stat_max(arr){if(len(arr)==0){return nil;}let m=arr[0];let i=1;while(i<len(arr)){if(arr[i]>m){m=arr[i];}i=i+1;}return m;}
fun stat_mean(arr){if(len(arr)==0){return 0;}return stat_sum(arr)/len(arr);}
fun stat_range(arr){if(len(arr)==0){return 0;}return stat_max(arr)-stat_min(arr);}
fun stat_variance(arr){if(len(arr)==0){return 0;}let m=stat_mean(arr);let s=0;let i=0;while(i<len(arr)){let d=arr[i]-m;s=s+d*d;i=i+1;}return s/len(arr);}
fun stat_stddev(arr){return sqrt(stat_variance(arr));}
fun stat_median(arr){if(len(arr)==0){return nil;}let x=sort(arr);let n=len(x);let mid=floor(n/2);if(n%2==1){return x[mid];}return (x[mid-1]+x[mid])/2;}
fun stat_count(arr,value){let c=0;let i=0;while(i<len(arr)){if(arr[i]==value){c=c+1;}i=i+1;}return c;}
