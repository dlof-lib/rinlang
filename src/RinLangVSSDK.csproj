<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Classic Visual Studio extensions (VSSDK / MEF) still target the .NET Framework
         that Visual Studio itself runs on. This is required, not optional. -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>RinLang.VSSDK</RootNamespace>
    <AssemblyName>RinLangVSSDK</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <UseCommonOutputDirectory>true</UseCommonOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>true</DeployExtension>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- We ship our own Properties\AssemblyInfo.cs; without this the SDK also
         generates one in obj\, producing duplicate-attribute (CS0579) errors. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK-style net472 projects don't reference these classic framework
         assemblies by default; MEF's [Export]/[Import] attributes live here. -->
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core VS SDK: MEF editor contracts, shell interop, package infrastructure -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.6.36389" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.6.2179">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.6.40">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Guids.cs" />
    <Compile Include="PackageIds.cs" />
    <Compile Include="RinLangPackage.cs" />
    <Compile Include="ContentDefinition\RinContentDefinition.cs" />
    <Compile Include="Classification\RinClassificationTypes.cs" />
    <Compile Include="Classification\RinClassificationFormats.cs" />
    <Compile Include="Classification\RinTokenizer.cs" />
    <Compile Include="Classification\RinClassifier.cs" />
    <Compile Include="Classification\RinClassifierProvider.cs" />
    <Compile Include="Commands\RunRinFileCommand.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Command table: defines the "Run Rin File" toolbar/menu button -->
    <VSCTCompile Include="RinLangPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="Resources\icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\RinCommand.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Snippets\Rin\*.snippet">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
