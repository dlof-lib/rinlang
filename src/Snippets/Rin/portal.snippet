<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>portal</Title>
      <Shortcut>portal</Shortcut>
      <Description>بوابة/حاوية تنسيق تحمل نمط عرض (style) عام</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>name</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>style://dark</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[@portal=$p1$
	style value="$p2$";
	$end$
.end/portal]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
