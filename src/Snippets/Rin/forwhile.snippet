<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Counting while loop</Title>
      <Shortcut>forwhile</Shortcut>
      <Description>حلقة while بعدّاد جاهزة</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>i</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>count</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[let $p1$ = 0;
while ($p1$ < $p2$) {
	$end$
	$p1$ = $p1$ + 1;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
