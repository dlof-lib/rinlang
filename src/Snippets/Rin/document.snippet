<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>document</Title>
      <Shortcut>document</Shortcut>
      <Description>مستند NoSQL (upsert)</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>id1</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>key</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[document id="$p1$" fields={ $p2$: $end$ };]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
