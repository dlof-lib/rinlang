<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>link.id</Title>
      <Shortcut>link.id</Shortcut>
      <Description>تسجيل معرّف ربط عام (container.link.id) للحاوية الحالية</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>core.user</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[link.id="$p1$";]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
