<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>If</Title>
      <Shortcut>if</Shortcut>
      <Description>جملة شرطية</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>condition</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[if ($p1$) {
	$end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
