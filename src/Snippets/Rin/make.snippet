<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>make</Title>
      <Shortcut>make</Shortcut>
      <Description>المفهوم الجامع make (سابقاً Everything) — أنشئ شيئًا قابلًا للتنفيذ أو الاستخدام: منطق كامل وأي حاوية أخرى متداخلة بلا قيود</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>name</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[@make=$p1$
	$end$
.end/make]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
