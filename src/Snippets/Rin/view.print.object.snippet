<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>view.print/object</Title>
      <Shortcut>viewprintobject</Shortcut>
      <Description>معاينة حيّة لكائن في الكونسول (بمعرّف نصي مسجَّل عبر container.(); أو بقيمة مباشرة)</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>"user01"</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[view.print/object($p1$);]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
