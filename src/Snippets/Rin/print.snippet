<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Print</Title>
      <Shortcut>print</Shortcut>
      <Description>طباعة قيمة</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>expr</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[print $p1$;]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
