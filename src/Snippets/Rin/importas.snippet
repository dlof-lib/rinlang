<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>import as</Title>
      <Shortcut>importas</Shortcut>
      <Description>استيراد مكتبة كحاوية باسم مستعار</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>lib/math.og.rin</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>mathx</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[@import "$p1$" as $p2$;]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
