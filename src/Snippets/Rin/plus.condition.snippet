<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Plus condition (statement-level ternary)</Title>
      <Shortcut>pluscond</Shortcut>
      <Description>شرط ثلاثي عام: plus.condition(cond) { .. } / { .. }</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>condition</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[plus.condition ($p1$) {
	$end$
} / {

}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
