<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Pipeline chain</Title>
      <Shortcut>pipe</Shortcut>
      <Description>سلسلة أنابيب |&gt;</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>result</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>data</Default>
        </Literal>
        <Literal>
          <ID>p3</ID>
          <ToolTip>p3</ToolTip>
          <Default>normalize</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[let $p1$ = $p2$ |> $p3$() |> $end$();]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
