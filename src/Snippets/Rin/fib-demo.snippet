<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Recursive fibonacci example</Title>
      <Shortcut>fib-demo</Shortcut>
      <Description>مثال دالة تكرارية (fibonacci)</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>10</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[fun fib(n) {
	if (n < 2) { return n; }
	return fib(n - 1) + fib(n - 2);
}
print fib($p1$);]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
