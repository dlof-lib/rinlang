<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Function</Title>
      <Shortcut>fun</Shortcut>
      <Description>تعريف دالة</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>name</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>params</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[fun $p1$($p2$) {
	$end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
