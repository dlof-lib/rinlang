<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>container.doc</Title>
      <Shortcut>container.doc</Shortcut>
      <Description>مجموعة مستندات NoSQL</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>p1</ID>
          <ToolTip>p1</ToolTip>
          <Default>name</Default>
        </Literal>
        <Literal>
          <ID>p2</ID>
          <ToolTip>p2</ToolTip>
          <Default>id1</Default>
        </Literal>
        <Literal>
          <ID>p3</ID>
          <ToolTip>p3</ToolTip>
          <Default>value</Default>
        </Literal>
      </Declarations>
      <Code Language="Rin"><![CDATA[@container.doc=$p1$
	document id="$p2$" fields={ $end$: $p3$ };
.end/container.doc]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
