<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية زر "تشغيل" الرئيسي: تدرّج بنفسجي جذّاب بدل اللون المسطّح، مع حالات
     ضغط/تعطيل واضحة، ليكون أبرز عنصر تفاعلي في الشريط العلوي (Call To Action) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#3A3550" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rin_accent_pressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- الحالة الافتراضية: تدرّج أساسي + طبقة لمعان زجاجي علوية خفيفة، لإحساس CTA لامع
         بدل سطح تدرّج مسطّح، بنفس أسلوب bg_bottom_nav_pill لتوحيد لغة "اللمعان" عبر التطبيق. -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle" android:angle="45">
                    <gradient
                        android:type="linear"
                        android:angle="45"
                        android:startColor="@color/rin_run_gradient_start"
                        android:endColor="@color/rin_run_gradient_end" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#3DFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
