<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rin_background">

    <include layout="@layout/toolbar_app" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pairing_title"
                android:textColor="@color/rin_on_toolbar"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/pairing_subtitle"
                android:textColor="@color/rin_editor_hint"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pairing_qr_frame">

                <ImageView
                    android:id="@+id/imgPairingQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:contentDescription="@string/pairing_title"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtPairingToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="@color/rin_editor_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="K5PJ-QT2M-9XCF-3H7L" />

            <TextView
                android:id="@+id/txtPairingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/rin_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="بانتظار التأكيد من GETY..." />

            <TextView
                android:id="@+id/txtPairingCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/rin_editor_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPairingRegenerate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_run_button_premium"
                android:text="@string/pairing_regenerate"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/txtPairingCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="6dp"
                android:text="@string/pairing_cancel"
                android:textColor="@color/rin_editor_hint"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
