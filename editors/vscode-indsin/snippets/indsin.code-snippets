{
  "container": {
    "prefix": "container",
    "description": "indsin container",
    "body": [
      "@container=${1:App}",
      "\t$0",
      ".end/container"
    ]
  },
  "view": {
    "prefix": "view",
    "description": "Generic element",
    "body": [
      "@view.${1|Column,Row,Stack,Card,Box,Grid,Wrap,Scaffold|}=${2:Name}",
      "\t$0",
      ".end/view"
    ]
  },
  "column": {
    "prefix": "column",
    "description": "Column layout",
    "body": [
      "@view.Column=${1:Root}",
      "\tpadding=\"${2|compact,normal,comfortable,spacious|}\";",
      "\tgap=\"${3|compact,normal,comfortable,spacious|}\";",
      "\t$0",
      ".end/view"
    ]
  },
  "row": {
    "prefix": "row",
    "description": "Row layout",
    "body": [
      "@view.Row=${1:Row}",
      "\tgap=\"normal\";",
      "\t$0",
      ".end/view"
    ]
  },
  "card": {
    "prefix": "card",
    "description": "Card",
    "body": [
      "@view.Card=${1:Card}",
      "\ttitle=\"${2:Title}\";",
      "\televation=\"${3|none,xs,sm,md,lg,xl|}\";",
      "\t$0",
      ".end/view"
    ]
  },
  "text": {
    "prefix": "text",
    "description": "Text",
    "body": [
      "@view.Text=${1:Label}",
      "\ttext=\"${2:Hello}\";",
      "\tsize=\"${3|caption,body,label,subtitle,title,heading,headline,display|}\";",
      ".end/view"
    ]
  },
  "button": {
    "prefix": "button",
    "description": "Button with tap handler",
    "body": [
      "@view.Button=${1:Action}",
      "\tlabel=\"${2:Click me}\";",
      "\tvariant=\"${3|fill,outline,ghost,link,glass,gradient|}\";",
      "\tonTap=${4:count = count + 1};",
      ".end/view"
    ]
  },
  "input": {
    "prefix": "input",
    "description": "Text input",
    "body": [
      "@view.Input=${1:Field}",
      "\tlabel=\"${2:Name}\";",
      "\tplaceholder=\"${3:Type here}\";",
      ".end/view"
    ]
  },
  "image": {
    "prefix": "image",
    "description": "Image",
    "body": [
      "@view.Image=${1:Photo}",
      "\tsrc=\"${2:https://example.com/image.png}\";",
      "\talt=\"${3:Description}\";",
      "\tfit=\"${4|cover,contain|}\";",
      ".end/view"
    ]
  },
  "banner": {
    "prefix": "banner",
    "description": "Banner",
    "body": [
      "@view.Banner=${1:Notice}",
      "\ttype=\"${2|info,success,warning,error,action,progress|}\";",
      "\tmessage=\"${3:Saved}\";",
      "\tdismissible=true;",
      ".end/view"
    ]
  },
  "tabs": {
    "prefix": "tabs",
    "description": "Tabs",
    "body": [
      "@view.Tabs=${1:Tabs}",
      "\t@view.TabItem=${2:One}",
      "\t\tlabel=\"${2}\";",
      "\t.end/view",
      "\t@view.TabItem=${3:Two}",
      "\t\tlabel=\"${3}\";",
      "\t.end/view",
      ".end/view"
    ]
  },
  "list": {
    "prefix": "list",
    "description": "List",
    "body": [
      "@view.List=${1:Items}",
      "\t@view.ListItem=${2:Item}",
      "\t\ttext=\"${3:Entry}\";",
      "\t.end/view",
      ".end/view"
    ]
  },
  "responsive": {
    "prefix": "responsive",
    "description": "Responsive attribute set",
    "body": [
      "${1:padding}=\"compact\";",
      "${1}_md=\"normal\";",
      "${1}_lg=\"spacious\";"
    ]
  },
  "effect": {
    "prefix": "effect",
    "description": "Entrance effect",
    "body": [
      "effect=\"${1|fade,slideUp,slideDown,slideLeft,slideRight,pulse,shake,bounce,grow|}\";",
      "duration=\"${2|instant,fast,normal,slow,slower|}\";",
      "easing=\"${3|ease,easeout,easeinout,spring,bounce|}\";"
    ]
  },
  "warp": {
    "prefix": "warp",
    "description": "Reactive state",
    "body": [
      "warp ${1:count} = ${2:0};"
    ]
  },
  "tag-column": {
    "prefix": "<column",
    "description": "Column (tag syntax)",
    "body": [
      "<Column#${1:Root} padding=${2|compact,normal,comfortable,spacious|} gap=${3|compact,normal,comfortable,spacious|}>",
      "\t$0",
      "</Column>"
    ]
  },
  "tag-row": {
    "prefix": "<row",
    "description": "Row (tag syntax)",
    "body": [
      "<Row#${1:Row} gap=normal>",
      "\t$0",
      "</Row>"
    ]
  },
  "tag-card": {
    "prefix": "<card",
    "description": "Card (tag syntax)",
    "body": [
      "<Card#${1:Card} title=\"${2:Title}\" elevation=${3|none,xs,sm,md,lg,xl|}>",
      "\t$0",
      "</Card>"
    ]
  },
  "tag-text": {
    "prefix": "<text",
    "description": "Text with child content",
    "body": [
      "<Text#${1:Label} size=${2|caption,body,label,subtitle,title,heading,headline,display|}>${3:Hello {name}}</Text>"
    ]
  },
  "tag-button": {
    "prefix": "<button",
    "description": "Button with tap handler",
    "body": [
      "<Button#${1:Action} variant=${2|filled,outline,gradient|} onTap={${3:count = count + 1}}>${4:Label}</Button>"
    ]
  },
  "tag-warp": {
    "prefix": "<warp",
    "description": "Reactive state cell",
    "body": [
      "<warp ${1:count}={${2:0}} />"
    ]
  },
  "tag-import": {
    "prefix": "<import",
    "description": "Import library",
    "body": [
      "<Import src=\"${1:lib/ui.og.rin}\" />"
    ]
  },
  "tag-loop": {
    "prefix": "<loop",
    "description": "Loop root",
    "body": [
      "<Loop#${1:canvas}>",
      "\t$0",
      "</Loop>"
    ]
  },
  "tag-fragment": {
    "prefix": "<fragment",
    "description": "Transparent group",
    "body": [
      "<>",
      "\t$0",
      "</>"
    ]
  },
  "tag-define": {
    "prefix": "<define",
    "description": "Component template",
    "body": [
      "<Define#${1:Name} ${2:label}=\"${3:text}\">",
      "\t$0",
      "</Define>"
    ]
  },
  "tag-repeat": {
    "prefix": "<repeat",
    "description": "Compile-time repeat",
    "body": [
      "<Repeat times=${1:3} as=${2:i}>",
      "\t$0",
      "</Repeat>"
    ]
  },
  "tag-if": {
    "prefix": "<if",
    "description": "Reactive condition",
    "body": [
      "<If cond={${1:flag}}>",
      "\t$0",
      "</If>"
    ]
  },
  "tag-else": {
    "prefix": "<else",
    "description": "Else branch",
    "body": [
      "<Else>",
      "\t$0",
      "</Else>"
    ]
  },
  "tag-fun": {
    "prefix": "<fun",
    "description": "Rin function",
    "body": [
      "<Fun#${1:name} params=\"${2:a, b}\">",
      "\t$0",
      "</Fun>"
    ]
  },
  "tag-rin": {
    "prefix": "<rin",
    "description": "Raw Rin code block",
    "body": [
      "<Rin>",
      "\t$0",
      "</Rin>"
    ]
  },
  "tag-screen": {
    "prefix": "<screen",
    "description": "Screen root: size preset or WxH, canvas background",
    "body": [
      "<Screen#${1:app} size=${2|phone,tablet,desktop,watch,tv,phone_landscape|} bg=${3:#0B1020} padding=${4:20} gap=${5:14}>",
      "\t$0",
      "</Screen>"
    ]
  },
  "tag-palette": {
    "prefix": "<palette",
    "description": "Whole theme from ONE seed color (WCAG-checked)",
    "body": [
      "<Palette seed=${1:#6C5CE7} ${2|dark,light|} />"
    ]
  },
  "tag-theme": {
    "prefix": "<theme",
    "description": "Custom theme roles (primary, background, surface, text…)",
    "body": [
      "<Theme#${1:Brand} primary=${2:#6C5CE7} background=${3:#0B1020} surface=${4:#161B33} active />"
    ]
  },
  "tag-aspect": {
    "prefix": "aspect",
    "description": "Height follows width (16:9, 1:1, 4:3)",
    "body": [
      "aspect=\"${1|16:9,1:1,4:3,3:2,21:9|}\""
    ]
  },
  "tag-tokens": {
    "prefix": "<tokens",
    "description": "Design tokens usable as {name}",
    "body": [
      "<Tokens ${1:brand}=${2:#6C5CE7} ${3:pad}=${4:20} />"
    ]
  },
  "tag-style": {
    "prefix": "<style",
    "description": "Reusable named style (apply with class=\"…\")",
    "body": [
      "<Style#${1:card} radius=${2:16} elevation=${3|sm,md,lg,xl|} bg=${4:surface} padding=${5:14} />"
    ]
  },
  "theme-toggle": {
    "prefix": "toggleTheme",
    "description": "Dark/Light toggle button",
    "body": [
      "<Button#${1:themeBtn} onTap={toggleTheme()}>${2:Theme}</Button>"
    ]
  },
  "c-hero": {
    "prefix": "<hero",
    "description": "Gradient hero card",
    "body": [
      "<Hero title=\"${1:Title}\" subtitle=\"${2:Subtitle}\">",
      "\t$0",
      "</Hero>"
    ]
  },
  "c-stat": {
    "prefix": "<stat",
    "description": "Metric card",
    "body": [
      "<Stat label=\"${1:Label}\" value=\"${2:0}\" tint=${3:primary} w=${4:30%} />"
    ]
  },
  "c-chip": {
    "prefix": "<chip",
    "description": "Small pill",
    "body": [
      "<Chip label=\"${1:Label}\" tint=${2:primary} />"
    ]
  },
  "c-alert": {
    "prefix": "<alert",
    "description": "Themed alert",
    "body": [
      "<Alert tone=${1|info,success,warning,danger|} title=\"${2:Title}\" message=\"${3:Message}\" />"
    ]
  },
  "c-section": {
    "prefix": "<section",
    "description": "Titled section",
    "body": [
      "<Section title=\"${1:Title}\">",
      "\t$0",
      "</Section>"
    ]
  },
  "c-listtile": {
    "prefix": "<listtile",
    "description": "List row",
    "body": [
      "<ListTile title=\"${1:Title}\" subtitle=\"${2}\" trailing=\"${3}\" />"
    ]
  },
  "c-toggle": {
    "prefix": "<toggle",
    "description": "Switch row bound to a warp cell",
    "body": [
      "<Toggle label=\"${1:Label}\" cell={${2:flag}} />"
    ]
  },
  "c-empty": {
    "prefix": "<emptystate",
    "description": "Empty state",
    "body": [
      "<EmptyState title=\"${1:Nothing here}\" message=\"${2}\">",
      "\t$0",
      "</EmptyState>"
    ]
  },
  "indsin LoginForm": {
    "prefix": "login",
    "description": "Full login form bound to warp cells",
    "body": [
      "<LoginForm email={${1:email}} password={${2:password}} show={${3:showPw}} remember={${4:remember}}",
      "           error={${5:err}} loading={${6:busy}} submit={${7:signIn()}} />"
    ]
  },
  "indsin Field": {
    "prefix": "field",
    "description": "Labelled bound input",
    "body": [
      "<Field label=\"${1:Email}\" value={${2:cell}} placeholder=\"${3}\" error={${4:cellErr}} />"
    ]
  },
  "indsin PasswordField": {
    "prefix": "passfield",
    "description": "Password field with show/hide",
    "body": [
      "<PasswordField label=\"Password\" value={${1:password}} show={${2:showPw}} meter=true />"
    ]
  },
  "indsin Box row": {
    "prefix": "boxrow",
    "description": "Flex Box row",
    "body": [
      "<Box#${1:row} direction=row gap=${2:8} justify=${3|between,center,end,around,evenly,start|} padding=${4:10} bg=surface radius=${5:14} width=full>",
      "  $0",
      "</Box>"
    ]
  },
  "indsin Box styled": {
    "prefix": "boxstyle",
    "description": "Styled Box",
    "body": [
      "<Box#${1:box} padding=14 radius=12 border=2 borderColor=primary border_style=${2|dashed,dotted,solid|} outline=3 outline_offset=2 opacity=1>",
      "  $0",
      "</Box>"
    ]
  }
}