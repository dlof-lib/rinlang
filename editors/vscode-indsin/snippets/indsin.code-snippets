{
  "container": { "prefix": "container", "description": "indsin container", "body": ["@container=${1:App}", "\t$0", ".end/container"] },
  "view": { "prefix": "view", "description": "Generic element", "body": ["@view.${1|Column,Row,Stack,Card,Box,Grid,Wrap,Scaffold|}=${2:Name}", "\t$0", ".end/view"] },
  "column": { "prefix": "column", "description": "Column layout", "body": ["@view.Column=${1:Root}", "\tpadding=\"${2|compact,normal,comfortable,spacious|}\";", "\tgap=\"${3|compact,normal,comfortable,spacious|}\";", "\t$0", ".end/view"] },
  "row": { "prefix": "row", "description": "Row layout", "body": ["@view.Row=${1:Row}", "\tgap=\"normal\";", "\t$0", ".end/view"] },
  "card": { "prefix": "card", "description": "Card", "body": ["@view.Card=${1:Card}", "\ttitle=\"${2:Title}\";", "\televation=\"${3|none,xs,sm,md,lg,xl|}\";", "\t$0", ".end/view"] },
  "text": { "prefix": "text", "description": "Text", "body": ["@view.Text=${1:Label}", "\ttext=\"${2:Hello}\";", "\tsize=\"${3|caption,body,label,subtitle,title,heading,headline,display|}\";", ".end/view"] },
  "button": { "prefix": "button", "description": "Button with tap handler", "body": ["@view.Button=${1:Action}", "\tlabel=\"${2:Click me}\";", "\tvariant=\"${3|fill,outline,ghost,link,glass,gradient|}\";", "\tonTap=${4:count = count + 1};", ".end/view"] },
  "input": { "prefix": "input", "description": "Text input", "body": ["@view.Input=${1:Field}", "\tlabel=\"${2:Name}\";", "\tplaceholder=\"${3:Type here}\";", ".end/view"] },
  "image": { "prefix": "image", "description": "Image", "body": ["@view.Image=${1:Photo}", "\tsrc=\"${2:https://example.com/image.png}\";", "\talt=\"${3:Description}\";", "\tfit=\"${4|cover,contain|}\";", ".end/view"] },
  "banner": { "prefix": "banner", "description": "Banner", "body": ["@view.Banner=${1:Notice}", "\ttype=\"${2|info,success,warning,error,action,progress|}\";", "\tmessage=\"${3:Saved}\";", "\tdismissible=true;", ".end/view"] },
  "tabs": { "prefix": "tabs", "description": "Tabs", "body": ["@view.Tabs=${1:Tabs}", "\t@view.TabItem=${2:One}", "\t\tlabel=\"${2}\";", "\t.end/view", "\t@view.TabItem=${3:Two}", "\t\tlabel=\"${3}\";", "\t.end/view", ".end/view"] },
  "list": { "prefix": "list", "description": "List", "body": ["@view.List=${1:Items}", "\t@view.ListItem=${2:Item}", "\t\ttext=\"${3:Entry}\";", "\t.end/view", ".end/view"] },
  "responsive": { "prefix": "responsive", "description": "Responsive attribute set", "body": ["${1:padding}=\"compact\";", "${1}_md=\"normal\";", "${1}_lg=\"spacious\";"] },
  "effect": { "prefix": "effect", "description": "Entrance effect", "body": ["effect=\"${1|fade,slideUp,slideDown,slideLeft,slideRight,pulse,shake,bounce,grow|}\";", "duration=\"${2|instant,fast,normal,slow,slower|}\";", "easing=\"${3|ease,easeout,easeinout,spring,bounce|}\";"] },
  "warp": { "prefix": "warp", "description": "Reactive state", "body": ["warp ${1:count} = ${2:0};"] }
}
