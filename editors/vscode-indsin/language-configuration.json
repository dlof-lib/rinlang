{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" }, { "open": "[", "close": "]" }, { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["`", "`"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(@container\\b|@view\\.).*$",
    "decreaseIndentPattern": "^\\s*\\.end/(view|container)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(@container\\b|@view\\.)",
      "end": "^\\s*\\.end/(view|container)\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_][A-Za-z0-9_]*)"
}
